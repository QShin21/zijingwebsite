{
  "name": "zijing-esports",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "miniapp:check": "node scripts/check-miniapp.mjs",
    "miniapp:generate": "node scripts/build-mini-questionnaire.mjs",
    "miniapp:icons": "node scripts/miniapp-icons.mjs",
    "miniapp:preview": "node scripts/wechat.mjs preview",
    "miniapp:upload": "node scripts/wechat.mjs upload",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "db:dev": "node scripts/dev-db.mjs",
    "admin:create": "tsx scripts/admin.ts",
    "seed:demo": "tsx scripts/demo.ts",
    "demo:clean": "tsx scripts/demo.ts clean",
    "setup:local": "node scripts/setup.mjs",
    "db:stop": "node scripts/dev-db.mjs stop",
    "backup": "node scripts/backup.mjs create",
    "restore:verify": "node scripts/backup.mjs verify",
    "format": "prettier --write src scripts tests docs *.mjs *.ts *.json",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/email-nodemailer": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/storage-s3": "3.90.1",
    "@payloadcms/translations": "3.90.1",
    "dotenv": "17.2.3",
    "graphql": "16.11.0",
    "next": "16.3.5",
    "payload": "3.90.1",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.11.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.0.18"
  }
}
