<view wx:if="{{shown}}" class="privacy-mask" catchtouchmove="stop">
  <view class="privacy-dialog" aria-role="dialog" aria-label="{{t.dialog}}">
    <text class="privacy-title">{{t.dialog}}</text>
    <text class="privacy-note">{{t.note}}</text>
    <scroll-view scroll-y class="privacy-body">
      <text wx:if="{{loading}}" class="privacy-note">{{t.loading}}</text>
      <block wx:if="{{docReady}}">
        <text class="privacy-heading">{{t.sitePrefix}}{{title}}</text>
        <rich-text nodes="{{nodes}}" user-select />
        <view wx:for="{{sections}}" wx:key="index"><text class="privacy-heading">{{item.heading}}</text><text class="privacy-text" selectable>{{item.text}}</text></view>
        <view wx:for="{{links}}" wx:key="url"><text class="privacy-note">{{item.label}}</text><text class="privacy-text" selectable>{{item.url}}</text></view>
        <text class="privacy-note">{{t.contractPrefix}}{{contractName}}{{t.contractSuffix}}</text>
        <button class="privacy-secondary" bindtap="openPlatform" loading="{{contractOpening}}" disabled="{{contractOpening}}">{{contractOpened ? t.openAgain : t.open}}</button>
        <text wx:if="{{contractOpened}}" class="privacy-note">{{t.opened}}</text>
      </block>
      <text wx:if="{{error}}" class="privacy-error" aria-role="alert">{{error}}</text>
      <button wx:if="{{error && !docReady}}" class="privacy-secondary" bindtap="retry" disabled="{{loading}}">{{t.retry}}</button>
    </scroll-view>
    <view class="privacy-actions">
      <button class="privacy-secondary" bindtap="deny">{{t.deny}}</button>
      <button wx:if="{{docReady && sdkReady && contractOpened && !contractOpening}}" id="zijing-privacy-agree" class="privacy-primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agree">{{t.agree}}</button>
      <button wx:else class="privacy-primary" disabled>{{t.agree}}</button>
    </view>
  </view>
</view>
