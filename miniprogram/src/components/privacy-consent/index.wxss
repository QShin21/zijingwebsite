.privacy-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1000; background: rgba(21,21,25,.56); display: flex; align-items: center; justify-content: center; padding: 28rpx; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); }
.privacy-dialog { width: 100%; max-height: 90vh; box-sizing: border-box; padding: 30rpx; border: 1rpx solid var(--z-line); border-radius: 16rpx; background: var(--z-surface); color: var(--z-text); }
.privacy-title { display: block; font-size: 36rpx; line-height: 1.5; font-weight: 600; }
.privacy-note { display: block; font-size: 27rpx; color: var(--z-muted); line-height: 1.85; margin: 18rpx 0; }
.privacy-body { height: 48vh; margin: 20rpx 0; font-size: 29rpx; line-height: 1.9; border-top: 1rpx solid var(--z-line); border-bottom: 1rpx solid var(--z-line); }
.privacy-heading { display: block; margin: 24rpx 0 12rpx; font-size: 31rpx; font-weight: 600; }
.privacy-text { display: block; white-space: pre-wrap; word-break: break-word; }
.privacy-error { display: block; margin: 20rpx 0; color: var(--z-error-text); }
.privacy-actions { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 22rpx; }
button { min-height: 44px; border: 1rpx solid var(--z-control-border); border-radius: 12rpx; font-size: 28rpx; padding: 20rpx; line-height: 1.6; margin: 0; }
button::after { border: 0; }
.privacy-actions button { flex: 1; min-width: 200rpx; }
.privacy-secondary { background: var(--z-secondary-bg); color: var(--z-secondary-text); }
.privacy-primary { background: var(--z-primary); color: var(--z-on-primary); border-color: var(--z-primary); }
button[disabled] { background: var(--z-disabled-bg); color: var(--z-disabled-text); opacity: 1; }
