<import src="../../templates/common.wxml" />
<view class="page"><text class="eyebrow">SHARE WITH YOUR PEOPLE</text><text class="title">{{kind === 'showcase' ? '留下这份精彩。' : '聊聊你的想法。'}}</text><template is="feedback" data="{{needsLogin}}" /><view wx:if="{{!needsLogin}}" class="section panel"><view wx:if="{{kind === 'event' || kind === 'notice'}}" class="field"><text class="field-label">发布类型</text><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view>{{categories[categoryIndex]}} ▾</view></picker></view><view class="field"><text class="field-label">标题</text><input value="{{title}}" bindinput="input" data-field="title" placeholder="简洁清晰的标题" maxlength="120" /></view><view class="field"><text class="field-label">正文</text><textarea value="{{body}}" bindinput="input" data-field="body" placeholder="分享你的内容，最多 5000 字" maxlength="5000" /></view><block wx:if="{{kind === 'showcase'}}"><view class="field"><text class="field-label">照片</text><view wx:for="{{images}}" wx:key="path" class="selected-photo"><image src="{{item.path}}" mode="widthFix" /><input value="{{item.caption}}" bindinput="caption" data-index="{{index}}" placeholder="图片说明（可选）" maxlength="200" /><button class="plain" bindtap="removeImage" data-index="{{index}}">移除照片</button></view><button class="secondary" bindtap="chooseImages" disabled="{{images.length >= 6}}">添加照片 · 最多 6 张</button><text class="muted">单张不超过 2 MB，支持静态 PNG、JPEG、WebP。</text></view><view class="field"><text class="field-label">视频链接（可选）</text><input value="{{videoURL}}" bindinput="input" data-field="videoURL" placeholder="填写 HTTPS 视频链接" maxlength="2000" /></view><text class="muted">普通成员的风采投稿经过管理员审核后公开。</text></block><text wx:if="{{error}}" class="error">{{error}}</text><button class="primary section" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{kind === 'showcase' ? '提交投稿' : '发布'}}</button></view></view>
