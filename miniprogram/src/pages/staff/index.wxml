<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page staff-page"><button class="plain" bindtap="back">返回</button><view class="page-heading"><text class="eyebrow">社团工作 · 骨干招新</text><text class="title">骨干招新</text><text class="subtitle">执行部 / 宣传部。参与活动执行与宣传工作，各入口共用同一批次申请和回执。</text></view>
<view class="timeline"><view class="timeline-step current"><text class="timeline-number">01</text><text>选择招新批次</text></view><view class="timeline-step"><text class="timeline-number">02</text><text>填写并提交申请</text></view><view class="timeline-step"><text class="timeline-number">03</text><text>查看回执与反馈</text></view></view>
<template is="feedback" data="{{loading,error,needsLogin}}" />
<block wx:if="{{!loading && !error}}"><text class="section-title section">骨干招新批次</text><view wx:for="{{docs}}" wx:key="id" class="record-sheet"><text class="section-title">{{item.title}}</text><text class="body">{{item.description}}</text><view class="meta"><text class="badge">{{item.state}}</text><text>截止：{{item.deadlineText}}</text></view><button class="primary section" bindtap="openBatch" data-id="{{item.id}}">查看批次与本人申请</button><button wx:if="{{reviewStaff}}" class="plain" bindtap="reviewBatch" data-id="{{item.id}}">审核该批次申请 →</button></view><view wx:if="{{!docs.length}}" class="empty"><text>暂无已发布骨干批次</text><text class="muted">普通入社可以继续查看游戏社群。</text></view><button wx:if="{{hasMore}}" class="plain" loading="{{loading}}" bindtap="more">加载更多批次</button></block>
<view class="section"><text class="section-kicker">本人记录</text><text class="section-title">我的骨干申请</text><text wx:if="{{!user}}" class="muted">登录后查看本人申请与历史回执。</text><button wx:if="{{!user}}" class="secondary" bindtap="login">登录账号</button><text wx:if="{{ownLoading}}" class="muted">正在加载本人回执</text><text wx:if="{{ownError}}" class="error">{{ownError}}</text><button wx:if="{{ownError}}" class="plain" bindtap="retryOwn">重试本人申请</button><view wx:for="{{own}}" wx:key="id" class="record-sheet"><text class="section-title">{{item.batchTitle}}</text><text class="badge">{{item.statusText}}</text><text class="muted">申请编号 {{item.id}} · {{item.updatedText}}</text><button class="plain" bindtap="openBatch" data-id="{{item.batch}}">查看本人回执 →</button></view><text wx:if="{{user && !own.length && !ownLoading && !ownError}}" class="muted">尚无骨干申请</text><button wx:if="{{ownHasMore}}" class="plain" disabled="{{ownLoading}}" bindtap="moreOwn">加载更多本人申请</button></view>
<view wx:if="{{legacy.length || legacyError}}" class="section"><text class="section-title">外部招新与历史资料</text><text class="muted">保留既有批次的报名详情。</text><text wx:if="{{legacyError}}" class="error">{{legacyError}}</text><template is="cards" data="{{docs:legacy,label:'历史骨干招新'}}" /></view></view>
