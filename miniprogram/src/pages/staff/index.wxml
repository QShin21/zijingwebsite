<import src="../../templates/common.wxml" />
<view class="page"><button class="plain" bindtap="back">返回</button><text class="eyebrow">STAFF RECRUITMENT</text><text class="title">执行部 / 宣传部骨干招新</text><text class="subtitle">参与活动执行与宣传工作。主页和所有社群共用同一批次与本人申请。</text>
<view class="row section"><button class="secondary" bindtap="openPage" data-page="communities">找游戏社群</button><button class="secondary" bindtap="apply">申请新建社群</button></view>
<template is="feedback" data="{{loading,error,needsLogin}}" />
<block wx:if="{{!loading && !error}}"><text class="section-title section">骨干招新批次</text><view wx:for="{{docs}}" wx:key="id" class="panel section"><text class="section-title">{{item.title}}</text><text class="body">{{item.description}}</text><text class="badge">{{item.state}}</text><text class="muted">截止：{{item.deadlineText}}</text><button class="primary section" bindtap="openBatch" data-id="{{item.id}}">查看批次与本人申请</button><button wx:if="{{reviewStaff}}" class="plain" bindtap="reviewBatch" data-id="{{item.id}}">审核该批次申请 →</button></view><view wx:if="{{!docs.length}}" class="empty"><text>暂无已发布骨干批次</text><text class="muted">普通入社可以继续查看游戏社群。</text></view><button wx:if="{{hasMore}}" class="plain" loading="{{loading}}" bindtap="more">加载更多批次</button></block>
<view class="section"><text class="section-title">我的骨干申请</text><text wx:if="{{!user}}" class="muted">登录后查看本人申请；普通社区管理员不会因展示入口获得答卷权限。</text><button wx:if="{{!user}}" class="secondary" bindtap="login">登录账号</button><text wx:if="{{ownLoading}}" class="muted">正在加载本人回执</text><text wx:if="{{ownError}}" class="error">{{ownError}}</text><button wx:if="{{ownError}}" class="plain" bindtap="retryOwn">重试本人申请</button><view wx:for="{{own}}" wx:key="id" class="panel section"><text class="section-title">{{item.batchTitle}}</text><text class="badge">{{item.statusText}}</text><text class="muted">申请编号 {{item.id}} · {{item.updatedText}}</text><button class="plain" bindtap="openBatch" data-id="{{item.batch}}">查看本人回执 →</button></view><text wx:if="{{user && !own.length && !ownLoading && !ownError}}" class="muted">尚无骨干申请</text><button wx:if="{{ownHasMore}}" class="plain" disabled="{{ownLoading}}" bindtap="moreOwn">加载更多本人申请</button></view>
<view wx:if="{{legacy.length || legacyError}}" class="section"><text class="section-title">外部招新与历史资料</text><text class="muted">保留既有批次的报名详情。</text><text wx:if="{{legacyError}}" class="error">{{legacyError}}</text><template is="cards" data="{{docs:legacy,label:'历史骨干招新'}}" /></view></view>
