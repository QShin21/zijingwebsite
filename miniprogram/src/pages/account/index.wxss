.profile { display: flex; align-items: center; gap: 24rpx; }
.avatar { display: flex; align-items: center; justify-content: center; width: 108rpx; height: 108rpx; flex-shrink: 0; border-radius: 14rpx; background: var(--z-secondary-bg); color: var(--z-primary); font-size: 44rpx; font-weight: 600; }
.profile-main { flex: 1; min-width: 0; }
.profile-name { display: block; font-size: 33rpx; font-weight: 600; }
.profile-email { word-break: break-all; }
.profile-refresh { display: flex; gap: 16rpx; align-items: center; margin-top: 24rpx; }
.theme-picker { border-top: 1rpx solid var(--z-line); padding-top: 32rpx; }
