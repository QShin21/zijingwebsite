.account-card { position: relative; overflow: hidden; margin: -24rpx -32rpx 0; padding: 48rpx 32rpx 44rpx; background: radial-gradient(70% 140% at 100% 0%, var(--z-stage2), transparent 62%), var(--z-stage); color: var(--z-stage-ink); border-radius: 0 0 48rpx 48rpx; }
.account-card-inner { position: relative; z-index: 2; }
.account-kicker { display: block; color: var(--z-stage-accent, var(--z-stage-ink)); font-size: 22rpx; font-weight: 900; letter-spacing: 6rpx; }
.account-identity { display: flex; align-items: center; gap: 28rpx; margin-top: 24rpx; }
.account-avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 132rpx; height: 132rpx; border-radius: 50%; background: linear-gradient(135deg, var(--z-primary), var(--z-accent)); color: var(--z-on-primary); font-size: 56rpx; font-weight: 900; box-shadow: 0 0 0 10rpx rgba(255, 255, 255, .08); }
.account-who { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.account-name { font-size: 44rpx; font-weight: 900; word-break: break-word; }
.account-role, .account-email { color: var(--z-stage-muted); font-size: 25rpx; }
.account-offices { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 6rpx; }
.account-office { padding: 2rpx 16rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .12); font-size: 22rpx; font-weight: 800; }
.account-refresh { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; }
.account-hint { margin-top: 24rpx; }
.account-todo, .account-queue { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 26rpx; border: 1rpx solid var(--z-line); border-radius: 28rpx; background: var(--z-surface); }
.account-todo-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 72rpx; height: 72rpx; border-radius: 22rpx; background: var(--z-tint); color: var(--z-primary); font-size: 32rpx; font-weight: 900; }
.account-todo-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.account-todo-title { font-size: 30rpx; font-weight: 800; }
.account-team { padding: 24rpx 26rpx; border: 1rpx solid var(--z-line); border-radius: 28rpx; background: var(--z-surface); }
.account-team-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.account-links { margin-top: 24rpx; }
.account-queues { margin-top: 16rpx; }
.mini-page .account-logout { display: block; width: 100%; margin-top: 16rpx; color: var(--z-danger); text-align: center; }

.mini-page .account-team-link { flex: 1; min-width: 44px; min-height: 44px; padding: 8rpx 12rpx 8rpx 0; border: 0; background: transparent; box-shadow: none; color: var(--z-link); text-align: left; font-size: 30rpx; font-weight: 800; word-break: break-word; overflow-wrap: anywhere; }
@media (max-width: 359px) { .mini-page .account-team-link { font-size: 15px; } }
/* 校园美术 (2026-11-13) */
.account-card { border-radius: 0 0 36rpx 36rpx; }
