.profile { display: flex; align-items: center; gap: 26rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 32rpx; background: #f1e8fa; color: #6536a6; display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 700; }
.profile-name { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.profile .muted { display: block; }
.menu { padding: 8rpx 28rpx; }
.menu-row { display: flex; justify-content: space-between; padding: 32rpx 0; border-bottom: 1rpx solid #efe9f4; }
.menu-row:last-child { border-bottom: 0; }
