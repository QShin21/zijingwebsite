<page-meta page-style="{{themePageStyle}}" />
<view class="page mini-page account-page">
  <view class="page-heading"><text class="eyebrow">我的紫荆</text><text class="title">{{user ? '你好，' + user.name : '从这里，参与紫荆。'}}</text><text class="subtitle">查看本人申请、社团记录与展示设置。</text></view>
  <view class="profile"><view class="avatar">{{user ? initial : '紫'}}</view><view class="profile-main" wx:if="{{user}}"><text class="profile-name">{{user.name}}</text><text class="muted">平台身份：{{role}}</text><text class="muted profile-email">{{user.email}}</text></view><view wx:else><text class="profile-name">登录紫荆账号</text><text class="muted">沿用网站账号与清华邮箱验证。</text></view></view>
  <view wx:if="{{refreshing}}" class="profile-refresh" aria-role="status"><view class="state-dot"></view><text class="muted">正在更新账号资料与管理入口</text></view><view wx:if="{{error}}" class="profile-error"><text class="error" aria-role="alert">{{error}}</text><button class="secondary" bindtap="refresh">重新获取账号资料</button></view>
  <view wx:if="{{!user}}" class="action-bar"><button class="primary" bindtap="login">登录账号</button><button class="plain" bindtap="register">注册账号 →</button></view>
  <block wx:if="{{user}}"><view class="section"><text class="section-title">我的申请与回执</text><button class="content-link directory-row" bindtap="openPage" data-page="applications"><view class="directory-main"><text class="directory-title">社群管理员申请</text><text class="muted">建群、参与管理、名片与展示授权。</text></view><text class="directory-arrow">→</text></button><button class="content-link directory-row" bindtap="openPage" data-page="staff"><view class="directory-main"><text class="directory-title">骨干招新申请</text><text class="muted">当前批次、历史回执与处理反馈。</text></view><text class="directory-arrow">→</text></button><button class="content-link directory-row" bindtap="openPage" data-page="team"><view class="directory-main"><text class="directory-title">代表队申请与成员记录</text><text class="muted">选拔、队员简介与本人展示设置。</text></view><text class="directory-arrow">→</text></button><button class="content-link directory-row" bindtap="openPage" data-page="team-honor-workspace"><view class="directory-main"><text class="directory-title">我的荣誉投稿</text><text class="muted">草稿、审核反馈与公开归档。</text></view><text class="directory-arrow">→</text></button></view>
  <view class="section"><text class="section-title">当前可用工作台</text><text class="muted">社群任职与平台身份独立，每次进入会重新核对权限。</text><button wx:if="{{reviewCommunity}}" class="content-link directory-row" bindtap="openPage" data-page="review"><text class="directory-main">建群与管理员申请审核</text><text class="directory-arrow">→</text></button><button wx:if="{{reviewStaff}}" class="content-link directory-row" bindtap="openPage" data-page="staff"><text class="directory-main">骨干招新批次与审核</text><text class="directory-arrow">→</text></button><button class="content-link directory-row" bindtap="openPage" data-page="activity-manage"><text class="directory-main">活动问卷与报名工作台</text><text class="directory-arrow">→</text></button></view></block>
  <view class="section theme-picker"><text class="section-title">外观</text><text class="muted theme-picker-help">默认浅色，记住你的选择，不自动跟随系统。</text><view class="theme-choices"><button class="theme-choice {{theme === 'light' ? 'selected' : ''}}" bindtap="setVisualTheme" data-theme="light" disabled="{{themeUnavailable}}" aria-label="浅色主题{{theme === 'light' ? '，已选择' : ''}}"><view class="theme-swatch theme-swatch-light" aria-hidden="true"><view></view><view></view><view></view></view><view class="theme-choice-title"><text>浅色</text><text wx:if="{{theme === 'light'}}" class="theme-check">✓</text></view></button><button class="theme-choice {{theme === 'dark' ? 'selected' : ''}}" bindtap="setVisualTheme" data-theme="dark" disabled="{{themeUnavailable}}" aria-label="深色主题{{theme === 'dark' ? '，已选择' : ''}}"><view class="theme-swatch theme-swatch-dark" aria-hidden="true"><view></view><view></view><view></view></view><view class="theme-choice-title"><text>深色</text><text wx:if="{{theme === 'dark'}}" class="theme-check">✓</text></view></button></view><text wx:if="{{themeNotice}}" class="theme-message" aria-role="status">{{themeNotice}}</text><text wx:if="{{themeError}}" class="error" aria-role="alert">{{themeError}}</text></view>
  <view class="section"><button class="content-link directory-row" bindtap="openWebsite" data-url="/privacy"><text class="directory-main">隐私说明</text><text class="directory-arrow">→</text></button><button class="content-link directory-row" bindtap="openWebsite" data-url="/contact"><text class="directory-main">联系与合作</text><text class="directory-arrow">→</text></button><button wx:if="{{user}}" class="content-link directory-row" bindtap="reset"><text class="directory-main">重设密码</text><text class="directory-arrow">→</text></button><button wx:if="{{user}}" class="plain section" bindtap="logout">退出账号</button></view><text class="bottom-note">竞在紫荆 · v{{version}}</text>
</view>
