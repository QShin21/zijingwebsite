<page-meta page-style="{{themePageStyle}}" />
<view class="page mini-page account-page"><text class="eyebrow">MY ZIJING</text><text class="title">{{user ? '你好，' + user.name : '你的紫荆，从这里开始。'}}</text><view class="section panel profile"><view class="avatar">{{initial}}</view><view wx:if="{{user}}"><text class="profile-name">{{user.name}}</text><text class="muted">{{role}}</text><text class="muted">{{user.email}}</text></view><view wx:else><text class="profile-name">欢迎来到紫荆</text><text class="muted">使用已有网站账号登录</text></view></view><view wx:if="{{refreshing}}" class="profile-refresh" role="status"><view class="state-dot"></view><text class="muted">正在更新账号资料</text></view><view wx:if="{{error}}" class="profile-error"><text class="error" role="alert">{{error}}</text><button class="secondary" bindtap="refresh">重新获取账号资料</button></view><view wx:if="{{!user}}" class="section"><button class="primary" bindtap="login">登录账号</button><button class="plain" bindtap="register">注册清华邮箱账号 →</button></view>
<view wx:if="{{user}}" class="section panel menu"><button class="menu-row content-link" bindtap="openPage" data-page="applications" hover-class="pressed"><text>我的建群与管理员申请</text><text>→</text></button><button class="menu-row content-link" bindtap="openPage" data-page="staff" hover-class="pressed"><text>我的骨干申请 / 当前批次</text><text>→</text></button><button class="menu-row content-link" bindtap="openPage" data-page="team" hover-class="pressed"><text>代表队招新 / 申请与成员记录</text><text>→</text></button><button class="menu-row content-link" bindtap="openPage" data-page="team-honor-workspace" hover-class="pressed"><text>我的荣誉投稿 / 当前审核入口</text><text>→</text></button><button wx:if="{{reviewCommunity}}" class="menu-row content-link" bindtap="openPage" data-page="review" hover-class="pressed"><text>建群与管理员申请审核</text><text>→</text></button><button class="menu-row content-link" bindtap="openPage" data-page="activity-manage" hover-class="pressed"><text>我的活动报名工作台</text><text>→</text></button><button class="menu-row content-link" bindtap="reset" hover-class="pressed"><text>重设密码</text><text>→</text></button></view>
<view class="section panel menu"><button class="menu-row content-link" bindtap="openWebsite" data-url="/privacy" hover-class="pressed"><text>隐私说明</text><text>→</text></button><button class="menu-row content-link" bindtap="openWebsite" data-url="/contact" hover-class="pressed"><text>联系与合作</text><text>→</text></button></view><button wx:if="{{user}}" class="plain section" bindtap="logout">退出账号</button><view class="section panel theme-picker"><text class="eyebrow">APPEARANCE / ZIJING</text><text class="section-title">外观</text><text class="muted theme-picker-help">默认浅色。会记住你的选择，不自动跟随系统。</text><view class="theme-choices"><button class="theme-choice {{theme === 'light' ? 'selected' : ''}}" bindtap="setVisualTheme" data-theme="light" disabled="{{themeUnavailable}}" hover-class="pressed" aria-label="浅色主题{{theme === 'light' ? '，已选择' : ''}}"><view class="theme-swatch theme-swatch-light" aria-hidden="true"><view></view><view></view><view></view></view><view class="theme-choice-title"><text>浅色</text><text wx:if="{{theme === 'light'}}" class="theme-check" aria-hidden="true">✓</text></view></button><button class="theme-choice {{theme === 'dark' ? 'selected' : ''}}" bindtap="setVisualTheme" data-theme="dark" disabled="{{themeUnavailable}}" hover-class="pressed" aria-label="深色主题{{theme === 'dark' ? '，已选择' : ''}}"><view class="theme-swatch theme-swatch-dark" aria-hidden="true"><view></view><view></view><view></view></view><view class="theme-choice-title"><text>深色</text><text wx:if="{{theme === 'dark'}}" class="theme-check" aria-hidden="true">✓</text></view></button></view><text wx:if="{{themeNotice}}" class="theme-message" aria-role="status">{{themeNotice}}</text><text wx:if="{{themeError}}" class="error" aria-role="alert">{{themeError}}</text></view><text class="bottom-note">竞在紫荆 · v{{version}}</text></view>
