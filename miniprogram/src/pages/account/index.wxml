<view class="page"><text class="eyebrow">MY ZIJING</text><text class="title">{{user ? '你好，' + user.name : '你的紫荆，从这里开始。'}}</text><view class="section panel profile"><view class="avatar">{{initial}}</view><view wx:if="{{user}}"><text class="profile-name">{{user.name}}</text><text class="muted">{{role}}</text><text class="muted">{{user.email}}</text></view><view wx:else><text class="profile-name">欢迎来到紫荆</text><text class="muted">使用已有网站账号登录</text></view></view><text wx:if="{{error}}" class="error">{{error}}</text><view wx:if="{{!user}}" class="section"><button class="primary" bindtap="login">登录账号</button><button class="plain" bindtap="register">注册清华邮箱账号 →</button></view>
<view wx:if="{{user}}" class="section panel menu"><view class="menu-row" bindtap="openPage" data-page="applications"><text>我的建群与管理员申请</text><text>→</text></view><view class="menu-row" bindtap="openPage" data-page="staff"><text>我的骨干申请 / 当前批次</text><text>→</text></view><view class="menu-row" bindtap="openPage" data-page="team"><text>代表队招新 / 申请与成员记录</text><text>→</text></view><view class="menu-row" bindtap="openPage" data-page="team-honor-workspace"><text>我的荣誉投稿 / 当前审核入口</text><text>→</text></view><view wx:if="{{reviewCommunity}}" class="menu-row" bindtap="openPage" data-page="review"><text>建群与管理员申请审核</text><text>→</text></view><view class="menu-row" bindtap="openPage" data-page="activity-manage"><text>我的活动报名工作台</text><text>→</text></view><view class="menu-row" bindtap="reset"><text>重设密码</text><text>→</text></view></view>
<view class="section panel menu"><view class="menu-row" bindtap="openWebsite" data-url="/privacy"><text>隐私说明</text><text>→</text></view><view class="menu-row" bindtap="openWebsite" data-url="/contact"><text>联系与合作</text><text>→</text></view></view><button wx:if="{{user}}" class="plain section" bindtap="logout">退出账号</button><text class="bottom-note">竞在紫荆 · v{{version}}</text></view>
