<page-meta page-style="{{themePageStyle}}" />
<view class="page mini-page native-page account-page">
  <view class="account-heading"><text class="title">我的紫荆</text></view>
  <view wx:if="{{user}}" class="account-identity"><view class="account-avatar">{{initial}}</view><view class="account-identity-copy"><text class="account-name">{{user.name}}</text><text class="account-role">平台身份：{{role}}</text><text class="account-email" selectable>{{user.email}}</text></view></view>
  <view wx:if="{{refreshing}}" class="account-refresh" aria-role="status"><view class="state-dot"></view><text class="muted">正在核对账号与管理权限</text></view>
  <view wx:if="{{error}}" class="account-profile-error"><text class="error" aria-role="alert">{{error}}</text><button class="secondary" bindtap="refresh">重新获取账号资料</button></view>
  <view wx:if="{{!user}}" class="account-login"><text class="section-title">登录后继续你的事务</text><text class="native-summary">网站与小程序使用同一紫荆账号，注册时验证清华邮箱。</text><view class="actions"><button class="primary" bindtap="login">登录账号</button><button class="secondary" bindtap="register">注册账号</button></view></view>
  <block wx:if="{{user}}">
    <view class="native-section account-applications"><view class="native-section-head"><text class="section-title">我的申请与投稿</text></view>
      <view class="account-task-grid">
        <button class="content-link account-task" bindtap="openPage" data-page="applications" hover-class="pressed"><text class="account-task-title">社群管理员申请</text><text class="account-task-detail">处理结果与名片授权</text></button>
        <button class="content-link account-task" bindtap="openPage" data-page="staff" hover-class="pressed"><text class="account-task-title">骨干招新申请</text><text class="account-task-detail">继续填写与查看回执</text></button>
        <button class="content-link account-task" bindtap="openPage" data-page="team" data-params="{{teamApplicationParams}}" hover-class="pressed"><text class="account-task-title">入队申请</text><text class="account-task-detail">选拔进度与退回意见</text></button>
        <button class="content-link account-task" bindtap="openPage" data-page="team-honor-workspace" hover-class="pressed"><text class="account-task-title">荣誉投稿</text><text class="account-task-detail">草稿、材料与审核结果</text></button>
      </view>
      <button class="content-link account-activity" bindtap="openPage" data-page="events" hover-class="pressed"><view><text class="native-entry-title">活动报名与回执</text><text class="native-summary">进入对应活动，查看本人报名回执。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button>
    </view>
    <view class="native-section account-memberships"><view class="native-section-head"><text class="section-title">社群与队伍</text></view><button class="content-link shortcut" bindtap="openPage" data-page="communities"><view class="shortcut-main"><text class="shortcut-title">联系管理员与进群进度</text><text class="muted">进入对应社群查看自己的联系记录。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button><button class="content-link shortcut" bindtap="openPage" data-page="team" data-params="{{membershipParams}}"><view class="shortcut-main"><text class="shortcut-title">成员记录与公开简介</text><text class="muted">查看当前队伍与本人展示设置。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button></view>
    <view class="native-section account-workbench"><view class="native-section-head"><text class="section-title">管理工作台</text></view><text class="muted">各工作台按当前任职核对可处理的社群、队伍与对象。</text><view class="account-workbench-list"><button wx:if="{{reviewCommunity}}" class="content-link account-workbench-entry" bindtap="openPage" data-page="review"><text>社群与管理员申请审核</text><text aria-hidden="true">›</text></button><button wx:if="{{reviewStaff}}" class="content-link account-workbench-entry" bindtap="openPage" data-page="staff"><text>骨干招新批次与审核</text><text aria-hidden="true">›</text></button><button class="content-link account-workbench-entry" bindtap="openPage" data-page="activity-manage"><text>活动问卷与报名</text><text aria-hidden="true">›</text></button><button class="content-link account-workbench-entry" bindtap="openPage" data-page="team" data-params="{{managedTeamParams}}"><text>我可管理的队伍</text><text aria-hidden="true">›</text></button></view></view>
  </block>
  <view class="native-section account-appearance"><text class="section-title">外观</text><text class="native-summary">默认浅色，记住你的选择，不自动跟随系统。</text><view class="theme-choices"><button class="theme-choice {{theme === 'light' ? 'selected' : ''}}" bindtap="setVisualTheme" data-theme="light" disabled="{{themeUnavailable}}" aria-label="浅色主题{{theme === 'light' ? '，已选择' : ''}}"><view class="theme-swatch theme-swatch-light" aria-hidden="true"><view></view><view></view><view></view></view><view class="theme-choice-title"><text>浅色</text><text wx:if="{{theme === 'light'}}" class="theme-check">✓</text></view></button><button class="theme-choice {{theme === 'dark' ? 'selected' : ''}}" bindtap="setVisualTheme" data-theme="dark" disabled="{{themeUnavailable}}" aria-label="深色主题{{theme === 'dark' ? '，已选择' : ''}}"><view class="theme-swatch theme-swatch-dark" aria-hidden="true"><view></view><view></view><view></view></view><view class="theme-choice-title"><text>深色</text><text wx:if="{{theme === 'dark'}}" class="theme-check">✓</text></view></button></view><text wx:if="{{themeNotice}}" class="theme-message" aria-role="status">{{themeNotice}}</text><text wx:if="{{themeError}}" class="error" aria-role="alert">{{themeError}}</text></view>
  <view class="native-section account-settings"><button class="content-link account-setting" bindtap="openWebsite" data-url="/privacy"><text>隐私说明</text><text aria-hidden="true">›</text></button><button class="content-link account-setting" bindtap="openWebsite" data-url="/contact"><text>联系与合作</text><text aria-hidden="true">›</text></button><button wx:if="{{user}}" class="content-link account-setting" bindtap="reset"><text>重设密码</text><text aria-hidden="true">›</text></button><button wx:if="{{user}}" class="plain account-logout" bindtap="logout">退出账号</button></view>
  <text class="bottom-note">竞在紫荆 / v{{version}}</text>
</view>
