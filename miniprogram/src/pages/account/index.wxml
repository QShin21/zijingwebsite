<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/v2.wxml" />
<view class="page mini-page zj-tab-page account-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="account-card">
    <view class="zj-stage-stripes"></view>
    <zj-campus scene="{{scene}}" palette="{{palette}}" />
    <view class="account-card-inner">
      <text class="account-kicker">MY ZIJING · {{t.mine}}</text>
      <view class="account-identity">
        <view class="account-avatar">{{initial}}</view>
        <view class="account-who">
          <text class="account-name">{{user ? user.name : t.notSignedIn}}</text>
          <text wx:if="{{user}}" class="account-role">{{affiliation}}{{campus ? ' · ' + role : ''}}</text>
          <text wx:if="{{user}}" class="account-email" selectable>{{user.email}}</text>
          <view wx:if="{{campus && me.communities.length}}" class="account-offices">
            <text wx:for="{{me.communities}}" wx:key="*this" class="account-office">{{item}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{me}}" class="zj-scoreboard">
        <view class="zj-score"><text class="zj-score-value">{{me.todo.length}}</text><text class="zj-score-label">{{t.todo}}</text></view>
        <view class="zj-score"><text class="zj-score-value">{{me.counts.signups}}</text><text class="zj-score-label">{{t.signups}}</text></view>
        <view wx:if="{{campus}}" class="zj-score"><text class="zj-score-value">{{me.counts.applications}}</text><text class="zj-score-label">{{t.applications}}</text></view>
      </view>
      <view wx:if="{{!user}}" class="actions">
        <button class="accent" bindtap="login">{{t.cLoginAction}}</button>
        <button class="zj-stage-ghost" bindtap="register">{{t.cRegister}}</button>
      </view>
    </view>
  </view>

  <view wx:if="{{refreshing}}" class="account-refresh" aria-role="status"><view class="state-dot"></view><text class="muted">{{t.checking}}</text></view>
  <view wx:if="{{error}}"><text class="error" aria-role="alert">{{error}}</text><button class="secondary" bindtap="refresh">{{t.reloadAccount}}</button></view>
  <text wx:if="{{!user}}" class="muted account-hint">{{t.accountHint}}</text>

  <block wx:if="{{user && me}}">
    <view class="zj-section">
      <template is="zj-section" data="{{title: t.todo, count: me.todo.length}}" />
      <view wx:if="{{me.todo.length}}" class="zj-list">
        <view wx:for="{{me.todo}}" wx:key="key" class="account-todo" hover-class="zj-pressed" bindtap="openTodo" data-url="{{item.href}}" data-web="{{item.web}}" aria-role="link" aria-label="{{item.title}}">
          <text class="account-todo-icon">{{item.kind === 'review' ? '◎' : '!'}}</text>
          <view class="account-todo-main"><text class="account-todo-title">{{item.title}}</text><text class="zj-small">{{item.web ? t.webOnlyPrefix : ''}}{{item.detail}}</text></view>
          <text wx:if="{{item.count}}" class="zj-count">{{item.count}}</text>
          <text wx:else class="zj-arrow">›</text>
        </view>
      </view>
      <template wx:else is="zj-empty" data="{{title: t.todoEmpty, body: t.todoEmptyBody, icon: '✓', action: t.browseEvents, page: 'events'}}" />
    </view>

    <view class="zj-section">
      <template is="zj-section" data="{{title: t.mySchedule, more: t.allSignups, page: 'records', params: signupRecordParams}}" />
      <text wx:if="{{me.counts.archivedUpcoming}}" class="muted account-archive-hint">{{t.archivedUpcomingPrefix}}{{me.counts.archivedUpcoming}}{{t.archivedUpcomingSuffix}}</text>
      <view wx:if="{{me.upcoming.length}}"><block wx:for="{{me.upcoming}}" wx:key="key"><template is="zj-match" data="{{item, img, t, archive: true}}" /></block></view>
      <template wx:elif="{{me.counts.archivedUpcoming}}" is="zj-empty" data="{{title: t.allUpcomingArchived, body: t.allUpcomingArchivedBody, icon: '🎫', action: t.viewAllSignups, page: 'records', params: signupRecordParams}}" />
      <template wx:else is="zj-empty" data="{{title: t.noSignups, body: t.noSignupsBody, icon: '🎫', action: t.viewEvents, page: 'events'}}" />
      <button class="plain account-events-link" bindtap="openPage" data-page="events">{{t.browseSchedule}}</button>
    </view>

    <view class="zj-section">
      <template is="zj-section" data="{{title: t.seatReceipts}}" />
      <view wx:if="{{seatReceipts.length}}" class="zj-list">
        <view wx:for="{{seatReceipts}}" wx:key="key" class="account-todo" bindtap="openSeatReceipt" data-kind="{{item.kind}}" data-id="{{item.id}}" aria-role="link">
          <view class="account-todo-main"><text class="account-todo-title">{{item.title}}</text><text class="zj-small">{{item.summary}}</text></view><text wx:if="{{item.id}}" class="zj-arrow">›</text>
        </view>
      </view>
      <text wx:elif="{{!seatError}}" class="muted">{{t.seatEmpty}}</text>
      <text wx:if="{{seatError}}" class="error">{{t.seatError}}</text>
      <button wx:if="{{seatHasNext}}" class="secondary" bindtap="moreSeatReceipts" loading="{{seatLoading}}" disabled="{{seatLoading}}">{{t.seatMore}}</button>
    </view>

    <view wx:if="{{campus}}" class="zj-section">
      <template is="zj-section" data="{{title: t.progress, count: me.applications.length, more: t.allApplications, page: 'records', params: applicationRecordParams}}" />
      <text wx:if="{{me.counts.archivedApplications}}" class="muted account-archive-hint">{{t.archivedApplicationsPrefix}}{{me.counts.archivedApplications}}{{t.archivedApplicationsSuffix}}</text>
      <view wx:if="{{me.applications.length}}" class="zj-list"><block wx:for="{{me.applications}}" wx:key="key"><template is="zj-application" data="{{item, t, archive: true}}" /></block></view>
      <template wx:elif="{{me.counts.archivedApplications}}" is="zj-empty" data="{{title: t.allApplicationsArchived, body: t.allApplicationsArchivedBody, icon: '📮', action: t.viewAllApplications, page: 'records', params: applicationRecordParams}}" />
      <template wx:else is="zj-empty" data="{{title: t.noApplications, body: t.noApplicationsBody, icon: '📮'}}" />
      <view class="account-links">
        <button class="shortcut" bindtap="openPage" data-page="applications"><view class="shortcut-main"><text class="shortcut-title">{{t.adminApplication}}</text><text class="muted">{{t.adminApplicationHint}}</text></view><text class="shortcut-sign">›</text></button>
        <button class="shortcut" bindtap="openPage" data-page="staff"><view class="shortcut-main"><text class="shortcut-title">{{t.staffApplication}}</text><text class="muted">{{t.staffApplicationHint}}</text></view><text class="shortcut-sign">›</text></button>
        <button class="shortcut" bindtap="openPage" data-page="team" data-params="{{teamApplicationParams}}"><view class="shortcut-main"><text class="shortcut-title">{{t.teamApplication}}</text><text class="muted">{{t.teamApplicationHint}}</text></view><text class="shortcut-sign">›</text></button>
        <button class="shortcut" bindtap="openPage" data-page="team-honor-workspace"><view class="shortcut-main"><text class="shortcut-title">{{t.honorSubmission}}</text><text class="muted">{{t.honorSubmissionHint}}</text></view><text class="shortcut-sign">›</text></button>
      </view>
    </view>

    <view wx:if="{{campus}}" class="zj-section">
      <template is="zj-section" data="{{title: t.myTeams}}" />
      <view wx:if="{{me.memberships.length}}" class="zj-list">
        <view wx:for="{{me.memberships}}" wx:key="id" class="account-team">
          <view class="row"><button class="account-team-link" bindtap="openTeam" data-slug="{{item.slug}}" aria-role="link">{{item.title}} ›</button><text class="zj-pill {{item.active ? 'zj-pill-success' : 'zj-pill-neutral'}}">{{item.status}}</text></view>
          <view wx:if="{{item.active}}" class="account-team-actions">
            <button wx:if="{{item.actions.editProfile}}" class="secondary" bindtap="openTeamPage" data-page="team-profiles" data-team="{{item.teamID}}">{{t.editProfile}}</button>
            <button wx:if="{{item.actions.submitHonor}}" class="secondary" bindtap="openTeamPage" data-page="team-honor-workspace" data-team="{{item.teamID}}">{{t.submitHonor}}</button>
            <button wx:if="{{item.actions.leave}}" class="plain" bindtap="openPage" data-page="team" data-params="{{membershipParams}}">{{t.leaveTeam}}</button>
          </view>
        </view>
      </view>
      <template wx:else is="zj-empty" data="{{title: t.noTeams, body: t.noTeamsBody, icon: '🏆', action: t.viewTrials, page: 'recruitment'}}" />
    </view>

    <view wx:if="{{campus}}" class="zj-section">
      <template is="zj-section" data="{{title: t.console}}" />
      <text class="muted">{{t.consoleHint}}</text>
      <view class="zj-list account-queues">
        <view wx:for="{{queues}}" wx:key="key" class="account-queue" hover-class="zj-pressed" bindtap="openQueue" data-url="{{item.href}}" data-web="{{item.web}}" aria-role="link" aria-label="{{item.title}}">
          <view class="account-todo-main"><text class="account-todo-title">{{item.title}}</text><text class="zj-small">{{item.web ? t.webOnlyPrefix : ''}}{{item.scope}}</text></view>
          <text wx:if="{{item.pending}}" class="zj-count">{{item.pending}}</text>
          <text wx:elif="{{item.pending === 0}}" class="zj-pill zj-pill-success">{{t.allDone}}</text>
          <text wx:else class="zj-arrow">›</text>
        </view>
        <view class="account-queue" hover-class="zj-pressed" bindtap="openPage" data-page="activity-manage" aria-role="link"><view class="account-todo-main"><text class="account-todo-title">{{t.activityForms}}</text><text class="zj-small">{{t.activityFormsHint}}</text></view><text class="zj-arrow">›</text></view>
        <view class="account-queue" hover-class="zj-pressed" bindtap="openPage" data-page="team" data-params="{{managedTeamParams}}" aria-role="link"><view class="account-todo-main"><text class="account-todo-title">{{t.managedTeams}}</text><text class="zj-small">{{t.managedTeamsHint}}</text></view><text class="zj-arrow">›</text></view>
      </view>
    </view>
  </block>

  <view class="zj-section account-appearance">
    <template is="zj-section" data="{{title: t.appearance}}" />
    <text class="muted">{{t.appearanceHint}}</text>
    <view class="theme-choices">
      <button wx:for="{{themeChoices}}" wx:key="id" class="theme-choice {{palette === item.id ? 'selected' : ''}}" bindtap="setVisualTheme" data-theme="{{item.id}}" disabled="{{themeUnavailable}}" aria-label="{{item.label}}{{palette === item.id ? t.selectedSuffix : ''}}">
        <view class="theme-swatch theme-swatch-{{item.id}}" aria-hidden="true"><view></view><view></view><view></view></view>
        <view class="theme-choice-title"><text>{{item.label}}</text><text wx:if="{{palette === item.id}}" class="theme-check">✓</text></view>
      </button>
    </view>
    <text wx:if="{{themeNotice}}" class="theme-message" aria-role="status">{{themeNotice}}</text>
    <text wx:if="{{themeError}}" class="error" aria-role="alert">{{themeError}}</text>
  </view>

  <view class="zj-section account-links">
    <button class="shortcut" bindtap="switchLocale" aria-label="{{t.languageLabel}}"><view class="shortcut-main"><text class="shortcut-title">{{t.language}}</text><text class="muted">中文 / English</text></view><text class="shortcut-sign">{{locale === 'en' ? 'EN' : '中'}}</text></button>
    <button class="shortcut" bindtap="openWebsite" data-url="/privacy"><view class="shortcut-main"><text class="shortcut-title">{{t.privacy}}</text></view><text class="shortcut-sign">›</text></button>
    <button class="shortcut" bindtap="openWebsite" data-url="/contact"><view class="shortcut-main"><text class="shortcut-title">{{t.contact}}</text></view><text class="shortcut-sign">›</text></button>
    <button wx:if="{{user}}" class="shortcut" bindtap="reset"><view class="shortcut-main"><text class="shortcut-title">{{t.resetPassword}}</text></view><text class="shortcut-sign">›</text></button>
    <button wx:if="{{campus && queues.length}}" class="shortcut" bindtap="openAdmin"><view class="shortcut-main"><text class="shortcut-title">{{t.admin}}</text><text class="muted">{{t.copyWebLink}}</text></view><text class="shortcut-sign">⧉</text></button>
    <button wx:if="{{user}}" class="plain account-logout" bindtap="logout">{{t.logout}}</button>
  </view>
  <text class="bottom-note">{{t.brand}} / v{{version}}</text>
</view>
