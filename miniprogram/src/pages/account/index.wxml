<page-meta page-style="{{themePageStyle}}" />
<view class="page mini-page account-page">
  <view class="page-heading account-heading"><view><text class="title">我的事务</text><text class="subtitle">{{user ? user.name + '，在这里继续报名、申请和投稿。' : '登录后查看自己的申请、回执与社团记录。'}}</text></view></view>
  <view wx:if="{{refreshing}}" class="profile-refresh" aria-role="status"><view class="state-dot"></view><text class="muted">正在核对账号与管理权限</text></view>
  <view wx:if="{{error}}" class="profile-error"><text class="error" aria-role="alert">{{error}}</text><button class="secondary" bindtap="refresh">重新获取账号资料</button></view>
  <view wx:if="{{!user}}" class="account-login"><text class="section-title">使用已有紫荆账号</text><text class="muted">网站与小程序使用同一账号，注册时验证清华邮箱。</text><view class="actions"><button class="primary" bindtap="login">登录账号</button><button class="secondary" bindtap="register">注册账号</button></view></view>
  <block wx:if="{{user}}">
    <view class="section account-tasks"><view class="section-heading"><text class="section-title">报名、申请与回执</text></view>
      <button class="content-link shortcut" bindtap="openPage" data-page="applications"><view class="shortcut-main"><text class="shortcut-title">社群管理员申请</text><text class="muted">查看处理结果、补充资料与名片授权。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button>
      <button class="content-link shortcut" bindtap="openPage" data-page="staff"><view class="shortcut-main"><text class="shortcut-title">骨干招新申请</text><text class="muted">继续填写、查看回执与处理反馈。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button>
      <button class="content-link shortcut" bindtap="openPage" data-page="team" data-params="{{teamApplicationParams}}"><view class="shortcut-main"><text class="shortcut-title">入队申请</text><text class="muted">查看本人选拔进度与退回意见。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button>
      <button class="content-link shortcut" bindtap="openPage" data-page="team-honor-workspace"><view class="shortcut-main"><text class="shortcut-title">荣誉投稿</text><text class="muted">继续草稿、补充材料与查询审核结果。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button>
      <button class="content-link shortcut" bindtap="openPage" data-page="events"><view class="shortcut-main"><text class="shortcut-title">活动报名</text><text class="muted">打开对应活动，查看本人报名回执。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button>
    </view>
    <view class="section"><view class="section-heading"><text class="section-title">我的社群与队伍</text></view><button class="content-link shortcut" bindtap="openPage" data-page="communities"><view class="shortcut-main"><text class="shortcut-title">联系管理员与进群进度</text><text class="muted">进入对应社群查看自己的联系记录。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button><button class="content-link shortcut" bindtap="openPage" data-page="team" data-params="{{membershipParams}}"><view class="shortcut-main"><text class="shortcut-title">成员记录与公开简介</text><text class="muted">查看当前队伍与本人展示设置。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button></view>
    <view class="section workbench-links"><view class="section-heading"><text class="section-title">管理工作台</text></view><text class="field-note">各工作台按当前任职核对可处理的社群、队伍与对象。</text><button wx:if="{{reviewCommunity}}" class="content-link shortcut" bindtap="openPage" data-page="review"><text class="shortcut-main">社群与管理员申请审核</text><text class="shortcut-sign" aria-hidden="true">›</text></button><button wx:if="{{reviewStaff}}" class="content-link shortcut" bindtap="openPage" data-page="staff"><text class="shortcut-main">骨干招新批次与审核</text><text class="shortcut-sign" aria-hidden="true">›</text></button><button class="content-link shortcut" bindtap="openPage" data-page="activity-manage"><text class="shortcut-main">活动问卷与报名</text><text class="shortcut-sign" aria-hidden="true">›</text></button><button class="content-link shortcut" bindtap="openPage" data-page="team" data-params="{{managedTeamParams}}"><text class="shortcut-main">我可管理的队伍</text><text class="shortcut-sign" aria-hidden="true">›</text></button></view>
    <view class="section profile-section"><view class="section-heading"><text class="section-title">账号资料</text></view><view class="profile"><view class="avatar">{{initial}}</view><view class="profile-main"><text class="profile-name">{{user.name}}</text><text class="muted">平台身份：{{role}}</text><text class="muted profile-email" selectable>{{user.email}}</text></view></view></view>
  </block>
  <view class="section theme-picker"><text class="section-title">外观</text><text class="muted theme-picker-help">默认浅色，记住你的选择，不自动跟随系统。</text><view class="theme-choices"><button class="theme-choice {{theme === 'light' ? 'selected' : ''}}" bindtap="setVisualTheme" data-theme="light" disabled="{{themeUnavailable}}" aria-label="浅色主题{{theme === 'light' ? '，已选择' : ''}}"><view class="theme-swatch theme-swatch-light" aria-hidden="true"><view></view><view></view><view></view></view><view class="theme-choice-title"><text>浅色</text><text wx:if="{{theme === 'light'}}" class="theme-check">✓</text></view></button><button class="theme-choice {{theme === 'dark' ? 'selected' : ''}}" bindtap="setVisualTheme" data-theme="dark" disabled="{{themeUnavailable}}" aria-label="深色主题{{theme === 'dark' ? '，已选择' : ''}}"><view class="theme-swatch theme-swatch-dark" aria-hidden="true"><view></view><view></view><view></view></view><view class="theme-choice-title"><text>深色</text><text wx:if="{{theme === 'dark'}}" class="theme-check">✓</text></view></button></view><text wx:if="{{themeNotice}}" class="theme-message" aria-role="status">{{themeNotice}}</text><text wx:if="{{themeError}}" class="error" aria-role="alert">{{themeError}}</text></view>
  <view class="section account-settings"><button class="content-link shortcut" bindtap="openWebsite" data-url="/privacy"><text class="shortcut-main">隐私说明</text><text class="shortcut-sign" aria-hidden="true">›</text></button><button class="content-link shortcut" bindtap="openWebsite" data-url="/contact"><text class="shortcut-main">联系与合作</text><text class="shortcut-sign" aria-hidden="true">›</text></button><button wx:if="{{user}}" class="content-link shortcut" bindtap="reset"><text class="shortcut-main">重设密码</text><text class="shortcut-sign" aria-hidden="true">›</text></button><button wx:if="{{user}}" class="plain section" bindtap="logout">退出账号</button></view><text class="bottom-note">竞在紫荆 / v{{version}}</text>
</view>
