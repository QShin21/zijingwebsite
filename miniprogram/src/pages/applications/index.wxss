@import "../../templates/business.wxss";
@import "../../styles/native-forms.wxss";

/* V2 community-officer application: numbered sheets, consent block, receipts with progress. */
.applications-v2 { padding-top: 0; }
.applications-done { display: block; font-weight: 900; }
.applications-entry { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 8rpx; }
.applications-entry > button { flex: 1; min-width: 240rpx; }
.applications-editor { margin-top: 24rpx; }
.applications-editor-head { display: flex; flex-direction: column; gap: 8rpx; }
.applications-picker { display: flex; align-items: center; justify-content: space-between; }
.application-reason { height: 300rpx; }
.field-required { color: var(--z-danger); font-size: 22rpx; font-weight: 800; }
.applications-qr .qr { margin: 12rpx auto; }
.applications-qr-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.applications-consent { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--z-line); }
.applications-note { margin-top: 20rpx; }
.applications-privacy { display: flex; flex-wrap: wrap; gap: 8rpx 24rpx; }
.applications-steps { display: flex; gap: 8rpx; }
.applications-step { flex: 1; padding: 8rpx 4rpx; border-radius: 999rpx; background: var(--z-disabled-bg); color: var(--z-muted); font-size: 22rpx; font-weight: 800; text-align: center; }
.applications-step.done { background: var(--z-success-bg); color: var(--z-success); }
.applications-step.current { background: var(--z-primary); color: var(--z-on-primary); }
.applications-note-box { padding: 18rpx 22rpx; border-radius: 20rpx; background: var(--z-warning-bg); }
.mini-page .applications-disclosure { display: flex; justify-content: space-between; width: 100%; padding: 10rpx 0; }
.applications-detail { display: flex; flex-direction: column; gap: 10rpx; }
.mini-page .applications-more { display: block; width: 100%; margin-top: 16rpx; }
