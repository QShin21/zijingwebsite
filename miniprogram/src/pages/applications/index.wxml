<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page applications-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">‹ 返回</button>
      <text class="zj-hero-kicker">COMMUNITY · 社群管理员</text>
      <text class="zj-hero-title">社群管理员申请</text>
      <text class="zj-hero-lead">组织一个游戏社群，或参与已有社群的日常管理。申请进度和负责人反馈会保留在本页。</text>
    </view>
  </view>
  <template is="feedback" data="{{needsLogin}}" />
  <block wx:if="{{!needsLogin}}">
    <view wx:if="{{done}}" class="zj-callout zj-callout-success" aria-role="status">
      <text class="applications-done">{{done}}</text>
      <text>微信群仍由管理员人工建立与拉群。</text>
    </view>
    <view class="applications-entry">
      <button class="{{apply ? 'secondary' : 'primary'}}" bindtap="toggle" disabled="{{busy || imageBusy}}">{{apply ? '收起填写内容' : mode === 'card' ? '继续调整名片与展示' : (realName || reason ? '继续填写申请' : '填写管理员申请')}}</button>
      <button wx:if="{{mode !== 'submit'}}" class="plain" bindtap="newApplication" disabled="{{busy || imageBusy}}">填写另一份申请</button>
    </view>

    <view wx:if="{{apply}}" id="application-editor" class="applications-editor">
      <view class="applications-editor-head">
        <text class="zj-section-title">{{mode === 'card' ? '名片与展示设置' : mode === 'edit' ? '修改并重新提交' : '填写申请资料'}}</text>
        <text class="zj-small">{{mode === 'card' ? '管理已批准申请的进群联系方式。' : mode === 'edit' ? '根据处理意见补充资料，提交后重新进入审核。' : '请填写本人资料，并说明希望承担的社群工作。'}}</text>
        <text wx:if="{{editId}}" class="zj-pill zj-pill-action">回执 {{editId}}，本次保存沿用这份申请。</text>
      </view>

      <block wx:if="{{mode !== 'card'}}">
        <view class="zj-sheet">
          <text class="zj-sheet-title">① 社群与组织计划</text>
          <view class="field">
            <text class="field-label">游戏社群 <text class="field-required">必选</text></text>
            <picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="game" disabled="{{busy || gamesLoading}}">
              <view class="picker-value applications-picker"><text>{{games[gameIndex].title}}</text><text aria-hidden="true">▾</text></view>
            </picker>
            <text wx:if="{{gamesLoading}}" class="zj-form-hint" aria-role="status">正在读取社群选项…</text>
            <view wx:if="{{gamesError}}">
              <text class="error" aria-role="alert">社群选项加载失败：{{gamesError}}</text>
              <button class="plain" bindtap="loadGames" disabled="{{gamesLoading || busy}}">重试社群选项</button>
            </view>
          </view>
          <view wx:if="{{!games[gameIndex].id}}" class="field">
            <text class="field-label">新游戏名称 <text class="field-required">必填</text></text>
            <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{proposedGame}}" bindinput="input" data-field="proposedGame" maxlength="80" placeholder="2–80 字" disabled="{{busy}}" />
          </view>
          <view class="field">
            <text class="field-label">申请说明 <text class="field-required">必填</text></text>
            <textarea class="application-reason" cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{reason}}" bindinput="input" data-field="reason" placeholder="介绍组织计划、管理经验与可投入时间" maxlength="3000" disabled="{{busy}}" />
            <text class="zj-form-hint">10–3000 字。写清活动安排和日常管理计划，方便负责人评估。</text>
          </view>
        </view>
        <view class="zj-sheet">
          <text class="zj-sheet-title">② 审核联系资料</text>
          <text class="zj-form-hint">姓名与手机号仅供本人及有权限的负责人审核使用。</text>
          <view class="field">
            <text class="field-label">姓名 <text class="field-required">必填</text></text>
            <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{realName}}" bindinput="input" data-field="realName" maxlength="80" placeholder="填写本人姓名" disabled="{{busy}}" />
          </view>
          <view class="field">
            <text class="field-label">手机号 <text class="field-required">必填</text></text>
            <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{phone}}" bindinput="input" data-field="phone" maxlength="21" placeholder="可含 + 国际区号" disabled="{{busy}}" />
          </view>
        </view>
      </block>

      <view class="zj-sheet">
        <text class="zj-sheet-title">{{mode === 'card' ? '进群联系方式' : '③ 进群联系方式'}}</text>
        <text class="zj-form-hint">获批并在任期间，已授权名片用于同学联系你申请加入微信群。</text>
        <view class="field">
          <text class="field-label">微信个人名片二维码 <text wx:if="{{mode !== 'card'}}" class="field-required">必填</text></text>
          <button wx:if="{{qr && !qrFailed}}" class="image-button applications-qr" hover-class="zj-pressed" bindtap="previewImage" data-url="{{qr}}" aria-label="预览微信名片"><image class="qr" src="{{qr}}" mode="aspectFit" binderror="qrImageError" data-url="{{qr}}" data-scope="{{qrPreviewScope}}" /></button>
          <view wx:if="{{qr && qrFailed}}" class="zj-alert"><text class="zj-small" aria-role="alert">名片预览暂时无法显示。原图片与已填资料已保留，可重试预览或重新选择图片。</text><button class="secondary" bindtap="retryQrPreview" data-url="{{qr}}" data-scope="{{qrPreviewScope}}" disabled="{{busy || imageBusy}}">重试名片预览</button></view>
          <text wx:if="{{savedQr && !qr}}" class="zj-callout">已保存的名片会继续保留，可主动查看或更换。</text>
          <view class="applications-qr-actions">
            <button class="secondary" bindtap="chooseQr" disabled="{{busy || imageBusy}}" loading="{{imageBusy}}">{{imageBusy ? '正在读取名片…' : qr || savedQr ? '选择新二维码图片' : '选择二维码图片'}}</button>
            <button wx:if="{{savedQr}}" class="plain" bindtap="inspectSaved" disabled="{{busy || imageBusy}}">查看已保存名片</button>
          </view>
          <text class="zj-form-hint">PNG、JPEG 或 WebP，2 MB 以内。取消选择或拒绝授权后，已填内容保留，可再次主动选择。</text>
        </view>
        <view id="contact-consent" class="applications-consent">
          <text class="field-label">名片展示同意</text>
          <checkbox-group bindchange="consent">
            <label class="consent"><checkbox color="{{themePrimary}}" value="contact" checked="{{contactConsent}}" disabled="{{busy}}" aria-label="我同意展示我的微信名片作为进群联系方式" /><text>我同意展示我的微信名片作为进群联系方式</text></label>
          </checkbox-group>
          <text class="zj-form-hint">{{mode === 'card' ? '取消勾选并保存，即关闭名片展示。' : '由本人主动勾选；获批后可在本回执关闭展示。'}}</text>
          <text wx:if="{{formError === '由于入社流程规定，必须展示管理联系方式'}}" class="error" aria-role="alert">{{formError}}</text>
          <text class="zj-form-hint">选择图片需另行完成微信隐私授权；完成该授权后，仍需在此主动确认名片展示。</text>
        </view>
      </view>

      <text class="zj-form-hint applications-note">{{mode === 'card' ? '保存后，按本次勾选更新名片展示设置。' : '申请资料用于审核。提交和批准均不会自动加入微信群。'}}</text>
      <view class="applications-privacy"><button class="plain" bindtap="openContract">微信隐私指引</button><button class="plain" bindtap="openPage" data-page="fixed" data-params="{{ {key: 'privacy'} }}">社团隐私说明</button></view>
      <block wx:if="{{formError !== '由于入社流程规定，必须展示管理联系方式'}}"><text wx:if="{{formError}}" class="error" aria-role="alert">{{formError}}</text></block>
      <view class="zj-dock">
        <button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || imageBusy || loading || (mode !== 'card' && gamesLoading)}}">{{busy ? '正在保存…' : mode === 'card' ? '保存名片与展示设置' : mode === 'edit' ? '保存并重新提交' : '提交申请'}}</button>
      </view>
    </view>

    <text wx:if="{{operationError || (!apply && formError)}}" class="error" aria-role="alert">{{operationError || formError}}</text>
    <view class="zj-section">
      <view class="zj-section-head"><view><text class="zj-section-title">我的申请回执</text><text class="zj-small">查看处理意见，或继续原申请。</text></view><button class="plain zj-more" bindtap="retry" disabled="{{loading || busy}}">刷新核对</button></view>
      <text wx:if="{{error}}" class="error" aria-role="alert">{{error}}</text>
      <text wx:if="{{done && error}}" class="zj-form-hint">已确认保存的回执仍保留在下方，刷新后再核对最新可用操作。</text>
      <view wx:if="{{loading}}" class="zj-skeleton" aria-role="status" aria-label="正在读取回执"><view wx:if="{{!docs.length}}" class="zj-skeleton-row"><view class="zj-skeleton-date"></view><view class="zj-skeleton-lines"><view></view><view></view><view></view></view></view></view>
      <view wx:for="{{docs}}" wx:key="id" class="zj-record applications-record">
        <view class="zj-record-head"><text class="zj-pill zj-pill-{{item.status === 'approved' ? 'success' : item.status === 'returned' ? 'warning' : item.status === 'rejected' ? 'danger' : item.status === 'withdrawn' ? 'neutral' : 'info'}}">{{item.statusText}}</text><text class="zj-small">{{item.dateText}}</text></view>
        <text class="zj-record-title">{{item.proposedGame || item.game.title || '游戏社群申请'}}</text>
        <text class="zj-small">回执 {{item.id}}</text>
        <view class="applications-steps" aria-label="办理进度">
          <text class="applications-step done">已提交</text>
          <text class="applications-step {{item.status === 'pending' ? 'current' : item.status === 'approved' || item.status === 'rejected' ? 'done' : ''}}">审核中</text>
          <text class="applications-step {{item.status === 'approved' || item.status === 'rejected' ? 'current' : ''}}">{{item.status === 'rejected' ? '未通过' : '结果'}}</text>
        </view>
        <text class="zj-callout">{{item.status === 'pending' ? '等待负责人审核，处理意见会显示在这份回执中。' : item.status === 'approved' ? '申请已获批。微信群的建立和成员邀请仍需人工完成。' : item.status === 'returned' ? '请按反馈补充资料，再从这份回执重新提交。' : item.status === 'withdrawn' ? '网站申请已撤回，可按可用操作修改并重新提交。' : item.status === 'rejected' ? '负责人已完成审核，请查看处理意见。' : '请刷新回执，核对最新申请状态。'}}</text>
        <view wx:if="{{item.reviewNote}}" class="applications-note-box"><text class="field-label">负责人反馈</text><text class="body" selectable>{{item.reviewNote}}</text></view>
        <button class="plain applications-disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy || imageBusy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? '收起申请资料' : '查看已提交资料'}}</text><text aria-hidden="true">{{expandedId === item.id ? '−' : '＋'}}</text></button>
        <view wx:if="{{expandedId === item.id}}" class="applications-detail">
          <text class="field-label">组织计划</text><text class="body" selectable>{{item.reason}}</text>
          <view class="zj-kv">
            <view class="zj-kv-row"><text class="zj-kv-label">姓名</text><text class="zj-kv-value" selectable>{{item.realName}}</text></view>
            <view class="zj-kv-row"><text class="zj-kv-label">手机号</text><text class="zj-kv-value" selectable>{{item.phone}}</text></view>
            <view class="zj-kv-row"><text class="zj-kv-label">名片展示</text><text class="zj-kv-value">{{item.contactConsent === true ? '已授权在任期间展示' : '未授权展示'}}</text></view>
          </view>
          <button class="secondary" bindtap="inspect" data-id="{{item.id}}" disabled="{{busy || imageBusy}}">查看已提交二维码</button>
        </view>
        <view wx:if="{{item.actions.edit || item.actions.card || item.actions.withdraw}}" class="zj-record-actions">
          <button wx:if="{{item.actions.edit}}" class="secondary" bindtap="openForm" data-id="{{item.id}}" data-action="edit" disabled="{{busy || imageBusy}}">修改并重新提交</button>
          <button wx:if="{{item.actions.card}}" class="secondary" bindtap="openForm" data-id="{{item.id}}" data-action="card" disabled="{{busy || imageBusy}}">更新名片与授权</button>
          <button wx:if="{{item.actions.withdraw}}" class="danger" bindtap="withdraw" data-id="{{item.id}}" disabled="{{busy || imageBusy}}">撤回网站申请</button>
        </view>
      </view>
      <view wx:if="{{!docs.length && !loading && !error}}" class="zj-empty"><text class="zj-empty-icon">📮</text><text class="zj-empty-title">尚未提交申请</text><text class="zj-small">填写社群与组织计划后，回执会保留在这里。</text></view>
      <button wx:if="{{hasMore}}" class="secondary applications-more" bindtap="onReachBottom" disabled="{{loading || busy}}" loading="{{loading}}">加载更多回执</button>
    </view>
  </block>
</view>
<privacy-consent id="privacyConsent" />
