<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page business-page applications-page">
  <button class="plain back" bindtap="back">返回</button>
  <view class="page-heading"><text class="title">社群管理员申请</text><text class="subtitle">组织一个游戏社群，或参与已有社群的日常管理。</text></view>
  <template is="feedback" data="{{needsLogin}}" />
  <block wx:if="{{!needsLogin}}">
    <view wx:if="{{done}}" class="task-feedback" aria-role="status"><text class="task-feedback-label">{{done}}</text><text class="muted">微信群仍由管理员人工建立与拉群。</text></view>
    <view class="compact-actions"><button class="{{apply ? 'plain' : 'primary'}}" bindtap="toggle" disabled="{{busy || imageBusy}}">{{apply ? '收起填写内容' : (realName || reason ? '继续填写申请' : '填写管理员申请')}}</button><button wx:if="{{mode !== 'submit'}}" class="plain" bindtap="newApplication" disabled="{{busy || imageBusy}}">填写另一份申请</button></view>
    <view wx:if="{{apply}}" id="application-editor" class="application-editor">
      <view class="business-summary"><text class="task-context">{{mode === 'card' ? '已批准申请 / 联系方式展示' : mode === 'edit' ? '补充资料 / 原申请重提' : '本人申请 / 等待负责人审核'}}</text><text class="section-title">{{mode === 'card' ? '名片与展示设置' : mode === 'edit' ? '修改并重新提交' : '填写申请资料'}}</text><text wx:if="{{editId}}" class="muted">回执 {{editId}}，保存沿用这份申请。</text></view>
      <text wx:if="{{formError}}" class="error" aria-role="alert">{{formError}}</text>
      <block wx:if="{{mode !== 'card'}}">
        <view class="task-section"><text class="task-section-title">社群与组织计划</text><text class="muted">说明你希望组织的游戏社群，以及能够投入的日常工作。</text>
          <view class="field"><text class="field-label">游戏社群 · 必选</text><picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="game" disabled="{{busy || gamesLoading}}"><view>{{games[gameIndex].title}} ▾</view></picker></view>
          <view wx:if="{{gamesError}}"><text class="error">社群选项加载失败：{{gamesError}}</text><button class="plain" bindtap="loadGames" disabled="{{gamesLoading || busy}}">重试社群选项</button></view>
          <view wx:if="{{!games[gameIndex].id}}" class="field"><text class="field-label">新游戏名称 · 必填</text><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{proposedGame}}" bindinput="input" data-field="proposedGame" maxlength="80" placeholder="2–80 字" disabled="{{busy}}" /></view>
          <view class="field"><text class="field-label">申请说明 · 必填</text><textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{reason}}" bindinput="input" data-field="reason" placeholder="介绍组织计划、管理经验与可投入时间" maxlength="3000" disabled="{{busy}}" /><text class="field-note">10–3000 字。请写清具体计划，方便负责人评估。</text></view>
        </view>
        <view class="task-section"><text class="task-section-title">审核联系资料</text><text class="muted">姓名与手机号仅供本人及有权限的负责人审核使用。</text>
          <view class="field"><text class="field-label">姓名 · 必填</text><input cursor-spacing="24" value="{{realName}}" bindinput="input" data-field="realName" maxlength="80" disabled="{{busy}}" /></view>
          <view class="field"><text class="field-label">手机号 · 必填</text><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{phone}}" bindinput="input" data-field="phone" maxlength="21" placeholder="可含 + 国际区号" disabled="{{busy}}" /></view>
        </view>
      </block>
      <view class="task-section"><text class="task-section-title">进群联系方式</text><text class="muted">获批并在任期间，已授权名片用于同学联系你申请加入微信群。</text>
        <view class="field"><text class="field-label">微信个人名片二维码{{mode === 'card' ? '' : ' · 必填'}}</text>
          <button class="image-button" hover-class="pressed" wx:if="{{qr}}" bindtap="previewImage" data-url="{{qr}}" aria-label="预览微信名片"><image class="qr" src="{{qr}}" mode="aspectFit" /></button>
          <text wx:if="{{savedQr && !qr}}" class="muted">当前保留已保存的名片。</text>
          <button class="secondary" bindtap="chooseQr" disabled="{{busy || imageBusy}}" loading="{{imageBusy}}">{{qr || savedQr ? '选择新二维码图片' : '选择二维码图片'}}</button>
          <button wx:if="{{savedQr}}" class="plain" bindtap="inspectSaved" disabled="{{busy || imageBusy}}">查看已保存名片</button>
          <text class="field-note">PNG、JPEG 或 WebP，2 MB 以内。取消选择或拒绝授权后，已填内容保留，可再次主动选择。</text>
        </view>
        <view id="contact-consent"><checkbox-group bindchange="consent"><label class="consent"><checkbox color="{{themePrimary}}" value="contact" checked="{{contactConsent}}" disabled="{{busy}}" aria-label="我同意展示我的微信名片作为进群联系方式" /><text>我同意展示我的微信名片作为进群联系方式</text></label></checkbox-group><text class="field-note">{{mode === 'card' ? '取消勾选并保存，即关闭名片展示。' : '由本人主动勾选；获批后可在本回执关闭展示。'}}</text></view>
      </view>
      <view class="form-footer"><text class="muted">申请资料用于审核。提交后可在本页查看进度与处理意见；提交和批准均不会自动加入微信群。</text><view class="privacy-links"><button class="plain" bindtap="openContract">微信隐私指引</button><button class="plain" bindtap="openPage" data-page="fixed" data-params="{{ {key: 'privacy'} }}">社团隐私说明</button></view><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || imageBusy || (mode !== 'card' && gamesLoading)}}">{{mode === 'card' ? '保存名片与展示设置' : mode === 'edit' ? '保存并重新提交' : '提交申请'}}</button></view>
    </view>
    <text wx:if="{{operationError || (!apply && formError)}}" class="error" aria-role="alert">{{operationError || formError}}</text>
    <view class="task-section"><view class="section-head"><text class="section-title">我的申请回执</text><button class="plain" bindtap="retry" disabled="{{loading || busy}}">刷新核对</button></view><text wx:if="{{error}}" class="error">{{error}}</text><text wx:if="{{loading}}" class="muted">正在读取回执…</text>
      <view class="record-list"><view wx:for="{{docs}}" wx:key="id" class="task-record"><view class="record-heading"><view><text class="section-title">{{item.proposedGame || '游戏社群申请'}}</text><view class="record-meta"><text>回执 {{item.id}}</text><text>{{item.dateText}}</text></view></view><text class="badge">{{item.statusText}}</text></view>
        <view wx:if="{{item.reviewNote}}" class="task-feedback"><text class="task-feedback-label">负责人反馈</text><text class="body">{{item.reviewNote}}</text></view>
        <button class="plain disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy || imageBusy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? '收起申请资料' : '查看已提交资料'}}</text><text class="disclosure-mark">{{expandedId === item.id ? '−' : '＋'}}</text></button>
        <view wx:if="{{expandedId === item.id}}" class="record-detail"><text class="material-title">组织计划</text><text class="body">{{item.reason}}</text><view class="record-facts"><view class="record-fact"><text class="fact-label">姓名</text><text class="fact-value" selectable>{{item.realName}}</text></view><view class="record-fact"><text class="fact-label">手机号</text><text class="fact-value" selectable>{{item.phone}}</text></view><view class="record-fact"><text class="fact-label">名片展示</text><text class="fact-value">{{item.contactConsent ? '已授权在任期间展示' : '未授权展示'}}</text></view></view><button class="plain" bindtap="inspect" data-id="{{item.id}}" disabled="{{busy || imageBusy}}">查看已提交二维码</button></view>
        <view class="actions"><button wx:if="{{item.actions.edit}}" class="secondary" bindtap="openForm" data-id="{{item.id}}" data-action="edit" disabled="{{busy || imageBusy}}">修改并重新提交</button><button wx:if="{{item.actions.card}}" class="secondary" bindtap="openForm" data-id="{{item.id}}" data-action="card" disabled="{{busy || imageBusy}}">更新名片与授权</button><button wx:if="{{item.actions.withdraw}}" class="plain" bindtap="withdraw" data-id="{{item.id}}" disabled="{{busy || imageBusy}}">撤回网站申请</button></view>
      </view></view>
      <view wx:if="{{!docs.length && !loading && !error}}" class="empty"><text class="state-title">尚未提交申请</text><text class="muted">填写社群与组织计划后，回执会保留在这里。</text></view><button wx:if="{{hasMore}}" class="plain" bindtap="onReachBottom" disabled="{{loading || busy}}" loading="{{loading}}">加载更多回执</button>
    </view>
  </block>
</view>
<privacy-consent id="privacyConsent" />
