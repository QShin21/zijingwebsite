<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page applications-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{t.kicker}}</text>
      <text class="zj-hero-title">{{t.heroTitle}}</text>
      <text class="zj-hero-lead">{{t.heroLead}}</text>
    </view>
  </view>
  <template is="feedback" data="{{needsLogin,t}}" />
  <block wx:if="{{!needsLogin}}">
    <view wx:if="{{done}}" class="zj-callout zj-callout-success" aria-role="status">
      <text class="applications-done">{{done}}</text>
      <text>{{t.doneNote}}</text>
    </view>
    <view class="applications-entry">
      <button class="{{apply ? 'secondary' : 'primary'}}" bindtap="toggle" disabled="{{busy || imageBusy}}">{{apply ? t.collapseForm : mode === 'card' ? t.continueCard : (realName || reason ? t.continueApply : t.startApply)}}</button>
      <button wx:if="{{mode !== 'submit'}}" class="plain" bindtap="newApplication" disabled="{{busy || imageBusy}}">{{t.anotherApply}}</button>
    </view>

    <view wx:if="{{apply}}" id="application-editor" class="applications-editor">
      <view class="applications-editor-head">
        <text class="zj-section-title">{{mode === 'card' ? t.headCard : mode === 'edit' ? t.headEdit : t.headSubmit}}</text>
        <text class="zj-small">{{mode === 'card' ? t.leadCard : mode === 'edit' ? t.leadEdit : t.leadSubmit}}</text>
        <text wx:if="{{editId}}" class="zj-pill zj-pill-action">{{t.receiptPrefix}}{{editId}}{{t.receiptKeepSuffix}}</text>
      </view>

      <block wx:if="{{mode !== 'card'}}">
        <view class="zj-sheet">
          <text class="zj-sheet-title">{{t.section1}}</text>
          <view class="field">
            <text class="field-label">{{t.gameLabel}}<text class="field-required">{{t.requiredPick}}</text></text>
            <picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="game" disabled="{{busy || gamesLoading}}">
              <view class="picker-value applications-picker"><text>{{games[gameIndex].title}}</text><text aria-hidden="true">▾</text></view>
            </picker>
            <text wx:if="{{gamesLoading}}" class="zj-form-hint" aria-role="status">{{t.gamesLoading}}</text>
            <view wx:if="{{gamesError}}">
              <text class="error" aria-role="alert">{{t.gamesErrorPrefix}}{{gamesError}}</text>
              <button class="plain" bindtap="loadGames" disabled="{{gamesLoading || busy}}">{{t.retryGames}}</button>
            </view>
          </view>
          <view wx:if="{{!games[gameIndex].id}}" class="field">
            <text class="field-label">{{t.newGameLabel}}<text class="field-required">{{t.required}}</text></text>
            <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{proposedGame}}" bindinput="input" data-field="proposedGame" maxlength="80" placeholder="{{t.newGamePlaceholder}}" disabled="{{busy}}" />
          </view>
          <view class="field">
            <text class="field-label">{{t.reasonLabel}}<text class="field-required">{{t.required}}</text></text>
            <textarea class="application-reason" cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{reason}}" bindinput="input" data-field="reason" placeholder="{{t.reasonPlaceholder}}" maxlength="3000" disabled="{{busy}}" />
            <text class="zj-form-hint">{{t.reasonHint}}</text>
          </view>
        </view>
        <view class="zj-sheet">
          <text class="zj-sheet-title">{{t.section2}}</text>
          <text class="zj-form-hint">{{t.privateHint}}</text>
          <view class="field">
            <text class="field-label">{{t.nameLabel}}<text class="field-required">{{t.required}}</text></text>
            <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{realName}}" bindinput="input" data-field="realName" maxlength="80" placeholder="{{t.namePlaceholder}}" disabled="{{busy}}" />
          </view>
          <view class="field">
            <text class="field-label">{{t.phoneLabel}}<text class="field-required">{{t.required}}</text></text>
            <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{phone}}" bindinput="input" data-field="phone" maxlength="21" placeholder="{{t.phonePlaceholder}}" disabled="{{busy}}" />
          </view>
        </view>
      </block>

      <view class="zj-sheet">
        <text class="zj-sheet-title">{{mode === 'card' ? t.contactCard : t.contactStep}}</text>
        <text class="zj-form-hint">{{t.contactHint}}</text>
        <view class="field">
          <text class="field-label">{{t.qrLabel}}<text wx:if="{{mode !== 'card'}}" class="field-required">{{t.required}}</text></text>
          <button wx:if="{{qr && !qrFailed}}" class="image-button applications-qr" hover-class="zj-pressed" bindtap="previewImage" data-url="{{qr}}" aria-label="{{t.previewCard}}"><image class="qr" src="{{qr}}" mode="aspectFit" binderror="qrImageError" data-url="{{qr}}" data-scope="{{qrPreviewScope}}" /></button>
          <view wx:if="{{qr && qrFailed}}" class="zj-alert"><text class="zj-small" aria-role="alert">{{t.previewFailed}}</text><button class="secondary" bindtap="retryQrPreview" data-url="{{qr}}" data-scope="{{qrPreviewScope}}" disabled="{{busy || imageBusy}}">{{t.retryPreview}}</button></view>
          <text wx:if="{{savedQr && !qr}}" class="zj-callout">{{t.savedKept}}</text>
          <view class="applications-qr-actions">
            <button class="secondary" bindtap="chooseQr" disabled="{{busy || imageBusy}}" loading="{{imageBusy}}">{{imageBusy ? t.readingCard : qr || savedQr ? t.chooseNewQr : t.chooseQr}}</button>
            <button wx:if="{{savedQr}}" class="plain" bindtap="inspectSaved" disabled="{{busy || imageBusy}}">{{t.viewSaved}}</button>
          </view>
          <text class="zj-form-hint">{{t.qrHint}}</text>
        </view>
        <view id="contact-consent" class="applications-consent">
          <text class="field-label">{{t.consentTitle}}</text>
          <checkbox-group bindchange="consent">
            <label class="consent"><checkbox color="{{themePrimary}}" value="contact" checked="{{contactConsent}}" disabled="{{busy}}" aria-label="{{t.consentLabel}}" /><text>{{t.consentLabel}}</text></label>
          </checkbox-group>
          <text class="zj-form-hint">{{mode === 'card' ? t.consentCardHint : t.consentHint}}</text>
          <text wx:if="{{formError === t.consentMessage}}" class="error" aria-role="alert">{{formError}}</text>
          <text class="zj-form-hint">{{t.privacyAuthHint}}</text>
        </view>
      </view>

      <text class="zj-form-hint applications-note">{{mode === 'card' ? t.noteCard : t.noteSubmit}}</text>
      <view class="applications-privacy"><button class="plain" bindtap="openContract">{{t.wechatPrivacy}}</button><button class="plain" bindtap="openPage" data-page="fixed" data-params="{{ {key: 'privacy'} }}">{{t.clubPrivacy}}</button></view>
      <block wx:if="{{formError !== t.consentMessage}}"><text wx:if="{{formError}}" class="error" aria-role="alert">{{formError}}</text></block>
      <view class="zj-dock">
        <button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || imageBusy || loading || (mode !== 'card' && gamesLoading)}}">{{busy ? t.saving : mode === 'card' ? t.saveCard : mode === 'edit' ? t.saveEdit : t.submit}}</button>
      </view>
    </view>

    <text wx:if="{{operationError || (!apply && formError)}}" class="error" aria-role="alert">{{operationError || formError}}</text>
    <view class="zj-section">
      <view class="zj-section-head"><view><text class="zj-section-title">{{t.receiptsTitle}}</text><text class="zj-small">{{t.receiptsLead}}</text></view><button class="plain zj-more" bindtap="retry" disabled="{{loading || busy}}">{{t.refresh}}</button></view>
      <text wx:if="{{error}}" class="error" aria-role="alert">{{error}}</text>
      <text wx:if="{{done && error}}" class="zj-form-hint">{{t.savedKeptBelow}}</text>
      <view wx:if="{{loading}}" class="zj-skeleton" aria-role="status" aria-label="{{t.readingReceipts}}"><view wx:if="{{!docs.length}}" class="zj-skeleton-row"><view class="zj-skeleton-date"></view><view class="zj-skeleton-lines"><view></view><view></view><view></view></view></view></view>
      <view wx:for="{{docs}}" wx:key="id" class="zj-record applications-record">
        <view class="zj-record-head"><text class="zj-pill zj-pill-{{item.status === 'approved' ? 'success' : item.status === 'returned' ? 'warning' : item.status === 'rejected' ? 'danger' : item.status === 'withdrawn' ? 'neutral' : 'info'}}">{{item.statusText}}</text><text class="zj-small">{{item.dateText}}</text></view>
        <text class="zj-record-title">{{item.proposedGame || item.game.title || t.gameFallback}}</text>
        <text class="zj-small">{{t.receiptPrefix}}{{item.id}}</text>
        <view class="applications-steps" aria-label="{{t.progressLabel}}">
          <text class="applications-step done">{{t.stepSubmitted}}</text>
          <text class="applications-step {{item.status === 'pending' ? 'current' : item.status === 'approved' || item.status === 'rejected' ? 'done' : ''}}">{{t.stepReview}}</text>
          <text class="applications-step {{item.status === 'approved' || item.status === 'rejected' ? 'current' : ''}}">{{item.status === 'rejected' ? t.stepRejected : t.stepResult}}</text>
        </view>
        <text class="zj-callout">{{item.status === 'pending' ? t.notePending : item.status === 'approved' ? t.noteApproved : item.status === 'returned' ? t.noteReturned : item.status === 'withdrawn' ? t.noteWithdrawn : item.status === 'rejected' ? t.noteRejected : t.noteUnknown}}</text>
        <view wx:if="{{item.reviewNote}}" class="applications-note-box"><text class="field-label">{{t.reviewerFeedback}}</text><text class="body" selectable>{{item.reviewNote}}</text></view>
        <button class="plain applications-disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy || imageBusy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? t.collapseDetails : t.viewDetails}}</text><text aria-hidden="true">{{expandedId === item.id ? '−' : '＋'}}</text></button>
        <view wx:if="{{expandedId === item.id}}" class="applications-detail">
          <text class="field-label">{{t.plan}}</text><text class="body" selectable>{{item.reason}}</text>
          <view class="zj-kv">
            <view class="zj-kv-row"><text class="zj-kv-label">{{t.name}}</text><text class="zj-kv-value" selectable>{{item.realName}}</text></view>
            <view class="zj-kv-row"><text class="zj-kv-label">{{t.phone}}</text><text class="zj-kv-value" selectable>{{item.phone}}</text></view>
            <view class="zj-kv-row"><text class="zj-kv-label">{{t.cardDisplay}}</text><text class="zj-kv-value">{{item.contactConsent === true ? t.cardAuthorized : t.cardNotAuthorized}}</text></view>
          </view>
          <button class="secondary" bindtap="inspect" data-id="{{item.id}}" disabled="{{busy || imageBusy}}">{{t.viewSubmittedQr}}</button>
        </view>
        <view wx:if="{{item.actions.edit || item.actions.card || item.actions.withdraw}}" class="zj-record-actions">
          <button wx:if="{{item.actions.edit}}" class="secondary" bindtap="openForm" data-id="{{item.id}}" data-action="edit" disabled="{{busy || imageBusy}}">{{t.editResubmit}}</button>
          <button wx:if="{{item.actions.card}}" class="secondary" bindtap="openForm" data-id="{{item.id}}" data-action="card" disabled="{{busy || imageBusy}}">{{t.updateCard}}</button>
          <button wx:if="{{item.actions.withdraw}}" class="danger" bindtap="withdraw" data-id="{{item.id}}" disabled="{{busy || imageBusy}}">{{t.withdraw}}</button>
        </view>
      </view>
      <view wx:if="{{!docs.length && !loading && !error}}" class="zj-empty"><text class="zj-empty-icon">📮</text><text class="zj-empty-title">{{t.emptyTitle}}</text><text class="zj-small">{{t.emptyBody}}</text></view>
      <button wx:if="{{hasMore}}" class="secondary applications-more" bindtap="onReachBottom" disabled="{{loading || busy}}" loading="{{loading}}">{{t.more}}</button>
    </view>
  </block>
</view>
<privacy-consent id="privacyConsent" />
