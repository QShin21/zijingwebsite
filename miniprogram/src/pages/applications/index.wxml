<import src="../../templates/common.wxml" />
<view class="page">
  <button class="plain back" bindtap="back">返回</button>
  <text class="eyebrow">BUILD YOUR COMMUNITY</text><text class="title">社群管理员申请</text>
  <text class="subtitle">申请新建游戏社群或参与已有社群管理。负责人批准后，微信群由管理员人工建立与拉群。</text>
  <template is="feedback" data="{{needsLogin}}" />
  <block wx:if="{{!needsLogin}}">
    <view wx:if="{{done}}" class="section panel" aria-role="status"><text class="section-title">{{done}}</text><text class="muted">申请、批准和名片预览均不会自动创建或加入微信群。</text></view>
    <view class="actions"><button class="secondary" bindtap="toggle" disabled="{{busy || imageBusy}}">{{apply ? '收起表单' : '填写申请 ＋'}}</button><button wx:if="{{mode !== 'submit'}}" class="plain" bindtap="newApplication" disabled="{{busy || imageBusy}}">填写另一份申请</button></view>
    <view wx:if="{{apply}}" class="section panel">
      <text class="section-title">{{mode === 'card' ? '名片与展示设置' : mode === 'edit' ? '修改并重新提交' : '填写申请'}}</text>
      <text wx:if="{{editId}}" class="muted">回执编号 {{editId}}；保存沿用本申请。</text>
      <block wx:if="{{mode !== 'card'}}">
        <view class="field"><text class="field-label">游戏社群</text><picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="game" disabled="{{busy || gamesLoading}}"><view>{{games[gameIndex].title}} ▾</view></picker></view>
        <view wx:if="{{gamesError}}"><text class="error">社群选项加载失败：{{gamesError}}</text><button class="plain" bindtap="loadGames" disabled="{{gamesLoading || busy}}">重试社群选项</button></view>
        <view wx:if="{{!games[gameIndex].id}}" class="field"><text class="field-label">新游戏名称</text><input value="{{proposedGame}}" bindinput="input" data-field="proposedGame" maxlength="80" placeholder="2–80 字" disabled="{{busy}}" /></view>
        <view class="field"><text class="field-label">姓名</text><input value="{{realName}}" bindinput="input" data-field="realName" maxlength="80" disabled="{{busy}}" /></view>
        <view class="field"><text class="field-label">手机号</text><input value="{{phone}}" bindinput="input" data-field="phone" maxlength="21" placeholder="可含 + 国际区号" disabled="{{busy}}" /></view>
        <view class="field"><text class="field-label">申请说明</text><textarea value="{{reason}}" bindinput="input" data-field="reason" placeholder="说明组织计划与投入，10–3000 字" maxlength="3000" disabled="{{busy}}" /></view>
      </block>
      <view class="field"><text class="field-label">微信个人名片二维码</text>
        <image wx:if="{{qr}}" class="qr" src="{{qr}}" mode="aspectFit" bindtap="previewImage" data-url="{{qr}}" />
        <text wx:if="{{savedQr && !qr}}" class="muted">保留已保存的名片；选择新图片后才更换。</text>
        <button class="secondary" bindtap="chooseQr" disabled="{{busy || imageBusy}}" loading="{{imageBusy}}">{{qr || savedQr ? '选择新二维码图片' : '选择二维码图片'}}</button>
        <button wx:if="{{savedQr}}" class="plain" bindtap="inspectSaved" disabled="{{busy || imageBusy}}">查看已保存名片</button>
        <text class="muted">仅接受 2 MB 以内的 PNG、JPEG 或 WebP。授权拒绝或取消后可再次点击选择；已填内容会保留。</text>
      </view>
      <view class="privacy-note"><text class="muted">姓名、手机号、申请说明与名片用于申请审核，由本人及获得审核权限的负责人读取。名片展示由下方独立设置决定，默认不勾选；获批后仍可关闭。</text><button class="plain" bindtap="openContract">阅读微信平台隐私保护指引</button><button class="plain" bindtap="openPage" data-page="fixed" data-params="{{ {key: 'privacy'} }}">阅读社团隐私说明</button></view>
      <checkbox-group bindchange="consent"><label class="consent"><checkbox value="contact" checked="{{contactConsent}}" disabled="{{busy}}" /><text>同意在任期间向登录成员展示我的微信名片（可选）</text></label></checkbox-group>
      <text wx:if="{{formError}}" class="error" aria-role="alert">{{formError}}</text>
      <button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || imageBusy || (mode !== 'card' && gamesLoading)}}">{{mode === 'card' ? '保存名片与展示设置' : mode === 'edit' ? '保存并重新提交' : '提交申请'}}</button>
    </view>
    <text wx:if="{{operationError || (!apply && formError)}}" class="error" aria-role="alert">{{operationError || formError}}</text>
    <view class="section"><view class="section-head"><text class="section-title">我的申请回执</text><button class="plain" bindtap="retry" disabled="{{loading}}">刷新</button></view>
      <text wx:if="{{error}}" class="error">{{error}}</text><text wx:if="{{loading}}" class="muted">正在读取回执…</text>
      <view wx:for="{{docs}}" wx:key="id" class="section panel"><view class="row"><text class="section-title">{{item.proposedGame || '游戏社群申请'}}</text><text class="badge">{{item.statusText}}</text></view>
        <text class="muted">回执 {{item.id}} · {{item.dateText}}</text><text wx:if="{{item.reviewNote}}" class="body">处理意见：{{item.reviewNote}}</text><text class="body">{{item.reason}}</text><text class="muted" selectable>{{item.realName}} · {{item.phone}}</text>
        <text class="muted">名片展示：{{item.contactConsent ? '已授权在任期间展示' : '未授权展示'}}</text>
        <button class="plain" bindtap="inspect" data-id="{{item.id}}" disabled="{{busy || imageBusy}}">查看已提交二维码</button>
        <view class="actions"><button wx:if="{{item.actions.edit}}" class="secondary" bindtap="openForm" data-id="{{item.id}}" data-action="edit" disabled="{{busy || imageBusy}}">修改并重新提交</button><button wx:if="{{item.actions.card}}" class="secondary" bindtap="openForm" data-id="{{item.id}}" data-action="card" disabled="{{busy || imageBusy}}">更新名片与授权</button><button wx:if="{{item.actions.withdraw}}" class="danger" bindtap="withdraw" data-id="{{item.id}}" disabled="{{busy || imageBusy}}">撤回网站申请</button></view>
      </view>
      <view wx:if="{{!docs.length && !loading && !error}}" class="empty"><text>尚未提交申请</text><text class="muted">可申请新建社群或参与已有社群管理。</text></view>
      <button wx:if="{{hasMore}}" class="plain" bindtap="onReachBottom" disabled="{{loading}}" loading="{{loading}}">加载更多</button>
    </view>
  </block>
</view>
<privacy-consent id="privacyConsent" />
