<import src="../../templates/common.wxml" />
<view class="page"><text class="eyebrow">BUILD YOUR COMMUNITY</text><text class="title">社群管理员申请</text><text class="subtitle">申请建立或共同管理游戏社群。</text><template is="feedback" data="{{needsLogin}}" /><block wx:if="{{!needsLogin}}"><view wx:if="{{done}}" class="section panel"><text class="section-title">申请已提交</text><text class="body">请添加社长微信 yz167015 备案，等待社团负责人审核。</text><button class="secondary section" bindtap="copy" data-value="yz167015">复制社长微信</button></view><button class="secondary section" bindtap="toggle">{{apply ? '收起申请表' : '提交新申请 ＋'}}</button><view wx:if="{{apply}}" class="section panel"><view class="field"><text class="field-label">游戏社群</text><picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="game"><view>{{games[gameIndex].title}} ▾</view></picker></view><view wx:if="{{!games[gameIndex].id}}" class="field"><text class="field-label">新游戏名称</text><input value="{{proposedGame}}" bindinput="input" data-field="proposedGame" maxlength="80" placeholder="2–80 字" /></view><view class="field"><text class="field-label">姓名</text><input value="{{realName}}" bindinput="input" data-field="realName" maxlength="80" /></view><view class="field"><text class="field-label">手机号</text><input value="{{phone}}" bindinput="input" data-field="phone" type="text" maxlength="21" placeholder="可含 + 国际区号" /></view><view class="field"><text class="field-label">微信个人名片二维码</text><image wx:if="{{qr}}" class="qr" src="{{qr}}" mode="aspectFit" /><button class="secondary" bindtap="chooseQr">{{qr ? '重新选择二维码' : '选择二维码图片'}}</button><text class="muted">2 MB 以内，仅申请人及授权审核者可读取申请资料。</text></view><view class="field"><text class="field-label">申请说明</text><textarea value="{{reason}}" bindinput="input" data-field="reason" placeholder="说明组织计划与投入，至少 10 字" maxlength="5000" /></view><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交申请</button></view><text wx:if="{{error}}" class="error">{{error}}</text><view class="section"><text class="section-title">我的申请</text><view wx:for="{{docs}}" wx:key="id" class="section panel"><view class="row"><text class="section-title">{{item.proposedGame}}</text><text class="badge">{{item.statusText}}</text></view><text class="muted">{{item.dateText}}</text><text class="body">{{item.reason}}</text><text class="muted">{{item.realName}} · {{item.phone}}</text><button class="plain" bindtap="inspect" data-id="{{item.id}}">查看已提交二维码</button></view><view wx:if="{{!docs.length && !loading}}" class="empty"><text class="muted">尚未提交申请</text></view><button wx:if="{{hasMore}}" class="plain" bindtap="onReachBottom">加载更多</button></view></block></view>
