<import src="../../templates/common.wxml" />
<view class="chat-page"><view class="chat-status"><text>{{status}}</text><text class="more" bindtap="retry">刷新</text></view><template is="feedback" data="{{needsLogin}}" /><scroll-view wx:if="{{!needsLogin}}" class="messages" scroll-y scroll-into-view="{{scrollInto}}"><button wx:if="{{hasMore}}" class="plain" bindtap="history" loading="{{loading}}">加载更早消息</button><view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}" class="message {{item.own ? 'own' : ''}}"><text class="message-meta">{{item.name}} · {{item.dateText}}</text><view class="bubble" bindlongpress="manageMessage" data-message="{{item}}"><text wx:if="{{item.body}}" selectable>{{item.body}}</text><image wx:if="{{item.localImage}}" class="message-image" src="{{item.localImage}}" mode="widthFix" bindtap="previewImage" data-url="{{item.localImage}}" /></view></view><view wx:if="{{!messages.length && !loading}}" class="empty"><text>还没有消息</text><text class="muted">与社群伙伴打个招呼。</text></view><view class="chat-bottom"></view></scroll-view><view wx:if="{{!needsLogin}}" class="composer"><text wx:if="{{error}}" class="error">{{error}}</text><view wx:if="{{image}}" class="image-preview" bindtap="removeImage"><image src="{{image}}" mode="aspectFit" /><text class="muted">点击移除</text></view><view wx:if="{{showStickers}}" class="sticker-panel"><view class="search"><input value="{{stickerQuery}}" bindinput="stickerInput" bindconfirm="searchStickers" placeholder="搜索表情" maxlength="40" /><button class="secondary" bindtap="searchStickers" loading="{{stickerLoading}}">搜索</button></view><scroll-view scroll-y class="sticker-grid"><image wx:for="{{stickers}}" wx:key="url" src="{{item.image}}" mode="aspectFit" bindtap="chooseSticker" data-sticker="{{item}}" /></scroll-view><text wx:if="{{!stickerLoading && !stickers.length}}" class="muted">输入关键词搜索表情，结果由外部来源提供。</text></view><view class="compose-row"><button class="attach" bindtap="toggleStickers" aria-label="搜索表情">☺</button><button class="attach" bindtap="chooseImage" aria-label="添加图片">＋</button><input value="{{body}}" bindinput="input" placeholder="发送消息" maxlength="5000" confirm-type="send" bindconfirm="send" adjust-position /><button class="primary send" bindtap="send" loading="{{busy}}" disabled="{{busy || (!body && !image)}}">发送</button></view><text wx:if="{{managed}}" class="manage-hint">长按消息可管理发言</text></view></view>
