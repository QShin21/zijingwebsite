.chat-page { display: flex; flex-direction: column; height: 100vh; }
.chat-status { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 30rpx; color: #9884a9; font-size: 22rpx; border-bottom: 1rpx solid #ebe3f3; }
.messages { flex: 1; height: 0; padding: 24rpx 26rpx 0; }
.message { margin: 28rpx 0; display: flex; flex-direction: column; align-items: flex-start; }
.message.own { align-items: flex-end; }
.message-meta { font-size: 21rpx; color: #938399; margin-bottom: 11rpx; }
.bubble { max-width: 86%; background: #fff; padding: 23rpx; border: 1rpx solid #e9e0f0; border-radius: 22rpx; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-word; }
.own .bubble { background: #ede1fa; border-color: #e4d3f3; }
.message-image { display: block; width: 390rpx; max-width: 100%; border-radius: 12rpx; margin-top: 12rpx; }
.composer { background: #fff; padding: 18rpx 20rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eee5f6; }
.compose-row { display: flex; gap: 14rpx; align-items: center; }
.compose-row input { background: #f5f0f9; height: 80rpx; border-radius: 18rpx; flex: 1; padding: 16rpx; }
.attach { padding: 8rpx; font-size: 40rpx; color: #71449e; background: #fff; }
.send { padding: 18rpx 24rpx; }
.image-preview { display: flex; gap: 20rpx; align-items: center; padding-bottom: 18rpx; }
.image-preview image { width: 120rpx; height: 120rpx; }
.manage-hint { display: block; margin-top: 12rpx; font-size: 20rpx; color: #a193ab; text-align: center; }
.chat-bottom { height: 20rpx; }
.sticker-grid { height: 280rpx; } .sticker-grid image { width: 140rpx; height: 140rpx; margin: 8rpx; } .sticker-panel { padding: 0 10rpx 22rpx; }
