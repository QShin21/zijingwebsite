<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page business-page community-joins-page">
  <button class="plain back" bindtap="back">返回社群</button><view class="page-heading"><text class="task-context">{{title}}</text><text class="title">人工进群管理</text><text class="subtitle">在微信完成好友核实与拉群后，在这里记录实际进度。</text></view>
  <template is="feedback" data="{{needsLogin}}" />
  <text wx:if="{{loading}}" class="muted">正在核对管理权限与进群意向…</text><view wx:if="{{!needsLogin && !allowed && !loading && !error}}" class="empty"><text class="state-title">当前账号没有此社群的进群管理权限</text><button class="secondary" bindtap="retry">重新核对权限</button></view>
  <view wx:if="{{error}}"><text class="error">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">重新加载</button></view><text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text><text wx:if="{{done}}" class="result-message" aria-role="status">{{done}}</text>
  <block wx:if="{{allowed && !needsLogin}}">
    <view class="section-head"><text class="section-title">进群意向与进度</text><button class="plain" bindtap="retry" disabled="{{loading || busy}}">刷新核对</button></view>
    <view class="record-list"><view wx:for="{{docs}}" wx:key="id" class="task-record">
      <text class="section-title">{{item.memberName}}</text><text class="join-status">{{item.statusText}}</text><view class="record-meta"><text>回执 {{item.id}}</text><text>{{item.dateText}}</text></view>
      <view wx:if="{{item.note}}" class="task-feedback"><text class="task-feedback-label">上次处理说明</text><text class="body">{{item.note}}</text></view>
      <view wx:if="{{item.actions.confirmFriend || item.actions.confirmJoined}}" class="join-next"><text class="material-title">{{item.actions.confirmFriend ? '下一步：到微信核实好友已通过' : '下一步：在微信完成拉群'}}</text><text class="muted">{{item.actions.confirmFriend ? '确认好友已添加后，记录为等待拉群。' : '核实对方实际进入微信群后，再确认进群。'}}</text>
        <button class="plain disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? '收起处理说明' : '添加处理说明（可选）'}}</text><text>{{expandedId === item.id ? '−' : '＋'}}</text></button><view wx:if="{{expandedId === item.id}}" class="field"><text class="field-label">本人可见的处理说明</text><textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{item.noteDraft}}" bindinput="note" data-id="{{item.id}}" maxlength="500" placeholder="最多 500 字" disabled="{{busy}}" /></view>
        <view class="actions"><button wx:if="{{item.actions.confirmFriend}}" class="primary" bindtap="handle" data-id="{{item.id}}" data-action="confirmFriend" disabled="{{busy || loading}}">好友已通过，等待拉群</button><button wx:if="{{item.actions.confirmJoined}}" class="primary" bindtap="handle" data-id="{{item.id}}" data-action="confirmJoined" disabled="{{busy || loading}}">已人工拉群，确认进群</button></view>
      </view><text wx:else class="task-note">暂无可执行操作，请刷新核对最新进度。</text>
    </view></view>
    <view wx:if="{{!docs.length && !loading && !error}}" class="empty"><text class="state-title">暂无待处理进群意向</text><text class="muted">同学在本社群留下的意向会显示在这里。</text></view><button wx:if="{{hasMore}}" class="plain" bindtap="onReachBottom" disabled="{{loading || busy}}" loading="{{loading}}">加载更多记录</button>
  </block>
</view>
