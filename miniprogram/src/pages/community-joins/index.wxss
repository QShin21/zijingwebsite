@import "../../templates/business.wxss";
@import "../../styles/native-forms.wxss";

.community-joins-page .join-community-name { display: block; margin-bottom: 8px; color: var(--z-muted); font-size: 14px; line-height: 1.7; overflow-wrap: anywhere; }
.community-joins-page .join-loading { padding: 12px 0 20px; }
.community-joins-page .join-workflow { margin: 24px 0; padding: 0 0 0 12px; border-left: 2px solid var(--z-primary); }
.community-joins-page .join-workflow-title { display: block; margin-bottom: 8px; font-size: 16px; line-height: 1.65; font-weight: 600; }
.community-joins-page .join-progress { margin: 16px 0; padding: 12px 16px; background: var(--z-secondary-bg); border-radius: 6px; }
.community-joins-page .join-status-label { display: block; color: var(--z-secondary-text); font-size: 12px; line-height: 1.6; }
.community-joins-page .join-status { display: block; margin-top: 4px; color: var(--z-secondary-text); font-size: 16px; font-weight: 600; line-height: 1.7; overflow-wrap: anywhere; }
.community-joins-page .join-previous-note { margin: 16px 0; }
.native-form-page.community-joins-page .join-previous-note .material-title { margin: 0 0 6px; color: var(--z-muted); font-size: 14px; font-weight: 400; }
.native-form-page.community-joins-page .join-previous-note .body { margin-top: 0; }
.community-joins-page .join-next { margin-top: 20px; }
.community-joins-page .join-next-title { display: block; margin-bottom: 8px; font-size: 16px; line-height: 1.65; font-weight: 600; }
.native-form-page.community-joins-page .join-next .disclosure { margin-top: 8px; }
.native-form-page.community-joins-page .join-next .field { margin: 12px 0 20px; }
.native-form-page.community-joins-page .join-next textarea { height: 128px; }
.native-form-page.community-joins-page .join-next .actions { margin-top: 12px; }
.native-form-page.community-joins-page .join-next .actions > button { flex-basis: 100%; min-width: 0; }
.community-joins-page .join-readonly-note { display: block; margin-top: 12px; color: var(--z-muted); font-size: 15px; line-height: 1.75; }
.community-joins-page .join-receipt-title { display: block; font-weight: 600; }
.community-joins-page .join-receipt-note { display: block; margin-top: 4px; font-size: 14px; line-height: 1.75; }
.community-joins-page .join-busy { display: block; margin: 12px 0; color: var(--z-muted); font-size: 14px; line-height: 1.75; }
.community-joins-page .join-more { width: 100%; margin-top: 16px; }
