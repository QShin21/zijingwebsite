<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page staff-review-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{t.kicker}}</text>
      <text class="zj-hero-title">{{t.heroTitle}}</text>
      <text class="zj-hero-lead">{{t.heroLead}}</text>
    </view>
  </view>

  <view wx:if="{{message}}" class="zj-callout zj-callout-warning" aria-role="alert"><text class="staff-review-label">{{t.noticeLabel}}</text><text>{{message}}</text></view>
  <template is="feedback" data="{{loading,error,needsLogin,t}}" />
  <block wx:if="{{!loading && !error && !needsLogin}}">
    <view class="staff-review-filters">
      <view class="staff-review-filter">
        <text class="zj-small">{{t.direction}}</text>
        <picker range="{{directions}}" range-key="label" value="{{departmentIndex}}" disabled="{{busy}}" bindchange="direction"><view class="staff-review-picker"><text>{{directions[departmentIndex].label}}</text><text aria-hidden="true">▾</text></view></picker>
      </view>
      <view class="staff-review-filter">
        <text class="zj-small">{{t.status}}</text>
        <picker range="{{states}}" range-key="label" value="{{statusIndex}}" disabled="{{busy}}" bindchange="state"><view class="staff-review-picker"><text>{{states[statusIndex].label}}</text><text aria-hidden="true">▾</text></view></picker>
      </view>
    </view>

    <view class="zj-section-head"><text class="zj-section-title">{{t.records}}</text><text class="zj-count">{{total}}</text></view>
    <view wx:for="{{docs}}" wx:key="id" class="zj-record staff-review-record {{expandedId === item.id ? 'staff-review-open' : ''}}">
      <view class="zj-record-head">
        <view class="staff-review-who"><text class="staff-review-avatar">{{item.memberName[0]}}</text><view><text class="zj-record-title">{{item.memberName}}</text><text class="zj-small">{{t.applicationPrefix}}{{item.id}}{{t.updatedPrefix}}{{item.updatedText}}</text></view></view>
        <text class="zj-pill zj-pill-action">{{item.statusText}}</text>
      </view>
      <text wx:if="{{item.batchTitle}}" class="zj-tag zj-tag-club staff-review-batch">{{item.batchTitle}}</text>
      <button class="plain staff-review-disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? t.collapse : t.expand}}</text><text aria-hidden="true">{{expandedId === item.id ? '−' : '＋'}}</text></button>

      <view wx:if="{{expandedId === item.id}}" class="record-detail">
        <view class="staff-review-sheet">
          <text class="field-label">{{t.answers}}</text>
          <text class="zj-form-hint">{{t.answersHint}}</text>
          <view class="zj-kv">
            <view wx:for="{{item.rows}}" wx:for-item="answer" wx:key="id" class="zj-kv-row staff-review-answer"><text class="zj-kv-label">{{answer.label}}</text><text class="zj-kv-value" selectable>{{answer.answer}}</text></view>
          </view>
          <text wx:if="{{!item.rows.length}}" class="zj-form-hint">{{t.noAnswers}}</text>
        </view>
        <view wx:if="{{item.feedback}}" class="zj-callout"><text class="staff-review-label">{{t.existingFeedback}}</text><text selectable>{{item.feedback}}</text></view>

        <view wx:if="{{item.allowed.length}}" class="staff-review-decision">
          <text class="zj-sheet-title">{{t.handle}}</text>
          <text class="zj-form-hint">{{t.handleHint}}</text>
          <view class="field">
            <text class="field-label">{{t.decision}}</text>
            <picker range="{{item.allowed}}" range-key="label" value="{{item.decisionIndex}}" disabled="{{busy}}" bindchange="field" data-index="{{index}}" data-key="decisionIndex"><view class="staff-review-picker"><text>{{item.allowed[item.decisionIndex].label}}</text><text aria-hidden="true">▾</text></view></picker>
          </view>
          <view class="field">
            <view class="staff-review-feedback-head"><text class="field-label">{{t.feedback}}</text><text wx:if="{{item.allowed[item.decisionIndex].value === 'returned' || item.allowed[item.decisionIndex].value === 'rejected'}}" class="zj-pill zj-pill-danger">{{t.required}}</text></view>
            <textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{item.feedbackDraft}}" disabled="{{busy}}" maxlength="1000" bindinput="field" data-index="{{index}}" data-key="feedbackDraft" placeholder="{{t.feedbackPlaceholder}}" />
            <text class="zj-form-hint">{{t.feedbackHint}}</text>
          </view>
          <view class="staff-review-check"><text class="staff-review-label">{{t.willSave}}</text><text>{{item.allowed[item.decisionIndex].label}}</text></view>
          <button class="primary" bindtap="decide" data-index="{{index}}" loading="{{busy}}" disabled="{{busy}}">{{busy ? t.saving : t.save}}</button>
        </view>
        <view wx:else class="zj-callout"><text class="staff-review-label">{{t.readOnly}}</text><text>{{t.readOnlyHint}}</text></view>
      </view>
    </view>
    <view wx:if="{{!docs.length}}" class="zj-empty"><text class="zj-empty-icon">✓</text><text class="zj-empty-title">{{t.emptyTitle}}</text><text class="zj-small">{{t.emptyBody}}</text></view>
    <view wx:if="{{pages > 1}}" class="staff-review-pager"><button bindtap="previous" disabled="{{busy || page <= 1}}">{{t.previous}}</button><text class="staff-review-page">{{page}} / {{pages}}</text><button bindtap="next" disabled="{{busy || page >= pages}}">{{t.next}}</button></view>
  </block>
</view>
