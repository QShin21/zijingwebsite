<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page business-page staff-review-page">
  <button class="plain back" bindtap="back">返回</button><view class="page-heading"><text class="title">骨干申请审核</text><text class="subtitle">按方向与状态查找申请，展开答卷后填写反馈与处理结果。</text></view>
  <template is="feedback" data="{{loading,error,needsLogin}}" /><text wx:if="{{message}}" class="result-message" aria-role="alert">{{message}}</text>
  <block wx:if="{{!loading && !error && !needsLogin}}">
    <view class="scope-filters"><view class="field"><text class="field-label">申请方向</text><picker range="{{directions}}" range-key="label" value="{{departmentIndex}}" disabled="{{busy}}" bindchange="direction"><view>{{directions[departmentIndex].label}} ▾</view></picker></view><view class="field"><text class="field-label">处理状态</text><picker range="{{states}}" range-key="label" value="{{statusIndex}}" disabled="{{busy}}" bindchange="state"><view>{{states[statusIndex].label}} ▾</view></picker></view></view>
    <view class="section-head"><text class="section-title">申请记录</text><text class="muted">共 {{total}} 份</text></view>
    <view class="record-list"><view wx:for="{{docs}}" wx:key="id" class="task-record review-entry">
      <view class="record-heading"><view><text class="section-title">{{item.memberName}}</text><view class="record-meta"><text>申请 {{item.id}}</text><text>{{item.updatedText}}</text></view></view><text class="badge">{{item.statusText}}</text></view>
      <button class="plain disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? '收起答卷与处理区' : '查看答卷与处理记录'}}</text><text>{{expandedId === item.id ? '−' : '＋'}}</text></button>
      <view wx:if="{{expandedId === item.id}}" class="record-detail"><text class="material-title">申请时提交的答卷</text><view wx:for="{{item.rows}}" wx:for-item="answer" wx:key="id" class="answer"><text class="answer-label">{{answer.label}}</text><text selectable>{{answer.answer}}</text></view>
        <view wx:if="{{item.allowed.length}}" class="review-actions"><text class="section-title">处理这份申请</text><text class="muted">反馈会出现在申请人的回执中。录用不自动授予平台角色。</text><view class="field"><text class="field-label">处理决定</text><picker range="{{item.allowed}}" range-key="label" value="{{item.decisionIndex}}" disabled="{{busy}}" bindchange="field" data-index="{{index}}" data-key="decisionIndex"><view>{{item.allowed[item.decisionIndex].label}} ▾</view></picker></view><view class="field"><text class="field-label">给申请人的反馈</text><textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{item.feedbackDraft}}" disabled="{{busy}}" maxlength="1000" bindinput="field" data-index="{{index}}" data-key="feedbackDraft" placeholder="退回或未录用请说明具体原因" /></view><button class="primary" bindtap="decide" data-index="{{index}}" loading="{{busy}}" disabled="{{busy}}">保存处理结果</button></view>
        <view wx:else class="task-feedback"><text class="task-feedback-label">当前回执只读</text><text wx:if="{{item.feedback}}" class="body">{{item.feedback}}</text><text class="muted">可刷新核对最新状态与允许的操作。</text></view>
      </view>
    </view></view>
    <view wx:if="{{!docs.length}}" class="empty"><text class="state-title">暂无符合条件的申请</text><text class="muted">可切换申请方向或处理状态查看。</text></view>
    <view wx:if="{{pages > 1}}" class="pagination"><button bindtap="previous" disabled="{{busy || page <= 1}}">上一页</button><text>{{page}} / {{pages}}</text><button bindtap="next" disabled="{{busy || page >= pages}}">下一页</button></view>
  </block>
</view>
