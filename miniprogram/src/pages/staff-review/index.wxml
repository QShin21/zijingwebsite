<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page staff-review-page"><button class="plain" bindtap="back">返回</button><view class="page-heading"><text class="eyebrow">社团工作 · 审核待办</text><text class="title">骨干申请审核</text><text class="subtitle">按部门与状态查看当前有权处理的申请。先核对答案，再填写反馈、保存决定。</text></view><template is="feedback" data="{{loading,error,needsLogin}}" />
<block wx:if="{{!loading && !error && !needsLogin}}"><view class="row filters"><picker range="{{directions}}" range-key="label" value="{{departmentIndex}}" disabled="{{busy}}" bindchange="direction"><text>{{directions[departmentIndex].label}} ▾</text></picker><picker range="{{states}}" range-key="label" value="{{statusIndex}}" disabled="{{busy}}" bindchange="state"><text>{{states[statusIndex].label}} ▾</text></picker></view><text class="muted">共 {{total}} 份申请</text>
<view wx:for="{{docs}}" wx:key="id" class="record-sheet review-entry"><text class="record-id">申请 {{item.id}} · {{item.updatedText}}</text><view class="row"><text class="section-title">{{item.memberName}}</text><text class="badge">{{item.statusText}}</text></view><view wx:for="{{item.rows}}" wx:for-item="answer" wx:key="id" class="answer"><text class="label">{{answer.label}}</text><text selectable>{{answer.answer}}</text></view>
<block wx:if="{{item.allowed.length}}"><view class="form-section"><text class="form-section-title">处理这份申请</text><text class="muted">反馈会出现在申请人的回执中；退回或未录用须写明原因。录用结果不授予平台管理角色。</text><picker range="{{item.allowed}}" range-key="label" value="{{item.decisionIndex}}" disabled="{{busy}}" bindchange="field" data-index="{{index}}" data-key="decisionIndex"><view class="picker">处理决定：{{item.allowed[item.decisionIndex].label}} ▾</view></picker><text class="label">给申请人的反馈</text><textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{item.feedbackDraft}}" disabled="{{busy}}" maxlength="1000" bindinput="field" data-index="{{index}}" data-key="feedbackDraft" placeholder="退回或未录用请说明原因" /><button class="primary section" bindtap="decide" data-index="{{index}}" loading="{{busy}}" disabled="{{busy}}">保存处理结果</button></view></block><text wx:else class="muted section">此记录目前只可查看</text></view>
<view wx:if="{{!docs.length}}" class="empty"><text>暂无符合条件的申请</text></view><view wx:if="{{pages > 1}}" class="row section"><button bindtap="previous" disabled="{{busy || page <= 1}}">上一页</button><text>{{page}} / {{pages}}</text><button bindtap="next" disabled="{{busy || page >= pages}}">下一页</button></view></block><text wx:if="{{message}}" class="body section" role="alert">{{message}}</text></view>
