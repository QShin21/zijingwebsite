<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page business-page native-page native-form-page staff-review-page">
  <button class="plain back" bindtap="back">返回</button>
  <view class="page-heading">
    <text class="title">骨干申请审核</text>
    <text class="subtitle">先阅读申请答卷，再填写反馈与处理决定。录用后的任命另行处理。</text>
  </view>

  <view wx:if="{{message}}" class="result-message staff-result" aria-role="alert"><text class="staff-result-label">处理提示</text><text>{{message}}</text></view>
  <template is="feedback" data="{{loading,error,needsLogin}}" />
  <block wx:if="{{!loading && !error && !needsLogin}}">
    <view class="staff-review-filters">
      <text class="task-section-title">查找申请</text>
      <view class="scope-filters">
        <view class="field">
          <text class="field-label">申请方向</text>
          <picker range="{{directions}}" range-key="label" value="{{departmentIndex}}" disabled="{{busy}}" bindchange="direction"><view class="staff-picker-value"><text>{{directions[departmentIndex].label}}</text><text class="staff-picker-mark" aria-hidden="true">▾</text></view></picker>
        </view>
        <view class="field">
          <text class="field-label">处理状态</text>
          <picker range="{{states}}" range-key="label" value="{{statusIndex}}" disabled="{{busy}}" bindchange="state"><view class="staff-picker-value"><text>{{states[statusIndex].label}}</text><text class="staff-picker-mark" aria-hidden="true">▾</text></view></picker>
        </view>
      </view>
    </view>

    <view class="section-head staff-record-heading"><text class="section-title">申请记录</text><text class="staff-result-count">共 {{total}} 份</text></view>
    <view class="record-list">
      <view wx:for="{{docs}}" wx:key="id" class="task-record review-entry">
        <view class="record-heading">
          <view><text class="section-title">{{item.memberName}}</text><view class="record-meta"><text>申请 {{item.id}}</text><text>最近更新 {{item.updatedText}}</text></view></view>
          <text class="badge">{{item.statusText}}</text>
        </view>
        <text wx:if="{{item.batchTitle}}" class="staff-batch-title">{{item.batchTitle}}</text>
        <button class="plain disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? '收起答卷与处理区' : '查看答卷与处理记录'}}</text><text class="disclosure-mark" aria-hidden="true">{{expandedId === item.id ? '−' : '＋'}}</text></button>

        <view wx:if="{{expandedId === item.id}}" class="record-detail">
          <view class="staff-material-heading"><text class="material-title">申请时提交的答卷</text><text class="muted">按提交时的题目保留，请先核对申请资料。</text></view>
          <view class="staff-answer-sheet">
            <view wx:for="{{item.rows}}" wx:for-item="answer" wx:key="id" class="answer"><text class="answer-label">{{answer.label}}</text><text class="staff-answer-value" selectable>{{answer.answer}}</text></view>
            <text wx:if="{{!item.rows.length}}" class="muted">这份回执暂无可展示的答卷内容。</text>
          </view>
          <view wx:if="{{item.feedback}}" class="task-feedback staff-previous-feedback"><text class="task-feedback-label">已有处理反馈</text><text class="body" selectable>{{item.feedback}}</text></view>

          <view wx:if="{{item.allowed.length}}" class="review-actions">
            <text class="section-title">处理这份申请</text>
            <text class="muted">反馈会出现在申请人的回执中。录用不自动授予平台角色。</text>
            <view class="field">
              <text class="field-label">处理决定</text>
              <picker range="{{item.allowed}}" range-key="label" value="{{item.decisionIndex}}" disabled="{{busy}}" bindchange="field" data-index="{{index}}" data-key="decisionIndex"><view class="staff-picker-value"><text>{{item.allowed[item.decisionIndex].label}}</text><text class="staff-picker-mark" aria-hidden="true">▾</text></view></picker>
            </view>
            <view class="field">
              <view class="staff-feedback-heading"><text class="field-label">给申请人的反馈</text><text wx:if="{{item.allowed[item.decisionIndex].value === 'returned' || item.allowed[item.decisionIndex].value === 'rejected'}}" class="staff-required">必填</text></view>
              <textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{item.feedbackDraft}}" disabled="{{busy}}" maxlength="1000" bindinput="field" data-index="{{index}}" data-key="feedbackDraft" placeholder="退回或未录用请说明具体原因" />
              <text class="field-note">退回补充或未录用时，请写明具体原因与需要补充的内容。</text>
            </view>
            <view class="staff-decision-check"><text class="staff-decision-label">即将保存</text><text>{{item.allowed[item.decisionIndex].label}}</text></view>
            <button class="primary" bindtap="decide" data-index="{{index}}" loading="{{busy}}" disabled="{{busy}}">{{busy ? '正在确认或保存' : '保存处理结果'}}</button>
          </view>
          <view wx:else class="task-feedback staff-readonly"><text class="task-feedback-label">当前回执只读</text><text class="muted">可下拉刷新，核对最新状态与允许的操作。</text></view>
        </view>
      </view>
    </view>
    <view wx:if="{{!docs.length}}" class="empty"><text class="state-title">暂无符合条件的申请</text><text class="muted">可切换申请方向或处理状态查看。</text></view>
    <view wx:if="{{pages > 1}}" class="pagination"><button bindtap="previous" disabled="{{busy || page <= 1}}">上一页</button><text>{{page}} / {{pages}}</text><button bindtap="next" disabled="{{busy || page >= pages}}">下一页</button></view>
  </block>
</view>
