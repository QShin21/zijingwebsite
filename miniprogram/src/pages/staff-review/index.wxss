@import "../../templates/business.wxss";
@import "../../styles/native-forms.wxss";

/* V2 staff review: filter chips, applicant records, answer sheet and decision panel. */
.staff-review-v2 { padding-top: 0; }
.staff-review-label { display: block; font-weight: 900; }
.staff-review-filters { display: flex; gap: 14rpx; margin-bottom: 20rpx; }
.staff-review-filter { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; padding: 16rpx 20rpx; border: 1rpx solid var(--z-line); border-radius: 24rpx; background: var(--z-surface); }
.staff-review-picker { display: flex; min-height: 44px; align-items: center; justify-content: space-between; gap: 10rpx; color: var(--z-primary); font-size: 28rpx; font-weight: 800; }
.staff-review-who { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; }
.staff-review-avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 76rpx; height: 76rpx; border-radius: 50%; background: var(--z-primary); color: var(--z-on-primary); font-size: 32rpx; font-weight: 900; }
.staff-review-who > view { flex: 1; min-width: 0; }
.staff-review-batch { align-self: flex-start; }
.staff-review-open { border-color: var(--z-primary); box-shadow: 0 16rpx 48rpx rgba(28, 18, 64, .12); }
.mini-page .staff-review-disclosure { display: flex; justify-content: space-between; width: 100%; padding: 10rpx 0; }
.record-detail { display: flex; flex-direction: column; gap: 18rpx; }
.staff-review-sheet { display: flex; flex-direction: column; gap: 6rpx; padding: 22rpx; border-radius: 24rpx; background: var(--z-raised); border: 1rpx solid var(--z-line); }
.staff-review-answer .zj-kv-label { width: 200rpx; }
.staff-review-decision { display: flex; flex-direction: column; gap: 8rpx; padding: 24rpx; border-radius: 24rpx; background: var(--z-tint); }
.staff-review-feedback-head { display: flex; align-items: center; justify-content: space-between; }
.staff-review-check { display: flex; align-items: center; gap: 14rpx; padding: 14rpx 18rpx; border-radius: 18rpx; background: var(--z-surface); font-weight: 800; }
.staff-review-pager { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 24rpx; }
.staff-review-page { font-weight: 900; }
