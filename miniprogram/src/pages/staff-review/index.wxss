/* Page-local visual layer. Shared app styles and templates remain owned by integration. */
page { background: var(--z-page, #f7f8fa); color: var(--z-text, #251f2d); font-size: 14px; }
.page { width: 100%; max-width: 640px; margin: 0 auto; padding: 36rpx 32rpx 64rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.page button { color: var(--z-text, #251f2d); background: var(--z-control, #f5f2f8); border: 1rpx solid var(--z-control-border, #9b8aa9); border-radius: 14rpx; min-height: 44px; font-size: 27rpx; line-height: 1.55; padding: 22rpx 28rpx; }
.page button::after { border: 0; }
.page button[disabled] { opacity: .5; }
.page .content-link { display: block; width: 100%; text-align: left; font-weight: 400; white-space: normal; padding: 0; }
.page .eyebrow { color: var(--z-brand, #704693); font-size: 20rpx; letter-spacing: 3rpx; font-weight: 600; line-height: 1.6; margin-bottom: 14rpx; }
.page .title { color: var(--z-text, #251f2d); font-size: 54rpx; line-height: 1.28; font-weight: 700; letter-spacing: -1rpx; word-break: break-word; }
.page .subtitle { color: var(--z-subtitle, #5f536d); font-size: 27rpx; line-height: 1.8; margin-top: 20rpx; }
.page .section { margin-top: 44rpx; }
.page .section-head { align-items: flex-end; margin-bottom: 24rpx; gap: 18rpx; }
.page .section-head > view { min-width: 0; flex: 1; }
.page .section-title { display: block; font-size: 33rpx; line-height: 1.45; font-weight: 650; color: var(--z-text, #251f2d); word-break: break-word; }
.page .section-head .eyebrow { margin-bottom: 8rpx; }
.page .panel, .page .card { background: var(--z-surface, #ffffff); border: 1rpx solid var(--z-line, #ded8e7); border-radius: 20rpx; }
.page .panel { padding: 30rpx; }
.page .card { overflow: hidden; margin-bottom: 22rpx; }
.page .card-image { width: 100%; height: 300rpx; display: block; background: var(--z-media, #ece8f1); }
.page .card-body { padding: 28rpx; }
.page .card-title { color: var(--z-text, #251f2d); font-size: 33rpx; font-weight: 650; line-height: 1.55; margin-top: 14rpx; word-break: break-word; }
.page .card-summary { color: var(--z-subtitle, #5f536d); font-size: 26rpx; line-height: 1.75; margin-top: 14rpx; word-break: break-word; }
.page .card-footer { border-top: 1rpx solid var(--z-line, #ded8e7); padding-top: 22rpx; margin-top: 26rpx; }
.page .meta { color: var(--z-muted, #6c6179); font-size: 23rpx; line-height: 1.7; gap: 14rpx; word-break: break-word; }
.page .badge { color: var(--z-badge-text, #5b3188); background: var(--z-badge-bg, #eee6f9); border: 1rpx solid var(--z-badge-border, #c7b5db); padding: 4rpx 14rpx; border-radius: 7rpx; font-size: 22rpx; line-height: 1.65; }
.page .primary { width: 100%; background: var(--z-primary, #6536a6); border-color: var(--z-primary, #6536a6); color: var(--z-on-primary, #ffffff); font-weight: 650; }
.page .secondary { background: var(--z-secondary-bg, #f1eaf8); border-color: var(--z-secondary-border, #9077ab); color: var(--z-secondary-text, #5b368a); font-weight: 600; }
.page .plain { color: var(--z-link, #6536a6); background: transparent; border-color: transparent; }
.page .danger { color: var(--z-danger-text, #98283c); background: var(--z-danger-bg, #fff0f2); border-color: var(--z-danger-border, #bd6878); }
.page .more { display: inline-flex; align-items: center; flex-shrink: 0; justify-content: center; min-width: 90rpx; min-height: 44px; padding: 10rpx 0 10rpx 18rpx; font-size: 25rpx; color: var(--z-link, #6536a6); background: transparent; border: 0; }
.page .arrow { color: var(--z-positive, #126448); margin-left: 10rpx; }
.page .state, .page .empty { min-height: 260rpx; gap: 20rpx; padding: 44rpx 24rpx; border: 1rpx solid var(--z-line, #ded8e7); border-radius: 18rpx; background: var(--z-surface, #ffffff); }
.page .state-title { color: var(--z-text, #251f2d); font-size: 32rpx; line-height: 1.5; }
.page .state-dot { width: 16rpx; height: 16rpx; background: var(--z-primary, #6536a6); box-shadow: 0 0 0 8rpx var(--z-halo, #e8dcf5); margin-bottom: 10rpx; }
.page .empty-index { color: var(--z-positive, #126448); font-size: 24rpx; letter-spacing: 4rpx; }
.page .muted { color: var(--z-muted, #6c6179); font-size: 25rpx; line-height: 1.8; word-break: break-word; }
.page .error { display: block; width: 100%; background: var(--z-error-bg, #fff0f2); color: var(--z-danger-text, #98283c); border: 1rpx solid var(--z-error-border, #b5374b); border-radius: 12rpx; line-height: 1.75; padding: 22rpx; word-break: break-word; }
.page .chips { display: block; width: 100%; white-space: nowrap; margin: 28rpx 0; padding-bottom: 8rpx; }
.page .chip { display: inline-flex; align-items: center; justify-content: center; color: var(--z-subtitle, #5f536d); background: var(--z-surface, #ffffff); border: 1rpx solid var(--z-control-border, #9b8aa9); border-radius: 10rpx; font-size: 25rpx; min-height: 44px; padding: 18rpx 24rpx; margin-right: 12rpx; vertical-align: middle; }
.page .chip.active { color: var(--z-selected-text, #432164); background: var(--z-selected-bg, #eaddf8); border-color: var(--z-brand, #704693); }
.page .search { gap: 12rpx; align-items: stretch; margin: 28rpx 0; }
.page .search input { min-width: 0; height: 88rpx; border-color: var(--z-control-border, #9b8aa9); background: var(--z-surface, #ffffff); color: var(--z-text, #251f2d); border-radius: 14rpx; padding: 18rpx 22rpx; }
.page .search button { flex-shrink: 0; padding: 16rpx 24rpx; }
.page .field-label { color: var(--z-text, #251f2d); font-size: 27rpx; line-height: 1.6; }
.page .field input, .page .field textarea, .page .field picker { color: var(--z-text, #251f2d); background: var(--z-field-bg, #ffffff); border: 1rpx solid var(--z-field-border, #94849f); border-radius: 12rpx; padding: 22rpx; }
.page .field input { height: 94rpx; }
.page .field textarea { min-height: 230rpx; }
.page input::placeholder, .page textarea::placeholder { color: var(--z-muted, #6c6179); opacity: 1; }
.page .row { flex-wrap: wrap; gap: 18rpx; }
.page .actions { gap: 16rpx; }
.page .body { display: block; color: var(--z-body, #40354d); line-height: 1.9; font-size: 28rpx; word-break: break-word; }
.page .photo { display: block; max-width: 100%; border-radius: 12rpx; }
.page .image-button { display: block; width: 100%; background: transparent; border: 0; padding: 0; min-height: 44px; }
.page .image-button .photo { margin-top: 18rpx; }
.page .separator { background: var(--z-line, #ded8e7); }
.page .bottom-note { display: block; color: var(--z-muted, #6c6179); font-size: 23rpx; padding-top: 28rpx; margin-top: 38rpx; border-top: 1rpx solid var(--z-line, #ded8e7); word-break: break-word; }
.page .pressed { opacity: .82; }
.page button:focus, .page input:focus, .page textarea:focus, .page picker:focus, .page [tabindex]:focus { outline: 2px solid var(--z-focus, #006b57); outline-offset: 5rpx; }
@media (prefers-reduced-motion: reduce) { .page, .page view, .page button { animation: none; transition: none; } }
@media (min-width: 600px) {
  .page { padding: 32px 28px 54px; }
  .page .title { font-size: 34px; } .page .section-title, .page .card-title { font-size: 22px; }
  .page .subtitle, .page .body, .page .muted, .page button, .page .field-label { font-size: 17px; }
  .page .eyebrow, .page .meta, .page .badge, .page .bottom-note { font-size: 14px; }
  .page .card-image { height: 240px; }
}
@media (max-width: 359px) {
  .page .body, .page .subtitle, .page .muted, .page button, .page .field-label { font-size: 14px; }
  .page .eyebrow, .page .meta, .page .badge, .page .bottom-note { font-size: 12px; }
}
.page > .title { display: block; padding-bottom: 28rpx; margin-top: 16rpx; border-bottom: 1rpx solid var(--z-control-border, #9b8aa9); }
.page > .subtitle { margin-bottom: 26rpx; }
.page .chip { width: auto; }
.page .label, .page .answer-label { display: block; margin: 20rpx 0 14rpx; font-size: 28rpx; color: var(--z-text, #251f2d); font-weight: 600; line-height: 1.7; }
.page .answer { padding: 20rpx 0; border-top: 1rpx solid var(--z-line, #ded8e7); white-space: pre-wrap; word-break: break-word; }
.page textarea { width: 100%; height: 220rpx; min-height: 44px; padding: 22rpx; border: 1rpx solid var(--z-field-border, #94849f); background: var(--z-field-bg, #ffffff); color: var(--z-text, #251f2d); border-radius: 12rpx; font-size: 28rpx; }
.page label.field { display: block; }
.page .field input { min-height: 44px; }
.page .filters { padding: 24rpx; background: var(--z-surface, #ffffff); border: 1rpx solid var(--z-control-border, #9b8aa9); border-radius: 12rpx; margin: 28rpx 0; }
.page .filters picker { flex: 1; min-width: 0; color: var(--z-badge-text, #5b3188); padding: 16rpx 10rpx; }
.page .consent { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 18rpx; margin: 24rpx 0; border: 1rpx solid var(--z-positive-border, #a3c8b5); border-radius: 12rpx; background: var(--z-positive-bg, #eaf6ef); color: var(--z-positive-text, #254f40); font-size: 26rpx; line-height: 1.8; }
.page .consent checkbox, .page .consent switch { flex-shrink: 0; }
.page .evidence-video, .page .honor-video { width: 100%; height: 340rpx; border-radius: 14rpx; background: var(--z-page, #f7f8fa); }
.page .honor, .page .honor-record { border-top: 3rpx solid var(--z-positive, #126448); }
.page .honor .body:first-of-type { color: var(--z-positive, #126448); }
.page .profile-card { margin-top: 26rpx; border-top: 3rpx solid var(--z-primary, #6536a6); }
.page .profile-card .avatar, .page .preview-avatar { width: 120rpx; height: 120rpx; border-radius: 18rpx; margin-bottom: 22rpx; }
.page .biography { white-space: pre-wrap; word-break: break-word; }
.page .editor { border-top: 3rpx solid var(--z-primary, #6536a6); }
.page .privacy-note { background: var(--z-positive-bg, #eaf6ef); border: 1rpx solid var(--z-positive-line, #b1cebf); border-radius: 12rpx; padding: 22rpx; margin-top: 26rpx; }
.page .back, .page > .plain:first-child { width: auto; text-align: left; min-height: 44px; padding: 14rpx 0 20rpx; font-size: 24rpx; }
@media (min-width: 600px) { .page .label, .page .answer-label, .page textarea, .page .consent { font-size: 17px; } }

.page .panel, .page .card { box-shadow: var(--z-shadow, 0 8rpx 28rpx rgba(52,34,79,.035)); }
.page button[disabled] { opacity: 1; color: var(--z-disabled-text, #796b83); background: var(--z-disabled-bg, #eee9f3); border-color: var(--z-disabled-border, #d1c6dc); }
.page input[disabled], .page textarea[disabled] { color: var(--z-disabled-text, #796b83); background: var(--z-disabled-bg, #eee9f3); border-color: var(--z-disabled-border, #d1c6dc); }
.page .evidence-video, .page .honor-video, .page .showcase-video { background: var(--z-video-surface, #14131a); }
.page .photo { background: var(--z-media, #ece8f1); border: 1rpx solid var(--z-image-border, #dbd2e5); }
