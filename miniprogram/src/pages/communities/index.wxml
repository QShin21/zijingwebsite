<import src="../../templates/common.wxml" />
<view class="page"><text class="eyebrow">FIND YOUR PEOPLE</text><text class="title">加入我们</text><text class="subtitle">选择游戏社群，查看授权的管理员名片，在微信中主动加好友并等待人工拉群。</text>
  <template is="feedback" data="{{loading, needsLogin}}" />
  <block wx:if="{{!needsLogin}}">
    <view wx:if="{{error}}"><text class="error">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading}}">重试社群列表</button></view>
    <view class="section-head section"><text class="section-title">游戏社群</text><button class="plain" bindtap="applications">我的管理员申请 →</button></view>
    <view wx:for="{{docs}}" wx:key="id" class="section card" bindtap="openCommunity" data-doc="{{item}}"><image wx:if="{{item.coverImage}}" class="card-image" src="{{item.coverImage.url}}" mode="aspectFill" /><view class="card-body"><view class="row"><text class="community-title">{{item.title}}</text><text class="more">↗</text></view><text wx:if="{{item.summary}}" class="subtitle">{{item.summary}}</text><text class="community-hint">社群名片与进群进度 · 社群活动与通知 · 社群风采</text></view></view>
    <view wx:if="{{!loading && !docs.length && !error}}" class="empty"><text>暂未开放游戏社群</text><text class="muted">已有社群公开后会出现在这里，也可申请参与组织。</text></view>
    <button wx:if="{{hasMore}}" class="plain" bindtap="onReachBottom" disabled="{{loading}}" loading="{{loading}}">加载更多</button>
    <view class="section panel"><text class="section-title">申请参与社群组织</text><text class="subtitle">可以申请新建游戏社群，或参与已有社群管理。查看、识别名片和批准申请均不会自动进微信群。</text><button class="secondary section" bindtap="apply">申请社群管理员 →</button></view>
  </block>
  <view class="section panel"><text class="section-title">社团骨干招新</text><text class="subtitle">全社团共用同一批次申请。从主页和各个社群入口进入，可查看同一份申请与回执。</text><button class="secondary section" bindtap="staff">招新批次与我的申请 →</button>
    <view wx:for="{{staffBatches}}" wx:key="id" class="staff-row"><view class="row"><text>{{item.title}}</text><text class="badge">{{item.state}}</text></view><text wx:if="{{item.description}}" class="muted">{{item.description}}</text><button class="plain" bindtap="applyStaff" data-id="{{item.id}}">查看批次与申请状态 →</button></view>
  </view>
  <view class="section"><text class="section-title">社团展示</text><text class="subtitle">经审批升推的社群活动、通知与风采。</text>
    <view wx:for="{{promotions}}" wx:key="sourceKey" class="section card" bindtap="openWebsite" data-url="{{item.href}}"><view class="card-body"><view class="meta"><text>{{item.kindText}}</text><text>{{item.gameTitle}}</text></view><text class="card-title">{{item.snapshot.title}}</text><text class="card-summary">{{item.snapshot.body}}</text><text class="more">查看原内容 →</text></view></view>
    <text wx:if="{{!promotions.length && !clubLoading && !clubError}}" class="empty">暂无已审批的社团展示</text>
    <text wx:if="{{clubLoading}}" class="muted">正在读取社团批次与展示…</text><view wx:if="{{clubError}}"><text class="error">{{clubError}}</text><button class="secondary" bindtap="retryClub" disabled="{{clubLoading}}">重试社团信息</button></view>
  </view>
</view>
