<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<import src="../../templates/club.wxml" />
<view class="page mini-page communities-page">
  <view class="page-heading"><text class="title">游戏社群</text><text class="subtitle">找到你玩的游戏，联系管理员，认识一起玩的同学。</text></view>
  <template is="feedback" data="{{needsLogin}}" />
  <block wx:if="{{!needsLogin}}">
    <view class="filter-group"><text class="filter-label">查找游戏或社群</text><view class="search"><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{search}}" bindinput="inputSearch" bindconfirm="searchGames" placeholder="输入名称关键词" aria-label="搜索游戏或社群名称" confirm-type="search" maxlength="80" /><button class="secondary" bindtap="searchGames">查找</button></view><view wx:if="{{appliedSearch}}" class="row"><text class="muted">名称包含“{{appliedSearch}}”</text><button class="plain" bindtap="clearSearch">清除搜索</button></view></view>
    <view class="section-heading"><text class="section-title">{{appliedSearch ? '搜索结果' : '社群目录'}}</text><text class="muted" wx:if="{{docs.length}}">已加载 {{docs.length}} 个</text></view>
    <text wx:if="{{loading}}" class="result-caption" aria-role="status">正在读取社群…</text><view wx:if="{{error}}"><text class="error">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading}}">重试社群列表</button></view>
    <view class="record-list"><button wx:for="{{docs}}" wx:key="id" class="content-link community-entry" bindtap="openCommunity" data-doc="{{item}}" hover-class="pressed"><view class="community-entry-main"><view class="directory-main"><text class="directory-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="muted">{{item.summary}}</text></view><image wx:if="{{item.coverImage}}" class="community-thumb" src="{{item.coverImage.url}}" mode="aspectFill" aria-label="{{item.coverImage.alt || item.title}}" /></view><view class="community-entry-foot"><text>社群近况与管理员联系方式</text><text aria-hidden="true">›</text></view></button></view>
    <view wx:if="{{!loading && !docs.length && !error}}" class="empty"><text class="state-title">{{appliedSearch ? '没有找到这个名称' : '暂未开放游戏社群'}}</text><text class="muted">{{appliedSearch ? '试试游戏简称，或清除搜索查看全部社群。' : '已公开的社群会出现在这里，也可申请参与组织。'}}</text><button wx:if="{{appliedSearch}}" class="secondary" bindtap="clearSearch">查看全部社群</button></view>
    <button wx:if="{{hasMore}}" class="secondary section" bindtap="onReachBottom" disabled="{{loading}}" loading="{{loading}}">加载更多社群</button>
    <view class="section community-organize"><text class="section-title">想组织一个社群？</text><text class="muted">申请新建游戏社群，或参与已有社群管理。</text><view class="actions"><button class="secondary" bindtap="apply">申请社群管理员</button><button class="plain" bindtap="applications">我的申请</button></view></view>
  </block>
  <view class="section"><view class="section-heading"><text class="section-title">参与社团工作</text><button class="more" bindtap="staff">骨干招新</button></view><text class="muted">查看执行部、宣传部招新批次及本人申请。</text><button wx:for="{{staffBatches}}" wx:key="id" class="content-link shortcut" bindtap="applyStaff" data-id="{{item.id}}"><view class="shortcut-main"><text class="badge">{{item.state}}</text><text class="shortcut-title">{{item.title}}</text><text wx:if="{{item.description}}" class="muted">{{item.description}}</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button></view>
  <view wx:if="{{promotions.length}}" class="section"><view class="section-heading"><text class="section-title">社群推荐</text></view><template is="promotion-cards" data="{{docs:promotions}}" /></view>
  <text wx:if="{{clubLoading}}" class="result-caption">正在读取招新与推荐…</text><view wx:if="{{clubError}}" class="section"><text class="error">{{clubError}}</text><button class="secondary" bindtap="retryClub" disabled="{{clubLoading}}">重试社团信息</button></view>
</view>
