<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/v2.wxml" />
<view wx:if="{{campus}}" class="page mini-page zj-tab-page {{theme === 'dark' ? 'zj-dark' : ''}} {{palette === 'simple' ? 'communities-simple' : ''}}">
  <view class="page-heading {{scene ? 'page-heading-scenic' : ''}}">
    <zj-campus scene="{{scene}}" palette="{{palette}}" />
    <text class="eyebrow">{{t.eyebrow}}</text>
    <text class="title">{{t.title}}</text>
    <text class="subtitle">{{t.subtitle}}</text>
  </view>
  <template wx:if="{{!user}}" is="zj-login" data="{{title: t.loginTitle, body: t.loginBody, t}}" />
  <block wx:else>
    <view class="search" role="search">
      <input value="{{input}}" placeholder="{{t.searchPlaceholder}}" confirm-type="search" maxlength="80" bindinput="typing" bindconfirm="search" cursor-spacing="24" aria-label="{{t.searchLabel}}" />
      <button class="primary" bindtap="search">{{t.find}}</button>
    </view>
    <view wx:if="{{q}}" class="row"><text class="result-caption">{{t.resultsPrefix}}{{q}}{{t.resultsMiddle}}{{total}}{{t.resultsSuffix}}</text><button class="plain" bindtap="clear">{{t.allCommunities}}</button></view>
    <template wx:if="{{loading}}" is="zj-loading" data="{{t}}" />
    <template wx:elif="{{error}}" is="zj-error" data="{{error, t}}" />
    <block wx:elif="{{docs.length}}">
      <view class="zj-grid2">
        <view wx:for="{{docs}}" wx:key="key" class="zj-card zj-community" hover-class="zj-pressed" bindtap="openPage" data-page="{{item.page}}" data-params="{{item.params}}" aria-role="link" aria-label="{{item.title}}{{t.communitySuffix}}">
          <view class="zj-cover communities-cover">
            <view class="communities-icon" aria-hidden="true">
              <image wx:if="{{item.coverKey && img[item.coverKey]}}" class="communities-icon-image {{item.defaultIcon ? 'communities-icon-default' : ''}}" src="{{img[item.coverKey]}}" mode="aspectFit" lazy-load binderror="imageError" data-key="{{item.coverKey}}" data-url="{{img[item.coverKey]}}" />
              <text wx:else class="communities-icon-initial">{{item.initial}}</text>
            </view>
          </view>
          <view class="zj-card-body">
            <text class="zj-card-title">{{item.title}}</text>
            <text wx:if="{{item.summary}}" class="zj-card-summary zj-clamp">{{item.summary}}</text>
            <text class="zj-small">{{item.facts}}</text>
            <text wx:if="{{item.officer}}" class="zj-tag zj-tag-accent">{{t.officer}}</text>
          </view>
        </view>
      </view>
      <text wx:if="{{loadMoreError && !loading}}" class="error">{{loadMoreError}}</text>
      <button wx:if="{{hasMore || loadMoreError}}" class="secondary communities-more" bindtap="onReachBottom" disabled="{{loadingMore}}">{{loadingMore ? t.loadingMore : (loadMoreError ? t.retryMore : t.loadMore)}}</button>
    </block>
    <template wx:else is="zj-empty" data="{{title: q ? t.noMatchTitle : t.emptyTitle, body: q ? t.noMatchBody : t.emptyBody, icon: '🎮'}}" />
    <view class="communities-organize">
      <text class="communities-organize-title">{{t.organizeTitle}}</text>
      <text class="zj-small communities-organize-body">{{t.organizeBody}}</text>
      <button class="accent" bindtap="apply">{{t.apply}}</button>
    </view>
  </block>
</view>
