<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/v2.wxml" />
<view class="page mini-page {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="page-heading">
    <text class="eyebrow">COMMUNITIES · 游戏社群</text>
    <text class="title">找到同好，从这里开场</text>
    <text class="subtitle">选择你玩的游戏，看看活动与风采，再联系管理员人工拉你进群。</text>
  </view>
  <template wx:if="{{!user}}" is="zj-login" data="{{title: '登录后查看游戏社群', body: '社群名片与活动仅向社团成员展示。'}}" />
  <block wx:else>
    <view class="search" role="search">
      <input value="{{input}}" placeholder="搜索游戏名称或介绍" confirm-type="search" maxlength="80" bindinput="typing" bindconfirm="search" cursor-spacing="24" aria-label="搜索社群" />
      <button class="primary" bindtap="search">查找</button>
    </view>
    <view wx:if="{{q}}" class="row"><text class="result-caption">“{{q}}”的匹配结果 · {{total}} 个</text><button class="plain" bindtap="clear">全部社群</button></view>
    <template wx:if="{{loading}}" is="zj-loading" />
    <template wx:elif="{{error}}" is="zj-error" data="{{error}}" />
    <block wx:elif="{{docs.length}}">
      <view class="zj-grid2">
        <block wx:for="{{docs}}" wx:key="key"><template is="zj-community" data="{{item, img}}" /></block>
      </view>
      <text wx:if="{{loadMoreError && !loading}}" class="error">{{loadMoreError}}</text>
      <button wx:if="{{hasMore || loadMoreError}}" class="secondary communities-more" bindtap="onReachBottom" disabled="{{loadingMore}}">{{loadingMore ? '加载中…' : (loadMoreError ? '重试加载更多' : '加载更多')}}</button>
    </block>
    <template wx:else is="zj-empty" data="{{title: q ? '没有找到匹配的社群' : '社群正在筹备', body: q ? '换一个游戏名称或关键词试试。' : '想组织新的游戏社群，可以提交组织申请。', icon: '🎮'}}" />
    <view class="communities-organize">
      <text class="communities-organize-title">把热爱的游戏，组织成社群</text>
      <text class="zj-small communities-organize-body">参与已有社群的组织工作，或为还没出现的游戏发起申请。</text>
      <button class="accent" bindtap="apply">申请成为社群管理员</button>
    </view>
  </block>
</view>
