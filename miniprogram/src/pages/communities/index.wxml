<import src="../../templates/common.wxml" />
<view class="page"><text class="eyebrow">FIND YOUR PEOPLE</text><text class="title">加入我们</text><text class="subtitle">选择游戏项目，联系管理员加入对应群聊。</text><template is="feedback" data="{{loading, error, needsLogin}}" /><block wx:if="{{!needsLogin && !error}}"><view wx:for="{{docs}}" wx:key="id" class="section card" bindtap="openCommunity" data-doc="{{item}}"><image wx:if="{{item.coverImage}}" class="card-image" src="{{item.coverImage.url}}" mode="aspectFill" /><view class="card-body"><view class="row"><text class="community-title">{{item.title}}</text><text class="more">↗</text></view><text wx:if="{{item.summary}}" class="subtitle">{{item.summary}}</text><text class="community-hint">联系管理加入群聊 · 活动与通知 · 社群风采</text></view></view><view wx:if="{{!loading && !docs.length}}" class="empty"><text>游戏社群正在准备中</text><text class="muted">已有社群发布后会出现在这里。</text></view><button wx:if="{{hasMore}}" class="plain" bindtap="onReachBottom">加载更多</button><view class="section panel"><text class="section-title">想组织一个游戏社群？</text><text class="subtitle">提交管理员申请，由社团负责人审核。</text><button class="secondary section" bindtap="apply">申请社群管理员 →</button></view></block></view>
