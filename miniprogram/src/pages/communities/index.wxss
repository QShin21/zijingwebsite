.zj-community .communities-cover { height: 240rpx; background: linear-gradient(155deg, var(--z-stage2), var(--z-stage)); }
.communities-icon { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; padding: 4rpx 12rpx; background: radial-gradient(ellipse at center, rgba(255, 255, 255, .14), transparent 70%); }
.communities-simple .communities-icon { background: radial-gradient(ellipse at center, rgba(57, 50, 67, .48), rgba(57, 50, 67, .12) 42%, transparent 72%); }
.communities-icon-image { display: block; width: 100%; height: 100%; filter: drop-shadow(0 0 3rpx rgba(0, 0, 0, .9)) drop-shadow(0 0 3rpx rgba(255, 255, 255, .8)); }
.communities-icon-default { transform: scale(1.4); }
.communities-icon-initial { color: var(--z-stage-ink); font-size: 56rpx; font-weight: 900; }
.mini-page .communities-more { display: block; width: 100%; margin-top: 20rpx; }
.communities-organize { display: flex; flex-direction: column; gap: 14rpx; margin-top: 48rpx; padding: 36rpx 32rpx; border-radius: 40rpx; background: linear-gradient(150deg, var(--z-stage2), var(--z-stage)); color: var(--z-stage-ink); }
.communities-organize-title { font-size: 34rpx; font-weight: 900; }
.communities-organize .communities-organize-body { color: var(--z-stage-muted); }
