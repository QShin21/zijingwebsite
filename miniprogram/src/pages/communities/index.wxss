.mini-page .communities-more { display: block; width: 100%; margin-top: 20rpx; }
.communities-organize { display: flex; flex-direction: column; gap: 14rpx; margin-top: 48rpx; padding: 36rpx 32rpx; border-radius: 40rpx; background: linear-gradient(150deg, var(--z-stage2), var(--z-stage)); color: var(--z-stage-ink); }
.communities-organize-title { font-size: 34rpx; font-weight: 900; }
.communities-organize .communities-organize-body { color: var(--z-stage-muted); }
