/* Page-specific structure; shared native primitives live in app.wxss. */
.title-accent { color: var(--z-brand); }
.community-title { display: block; margin-top: 18rpx; font-size: 36rpx; font-weight: 650; color: var(--z-text); line-height: 1.5; word-break: break-word; }
.community-hint { display: block; margin-top: 26rpx; padding-top: 20rpx; border-top: 1rpx solid var(--z-line); font-size: 23rpx; line-height: 1.8; color: var(--z-muted); }
.community-apply { border-top: 3rpx solid var(--z-positive); }
.mini-page .community-entry { margin-top: 26rpx; }
