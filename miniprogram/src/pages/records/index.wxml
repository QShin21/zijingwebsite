<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/v2.wxml" />
<view class="page mini-page records-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{t.kicker}}</text>
      <text class="zj-hero-title">{{title}}</text>
      <text class="zj-hero-lead">{{hint}}</text>
    </view>
  </view>

  <view wx:if="{{needsLogin}}" class="zj-empty" aria-role="status">
    <text class="zj-empty-title">{{t.loginTitle}}</text>
    <text class="zj-small">{{t.loginBody}}</text>
    <button class="accent" bindtap="login">{{t.loginAction}}</button>
  </view>
  <view wx:elif="{{error}}"><text class="error" aria-role="alert">{{error}}</text><button wx:if="{{mode === 'signups' || campus}}" class="secondary" bindtap="retry">{{t.reload}}</button></view>
  <template wx:elif="{{loading && !docs.length}}" is="zj-loading" data="{{t}}" />
  <block wx:else>
    <view class="zj-section-head records-head"><text class="zj-section-title">{{title}}</text><text wx:if="{{totalDocs}}" class="zj-count">{{totalDocs}}</text></view>
    <view wx:if="{{mode === 'applications' && docs.length}}" class="zj-list"><block wx:for="{{docs}}" wx:key="key"><template is="zj-application" data="{{item, t, archive: true}}" /></block></view>
    <view wx:elif="{{mode === 'signups' && docs.length}}" class="zj-list">
      <view wx:for="{{docs}}" wx:key="key" class="zj-application records-receipt {{item.archived ? 'zj-record-archived' : ''}}" hover-class="{{item.page ? 'zj-pressed' : 'none'}}" bindtap="openReceipt" data-page="{{item.page}}" data-params="{{item.params}}" aria-role="{{item.page ? 'link' : 'text'}}" aria-label="{{item.title}}{{t.listSep}}{{item.statusLabel}}">
        <view class="zj-row">
          <text class="zj-small">{{item.when}}</text>
          <text class="zj-pill zj-pill-{{item.statusTone}}">{{item.statusLabel}}</text>
        </view>
        <text class="zj-card-title">{{item.title}}</text>
        <text class="zj-small">{{t.submittedPrefix}}{{item.submitted}}<block wx:if="{{item.updated}}">{{t.updatedPrefix}}{{item.updated}}</block></text>
        <view wx:if="{{item.archiveTarget}}" class="zj-archive-row">
          <text wx:if="{{item.archived}}" class="zj-archived-tag">{{t.cArchived}}</text>
          <button class="zj-archive" catchtap="setArchive" data-target="{{item.archiveTarget}}" data-archived="{{item.archived}}" disabled="{{item.archiving}}" loading="{{item.archiving}}" aria-label="{{item.archived ? t.cUnarchive : t.cArchive}}{{t.cColon}}{{item.title}}">{{item.archived ? t.cUnarchive : t.cArchive}}</button>
        </view>
      </view>
    </view>
    <template wx:elif="{{mode === 'signups'}}" is="zj-empty" data="{{title: t.noSignups, body: t.noSignupsBody, icon: '🎫', action: t.viewEvents, page: 'events'}}" />
    <template wx:else is="zj-empty" data="{{title: t.noApplications, body: t.noApplicationsBody, icon: '📮'}}" />
    <text wx:if="{{loadMoreError}}" class="error" aria-role="alert">{{loadMoreError}}</text>
    <button wx:if="{{hasMore}}" class="secondary records-more" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">{{loadMoreError ? t.retryMore : t.loadMore}}</button>
    <text wx:if="{{docs.length && !hasMore}}" class="result-caption records-end">{{t.allShown}}</text>
  </block>
</view>
