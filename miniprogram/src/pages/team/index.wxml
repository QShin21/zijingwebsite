<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page team-page"><button class="plain" bindtap="back">返回</button><view class="page-heading"><text class="eyebrow">代表队 · 招新与记录</text><text class="title">代表队招新与我的记录</text><text class="subtitle">由对应社群管理员人工选拔。录取、成员关系、社群任职与平台角色分别维护。</text></view>
  <template is="feedback" data="{{needsLogin}}" />
  <text wx:if="{{busy}}" class="muted">本次确认或保存尚未完成，完成后会核对最新记录。</text>
  <block wx:if="{{!needsLogin}}">
    <view class="actions"><button class="plain" bindtap="applications">我的建队申请 →</button><button wx:if="{{actions.establish}}" class="secondary" bindtap="apply" disabled="{{loading || busy}}">申请建立代表队</button><button wx:if="{{actions.reviewEstablishments}}" class="secondary" bindtap="reviewEstablishments" disabled="{{loading || busy}}">建队申请审核</button></view>
    <scroll-view scroll-x class="chips"><button class="chip {{view === 'recruitments' ? 'active' : ''}}" bindtap="tab" data-view="recruitments" hover-class="pressed">招新批次</button><button class="chip {{view === 'ownApplications' ? 'active' : ''}}" bindtap="tab" data-view="ownApplications" hover-class="pressed">我的入队申请</button><button class="chip {{view === 'memberships' ? 'active' : ''}}" bindtap="tab" data-view="memberships" hover-class="pressed">我的成员记录</button><button class="chip {{view === 'managedTeams' ? 'active' : ''}}" bindtap="tab" data-view="managedTeams" hover-class="pressed">可管理队伍</button></scroll-view>
    <text wx:if="{{loading}}" class="muted">正在读取代表队记录…</text><view wx:if="{{error}}"><text class="error">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">重试读取记录</button></view><text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text><text wx:if="{{done}}" class="body" aria-role="status">{{done}}</text>
    <view class="section-head"><text class="muted">共 {{total}} 条 · 已加载至第 {{page}} 页</text><button class="plain" bindtap="retry" disabled="{{loading || busy}}">刷新</button></view>
    <view wx:for="{{docs}}" wx:key="id" class="record-sheet"><view class="row"><text class="section-title">{{item.title}}</text><text class="badge">{{view === 'recruitments' ? item.state : item.statusText}}</text></view>
      <block wx:if="{{view === 'recruitments'}}"><text wx:if="{{item.startText}}" class="muted">开始：{{item.startText}}</text><text wx:if="{{item.endText}}" class="muted">截止：{{item.endText}}</text><button wx:if="{{item.actions.view}}" class="secondary section" bindtap="openRecruitment" data-id="{{item.id}}" disabled="{{loading || busy}}">{{item.actions.apply ? '查看批次并填写申请' : '查看批次与申请状态'}} →</button></block>
      <block wx:elif="{{view === 'ownApplications'}}"><text class="muted">申请 {{item.id}} · {{item.dateText}}</text><text wx:if="{{item.reviewNote}}" class="body">处理意见：{{item.reviewNote}}</text><button wx:if="{{item.actions.view}}" class="secondary section" bindtap="openRecruitment" data-id="{{item.id}}" data-own="{{true}}" disabled="{{loading || busy}}">{{item.actions.edit ? '查看回执 / 继续修改' : '查看已提交回执'}} →</button><button wx:if="{{item.actions.withdraw}}" class="plain" bindtap="operate" data-operation="withdraw-join" data-id="{{item.id}}" disabled="{{loading || busy}}">撤回入队申请</button></block>
      <block wx:elif="{{view === 'memberships'}}"><text class="muted">成员关系 {{item.id}} · {{item.dateText}}</text><text class="muted">成员记录独立于公开简介及历史阵容。公开展示资料需要另行授权。</text><button wx:if="{{item.actions.leave}}" class="secondary section" bindtap="operate" data-operation="leave" data-id="{{item.id}}" disabled="{{loading || busy}}">办理本人离队</button></block>
      <block wx:else><text class="muted">仅显示你当前可管理的队伍。</text><view class="actions"><button wx:if="{{item.actions.workbench}}" class="secondary" bindtap="workbench" data-id="{{item.id}}" disabled="{{loading || busy}}">队伍工作台 →</button><button wx:if="{{item.actions.workbench}}" class="plain" bindtap="members" data-id="{{item.id}}" disabled="{{loading || busy}}">成员管理 →</button></view></block>
      <view class="actions"><button class="plain" bindtap="teamPage" data-id="{{item.id}}" data-page="team-profiles" disabled="{{loading || busy}}">队员简介 / 我的展示设置 →</button><button class="plain" bindtap="teamPage" data-id="{{item.id}}" data-page="team-honors" disabled="{{loading || busy}}">已核验荣誉档案 →</button><button class="plain" bindtap="teamPage" data-id="{{item.id}}" data-page="team-honor-workspace" disabled="{{loading || busy}}">该队荣誉投稿 / 当前审核入口 →</button></view>
    </view>
    <view wx:if="{{!docs.length && !loading && !error}}" class="empty"><text>{{view === 'recruitments' ? '暂无可查看的招新批次' : view === 'ownApplications' ? '尚未提交入队申请' : view === 'memberships' ? '暂无本人成员关系记录' : '暂无当前可管理队伍'}}</text><text class="muted">可以刷新查看最新状态。</text></view><button wx:if="{{hasMore}}" class="plain section" bindtap="onReachBottom" disabled="{{loading || busy}}" loading="{{loading}}">加载更多</button>
    <button class="secondary section" bindtap="openWebsite" data-url="/teams/honors" disabled="{{loading || busy}}">我的荣誉投稿 / 当前审核入口 →</button>
    <text class="muted section">简介展示由本人另行确认；公开荣誉仅展示服务端已核验内容。投稿和审核入口会核对当前成员关系与授权。</text>
  </block>
</view>
