<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page team-page">
  <button class="plain back" bindtap="back">返回</button><view class="page-heading"><text class="title">代表队招新与记录</text><text class="subtitle">找到想加入的队伍，继续申请，查看自己的成员记录。</text></view>
  <template is="feedback" data="{{needsLogin}}" />
  <text wx:if="{{busy}}" class="notice-inline">本次确认或保存尚未完成，完成后会核对最新记录。</text>
  <block wx:if="{{!needsLogin}}">
    <scroll-view scroll-x class="chips section-tabs"><button class="chip section-tab {{view === 'recruitments' ? 'active' : ''}}" bindtap="tab" data-view="recruitments" disabled="{{busy}}">招新批次</button><button class="chip section-tab {{view === 'ownApplications' ? 'active' : ''}}" bindtap="tab" data-view="ownApplications" disabled="{{busy}}">我的申请</button><button class="chip section-tab {{view === 'memberships' ? 'active' : ''}}" bindtap="tab" data-view="memberships" disabled="{{busy}}">我的队伍</button><button class="chip section-tab {{view === 'managedTeams' ? 'active' : ''}}" bindtap="tab" data-view="managedTeams" disabled="{{busy}}">管理队伍</button></scroll-view>
    <view class="team-view-intro"><text class="section-title">{{view === 'recruitments' ? '选择招新批次' : view === 'ownApplications' ? '查看进度与反馈' : view === 'memberships' ? '本人成员关系' : '当前可管理的队伍'}}</text><text class="field-note">{{view === 'recruitments' ? '先查看队伍条件与时间安排，再填写入队申请。' : view === 'ownApplications' ? '进入回执查看完整作答；允许修改时可继续补充。' : view === 'memberships' ? '公开简介由本人另行确认，历史阵容保留在队伍档案。' : '管理范围由当前社群或队伍任职决定。'}}</text></view>
    <text wx:if="{{loading}}" class="result-caption" aria-role="status">正在读取代表队记录…</text><view wx:if="{{error}}"><text class="error">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">重试读取记录</button></view><text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text><text wx:if="{{done}}" class="notice-inline" aria-role="status">{{done}}</text>
    <view class="section-heading team-result-heading"><text class="muted">共 {{total}} 条，已加载 {{docs.length}} 条</text><button class="more" bindtap="retry" disabled="{{loading || busy}}">刷新</button></view>
    <view class="record-list"><view wx:for="{{docs}}" wx:key="id" class="team-record"><view class="meta-line"><text class="badge">{{view === 'recruitments' ? item.state : item.statusText}}</text><text wx:if="{{view === 'ownApplications'}}">申请 {{item.id}}</text><text wx:if="{{view === 'memberships'}}">成员记录 {{item.id}}</text></view><text class="section-title team-record-title">{{item.title}}</text>
      <block wx:if="{{view === 'recruitments'}}"><view class="recruitment-dates"><view wx:if="{{item.startText}}"><text class="field-note">开始时间</text><text>{{item.startText}}</text></view><view wx:if="{{item.endText}}"><text class="field-note">截止时间</text><text>{{item.endText}}</text></view></view><button wx:if="{{item.actions.view}}" class="primary team-record-action" bindtap="openRecruitment" data-id="{{item.id}}" disabled="{{loading || busy}}">{{item.actions.apply ? '查看条件并申请' : '查看批次与申请状态'}}</button></block>
      <block wx:elif="{{view === 'ownApplications'}}"><text class="field-note">更新于 {{item.dateText}}</text><view wx:if="{{item.reviewNote}}" class="review-feedback"><text class="field-label">处理意见</text><text selectable>{{item.reviewNote}}</text></view><view class="actions"><button wx:if="{{item.actions.view}}" class="primary" bindtap="openRecruitment" data-id="{{item.id}}" data-own="{{true}}" disabled="{{loading || busy}}">{{item.actions.edit ? '查看回执并修改' : '查看已提交回执'}}</button><button wx:if="{{item.actions.withdraw}}" class="plain" bindtap="operate" data-operation="withdraw-join" data-id="{{item.id}}" disabled="{{loading || busy}}">撤回入队申请</button></view></block>
      <block wx:elif="{{view === 'memberships'}}"><text class="field-note">更新于 {{item.dateText}}</text><text class="muted">成员关系与本人公开简介分别维护。</text><button wx:if="{{item.actions.leave}}" class="plain team-record-action" bindtap="operate" data-operation="leave" data-id="{{item.id}}" disabled="{{loading || busy}}">办理本人离队</button></block>
      <block wx:else><view class="actions"><button wx:if="{{item.actions.workbench}}" class="primary" bindtap="workbench" data-id="{{item.id}}" disabled="{{loading || busy}}">队伍工作台</button><button wx:if="{{item.actions.workbench}}" class="secondary" bindtap="members" data-id="{{item.id}}" disabled="{{loading || busy}}">成员管理</button></view></block>
      <button class="plain record-disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy}}" aria-label="{{expandedRecord === item.id ? '收起队伍资料与荣誉入口' : '展开队伍资料与荣誉入口'}}">队伍资料与荣誉 {{expandedRecord === item.id ? '−' : '+'}}</button><view wx:if="{{expandedRecord === item.id}}" class="team-record-links"><button class="plain" bindtap="teamPage" data-id="{{item.id}}" data-page="team-profiles" disabled="{{loading || busy}}">公开简介与我的展示设置</button><button class="plain" bindtap="teamPage" data-id="{{item.id}}" data-page="team-honors" disabled="{{loading || busy}}">已核验荣誉档案</button><button class="plain" bindtap="teamPage" data-id="{{item.id}}" data-page="team-honor-workspace" disabled="{{loading || busy}}">该队荣誉投稿与审核</button></view>
    </view></view>
    <view wx:if="{{!docs.length && !loading && !error}}" class="empty"><text class="state-title">{{view === 'recruitments' ? '暂无可查看的招新批次' : view === 'ownApplications' ? '尚未提交入队申请' : view === 'memberships' ? '暂无本人成员关系记录' : '暂无当前可管理队伍'}}</text><text class="muted">{{view === 'ownApplications' ? '可在招新批次中了解队伍，选择合适的批次申请。' : '下拉刷新可查看最新记录。'}}</text><button wx:if="{{view === 'ownApplications'}}" class="secondary" bindtap="tab" data-view="recruitments">查看招新批次</button></view><button wx:if="{{hasMore}}" class="secondary section" bindtap="onReachBottom" disabled="{{loading || busy}}" loading="{{loading}}">加载更多</button>
    <view class="section team-organization"><view class="section-heading"><text class="section-title">组织与建队</text></view><view class="actions"><button class="plain" bindtap="applications">我的建队申请</button><button wx:if="{{actions.establish}}" class="secondary" bindtap="apply" disabled="{{loading || busy}}">申请建立代表队</button><button wx:if="{{actions.reviewEstablishments}}" class="secondary" bindtap="reviewEstablishments" disabled="{{loading || busy}}">建队申请审核</button></view><button class="plain" bindtap="openWebsite" data-url="/teams/honors" disabled="{{loading || busy}}">我的荣誉投稿与当前审核入口</button></view>
    <text class="bottom-note">入队录取与成员关系分别记录。社群任职、平台角色及简介公开授权由各自流程维护。</text>
  </block>
</view>
