/* V2 team affairs: scrollable tabs, record cards with date chips, stage organization block. */
.team-v2 { padding-top: 0; }
.team-tabs { width: 100%; white-space: nowrap; margin-bottom: 12rpx; }
.team-tabs-inner { display: inline-flex; gap: 12rpx; padding: 4rpx 0 8rpx; }
.mini-page .team-tab { flex-shrink: 0; padding: 14rpx 28rpx; border: 3rpx solid var(--z-line); border-radius: 999rpx; background: var(--z-surface); color: var(--z-muted); font-size: 26rpx; font-weight: 800; }
.mini-page .team-tab.active { border-color: var(--z-text); background: var(--z-text); color: var(--z-page); }
.team-intro { display: flex; flex-direction: column; gap: 6rpx; margin: 16rpx 0 8rpx; }
.team-result { margin-top: 12rpx; }
.team-dates { display: flex; gap: 12rpx; }
.team-date { flex: 1; display: flex; flex-direction: column; gap: 4rpx; padding: 14rpx 18rpx; border-radius: 20rpx; background: var(--z-stage); color: var(--z-stage-ink); }
.team-date-end { border-top: 6rpx solid var(--z-accent); }
.team-date-label { color: var(--z-accent); font-size: 22rpx; font-weight: 900; }
.team-date-value { font-size: 26rpx; font-weight: 800; }
.team-label { display: block; font-weight: 900; }
.mini-page .team-wide { display: block; width: 100%; margin-top: 8rpx; }
.mini-page .team-disclosure { display: flex; justify-content: space-between; width: 100%; padding: 10rpx 0; }
.team-links { display: flex; flex-direction: column; gap: 12rpx; }
.team-organization { display: flex; flex-direction: column; gap: 12rpx; margin-top: 40rpx; padding: 32rpx; border-radius: 40rpx; background: repeating-linear-gradient(115deg, transparent 0, transparent 22rpx, rgba(255, 255, 255, .03) 22rpx, rgba(255, 255, 255, .03) 44rpx), linear-gradient(150deg, var(--z-stage2), var(--z-stage)); color: var(--z-stage-ink); }
.team-organization-title { color: var(--z-stage-ink); }
.team-organization-note { color: var(--z-stage-muted); font-size: 25rpx; }
.team-organization-actions { display: flex; flex-direction: column; gap: 12rpx; }
