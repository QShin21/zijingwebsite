@import "../../templates/business.wxss";
@import "../../styles/native-forms.wxss";

/* V2 team members: member cards with tenure chips and a guarded revoke panel. */
.team-members-v2 { padding-top: 0; }
.members-label { display: block; font-weight: 900; }
.members-who { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; }
.members-avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 72rpx; height: 72rpx; border-radius: 50%; background: linear-gradient(135deg, var(--z-primary), var(--z-stage2)); color: #fff; font-size: 30rpx; font-weight: 900; }
.members-dates { display: flex; gap: 12rpx; }
.members-date { flex: 1; display: flex; flex-direction: column; gap: 4rpx; padding: 12rpx 16rpx; border-radius: 18rpx; background: var(--z-raised); border: 1rpx solid var(--z-line); font-size: 25rpx; font-weight: 800; }
.members-date-label { color: var(--z-primary); font-size: 21rpx; font-weight: 900; }
.mini-page .members-disclosure { display: flex; justify-content: space-between; width: 100%; padding: 10rpx 0; }
.members-revoke { display: flex; flex-direction: column; gap: 8rpx; padding: 24rpx; border: 1rpx solid var(--z-danger-line); border-radius: 24rpx; background: var(--z-danger-bg); }
.mini-page .members-more { display: block; width: 100%; margin-top: 16rpx; }
