<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page team-members-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{teamDoc.title || t.currentTeam}}{{t.kickerSuffix}}</text>
      <text class="zj-hero-title">{{t.title}}</text>
      <text class="zj-hero-lead">{{t.lead}}</text>
    </view>
  </view>
  <template is="feedback" data="{{needsLogin,t}}" />
  <text wx:if="{{busy}}" class="zj-callout" aria-role="status">{{t.busyNote}}</text>
  <view wx:if="{{loading}}" class="zj-skeleton" aria-role="status" aria-label="{{t.checking}}"><view wx:if="{{!allowed}}" class="zj-skeleton-row"><view class="zj-skeleton-date"></view><view class="zj-skeleton-lines"><view></view><view></view><view></view></view></view></view>
  <view wx:if="{{error}}" class="zj-alert"><text class="zj-small" aria-role="alert">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">{{t.retryRead}}</button></view>
  <text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text>
  <text wx:if="{{done}}" class="zj-callout zj-callout-success" aria-role="status">{{done}}</text>
  <view wx:if="{{!needsLogin && !loading && !error && !allowed}}" class="zj-empty"><text class="zj-empty-icon">🔒</text><text class="zj-empty-title">{{t.noAccessTitle}}</text><text class="zj-small">{{t.noAccessBody}}</text><button class="secondary" bindtap="retry" disabled="{{busy}}">{{t.recheck}}</button></view>
  <block wx:if="{{allowed && !needsLogin}}">
    <view class="zj-callout"><text class="members-label">{{t.basisLabel}}</text><text>{{t.basisBody}}</text></view>
    <view class="zj-section-head"><text class="zj-section-title">{{t.records}}</text><button class="plain zj-more" bindtap="retry" disabled="{{loading || busy}}">{{t.refresh}}</button></view>
    <view wx:for="{{docs}}" wx:key="id" class="zj-record members-record">
      <view class="zj-record-head">
        <view class="members-who"><text class="members-avatar">{{item.title[0]}}</text><text class="zj-record-title">{{item.title}}</text></view>
        <text class="zj-pill zj-pill-action">{{item.statusText}}</text>
      </view>
      <text class="zj-small">{{t.relationPrefix}}{{item.id}}</text>
      <view class="members-dates"><view wx:if="{{item.joinedText}}" class="members-date"><text class="members-date-label">{{t.joined}}</text><text>{{item.joinedText}}</text></view><view wx:if="{{item.endText}}" class="members-date"><text class="members-date-label">{{t.ended}}</text><text>{{item.endText}}</text></view></view>
      <block wx:if="{{item.actions.revoke}}">
        <button class="plain members-disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? t.hideHandling : t.showHandling}}</text><text>{{expandedId === item.id ? '−' : '＋'}}</text></button>
        <view wx:if="{{expandedId === item.id}}" class="members-revoke">
          <text class="zj-sheet-title">{{t.revokeTitle}}</text>
          <text class="zj-form-hint">{{t.revokeHint}}</text>
          <view class="field"><text class="field-label">{{t.reasonLabel}}</text><textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{item.noteDraft}}" bindinput="note" data-id="{{item.id}}" maxlength="1000" placeholder="{{t.reasonPlaceholder}}" disabled="{{busy}}" /><text class="zj-form-hint">{{t.reasonHint}}</text></view>
          <button class="danger" bindtap="revoke" data-id="{{item.id}}" disabled="{{loading || busy}}">{{t.revokeTitle}}</button>
        </view>
      </block>
      <text wx:else class="zj-form-hint">{{t.noAction}}</text>
    </view>
    <view wx:if="{{!docs.length && !loading && !error}}" class="zj-empty"><text class="zj-empty-icon">👥</text><text class="zj-empty-title">{{t.emptyTitle}}</text><text class="zj-small">{{t.emptyBody}}</text></view>
    <button wx:if="{{hasMore}}" class="secondary members-more" bindtap="onReachBottom" disabled="{{loading || busy}}">{{t.loadMore}}</button>
  </block>
</view>
