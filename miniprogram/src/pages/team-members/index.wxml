<import src="../../templates/common.wxml" />
<view class="page"><button class="plain" bindtap="back">返回工作台</button><text class="eyebrow">TEAM MEMBERSHIP</text><text class="title">队伍成员关系管理</text><text class="subtitle">{{teamDoc.title || '当前队伍'}} · 仅根据已批准的队伍成员关系处理。公开简介与历史阵容不能代表当前成员资格。</text><template is="feedback" data="{{needsLogin}}" />
  <text wx:if="{{busy}}" class="muted">本次确认或保存尚未完成，完成后会核对最新记录。</text><text wx:if="{{loading}}" class="muted">正在核对管理权限与成员记录…</text><view wx:if="{{error}}"><text class="error">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">重试读取记录</button></view><text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text><text wx:if="{{done}}" class="body" aria-role="status">{{done}}</text>
  <view wx:if="{{!needsLogin && !loading && !error && !allowed}}" class="empty"><text>当前暂无此队伍的成员管理权限</text><button class="secondary" bindtap="retry">重新核对权限</button></view>
  <block wx:if="{{allowed && !needsLogin}}"><button class="plain" bindtap="retry" disabled="{{loading || busy}}">刷新成员记录</button><view wx:for="{{docs}}" wx:key="id" class="panel section"><view class="row"><text class="section-title">{{item.title}}</text><text class="badge">{{item.statusText}}</text></view><text class="muted">成员关系编号 {{item.id}}</text><text wx:if="{{item.joinedText}}" class="muted">入队时间：{{item.joinedText}}</text><text wx:if="{{item.endText}}" class="muted">关系结束时间：{{item.endText}}</text><view wx:if="{{item.actions.revoke}}" class="field"><text class="field-label">撤销原因</text><textarea value="{{item.noteDraft}}" bindinput="note" data-id="{{item.id}}" maxlength="1000" placeholder="请填写具体原因，最多 1000 字" disabled="{{busy}}" /></view><button wx:if="{{item.actions.revoke}}" class="danger section" bindtap="revoke" data-id="{{item.id}}" disabled="{{loading || busy}}">撤销本队成员关系</button><text wx:else class="muted">当前暂无可执行撤销操作。</text></view><view wx:if="{{!docs.length && !loading && !error}}" class="empty"><text>暂无本队成员关系记录</text><text class="muted">录取申请后会产生对应成员记录。</text></view><button wx:if="{{hasMore}}" class="plain section" bindtap="onReachBottom" disabled="{{loading || busy}}">加载更多成员记录</button></block>
</view>
