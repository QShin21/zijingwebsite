<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page business-page team-members-page">
  <button class="plain back" bindtap="back">返回工作台</button><view class="page-heading"><text class="task-context">{{teamDoc.title || '当前队伍'}}</text><text class="title">成员关系管理</text><text class="subtitle">查看当前成员与历史关系，依据实际情况记录撤销原因。</text></view><template is="feedback" data="{{needsLogin}}" />
  <text wx:if="{{busy}}" class="muted">本次确认或保存尚未完成，完成后会核对最新记录。</text><text wx:if="{{loading}}" class="muted">正在核对管理权限与成员记录…</text><view wx:if="{{error}}"><text class="error">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">重试读取记录</button></view><text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text><text wx:if="{{done}}" class="result-message" aria-role="status">{{done}}</text>
  <view wx:if="{{!needsLogin && !loading && !error && !allowed}}" class="empty"><text class="state-title">当前暂无此队伍的成员管理权限</text><button class="secondary" bindtap="retry">重新核对权限</button></view>
  <block wx:if="{{allowed && !needsLogin}}">
    <view class="business-summary"><text class="section-title">以成员关系记录为准</text><text class="muted">公开简介与历史阵容不代表当前资格。撤销后保留历史记录，仅限现任队员的权限随之停止。</text></view><view class="section-head"><text class="section-title">成员记录</text><button class="plain" bindtap="retry" disabled="{{loading || busy}}">刷新核对</button></view>
    <view class="record-list"><view wx:for="{{docs}}" wx:key="id" class="task-record"><view class="record-heading"><view><text class="section-title">{{item.title}}</text><view class="record-meta"><text>关系 {{item.id}}</text></view></view><text class="badge">{{item.statusText}}</text></view><view class="membership-dates"><view wx:if="{{item.joinedText}}"><text class="muted">入队</text><text>{{item.joinedText}}</text></view><view wx:if="{{item.endText}}"><text class="muted">关系结束</text><text>{{item.endText}}</text></view></view>
      <block wx:if="{{item.actions.revoke}}"><button class="plain disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? '收起关系处理' : '处理这条成员关系'}}</text><text>{{expandedId === item.id ? '−' : '＋'}}</text></button><view wx:if="{{expandedId === item.id}}" class="review-actions membership-revoke"><text class="section-title">撤销本队成员关系</text><text class="muted">记录会保留。微信群成员情况需另行联系管理员处理。</text><view class="field"><text class="field-label">具体撤销原因 · 必填</text><textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{item.noteDraft}}" bindinput="note" data-id="{{item.id}}" maxlength="1000" placeholder="请说明需要撤销的具体原因，最多 1000 字" disabled="{{busy}}" /></view><button class="danger" bindtap="revoke" data-id="{{item.id}}" disabled="{{loading || busy}}">撤销本队成员关系</button></view></block><text wx:else class="task-note">当前暂无可执行撤销操作。</text>
    </view></view><view wx:if="{{!docs.length && !loading && !error}}" class="empty"><text class="state-title">暂无本队成员关系记录</text><text class="muted">录取申请后会产生对应成员记录。</text></view><button wx:if="{{hasMore}}" class="plain" bindtap="onReachBottom" disabled="{{loading || busy}}">加载更多成员记录</button>
  </block>
</view>
