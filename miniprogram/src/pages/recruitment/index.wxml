<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/v2.wxml" />
<view class="page mini-page {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="page-heading {{scene ? 'page-heading-scenic' : ''}}">
    <zj-campus scene="{{scene}}" palette="{{palette}}" />
    <text class="eyebrow">{{t.eyebrow}}</text>
    <text class="title">{{t.title}}</text>
    <text class="subtitle">{{t.subtitle}}</text>
  </view>
  <template wx:if="{{loading}}" is="zj-loading" data="{{t: t}}" />
  <template wx:elif="{{error}}" is="zj-error" data="{{error, t}}" />
  <block wx:else>
    <view class="zj-section">
      <template is="zj-section" data="{{title: t.staffTitle, count: staff.length}}" />
      <view wx:if="{{staff.length}}" class="zj-list"><block wx:for="{{staff}}" wx:key="key"><template is="zj-call" data="{{item, t}}" /></block></view>
      <template wx:else is="zj-empty" data="{{title: t.staffEmptyTitle, body: t.staffEmptyBody, icon: '🚩'}}" />
    </view>
    <view class="zj-section">
      <template is="zj-section" data="{{title: t.callsTitle, count: calls.length}}" />
      <template wx:if="{{!user}}" is="zj-login" data="{{title: t.callsLoginTitle, body: t.callsLoginBody, t}}" />
      <view wx:elif="{{calls.length}}" class="zj-list"><block wx:for="{{calls}}" wx:key="key"><template is="zj-call" data="{{item, t}}" /></block></view>
      <template wx:else is="zj-empty" data="{{title: t.callsEmptyTitle, body: t.callsEmptyBody, icon: '🏆', action: t.browseTeams, page: 'teams'}}" />
    </view>
    <view wx:if="{{mine.length}}" class="zj-section">
      <template is="zj-section" data="{{title: t.mineTitle}}" />
      <view class="zj-list"><block wx:for="{{mine}}" wx:key="key"><template is="zj-application" data="{{item, t}}" /></block></view>
    </view>
    <view class="recruitment-tools">
      <button wx:if="{{user}}" class="secondary" bindtap="workspace">{{t.workspace}}</button>
      <button class="secondary" bindtap="staffPage">{{t.staffPage}}</button>
    </view>
  </block>
</view>
