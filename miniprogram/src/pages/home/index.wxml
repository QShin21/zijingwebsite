<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<import src="../../templates/club.wxml" />
<view class="page mini-page home-page">
  <view class="masthead"><view><text class="brand-name">竞在紫荆</text><text class="brand-sub">ZIJING ESPORTS</text></view><text class="masthead-note">清华校园 · 电竞社群</text></view>
  <view class="home-cover">
    <text class="eyebrow">紫荆主场</text><text class="hero-title">{{site.heroTitle || '同场相逢，\n并肩而行。'}}</text>
    <text class="hero-description">{{site.heroSubtitle || '从一场活动、一个社群开始，记录属于我们的赛场与日常。'}}</text>
    <image wx:if="{{hero}}" class="hero-image" src="{{hero.url}}" mode="aspectFill" aria-label="{{hero.alt || site.heroTitle}}" />
    <view class="cover-actions"><button class="primary" bindtap="openPage" data-page="events">查看活动 →</button><button class="plain" bindtap="{{user ? 'openPage' : 'login'}}" data-page="communities">{{user ? '找到你的社群 →' : '登录，加入社群 →'}}</button></view>
    <text wx:if="{{!user}}" class="muted cover-note">活动与通知可直接浏览。</text>
  </view>
  <template is="feedback" data="{{loading, error}}" />
  <block wx:if="{{!loading && !error}}">
    <view wx:if="{{announcements.length}}" class="section notice-desk"><view class="section-head"><text class="section-title">社团公告</text><button class="more" bindtap="openModule" data-kind="announcements">全部 →</button></view><button wx:for="{{announcements}}" wx:key="id" class="content-link notice-row" bindtap="openContent" data-doc="{{item}}"><text class="notice-date">{{item.dateText}}</text><text class="notice-title">{{item.title}}</text><text class="directory-arrow">→</text></button></view>
    <view wx:for="{{modules}}" wx:key="kind" class="section home-module"><view class="section-head"><text class="section-title">{{item.title}}</text><button class="more" bindtap="openModule" data-kind="{{item.kind}}">全部 →</button></view><view wx:if="{{item.error}}" class="error">{{item.error}}</view><template wx:else is="cards" data="{{docs:item.docs, label:item.title}}" /></view>
    <view wx:if="{{showJoin}}" class="section home-directory"><text class="section-kicker">从这里参与</text><text class="section-title">找到适合你的入口</text><button class="content-link directory-row" bindtap="openWebsite" data-url="/join/members"><text class="directory-index">01</text><view class="directory-main"><text class="directory-title">游戏社群</text><text class="muted">联系管理员，人工加入微信群。</text></view><text class="directory-arrow">→</text></button><button class="content-link directory-row" bindtap="openWebsite" data-url="/join/teams"><text class="directory-index">02</text><view class="directory-main"><text class="directory-title">代表队选拔</text><text class="muted">查看招新批次、申请与成员记录。</text></view><text class="directory-arrow">→</text></button><button class="content-link directory-row" bindtap="openWebsite" data-url="/join/staff"><text class="directory-index">03</text><view class="directory-main"><text class="directory-title">骨干招新</text><text class="muted">参与执行部与宣传部的社团工作。</text></view><text class="directory-arrow">→</text></button></view>
    <template is="staff-batches" data="{{batches:staffBatches}}" />
    <view wx:if="{{clubError}}" class="section"><text class="error">{{clubError}}</text><button class="plain" bindtap="retryClub">重试骨干与社团展示入口</button></view>
    <view wx:if="{{promotions.event.length}}" class="section"><text class="section-title">社群活动 · 社团推荐</text><template is="promotion-cards" data="{{docs:promotions.event}}" /></view>
    <view wx:if="{{promotions.notice.length}}" class="section"><text class="section-title">社群通知 · 社团展示</text><template is="promotion-cards" data="{{docs:promotions.notice}}" /></view>
    <view wx:if="{{promotions.showcase.length}}" class="section"><text class="section-title">社群风采 · 社团展示</text><template is="promotion-cards" data="{{docs:promotions.showcase}}" /></view>
    <view wx:if="{{showAbout}}" class="section about-brief"><text class="section-kicker">关于紫荆</text><text class="section-title">{{site.name}}</text><text wx:if="{{site.description}}" class="body">{{site.description}}</text><button class="plain" bindtap="openWebsite" data-url="/about">了解社团 →</button></view>
    <view wx:if="{{site.navigation.length}}" class="section"><button wx:for="{{site.navigation}}" wx:key="path" class="content-link directory-row" bindtap="openWebsite" data-url="{{item.path}}"><text class="directory-main">{{item.label}}</text><text class="directory-arrow">→</text></button></view>
    <text class="bottom-note">{{site.footer || site.name || '竞在紫荆'}}</text>
  </block>
</view>
