<import src="../../templates/common.wxml" />
<view class="page">
  <view class="brand"><view class="brand-mark">Z</view><view><text class="brand-name">紫荆电竞社</text><text class="brand-sub">ZIJING ESPORTS</text></view></view>
  <view class="hero"><text class="eyebrow">{{user ? 'WELCOME BACK' : 'HELLO, ZIJING'}}</text><text class="hero-title">{{site.heroTitle || '因热爱相遇。'}}</text><text wx:if="{{site.heroSubtitle}}" class="hero-description">{{site.heroSubtitle}}</text><image wx:if="{{hero}}" class="hero-image" src="{{hero.url}}" mode="aspectFill" /><button class="primary hero-button" bindtap="{{user ? 'openWebsite' : 'login'}}" data-url="{{site.heroButtonURL}}">{{user ? site.heroButtonLabel : '登录，加入你的社群'}} <text>↗</text></button><text wx:if="{{!user}}" class="hero-hint">活动与通知可直接浏览</text></view>
  <template is="feedback" data="{{loading, error}}" />
  <block wx:if="{{!loading && !error}}">
    <view wx:if="{{announcements.length}}" class="section"><view class="section-head"><text class="section-title">社团通知</text><text class="more" bindtap="openModule" data-kind="announcements">全部 →</text></view><view wx:for="{{announcements}}" wx:key="id" class="notice panel" bindtap="openContent" data-doc="{{item}}"><text class="badge">通知</text><text class="notice-title">{{item.title}}</text><text class="muted">{{item.dateText}} →</text></view></view>
    <view wx:if="{{showJoin}}" class="section"><view class="section-head"><text class="section-title">一起，写下一段故事</text></view><view class="join-grid"><view class="join-item" bindtap="openWebsite" data-url="/join/members"><text>01</text><text class="join-title">普通社员</text><text class="muted">找到同样热爱的伙伴 ↗</text></view><view class="join-item" bindtap="openWebsite" data-url="/join/teams"><text>02</text><text class="join-title">代表队选拔</text><text class="muted">并肩走向赛场 ↗</text></view><view class="join-item" bindtap="openWebsite" data-url="/join/staff"><text>03</text><text class="join-title">骨干招新</text><text class="muted">让每一场活动发生 ↗</text></view></view></view>
    <view wx:for="{{modules}}" wx:key="kind" class="section"><view class="section-head"><text class="section-title">{{item.title}}</text><text class="more" bindtap="openModule" data-kind="{{item.kind}}">全部 →</text></view><view wx:if="{{item.error}}" class="error">{{item.error}}</view><template wx:else is="cards" data="{{docs:item.docs, label:item.title}}" /></view>
    <view wx:if="{{showAbout}}" class="section panel"><text class="eyebrow">ABOUT US</text><text class="section-title">{{site.name}}</text><text wx:if="{{site.description}}" class="subtitle">{{site.description}}</text><button class="plain" bindtap="openWebsite" data-url="/about">了解紫荆 →</button></view>
    <view wx:if="{{site.navigation.length}}" class="section"><view wx:for="{{site.navigation}}" wx:key="path" class="nav-row" bindtap="openWebsite" data-url="{{item.path}}"><text>{{item.label}}</text><text>→</text></view></view>
    <text class="bottom-note">{{site.footer || site.name}}</text>
  </block>
</view>
