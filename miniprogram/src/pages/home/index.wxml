<page-meta page-style="{{themePageStyle}}" />
<template name="visual-promotions">
  <button wx:for="{{docs}}" wx:key="sourceKey" class="panel section content-link" bindtap="openWebsite" data-url="{{item.href}}" hover-class="pressed"><text class="badge">已审批社团展示</text><text class="muted">来自 {{item.gameTitle}}</text><text class="card-title">{{item.snapshot.title}}</text><text class="card-summary">{{item.snapshot.body}}</text><text class="more">查看原社群内容 →</text></button>
</template>

<template name="visual-cards">
  <button wx:for="{{docs}}" wx:key="id" class="card content-link" bindtap="openContent" data-doc="{{item}}" hover-class="pressed">
    <image wx:if="{{item.coverImage}}" class="card-image" src="{{item.coverImage.url}}" mode="aspectFill" aria-label="{{item.coverImage.alt}}" />
    <view class="card-body"><view class="meta"><text>{{item.kindText || label}}</text><text wx:if="{{item.statusText}}" class="badge">{{item.statusText}}</text><text wx:if="{{item.demo}}" class="badge">演示资料</text></view><text class="card-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="card-summary">{{item.summary}}</text><view class="meta card-footer"><text>{{item.dateText}}</text><text>{{item.location || '查看详情 →'}}</text></view></view>
  </button>
  <view wx:if="{{!docs.length}}" class="empty"><text>内容正在准备中</text><text class="muted">新内容发布后会出现在这里。</text></view>
</template>

<import src="../../templates/common.wxml" />
<import src="../../templates/club.wxml" />
<view class="page mini-page home-page">
  <view class="brand"><view class="brand-mark" aria-hidden="true">Z</view><view><text class="brand-name">竞在紫荆</text><text class="brand-sub">ZIJING ESPORTS</text></view><text class="brand-label">校园电竞</text></view>
  <view class="hero">
    <view class="hero-top"><text class="eyebrow">{{user ? 'WELCOME BACK' : 'MEET AT ZIJING'}}</text><text class="hero-signal" aria-hidden="true">＋</text></view>
    <text class="hero-title">{{site.heroTitle || '因热爱相遇。'}}</text>
    <text wx:if="{{site.heroSubtitle}}" class="hero-description">{{site.heroSubtitle}}</text>
    <view wx:if="{{hero}}" class="hero-media"><image class="hero-image" src="{{hero.url}}" mode="aspectFill" aria-label="{{hero.alt || site.heroTitle}}" /><view class="hero-media-shade" aria-hidden="true"></view></view>
    <image wx:else class="hero-image hero-stage" src="{{theme === 'dark' ? '/assets/zijing-stage.webp' : '/assets/zijing-stage-light.webp'}}" mode="aspectFill" aria-label="紫荆原创主视觉" />
    <button class="primary hero-button" bindtap="{{user ? 'openWebsite' : 'login'}}" data-url="{{site.heroButtonURL}}" disabled="{{loading || !!error}}" hover-class="pressed"><text>{{user ? (site.heroButtonLabel || '继续探索紫荆') : '登录，加入你的社群'}}</text><text aria-hidden="true">↗</text></button>
    <text wx:if="{{!user}}" class="hero-hint">活动与通知可直接浏览</text>
  </view>
  <template is="feedback" data="{{loading, error}}" />
  <block wx:if="{{!loading && !error}}">
    <template is="staff-batches" data="{{batches:staffBatches}}" />
    <view wx:if="{{clubError}}" class="section panel"><text class="error">{{clubError}}</text><button class="plain" bindtap="retryClub">重试骨干与社团展示入口</button></view>
    <view wx:if="{{promotions.event.length}}" class="section"><text class="section-title">社群活动 · 社团推荐</text><template is="visual-promotions" data="{{docs:promotions.event}}" /></view>
    <view wx:if="{{promotions.notice.length}}" class="section"><text class="section-title">社群通知 · 社团展示</text><template is="visual-promotions" data="{{docs:promotions.notice}}" /></view>
    <view wx:if="{{promotions.showcase.length}}" class="section"><text class="section-title">社群风采 · 社团展示</text><template is="visual-promotions" data="{{docs:promotions.showcase}}" /></view>
    <view wx:if="{{announcements.length}}" class="section"><view class="section-head"><text class="section-title">社团通知</text><button class="more" bindtap="openModule" data-kind="announcements" hover-class="pressed">全部 →</button></view><button wx:for="{{announcements}}" wx:key="id" class="notice panel content-link" bindtap="openContent" data-doc="{{item}}" hover-class="pressed"><text class="badge">通知</text><text class="notice-title">{{item.title}}</text><text class="muted">{{item.dateText}} →</text></button></view>
    <view wx:if="{{showJoin}}" class="section"><view class="section-head"><text class="section-title">一起，写下一段故事</text></view><view class="join-grid"><button class="join-item content-link" bindtap="openWebsite" data-url="/join/members" hover-class="pressed"><text>01</text><text class="join-title">普通社员</text><text class="muted">找到同样热爱的伙伴 ↗</text></button><button class="join-item content-link" bindtap="openWebsite" data-url="/join/teams" hover-class="pressed"><text>02</text><text class="join-title">代表队选拔</text><text class="muted">并肩走向赛场 ↗</text></button><button class="join-item content-link" bindtap="openWebsite" data-url="/join/staff" hover-class="pressed"><text>03</text><text class="join-title">骨干招新</text><text class="muted">让每一场活动发生 ↗</text></button></view></view>
    <view wx:for="{{modules}}" wx:key="kind" class="section"><view class="section-head"><text class="section-title">{{item.title}}</text><button class="more" bindtap="openModule" data-kind="{{item.kind}}" hover-class="pressed">全部 →</button></view><view wx:if="{{item.error}}" class="error">{{item.error}}</view><template wx:else is="visual-cards" data="{{docs:item.docs, label:item.title}}" /></view>
    <view wx:if="{{showAbout}}" class="section panel"><text class="eyebrow">ABOUT US</text><text class="section-title">{{site.name}}</text><text wx:if="{{site.description}}" class="subtitle">{{site.description}}</text><button class="plain" bindtap="openWebsite" data-url="/about">了解紫荆 →</button></view>
    <view wx:if="{{site.navigation.length}}" class="section"><button wx:for="{{site.navigation}}" wx:key="path" class="nav-row content-link" bindtap="openWebsite" data-url="{{item.path}}" hover-class="pressed"><text>{{item.label}}</text><text>→</text></button></view>
    <text class="bottom-note">{{site.footer || site.name}}</text>
  </block>
</view>
