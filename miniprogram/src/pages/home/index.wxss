.masthead { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding-bottom: 28rpx; border-bottom: 1rpx solid var(--z-line); }
.brand-name { display: block; font-size: 31rpx; line-height: 1.4; font-weight: 700; }
.brand-sub { display: block; font-size: 17rpx; letter-spacing: 2rpx; color: var(--z-muted); margin-top: 8rpx; }
.masthead-note { font-size: 23rpx; color: var(--z-muted); text-align: right; }
.home-cover { padding: 44rpx 0 34rpx; border-bottom: 2rpx solid var(--z-text); }
.hero-title { display: block; font-size: 72rpx; letter-spacing: -2rpx; line-height: 1.23; font-weight: 700; white-space: pre-line; word-break: break-word; }
.hero-description { display: block; font-size: 29rpx; color: var(--z-subtitle); line-height: 1.9; margin: 28rpx 0; max-width: 32em; }
.hero-image { display: block; width: 100%; height: 340rpx; margin: 28rpx 0; border-radius: 12rpx; }
.cover-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; margin-top: 28rpx; }
.cover-actions > button { flex: 1; min-width: 220rpx; }
.cover-note { font-size: 25rpx; margin-top: 14rpx; }
.notice-desk { padding-top: 8rpx; }
.mini-page .notice-row { display: flex; align-items: flex-start; gap: 20rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--z-line); }
.notice-date { flex-shrink: 0; max-width: 145rpx; color: var(--z-muted); font-size: 23rpx; line-height: 1.85; }
.notice-title { flex: 1; min-width: 0; font-size: 29rpx; line-height: 1.7; }
.home-module > .section-head, .home-directory, .about-brief { border-top: 1rpx solid var(--z-line); padding-top: 30rpx; }
.home-module .card:last-child { border-bottom: 0; }
@media (min-width: 600px) { .hero-title { font-size: 48px; } .hero-description { font-size: 18px; } }
