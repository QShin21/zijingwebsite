.brand { display: flex; align-items: center; gap: 18rpx; margin: 10rpx 0 42rpx; }
.brand-mark { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; background: #6536a6; color: #fff; border-radius: 24rpx; font-size: 48rpx; font-style: italic; font-weight: 800; }
.brand-name { display: block; font-size: 30rpx; font-weight: 650; }
.brand-sub { display: block; font-size: 18rpx; letter-spacing: 3rpx; color: #82758e; margin-top: 7rpx; }
.hero { background: #f0e7fa; border-radius: 32rpx; padding: 48rpx 34rpx 35rpx; }
.hero-title { display: block; font-size: 64rpx; line-height: 1.3; font-weight: 750; color: #38214f; }
.hero-description { display: block; color: #7d638f; font-size: 28rpx; line-height: 1.8; margin-top: 24rpx; }
.hero-button { margin-top: 36rpx; display: flex; justify-content: space-between; }
.hero-hint { display: block; margin-top: 22rpx; font-size: 23rpx; color: #826793; }
.hero-image { width: 100%; height: 290rpx; border-radius: 18rpx; margin-top: 24rpx; }
.notice { margin-bottom: 16rpx; }
.notice-title { display: block; font-size: 30rpx; font-weight: 600; margin: 20rpx 0 12rpx; }
.join-grid { display: flex; flex-direction: column; gap: 18rpx; }
.join-item { border-radius: 24rpx; padding: 26rpx; background: #efe7f6; color: #805b9d; }
.join-title { display: block; font-size: 33rpx; font-weight: 600; color: #4d316b; margin: 12rpx 0; }
.nav-row { display: flex; justify-content: space-between; padding: 26rpx 12rpx; border-bottom: 1rpx solid #ebe5f0; }
