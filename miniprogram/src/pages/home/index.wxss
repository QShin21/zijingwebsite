.home-masthead { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 4px 0 16px; }
.home-brand { color: var(--z-primary); font-size: 17px; line-height: 1.5; font-weight: 700; letter-spacing: .5px; }
.home-identity { color: var(--z-muted); font-size: 12px; line-height: 1.5; }
.home-cover { padding: 8px 0 12px; }
.home-title { display: block; max-width: 11em; font-size: 32px; font-weight: 700; line-height: 1.3; letter-spacing: -.7px; white-space: pre-line; word-break: break-word; }
.home-description { display: block; margin-top: 12px; color: var(--z-subtitle); font-size: 15px; line-height: 1.75; word-break: break-word; }
.home-cover-actions { display: flex; align-items: stretch; gap: 20px; margin-top: 20px; }
.mini-page.native-page .home-cover-actions .primary { min-width: 160px; padding-left: 20px; padding-right: 20px; }
.mini-page.native-page .home-cover-actions .plain { flex-shrink: 0; }
.home-login-hint { display: block; color: var(--z-muted); font-size: 12px; line-height: 1.65; margin-top: 12px; }
.home-page .home-module:first-child { margin-top: 16px; }
.home-page .native-schedule-item:last-child { border-bottom: 0; }
.home-notices { margin-top: 24px; padding: 12px 16px; border: 1px solid var(--z-line); border-radius: 8px; background: var(--z-surface); }
.home-notices .native-section-head { margin-bottom: 4px; }
.home-notices .section-title { font-size: 16px; }
.mini-page.native-page .home-notice { display: block; width: 100%; padding: 12px 0; }
.home-notice + .home-notice { border-top: 1px solid var(--z-line); }
.home-notice-date { display: block; color: var(--z-muted); font-size: 12px; line-height: 1.5; font-variant-numeric: tabular-nums; margin-bottom: 4px; }
.home-notice-title { display: block; font-size: 15px; line-height: 1.65; word-break: break-word; }
.home-participate-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.mini-page.native-page .home-participate-actions > button { flex: 1; min-width: 80px; padding: 12px 6px; font-size: 15px; }
.home-page .staff-batches { padding-top: 24px; border-top: 1px solid var(--z-line); }
.home-page .staff-batches .section-heading { margin-bottom: 4px; }
.home-page .staff-batches .section-heading .section-title { font-size: 18px; }
.home-page .staff-batches .shortcut:last-child { border-bottom: 0; }
.home-promotion-group + .home-promotion-group { margin-top: 20px; }
.home-group-label { display: block; margin-bottom: 8px; color: var(--z-muted); font-size: 14px; line-height: 1.6; }
.home-about { padding-top: 24px; border-top: 1px solid var(--z-line); }
.home-photo { margin-top: 24px; }
.home-photo-image { display: block; width: 100%; height: 160px; border-radius: 8px; background: var(--z-media); }
.home-footer-navigation { display: flex; flex-wrap: wrap; gap: 4px 24px; margin-top: 20px; }
.mini-page.native-page .home-footer-navigation .plain { width: auto; font-size: 15px; text-align: left; }
@media (max-width: 359px) { .home-title { font-size: 30px; } .home-cover-actions { gap: 16px; } .mini-page.native-page .home-cover-actions .primary { min-width: 152px; } }
.home-module .home-notices { margin-top: 16px; margin-bottom: 8px; }

.home-lead { position: relative; display: flex; align-items: flex-start; gap: 16px; }
.home-lead .home-title { position: relative; z-index: 1; flex: 1; min-width: 0; }
.home-lead-image { display: block; flex-shrink: 0; width: 112px; height: 144px; border-radius: 12px; background: var(--z-media); }
.home-lead-fallback { background: var(--z-secondary-bg); }
.home-lead-fallback .native-field-graphic { opacity: .35; }
.home-field-mark { position: absolute; right: -4px; top: -4px; width: 148px; height: 128px; opacity: .13; pointer-events: none; }
.home-cover > .native-media-credit { margin-top: 8px; }
@media (max-width: 359px) { .home-lead { gap: 12px; } .home-lead-image { width: 96px; height: 128px; } }
