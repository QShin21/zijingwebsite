/* Page-specific structure; shared native primitives live in app.wxss. */
.auth-page > .title { margin-bottom: 18rpx; }
.auth-page > .panel { border-top: 3rpx solid var(--z-primary); }
.email-domain { color: var(--z-badge-text); padding: 20rpx 0 0; font-size: 26rpx; word-break: break-word; }
.code-row { display: flex; gap: 12rpx; align-items: stretch; }
.code-row input { flex: 1; min-width: 0; }
.code-row button { flex-shrink: 0; white-space: nowrap; padding: 18rpx 18rpx; font-size: 24rpx; }
.auth-page .actions { border-bottom: 1rpx solid var(--z-line); padding-bottom: 24rpx; }
