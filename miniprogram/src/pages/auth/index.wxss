/* V2 auth: stage hero with mode switch, form sheets, sticky submit dock. */
.auth-v2 { padding-top: 0; }
.auth-modes { display: flex; gap: 8rpx; margin-top: 14rpx; padding: 8rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .1); }
.mini-page .auth-mode { flex: 1; min-width: 0; padding: 12rpx 8rpx; border: 0; border-radius: 999rpx; background: transparent; color: var(--z-stage-muted); font-size: 27rpx; font-weight: 800; }
.mini-page .auth-mode.active { background: var(--z-accent); color: var(--z-on-accent); }
.auth-callout-title { display: block; font-weight: 900; }
.mini-page .auth-callout-action { margin-top: 14rpx; }
.auth-sheet .field { margin: 22rpx 0 6rpx; }
.auth-email {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.auth-email input {
  flex: none;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.auth-password-head { display: flex; align-items: center; justify-content: space-between; }
.mini-page .auth-password-toggle { min-height: 44px; padding: 8rpx 0; font-size: 26rpx; }
.auth-code { display: flex; gap: 12rpx; }
.auth-code input { flex: 1; min-width: 0; }
.auth-code button { flex-shrink: 0; }
.auth-busy { text-align: center; }
.auth-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx 28rpx; margin-top: 20rpx; }
/* 像素校园: square plates; the two-line email layout above is unchanged. */
.auth-modes, .mini-page .auth-mode, .auth-domain { border-radius: 0; }
.auth-modes { border: 4rpx solid var(--z-stage-line); }
.auth-domain { border-width: 4rpx; }
