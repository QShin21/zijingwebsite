<page-meta page-style="{{themePageStyle}}" />
<view class="page mini-page auth-page"><button class="plain" bindtap="back">返回</button><view class="page-heading"><text class="eyebrow">紫荆账号</text><text class="title">{{mode === 'login' ? '欢迎回来' : mode === 'register' ? '注册账号' : '重设密码'}}</text><text class="subtitle">{{mode === 'login' ? '使用网站已有账号，登录后回到刚才的页面。' : '使用清华师生与校友邮箱完成验证。'}}</text></view><view class="form-sheet section"><view wx:if="{{mode === 'login'}}" class="field"><text class="field-label">{{bridge ? '昵称或邮箱' : '完整邮箱'}}</text><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{identifier}}" bindinput="input" data-field="identifier" aria-label="昵称或完整邮箱" placeholder="{{bridge ? '输入昵称或完整邮箱' : '输入网站账号邮箱'}}" maxlength="254" /></view><block wx:if="{{mode === 'register'}}"><view class="field"><text class="field-label">昵称</text><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{name}}" bindinput="input" data-field="name" aria-label="昵称" placeholder="2–40 字，昵称不区分大小写" maxlength="40" /></view><view class="field"><text class="field-label">清华邮箱</text><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{emailPrefix}}" bindinput="input" data-field="emailPrefix" aria-label="邮箱前缀" placeholder="输入 @ 前的邮箱名" maxlength="64" /><picker range="{{domains}}" bindchange="domain"><view class="email-domain">@{{emailDomain}} ▾</view></picker></view></block><view wx:if="{{mode === 'reset'}}" class="field"><text class="field-label">完整清华邮箱</text><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{email}}" bindinput="input" data-field="email" aria-label="完整清华邮箱" placeholder="输入注册使用的邮箱" maxlength="254" /></view><view class="field"><text class="field-label">{{mode === 'reset' ? '新密码' : '密码'}}</text><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{password}}" password confirm-type="done" bindconfirm="submit" bindinput="input" data-field="password" aria-label="密码" placeholder="{{mode === 'login' ? '输入密码' : '至少 8 位'}}" maxlength="-1" /></view><view wx:if="{{mode !== 'login'}}" class="field"><text class="field-label">确认密码</text><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{confirm}}" password bindinput="input" data-field="confirm" aria-label="确认密码" placeholder="再次输入密码" maxlength="-1" /></view><view wx:if="{{mode !== 'login'}}" class="field"><text class="field-label">邮箱验证码</text><view class="code-row"><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{code}}" type="number" bindinput="input" data-field="code" aria-label="邮箱验证码" maxlength="6" placeholder="六位验证码" /><button class="secondary" bindtap="sendCode" disabled="{{busy || countdown > 0}}">{{countdown > 0 ? countdown + ' 秒' : '获取验证码'}}</button></view><text wx:if="{{sent}}" class="muted">请检查收件箱与垃圾邮件。验证码十分钟内有效。</text></view><button wx:if="{{!bridge}}" class="plain" disabled="{{busy}}" bindtap="retryBridge">重新检查登录与邮箱验证服务</button><text wx:if="{{error}}" class="error" aria-role="alert">{{error}}</text><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{mode === 'login' ? '登录' : mode === 'register' ? '验证并注册' : '重设密码'}}</button></view><view class="actions"><button wx:if="{{mode !== 'login'}}" class="plain" bindtap="switchMode" data-mode="login">返回登录</button><button wx:if="{{mode === 'login'}}" class="plain" bindtap="switchMode" data-mode="register">注册账号</button><button wx:if="{{mode === 'login'}}" class="plain" bindtap="switchMode" data-mode="reset">忘记密码</button></view><button class="plain" bindtap="openWebsite" data-url="/privacy">阅读隐私说明 →</button></view>
