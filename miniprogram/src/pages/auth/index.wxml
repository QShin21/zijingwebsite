<page-meta page-style="{{themePageStyle}}" />
<view class="page mini-page auth-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero auth-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{t.kicker}}</text>
      <text class="zj-hero-title">{{mode === 'login' ? t.titleLogin : mode === 'register' ? t.titleRegister : t.titleReset}}</text>
      <text class="zj-hero-lead">{{mode === 'login' ? t.leadLogin : mode === 'register' ? t.leadRegister : t.leadReset}}</text>
      <view class="auth-modes" aria-role="tablist">
        <button class="auth-mode {{mode === 'login' ? 'active' : ''}}" bindtap="switchMode" data-mode="login" disabled="{{busy}}" aria-selected="{{mode === 'login'}}">{{t.modeLogin}}</button>
        <button class="auth-mode {{mode === 'register' ? 'active' : ''}}" bindtap="switchMode" data-mode="register" disabled="{{busy}}" aria-selected="{{mode === 'register'}}">{{t.modeRegister}}</button>
        <button class="auth-mode {{mode === 'reset' ? 'active' : ''}}" bindtap="switchMode" data-mode="reset" disabled="{{busy}}" aria-selected="{{mode === 'reset'}}">{{t.modeReset}}</button>
      </view>
    </view>
  </view>

  <view wx:if="{{!bridge}}" class="zj-callout zj-callout-warning">
    <text class="auth-callout-title">{{t.bridgeTitle}}</text>
    <text>{{mode === 'login' ? t.bridgeLogin : t.bridgeOther}}</text>
    <button class="secondary auth-callout-action" disabled="{{busy}}" bindtap="retryBridge">{{t.bridgeRetry}}</button>
  </view>

  <view class="zj-sheet auth-sheet">
    <text class="zj-sheet-title">{{mode === 'login' ? t.sheetLogin : t.sheetProfile}}</text>
    <text class="zj-form-hint">{{t.requiredHint}}</text>
    <view wx:if="{{mode === 'login'}}" class="field">
      <text class="field-label">{{bridge ? t.identifierLabel : t.emailFull}} *</text>
      <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{identifier}}" bindinput="input" data-field="identifier" aria-label="{{t.identifierAria}}" placeholder="{{bridge ? t.identifierPlaceholder : t.identifierPlaceholderEmail}}" maxlength="254" />
    </view>
    <block wx:if="{{mode === 'register'}}">
      <view class="field">
        <text class="field-label">{{t.nickname}} *</text>
        <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{name}}" bindinput="input" data-field="name" aria-label="{{t.nickname}}" placeholder="{{t.nicknamePlaceholder}}" maxlength="40" />
        <text class="zj-form-hint">{{t.nicknameHint}}</text>
      </view>
      <view class="field">
        <text class="field-label">{{t.email}} *</text>
        <view class="auth-email">
          <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{emailPrefix}}" bindinput="input" data-field="emailPrefix" aria-label="{{t.emailPrefixAria}}" placeholder="{{t.emailPrefixPlaceholder}}" maxlength="64" />
          <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{emailDomain}}" bindinput="input" data-field="emailDomain" aria-label="{{t.emailDomainAria}}" placeholder="{{t.emailDomainPlaceholder}}" maxlength="253" />
        </view>
        <text class="zj-form-hint">{{t.emailHint}}</text>
      </view>
    </block>
    <view wx:if="{{mode === 'reset'}}" class="field">
      <text class="field-label">{{t.emailFull}} *</text>
      <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{email}}" bindinput="input" data-field="email" aria-label="{{t.emailFull}}" placeholder="{{t.resetEmailPlaceholder}}" maxlength="254" />
    </view>
    <view class="field">
      <view class="auth-password-head">
        <text class="field-label">{{mode === 'reset' ? t.newPassword : t.password}} *</text>
        <button class="plain auth-password-toggle" bindtap="togglePassword" aria-label="{{showPassword ? t.hidePassword : t.showPassword}}">{{showPassword ? t.hide : t.show}}</button>
      </view>
      <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{password}}" password="{{!showPassword}}" confirm-type="done" bindconfirm="submit" bindinput="input" data-field="password" aria-label="{{t.password}}" placeholder="{{mode === 'login' ? t.passwordPlaceholder : t.passwordMin}}" maxlength="-1" />
      <text wx:if="{{mode !== 'login'}}" class="zj-form-hint">{{t.passwordHint}}</text>
    </view>
    <view wx:if="{{mode !== 'login'}}" class="field">
      <text class="field-label">{{t.confirm}} *</text>
      <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{confirm}}" password="{{!showPassword}}" bindinput="input" data-field="confirm" aria-label="{{t.confirm}}" placeholder="{{t.confirmPlaceholder}}" maxlength="-1" />
    </view>
  </view>

  <view wx:if="{{mode !== 'login'}}" class="zj-sheet auth-sheet">
    <text class="zj-sheet-title">{{t.verifyTitle}}</text>
    <text class="zj-form-hint">{{mode === 'register' ? t.verifyRegister : t.verifyReset}}</text>
    <view class="field">
      <text class="field-label">{{t.codeLabel}} *</text>
      <view class="auth-code">
        <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{code}}" type="number" bindinput="input" data-field="code" aria-label="{{t.codeAria}}" maxlength="6" placeholder="{{t.codePlaceholder}}" />
        <button class="secondary" bindtap="sendCode" disabled="{{busy || countdown > 0}}">{{countdown > 0 ? countdown + t.resendSuffix : t.getCode}}</button>
      </view>
      <view wx:if="{{sent}}" class="zj-callout zj-callout-success" aria-role="status">
        <text class="auth-callout-title">{{t.sentTitle}}</text>
        <text>{{t.sentBody}}</text>
      </view>
    </view>
  </view>

  <text wx:if="{{error}}" class="error" aria-role="alert">{{error}}</text>
  <text wx:if="{{busy}}" class="zj-form-hint auth-busy" aria-role="status">{{t.busy}}</text>
  <view class="zj-dock">
    <button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{mode === 'login' ? t.submitLogin : mode === 'register' ? t.submitRegister : t.submitReset}}</button>
  </view>
  <view class="auth-links">
    <button wx:if="{{mode !== 'login'}}" class="plain" bindtap="switchMode" data-mode="login" disabled="{{busy}}">{{t.backToLogin}}</button>
    <button wx:if="{{mode === 'login'}}" class="plain" bindtap="switchMode" data-mode="register" disabled="{{busy}}">{{t.register}}</button>
    <button wx:if="{{mode === 'login'}}" class="plain" bindtap="switchMode" data-mode="reset" disabled="{{busy}}">{{t.forgot}}</button>
    <button class="plain" bindtap="openWebsite" data-url="/privacy">{{t.privacy}}</button>
  </view>
</view>
