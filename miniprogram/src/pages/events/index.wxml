<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<import src="../../templates/club.wxml" />
<view class="page mini-page events-page">
  <view class="page-heading"><text class="eyebrow">紫荆日程</text><text class="title">活动与通知</text><text class="subtitle">查找比赛、观赛、交流与训练安排，查看报名状态和具体时间。</text></view>
  <view class="chips"><button class="chip {{mode === 'events' ? 'active' : ''}}" bindtap="changeMode" data-mode="events">社团活动</button><button class="chip {{mode === 'announcements' ? 'active' : ''}}" bindtap="changeMode" data-mode="announcements">社团通知</button></view>
  <view class="search"><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{search}}" bindinput="input" bindconfirm="search" placeholder="搜索标题" aria-label="搜索活动或通知标题" confirm-type="search" maxlength="80" /><button class="secondary" bindtap="search">搜索</button></view>
  <scroll-view wx:if="{{mode === 'events'}}" scroll-x class="chips"><button wx:for="{{types}}" wx:key="*this" class="chip {{type === item ? 'active' : ''}}" bindtap="changeType" data-type="{{item}}">{{item}}</button></scroll-view>
  <template is="feedback" data="{{loading, error}}" />
  <block wx:if="{{!loading && !error}}"><view class="section-head"><text class="section-title">{{mode === 'events' ? (type === '全部' ? '全部活动' : type) : '通知列表'}}</text><text class="muted">第 {{page}} 页{{hasMore ? ' · 可继续加载' : ''}}</text></view><template is="cards" data="{{docs, label:mode === 'events' ? '活动' : '通知'}}" /></block>
  <button wx:if="{{hasMore && !loading}}" class="plain section" bindtap="onReachBottom" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button><text wx:if="{{docs.length && !hasMore && !loading}}" class="bottom-note">已展示全部内容</text>
  <view wx:if="{{!loading && !error && promoted.length}}" class="section"><text class="section-kicker">保留原社群与报名入口</text><text class="section-title">社群推荐</text><template is="promotion-cards" data="{{docs:promoted}}" /></view>
  <view wx:if="{{clubError}}" class="section"><text class="error">{{clubError}}</text><button class="plain" bindtap="retryClub">重试社团展示</button></view>
</view>
