<import src="../../templates/common.wxml" />
<view class="page"><text class="eyebrow">WHAT'S ON</text><text class="title">下一场，一起。</text><text class="subtitle">比赛、观赛、交流与训练。找到想参加的活动。</text><view class="chips"><view class="chip {{mode === 'events' ? 'active' : ''}}" bindtap="changeMode" data-mode="events">社团活动</view><view class="chip {{mode === 'announcements' ? 'active' : ''}}" bindtap="changeMode" data-mode="announcements">社团通知</view></view><view class="search"><input value="{{search}}" bindinput="input" bindconfirm="search" placeholder="搜索标题" confirm-type="search" maxlength="80" /><button class="secondary" bindtap="search">搜索</button></view><scroll-view wx:if="{{mode === 'events'}}" scroll-x class="chips"><view wx:for="{{types}}" wx:key="*this" class="chip {{type === item ? 'active' : ''}}" bindtap="changeType" data-type="{{item}}">{{item}}</view></scroll-view><template is="feedback" data="{{loading, error}}" /><template wx:if="{{!loading && !error}}" is="cards" data="{{docs, label:mode === 'events' ? '活动' : '通知'}}" /><button wx:if="{{hasMore && !loading}}" class="plain" bindtap="onReachBottom" loading="{{loadingMore}}">加载更多</button><text wx:if="{{docs.length && !hasMore}}" class="bottom-note">已展示全部内容</text></view>
