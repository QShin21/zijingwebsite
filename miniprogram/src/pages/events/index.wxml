<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/v2.wxml" />
<view class="page mini-page zj-tab-page {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="page-heading {{scene ? 'page-heading-scenic' : ''}}">
    <zj-campus scene="{{scene}}" palette="{{palette}}" />
    <text class="eyebrow">{{t.eyebrow}}</text>
    <text class="title">{{t.title}}</text>
    <text class="subtitle">{{user ? t.subtitleUser : t.subtitleGuest}}</text>
  </view>
  <view class="zj-segments" aria-role="tablist">
    <button class="zj-segment {{scope === 'all' ? 'active' : ''}}" bindtap="setScope" data-scope="all" aria-selected="{{scope === 'all'}}">{{t.scopeAll}}</button>
    <button class="zj-segment {{scope === 'club' ? 'active' : ''}}" bindtap="setScope" data-scope="club" aria-selected="{{scope === 'club'}}">{{t.scopeClub}}</button>
    <button class="zj-segment {{scope === 'community' ? 'active' : ''}}" bindtap="setScope" data-scope="community" aria-selected="{{scope === 'community'}}">{{t.scopeCommunity}}</button>
    <button class="zj-segment {{scope === 'mine' ? 'active' : ''}}" bindtap="setScope" data-scope="mine" aria-selected="{{scope === 'mine'}}">{{t.scopeMine}}</button>
  </view>
  <view class="chips">
    <view class="events-range-group" aria-role="radiogroup" aria-label="{{t.rangeLabel}}">
      <button class="chip {{range === 'upcoming' ? 'active' : ''}}" bindtap="setRange" data-range="upcoming" aria-role="radio" aria-checked="{{range === 'upcoming'}}" aria-label="{{t.upcoming}}{{range === 'upcoming' ? t.selectedSuffix : t.unselectedSuffix}}">{{t.upcoming}}</button>
      <button class="chip {{range === 'past' ? 'active' : ''}}" bindtap="setRange" data-range="past" aria-role="radio" aria-checked="{{range === 'past'}}" aria-label="{{t.past}}{{range === 'past' ? t.selectedSuffix : t.unselectedSuffix}}">{{t.past}}</button>
    </view>
    <button class="chip {{signupOpen ? 'active' : ''}}" bindtap="toggleSignupOpen" aria-role="checkbox" aria-checked="{{signupOpen}}" disabled="{{loading}}">{{t.signupOpen}}</button>
  </view>
  <template wx:if="{{loading}}" is="zj-loading" data="{{t}}" />
  <view wx:elif="{{error}}">
    <template is="zj-error" data="{{error, t}}" />
    <button wx:if="{{needsLogin}}" class="primary" bindtap="login">{{t.loginToView}}</button>
  </view>
  <block wx:elif="{{groups.length}}">
    <view wx:for="{{groups}}" wx:for-item="group" wx:key="key">
      <view class="zj-day-head"><text>{{group.label}}</text></view>
      <block wx:for="{{group.items}}" wx:key="key"><template is="zj-match" data="{{item, img, t}}" /></block>
    </view>
    <text wx:if="{{loadMoreError && !loading}}" class="error">{{loadMoreError}}</text>
    <button wx:if="{{hasMore || loadMoreError}}" class="secondary zj-more-button" bindtap="onReachBottom" disabled="{{loadingMore}}">{{loadingMore ? t.loadingMore : (loadMoreError ? t.retryMore : t.loadMore)}}</button>
  </block>
  <template wx:elif="{{scope === 'mine'}}" is="zj-empty" data="{{title: t.mineEmptyTitle, body: t.mineEmptyBody, icon: '🎫', action: t.mineEmptyAction, page: 'events'}}" />
  <template wx:else is="zj-empty" data="{{title: range === 'past' ? t.pastEmptyTitle : t.upcomingEmptyTitle, body: t.emptyBody, icon: '📅'}}" />
</view>
