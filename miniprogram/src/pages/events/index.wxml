<page-meta page-style="{{themePageStyle}}" />
<template name="visual-cards">
  <button wx:for="{{docs}}" wx:key="id" class="card content-link" bindtap="openContent" data-doc="{{item}}" hover-class="pressed">
    <image wx:if="{{item.coverImage}}" class="card-image" src="{{item.coverImage.url}}" mode="aspectFill" aria-label="{{item.coverImage.alt}}" />
    <view class="card-body"><view class="meta"><text>{{item.kindText || label}}</text><text wx:if="{{item.statusText}}" class="badge">{{item.statusText}}</text><text wx:if="{{item.demo}}" class="badge">演示资料</text></view><text class="card-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="card-summary">{{item.summary}}</text><view class="meta card-footer"><text>{{item.dateText}}</text><text>{{item.location || '查看详情 →'}}</text></view></view>
  </button>
  <view wx:if="{{!docs.length}}" class="empty"><text>内容正在准备中</text><text class="muted">新内容发布后会出现在这里。</text></view>
</template>

<import src="../../templates/common.wxml" />
<import src="../../templates/club.wxml" />
<view class="page mini-page events-page"><text class="eyebrow">WHAT'S ON</text><text class="title">下一场，一起。</text><text class="subtitle">比赛、观赛、交流与训练。找到想参加的活动。</text><view class="chips"><button class="chip {{mode === 'events' ? 'active' : ''}}" bindtap="changeMode" data-mode="events" hover-class="pressed">社团活动</button><button class="chip {{mode === 'announcements' ? 'active' : ''}}" bindtap="changeMode" data-mode="announcements" hover-class="pressed">社团通知</button></view><view class="search"><input placeholder-style="color:{{theme === 'dark' ? '#aaa5b9' : '#6c6179'}}" value="{{search}}" bindinput="input" bindconfirm="search" placeholder="搜索标题" confirm-type="search" maxlength="80" /><button class="secondary" bindtap="search">搜索</button></view><scroll-view wx:if="{{mode === 'events'}}" scroll-x class="chips"><button wx:for="{{types}}" wx:key="*this" class="chip {{type === item ? 'active' : ''}}" bindtap="changeType" data-type="{{item}}" hover-class="pressed">{{item}}</button></scroll-view><template is="feedback" data="{{loading, error}}" /><view wx:if="{{!loading && !error && promoted.length}}" class="section"><text class="section-title">来自社群 · 已审批社团展示</text><template is="promotion-cards" data="{{docs:promoted}}" /></view><view wx:if="{{clubError}}" class="panel section"><text class="error">{{clubError}}</text><button class="plain" bindtap="retryClub">重试社团展示</button></view><template wx:if="{{!loading && !error}}" is="visual-cards" data="{{docs, label:mode === 'events' ? '活动' : '通知'}}" /><button wx:if="{{hasMore && !loading}}" class="plain" bindtap="onReachBottom" loading="{{loadingMore}}">加载更多</button><text wx:if="{{docs.length && !hasMore}}" class="bottom-note">已展示全部内容</text></view>
