.events-heading { padding: 8px 0 20px; }
.events-heading .subtitle { margin-top: 8px; }
.events-modes { display: flex; gap: 4px; padding: 4px; border-radius: 10px; background: var(--z-control); }
.mini-page.native-page .events-mode { flex: 1; border: 1px solid transparent; border-radius: 7px; padding: 10px 8px; background: transparent; color: var(--z-subtitle); font-size: 16px; }
.mini-page.native-page .events-mode.active { border-color: var(--z-secondary-border); background: var(--z-surface); color: var(--z-primary); font-weight: 600; }
.events-filters { padding-top: 20px; }
.events-search-label { display: block; font-size: 14px; line-height: 1.6; color: var(--z-text); }
.events-page .search { gap: 8px; margin: 8px 0 16px; }
.events-type-label { display: block; font-size: 12px; line-height: 1.5; color: var(--z-muted); margin-bottom: 4px; }
.events-types { display: block; width: 100%; white-space: nowrap; }
.mini-page.native-page .events-type { display: inline-flex; align-items: center; justify-content: center; width: auto; min-width: 52px; padding: 10px 12px; margin-right: 4px; border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: transparent; color: var(--z-subtitle); font-size: 15px; }
.mini-page.native-page .events-type.active { color: var(--z-primary); border-bottom-color: var(--z-primary); font-weight: 600; }
.events-results-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px 16px; margin-top: 28px; padding-bottom: 4px; }
.events-result-count { color: var(--z-muted); font-size: 12px; line-height: 1.6; }
.events-page .native-schedule-item:first-child { padding-top: 16px; }
.mini-page.native-page .events-load-more { width: 100%; margin-top: 24px; }
.events-results-end { text-align: center; }
.events-promotions { padding-top: 24px; border-top: 1px solid var(--z-line); }
