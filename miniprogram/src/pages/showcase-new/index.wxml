<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/v2.wxml" />
<view class="page mini-page showcase-new-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{t.kicker}}</text>
      <text class="zj-hero-title">{{t.heroTitle}}</text>
      <text class="zj-hero-lead">{{t.heroLead}}</text>
    </view>
  </view>
  <template wx:if="{{needsLogin}}" is="zj-login" data="{{title: t.loginTitle, body: t.loginBody, t}}" />
  <view wx:elif="{{done}}" class="zj-sheet showcase-new-done">
    <text class="zj-pill zj-pill-action">{{t.submitted}}</text>
    <text class="zj-sheet-title">{{t.doneTitle}}</text>
    <text class="zj-form-hint">{{t.doneHint}}</text>
    <view class="zj-dock"><button class="primary" bindtap="openMine">{{t.openMine}}</button></view>
  </view>
  <block wx:else>
    <view class="zj-sheet">
      <text class="zj-sheet-title">{{t.step1}}</text>
      <view class="field">
        <text class="field-label">{{t.titleLabel}}</text>
        <input value="{{title}}" maxlength="120" placeholder="{{t.titlePlaceholder}}" placeholder-style="color:{{themeMuted}}" bindinput="field" data-field="title" cursor-spacing="24" disabled="{{busy}}" />
      </view>
      <view class="field">
        <text class="field-label">{{t.bodyLabel}}</text>
        <textarea value="{{body}}" maxlength="5000" placeholder="{{t.bodyPlaceholder}}" placeholder-style="color:{{themeMuted}}" bindinput="field" data-field="body" cursor-spacing="24" disabled="{{busy}}" />
      </view>
    </view>
    <view class="zj-sheet">
      <text class="zj-sheet-title">{{t.step2}}</text>
      <view class="field">
        <text class="field-label">{{t.videoLabel}}</text>
        <input value="{{videoURL}}" maxlength="2000" placeholder="{{t.videoPlaceholder}}" placeholder-style="color:{{themeMuted}}" bindinput="field" data-field="videoURL" cursor-spacing="24" disabled="{{busy}}" />
      </view>
      <view class="field">
        <text class="field-label">{{t.photosLabel}}</text>
        <view class="showcase-grid">
          <view wx:for="{{images}}" wx:key="upload" class="showcase-item">
            <image class="showcase-preview" src="{{item.preview}}" mode="aspectFill" />
            <input class="showcase-caption" value="{{item.caption}}" maxlength="200" placeholder="{{t.captionPlaceholder}}" placeholder-style="color:{{themeMuted}}" bindinput="caption" data-index="{{index}}" cursor-spacing="24" disabled="{{busy}}" />
            <button class="plain showcase-remove" bindtap="remove" data-index="{{index}}" disabled="{{busy}}" aria-label="{{t.removePhotoPrefix}}{{index + 1}}{{t.removePhotoSuffix}}">{{t.remove}}</button>
          </view>
          <button wx:if="{{images.length < 6}}" class="showcase-add" bindtap="choose" disabled="{{busy || uploading > 0}}">{{uploading ? t.uploadingPrefix + uploading + t.uploadingSuffix : t.addPhotos}}</button>
        </view>
      </view>
      <text class="zj-callout">{{t.rightsNote}}</text>
    </view>
    <text wx:if="{{error}}" class="error" aria-role="alert">{{error}}</text>
    <view class="zj-dock">
      <button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || uploading > 0 || !slug}}">{{busy ? t.submitting : t.submit}}</button>
    </view>
  </block>
</view>
<privacy-consent id="privacyConsent" />
