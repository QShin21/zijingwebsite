@import "../../templates/business.wxss";
@import "../../styles/native-forms.wxss";

/* V2 sign-up flow: stage progress card, question cards, receipt card, sticky dock. */
.signup-v2 { padding-top: 0; }
.signup-message { margin-top: 0; }
.signup-tools { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.signup-switch { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 18rpx 0; }
.signup-switch .field-label { margin: 0; }
.signup-datetime { display: flex; gap: 12rpx; }
.signup-datetime picker { flex: 1; min-width: 0; }
.signup-questions-head { margin-top: 32rpx; }
.signup-editor-index { color: var(--z-primary); font-size: 26rpx; font-weight: 900; }
.mini-page .signup-wide { display: block; width: 100%; margin-top: 18rpx; }
.signup-dock-note { flex-basis: 100%; }
.mini-page .signup-disclosure { display: flex; justify-content: space-between; width: 100%; padding: 14rpx 0; }
.signup-answer .zj-kv-label { width: 200rpx; }
.signup-pager { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 24rpx; }
.signup-pager-status { font-weight: 900; }
.signup-receipt-wrap { display: flex; flex-direction: column; }
.signup-receipt { border: 3rpx solid var(--z-success-line); background: var(--z-success-bg); }
.signup-receipt-kicker { color: var(--z-success); }
.signup-receipt-status { color: var(--z-success); font-size: 48rpx; font-weight: 900; line-height: 1.2; }
.signup-feedback-label { display: block; font-weight: 900; }
.signup-privacy { display: flex; flex-direction: column; gap: 6rpx; margin: 16rpx 0 24rpx; }
.signup-progress { display: flex; flex-direction: column; gap: 14rpx; margin: 8rpx 0 24rpx; padding: 28rpx; border-radius: 32rpx; background: linear-gradient(150deg, var(--z-stage2), var(--z-stage)); color: var(--z-stage-ink); }
.signup-stages { display: flex; gap: 10rpx; }
.signup-stage { flex: 1; min-width: 0; padding: 10rpx 6rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .08); color: var(--z-stage-muted); font-size: 22rpx; font-weight: 800; text-align: center; }
.signup-stage.current { background: var(--z-accent); color: var(--z-on-accent); }
.signup-stage.done { background: rgba(240, 192, 96, .22); color: var(--z-accent); }
.signup-progress-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.signup-progress-title { font-size: 32rpx; font-weight: 900; }
.signup-progress-count { color: var(--z-accent); font-size: 36rpx; font-weight: 800; }
.signup-progress-hint { color: var(--z-stage-muted); font-size: 24rpx; }
.signup-page-label { display: block; margin: 8rpx 0 16rpx; color: var(--z-primary); font-size: 26rpx; font-weight: 900; }
.signup-questions { display: flex; flex-direction: column; gap: 18rpx; }
.signup-v2 .branch-notice { white-space: pre-wrap; }
.mini-page .signup-draft { flex-basis: 100%; }

/* questionnaire-question template */
.signup-v2 .question-section { min-width: 0; padding: 28rpx; border: 1rpx solid var(--z-line); border-radius: 32rpx; background: var(--z-surface); font-size: 30rpx; line-height: 1.75; }
.signup-v2 .question-section.invalid { border: 4rpx solid var(--z-danger); }
.mini-page.signup-v2 .question-section .label { margin: 0 0 14rpx; font-size: 31rpx; font-weight: 900; line-height: 1.55; }
.signup-v2 .question-help { display: block; margin-bottom: 16rpx; color: var(--z-muted); font-size: 26rpx; white-space: pre-wrap; }
.signup-v2 .choice { display: flex; align-items: flex-start; gap: 16rpx; min-width: 0; min-height: 48px; margin-top: 12rpx; padding: 20rpx 22rpx; border: 3rpx solid var(--z-line); border-radius: 24rpx; background: var(--z-raised); color: var(--z-text); font-size: 29rpx; line-height: 1.7; word-break: break-word; }
.signup-v2 .choice radio, .signup-v2 .choice checkbox { flex-shrink: 0; }
.signup-v2 .scale-choices { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.signup-v2 .scale-choice { display: flex; align-items: center; gap: 6rpx; min-height: 48px; min-width: 56px; padding: 16rpx 18rpx; border: 3rpx solid var(--z-line); border-radius: 20rpx; background: var(--z-raised); font-size: 28rpx; font-weight: 800; }
.signup-v2 .subquestion { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--z-line); }
.signup-v2 .entry-row { margin-top: 20rpx; padding: 22rpx; border: 1rpx solid var(--z-line); border-radius: 24rpx; background: var(--z-raised); }
.mini-page.signup-v2 .entry-row > .row { align-items: center; gap: 12rpx; padding-bottom: 14rpx; border-bottom: 1rpx solid var(--z-line); }
.mini-page.signup-v2 .entry-row > .row > .section-title { flex: 1; min-width: 64px; font-size: 30rpx; }
.signup-v2 .question-error { display: block; margin-top: 12rpx; color: var(--z-danger); font-size: 26rpx; font-weight: 800; line-height: 1.7; word-break: break-word; }
.mini-page.signup-v2 .question-section .clear-answer { margin-top: 14rpx; padding: 10rpx 0; border-color: transparent; background: transparent; color: var(--z-link); font-size: 26rpx; }
@media (max-width: 359px) {
  .signup-stage { font-size: 11px; }
  .signup-datetime { gap: 8rpx; }
}
.signup-seat-ticket { margin: 18rpx 0; }
.signup-seat-image { display: block; width: 100%; max-width: 640rpx; background: #fff; }
