/* Page-specific structure; shared native primitives live in app.wxss. */
.signup-heading { padding-bottom: 30rpx; border-bottom: 1rpx solid var(--z-control-border); }
.signup-heading .title { font-size: 45rpx; }
.mini-page .signup-status { display: inline-block; margin: 24rpx 0; color: var(--z-positive); border-color: var(--z-positive-border); background: var(--z-positive-bg); }
.mini-page .signup-intro { margin-top: 24rpx; }
.privacy-note { display: block; padding: 22rpx 24rpx; background: var(--z-positive-bg); border: 1rpx solid var(--z-positive-line); border-radius: 12rpx; }
.progress-panel { border-top: 3rpx solid var(--z-primary); }
.mini-page .progress-panel .body { margin: 0 0 22rpx; }
.mini-page .progress-panel .muted { margin-top: 18rpx; }
.progress-label { display: flex; align-items: baseline; justify-content: space-between; gap: 18rpx; margin-bottom: 22rpx; }
.progress-count { color: var(--z-brand); font-size: 31rpx; font-weight: 600; }
.mini-page .receipt-panel { border-top: 3rpx solid var(--z-positive); }
.receipt-mark { display: inline-block; color: var(--z-positive); background: var(--z-positive-bg); border: 1rpx solid var(--z-positive-border); border-radius: 8rpx; padding: 5rpx 14rpx; margin-bottom: 20rpx; font-size: 22rpx; }
textarea { height: 220rpx; }
.label { margin: 20rpx 0 18rpx; word-break: break-word; }
.choice { display: flex; align-items: center; gap: 14rpx; padding: 20rpx 18rpx; margin: 14rpx 0; min-height: 44px; border: 1rpx solid var(--z-control-border); border-radius: 12rpx; background: var(--z-control); color: var(--z-body); line-height: 1.65; word-break: break-word; }
.choice radio, .choice checkbox { flex-shrink: 0; }
.picker { padding: 24rpx 0; color: var(--z-badge-text); }
.answer { margin-top: 22rpx; padding-top: 12rpx; border-top: 1rpx solid var(--z-line); white-space: pre-wrap; word-break: break-word; }
.panel > .section-title, .panel > .muted { display: block; }
.row picker { flex: 1; min-width: 0; }
.question-help, .question-error, .branch-notice { display: block; white-space: pre-wrap; line-height: 1.8; }
.question-help { margin-bottom: 22rpx; }
.mini-page .invalid { border: 2rpx solid var(--z-error-border); }
.question-error { margin-top: 18rpx; color: var(--z-error-text); font-size: 26rpx; }
.entry-row, .subquestion { margin-top: 26rpx; border-top: 1rpx solid var(--z-control-border); padding-top: 16rpx; }
.entry-row .section-title { font-size: 29rpx; }
.scale-choices { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.scale-choice { display: flex; align-items: center; gap: 8rpx; min-height: 44px; min-width: 44px; padding: 12rpx; border: 1rpx solid var(--z-control-border); border-radius: 10rpx; background: var(--z-control); }
.picker-value { background: var(--z-field-bg); border: 1rpx solid var(--z-field-border); border-radius: 12rpx; padding: 24rpx; word-break: break-word; }
.row > button { flex: 1; min-width: 0; }
.branch-notice { border: 1rpx solid var(--z-secondary-border); border-radius: 12rpx; background: var(--z-secondary-bg); padding: 22rpx; color: var(--z-secondary-text); font-size: 26rpx; }
.question-editor .row { margin-top: 22rpx; }
.mini-page .signup-message { padding: 24rpx; color: var(--z-selected-text); background: var(--z-secondary-bg); border: 1rpx solid var(--z-secondary-border); border-radius: 12rpx; }
@media (min-width: 600px) { .signup-heading .title { font-size: 30px; } input, textarea, .label, .choice, .question-error { font-size: 17px; } }
.question-section { margin-top: 32rpx; padding: 32rpx 0; border-top: 1rpx solid var(--z-line); }
.question-section.invalid { padding: 26rpx; border-radius: 12rpx; }
.signup-page .progress-panel { padding: 26rpx; border: 1rpx solid var(--z-line); }
.signup-page .choice { margin: 0; border: 0; border-bottom: 1rpx solid var(--z-line); border-radius: 0; padding: 24rpx 4rpx; background: transparent; }
.signup-page .receipt-panel > .section-title { color: var(--z-primary); }
.signup-page .row > button { flex: 1; min-width: 180rpx; }
.signup-page .field-note { margin-bottom: 16rpx; }
