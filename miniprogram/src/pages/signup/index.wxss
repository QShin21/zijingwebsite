@import "../../templates/business.wxss";
.signup-page .signup-privacy { margin: 20rpx 0 28rpx; padding: 0 0 20rpx; border-bottom: 1rpx solid var(--z-line); }
.signup-page .signup-privacy .task-note { padding-top: 0; }
.signup-page .answer-progress { margin: 32rpx 0; padding: 24rpx 0; border-top: 2rpx solid var(--z-primary); }
.signup-page .progress-label { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 10rpx 20rpx; margin-bottom: 20rpx; }
.signup-page .question-page-label, .signup-page .question-position { display: block; color: var(--z-muted); font-size: 26rpx; margin: 28rpx 0 12rpx; }
.signup-page .question-section { margin-top: 26rpx; padding: 28rpx 0; border-top: 1rpx solid var(--z-line); }
.signup-page .question-section .label { margin: 0 0 18rpx; font-size: 32rpx; line-height: 1.7; }
.signup-page .question-help { margin-bottom: 20rpx; white-space: pre-wrap; }
.signup-page .choice { display: flex; align-items: flex-start; gap: 16rpx; padding: 24rpx 8rpx; min-height: 44px; border-bottom: 1rpx solid var(--z-line); color: var(--z-text); line-height: 1.75; word-break: break-word; }
.signup-page .choice radio, .signup-page .choice checkbox { flex-shrink: 0; }
.signup-page .scale-choices { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.signup-page .scale-choice { display: flex; align-items: center; gap: 8rpx; min-height: 44px; min-width: 44px; padding: 14rpx; border: 1rpx solid var(--z-control-border); border-radius: 10rpx; background: var(--z-control); }
.signup-page .entry-row, .signup-page .subquestion { margin-top: 26rpx; padding: 22rpx 0 0; border-top: 1rpx solid var(--z-line); }
.signup-page .entry-row > view > .label { margin-top: 24rpx; }
.signup-page .question-section.invalid { padding: 24rpx; border: 2rpx solid var(--z-error-border); border-radius: 12rpx; }
.signup-page .question-error { display: block; color: var(--z-error-text); font-size: 28rpx; line-height: 1.8; margin-top: 18rpx; }
.signup-page .branch-notice { display: block; margin-top: 24rpx; padding: 24rpx; border-left: 3rpx solid var(--z-primary); background: var(--z-secondary-bg); color: var(--z-secondary-text); white-space: pre-wrap; }
.signup-page .question-editor { margin: 28rpx 0; padding: 24rpx; border: 1rpx solid var(--z-line); border-radius: 12rpx; background: var(--z-surface); }
.signup-page .question-editor .question-position { margin: 0; }
.signup-page .question-editor .selection-label { align-items: center; justify-content: space-between; }
.signup-page .date-time-fields { display: flex; gap: 16rpx; }
.signup-page .date-time-fields picker { min-width: 0; padding: 0; border: 0; flex: 1; }
.signup-page .review-answers { padding: 24rpx 0; border-top: 1rpx solid var(--z-line); }
.signup-page .receipt-panel .business-summary .actions { margin-top: 24rpx; }
.signup-page .entry-row > .row > button { min-width: 180rpx; }
@media (max-width: 359px) { .signup-page .question-section .label, .signup-page .choice, .signup-page .question-error { font-size: 15px; } }
