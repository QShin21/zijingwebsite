<import src="../../templates/common.wxml" />
<import src="../../templates/questionnaire.wxml" />
<view class="page"><template is="feedback" data="{{loading,error,needsLogin}}" />
<button class="plain" bindtap="back">返回</button>
<block wx:if="{{!loading && !error && !needsLogin && info}}"><text class="title">{{info.title}}</text>
<block wx:if="{{edit}}">
 <view class="chips"><view wx:if="{{info.canManage}}" class="chip {{tab === 'edit' ? 'active' : ''}}" bindtap="tab" data-tab="edit">编辑问卷</view><view wx:if="{{info.canViewSignups}}" class="chip {{tab === 'entries' ? 'active' : ''}}" bindtap="tab" data-tab="entries">报名名单</view></view>
 <block wx:if="{{info.canManage && tab === 'edit' && advancedEditing}}"><view class="panel section"><text class="section-title">新版问卷</text><text class="body">此问卷包含高级题型或分支规则，可在小程序中填写和查看报名名单。制作与逻辑设置请进入网站编辑器。</text><button class="plain section" bindtap="websiteEditor">复制网站编辑地址</button><view wx:for="{{editQuestions}}" wx:key="id" class="answer"><text class="label">{{index+1}}. {{item.label}}</text><text class="muted">{{item.typeLabel}}</text></view></view></block>
 <block wx:elif="{{info.canManage && tab === 'edit'}}">
 <view class="panel"><view class="row"><text>启用问卷报名</text><switch checked="{{form.enabled}}" bindchange="field" data-key="enabled" /></view><text class="muted">用户填写后即确认报名；每个账号保留一份记录。</text></view>
 <block wx:if="{{form.enabled}}"><view class="panel section"><text class="label">报名说明</text><textarea value="{{form.intro}}" maxlength="1000" bindinput="field" data-key="intro" placeholder="说明本次报名所需的信息" />
 <text class="label">报名开始</text><view class="row"><picker mode="date" value="{{startDate}}" bindchange="time" data-key="start" data-part="date"><text>{{startDate || '选择日期'}}</text></picker><picker mode="time" value="{{startTime}}" bindchange="time" data-key="start" data-part="time"><text>{{startTime || '选择时间'}}</text></picker><button size="mini" bindtap="clearTime" data-key="start">不设</button></view>
 <text class="label">报名截止</text><view class="row"><picker mode="date" value="{{endDate}}" bindchange="time" data-key="end" data-part="date"><text>{{endDate || '选择日期'}}</text></picker><picker mode="time" value="{{endTime}}" bindchange="time" data-key="end" data-part="time"><text>{{endTime || '选择时间'}}</text></picker><button size="mini" bindtap="clearTime" data-key="end">不设</button></view>
 <view class="row section"><text>暂停接收报名</text><switch checked="{{form.closed}}" bindchange="field" data-key="closed" /></view></view>
 <view wx:for="{{editQuestions}}" wx:key="id" class="panel section question-editor"><text class="section-title">第 {{index+1}} 题</text><text class="label">题目标题</text><input value="{{item.label}}" maxlength="120" bindinput="question" data-index="{{index}}" data-key="label" placeholder="填写题目" />
 <picker range="{{typeLabels}}" value="{{item.typeIndex}}" bindchange="question" data-index="{{index}}" data-key="type"><view class="picker">题型：{{typeLabels[item.typeIndex]}} ▾</view></picker>
 <view class="row"><text>必填</text><switch checked="{{item.required}}" bindchange="question" data-index="{{index}}" data-key="required" /></view>
 <block wx:if="{{item.type === 'single' || item.type === 'multiple'}}"><text class="label">选项（每行一个）</text><textarea value="{{item.optionsText}}" maxlength="2400" bindinput="question" data-index="{{index}}" data-key="options" /></block>
 <view class="row section"><button size="mini" disabled="{{index === 0}}" bindtap="move" data-index="{{index}}" data-direction="-1">上移</button><button size="mini" disabled="{{index === editQuestions.length-1}}" bindtap="move" data-index="{{index}}" data-direction="1">下移</button><button size="mini" bindtap="remove" data-index="{{index}}">删除</button></view></view>
 <button class="plain section" bindtap="add">＋ 添加题目</button><text class="muted">已有报名保留提交时的题目和答案。</text></block>
 <button class="primary section" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存报名问卷</button>
 </block>
 <block wx:elif="{{info.canViewSignups && tab === 'entries'}}"><text class="subtitle">共 {{total}} 人报名</text><view wx:for="{{entries}}" wx:key="id" class="panel section"><text class="section-title">{{item.memberName}} · #{{item.id}}</text><view wx:for="{{item.rows}}" wx:for-item="answer" wx:key="label" class="answer"><text class="label">{{answer.label}}</text><text selectable>{{answer.answer}}</text></view></view><text wx:if="{{!entries.length && !busy}}" class="empty">暂无报名</text><view wx:if="{{pages > 1}}" class="row section"><button bindtap="previous" disabled="{{busy || page <= 1}}">上一页</button><text>{{page}} / {{pages}}</text><button bindtap="next" disabled="{{busy || page >= pages}}">下一页</button></view></block>
</block>
<block wx:else>
 <button wx:if="{{!staff && (info.canManage || info.canViewSignups)}}" class="plain" bindtap="manage">{{info.canManage ? '编辑报名问卷' : '查看报名名单'}} →</button>
 <block wx:if="{{staff}}"><text class="body">{{info.privacy}}</text><text class="muted">{{info.deadlinePolicy}}</text><text class="badge">{{info.state}}</text><button wx:if="{{info.actions.review}}" class="plain" bindtap="staffReview">骨干申请审核 →</button></block>
 <view wx:if="{{receipt && !responseEditing}}" class="panel section"><text class="section-title">{{staff ? receipt.statusText : '已报名'}}</text><text class="body">{{staff ? '申请编号' : '报名编号'}}：{{receipt.id}}</text><text wx:if="{{staff}}" class="muted">更新于 {{receipt.updatedText}}</text><text wx:if="{{receipt.feedback}}" class="body">处理反馈：{{receipt.feedback}}</text><view wx:for="{{receipt.rows}}" wx:key="id" class="answer"><text class="label">{{item.label}}</text><text selectable>{{item.answer}}</text></view><button wx:if="{{staff ? info.actions.edit : info.state === '报名开放'}}" class="primary section" disabled="{{busy}}" bindtap="editAnswers">{{staff ? receipt.status === 'withdrawn' ? '重新提交申请' : '修改申请' : '修改作答'}}</button><text wx:else class="muted section">{{info.state}}，当前回执只读。</text><button wx:if="{{staff && info.actions.withdraw}}" class="secondary section" disabled="{{busy}}" bindtap="withdraw">撤回申请</button><button class="plain section" disabled="{{busy}}" bindtap="retry">重新加载已提交内容</button></view>
 <block wx:else><text class="body">{{form.intro}}</text><block wx:if="{{!staff}}"><text class="badge">{{info.state}}</text><text class="muted">提交的答案仅供你本人和有权限的活动管理者查看，用于本次活动组织。</text></block>
 <block wx:if="{{form.enabled && (staff ? (responseEditing ? info.actions.edit : info.actions.submit) : info.state === '报名开放')}}">
  <view class="panel section"><text class="body">已填写 {{completed}} / {{answerTotal}} 题</text><progress percent="{{progress}}" activeColor="#6835ad" /><text class="muted section">带 * 为必填；返回上一步会保留已填内容。</text></view>
  <view wx:if="{{review}}" class="panel section"><text class="section-title">{{staff ? '核对骨干申请' : '核对报名信息'}}</text><text class="muted">请核对以下内容，确认后提交保存。</text><view wx:for="{{reviewRows}}" wx:key="id" class="answer"><text class="label">{{item.label}}</text><text selectable>{{item.answer}}</text></view></view>
  <block wx:else><text class="subtitle section">第 {{step+1}} / {{answerPages}} 页</text><block wx:for="{{questions}}" wx:for-item="question" wx:key="id"><template is="questionnaire-question" data="{{question,busy}}" /></block><text wx:if="{{branchNotice}}" class="branch-notice section">{{branchNotice}}</text></block>
  <view class="row section"><button wx:if="{{review || step > 0}}" class="plain" disabled="{{busy}}" bindtap="answerPrevious">{{review ? '返回修改' : '上一步'}}</button><button wx:if="{{!review}}" class="primary" disabled="{{busy}}" bindtap="answerNext">{{step < answerPages-1 ? '下一步' : '核对并提交'}}</button><button wx:else class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{staff ? '保存并提交骨干申请' : responseEditing ? '提交修改' : '提交并确认报名'}}</button></view>
 </block></block>
</block>
<text wx:if="{{message}}" class="body section" role="alert">{{message}}</text>
</block></view>
