<import src="../../templates/common.wxml" />
<view class="page"><template is="feedback" data="{{loading,error,needsLogin}}" />
<block wx:if="{{!loading && !error && !needsLogin && info}}"><text class="title">{{info.title}}</text>
<block wx:if="{{edit}}">
 <view class="chips"><view class="chip {{tab === 'edit' ? 'active' : ''}}" bindtap="tab" data-tab="edit">编辑问卷</view><view class="chip {{tab === 'entries' ? 'active' : ''}}" bindtap="tab" data-tab="entries">报名名单</view></view>
 <block wx:if="{{tab === 'edit'}}">
 <view class="panel"><view class="row"><text>启用问卷报名</text><switch checked="{{form.enabled}}" bindchange="field" data-key="enabled" /></view><text class="muted">用户填写后即确认报名；每个账号保留一份记录。</text></view>
 <block wx:if="{{form.enabled}}"><view class="panel section"><text class="label">报名说明</text><textarea value="{{form.intro}}" maxlength="1000" bindinput="field" data-key="intro" placeholder="说明本次报名所需的信息" />
 <text class="label">报名开始</text><view class="row"><picker mode="date" value="{{startDate}}" bindchange="time" data-key="start" data-part="date"><text>{{startDate || '选择日期'}}</text></picker><picker mode="time" value="{{startTime}}" bindchange="time" data-key="start" data-part="time"><text>{{startTime || '选择时间'}}</text></picker><button size="mini" bindtap="clearTime" data-key="start">不设</button></view>
 <text class="label">报名截止</text><view class="row"><picker mode="date" value="{{endDate}}" bindchange="time" data-key="end" data-part="date"><text>{{endDate || '选择日期'}}</text></picker><picker mode="time" value="{{endTime}}" bindchange="time" data-key="end" data-part="time"><text>{{endTime || '选择时间'}}</text></picker><button size="mini" bindtap="clearTime" data-key="end">不设</button></view>
 <view class="row section"><text>暂停接收报名</text><switch checked="{{form.closed}}" bindchange="field" data-key="closed" /></view></view>
 <view wx:for="{{editQuestions}}" wx:key="id" class="panel section question-editor"><text class="section-title">第 {{index+1}} 题</text><text class="label">题目标题</text><input value="{{item.label}}" maxlength="120" bindinput="question" data-index="{{index}}" data-key="label" placeholder="填写题目" />
 <picker range="{{typeLabels}}" value="{{item.typeIndex}}" bindchange="question" data-index="{{index}}" data-key="type"><view class="picker">题型：{{typeLabels[item.typeIndex]}} ▾</view></picker>
 <view class="row"><text>必填</text><switch checked="{{item.required}}" bindchange="question" data-index="{{index}}" data-key="required" /></view>
 <block wx:if="{{item.type === 'single' || item.type === 'multiple'}}"><text class="label">选项（每行一个）</text><textarea value="{{item.optionsText}}" maxlength="2400" bindinput="question" data-index="{{index}}" data-key="options" /></block>
 <view class="row section"><button size="mini" disabled="{{index === 0}}" bindtap="move" data-index="{{index}}" data-direction="-1">上移</button><button size="mini" disabled="{{index === editQuestions.length-1}}" bindtap="move" data-index="{{index}}" data-direction="1">下移</button><button size="mini" bindtap="remove" data-index="{{index}}">删除</button></view></view>
 <button class="plain section" disabled="{{editQuestions.length >= 20}}" bindtap="add">＋ 添加题目</button><text class="muted">最多 20 道题。已有报名保留提交时的题目和答案。</text></block>
 <button class="primary section" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存报名问卷</button>
 </block>
 <block wx:else><text class="subtitle">共 {{total}} 人报名</text><view wx:for="{{entries}}" wx:key="id" class="panel section"><text class="section-title">{{item.memberName}} · #{{item.id}}</text><view wx:for="{{item.rows}}" wx:for-item="answer" wx:key="label" class="answer"><text class="label">{{answer.label}}</text><text selectable>{{answer.answer}}</text></view></view><text wx:if="{{!entries.length && !busy}}" class="empty">暂无报名</text><view wx:if="{{pages > 1}}" class="row section"><button bindtap="previous" disabled="{{busy || page <= 1}}">上一页</button><text>{{page}} / {{pages}}</text><button bindtap="next" disabled="{{busy || page >= pages}}">下一页</button></view></block>
</block>
<block wx:else>
 <button wx:if="{{info.canManage}}" class="plain" bindtap="manage">编辑报名问卷 / 查看名单 →</button>
 <view wx:if="{{receipt}}" class="panel section"><text class="section-title">已报名</text><text class="body">报名编号：{{receipt.id}}</text><view wx:for="{{receipt.rows}}" wx:key="label" class="answer"><text class="label">{{item.label}}</text><text selectable>{{item.answer}}</text></view></view>
 <block wx:else><text class="body">{{form.intro}}</text><text class="badge">{{info.state}}</text><text class="muted">提交的答案仅供你本人和有权限的活动管理者查看，用于本次活动组织。</text>
 <block wx:if="{{form.enabled && info.state === '报名开放'}}"><view wx:for="{{questions}}" wx:for-item="question" wx:for-index="qindex" wx:key="id" class="panel section"><text class="label">{{qindex+1}}. {{question.label}}{{question.required ? ' *' : '（选填）'}}</text>
 <input wx:if="{{question.type === 'text'}}" value="{{answers[question.id] || ''}}" maxlength="200" bindinput="answer" data-id="{{question.id}}" placeholder="请输入" />
 <textarea wx:if="{{question.type === 'textarea'}}" value="{{answers[question.id] || ''}}" maxlength="2000" bindinput="answer" data-id="{{question.id}}" placeholder="请输入" />
 <radio-group wx:if="{{question.type === 'single'}}" bindchange="answer" data-id="{{question.id}}"><label wx:for="{{question.choices}}" wx:key="value" class="choice"><radio value="{{item.value}}" checked="{{item.checked}}"/>{{item.label}}</label></radio-group>
 <checkbox-group wx:if="{{question.type === 'multiple'}}" bindchange="answer" data-id="{{question.id}}"><label wx:for="{{question.choices}}" wx:key="value" class="choice"><checkbox value="{{item.value}}" checked="{{item.checked}}"/>{{item.label}}</label></checkbox-group>
 </view><text class="muted section">提交后即确认报名，内容仅供你与活动管理人员查看。</text><button class="primary section" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交并确认报名</button></block></block>
</block>
<text wx:if="{{message}}" class="body section" role="alert">{{message}}</text>
</block></view>
