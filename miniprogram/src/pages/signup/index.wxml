<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<import src="../../templates/questionnaire.wxml" />
<view class="page mini-page business-page native-page native-form-page signup-page">
  <button class="plain back" bindtap="back">返回</button>
  <view wx:if="{{loading || error || needsLogin}}" class="page-heading signup-heading">
    <text class="title">{{team ? '代表队申请' : staff ? '骨干招新申请' : edit ? '问卷与报名管理' : '活动报名'}}</text>
  </view>
  <template is="feedback" data="{{loading,error,needsLogin}}" />
  <view wx:if="{{team && error && confirmedReceipt && !needsLogin}}" class="business-summary signup-confirmed"><text class="section-title">上次保存已确认</text><text class="badge">{{confirmedReceipt.statusText}}</text><text class="body">{{confirmationMessage}}</text><view class="record-meta"><text>申请 {{confirmedReceipt.id}}</text><text>{{confirmedReceipt.updatedText}}</text></view><text wx:if="{{confirmedReceipt.feedback}}" class="body">处理反馈：{{confirmedReceipt.feedback}}</text><view wx:for="{{confirmedReceipt.rows}}" wx:key="id" class="answer"><text class="answer-label">{{item.label}}</text><text selectable>{{item.answer}}</text></view><button class="secondary section" bindtap="retry" disabled="{{loading || busy}}">重新读取申请状态</button></view>
  <block wx:if="{{!loading && !error && !needsLogin && info}}">
    <view class="page-heading signup-heading"><text class="task-context">{{team ? '代表队入队申请' : staff ? '骨干招新申请' : edit ? '活动问卷与报名管理' : '活动报名'}}</text><text class="title">{{info.title}}</text><view class="record-meta"><text wx:if="{{info.state}}" class="badge">{{info.state}}</text><text wx:if="{{receipt}}">{{applicationMode ? '申请' : '报名'}} {{receipt.id}}</text></view></view>
    <text wx:if="{{message}}" class="result-message signup-message" aria-role="alert">{{message}}</text>
    <block wx:if="{{edit}}">
      <view class="scope-switch"><button wx:if="{{info.canManage}}" class="scope-tab {{tab === 'edit' ? 'selected' : ''}}" bindtap="tab" data-tab="edit" disabled="{{busy || loading}}">编辑问卷</button><button wx:if="{{info.canViewSignups}}" class="scope-tab {{tab === 'entries' ? 'selected' : ''}}" bindtap="tab" data-tab="entries" disabled="{{busy || loading}}">报名名单</button></view>
      <view wx:if="{{info.canManage && tab === 'edit' && advancedEditing}}" class="task-section"><text class="task-section-title">题目与分支概览</text><text class="task-note">此问卷包含高级题型或分支规则。小程序可完整填写与查看报名名单，制作和逻辑设置请在网站编辑。</text><button class="secondary" bindtap="websiteEditor">复制网站编辑地址</button><view wx:for="{{editQuestions}}" wx:key="id" class="answer"><text class="answer-label">{{index+1}}. {{item.label}}</text><text class="muted">{{item.typeLabel}}</text></view></view>
      <block wx:elif="{{info.canManage && tab === 'edit'}}">
        <view class="task-section"><text class="task-section-title">报名方式</text><label class="selection-label"><view><text class="field-label">启用问卷报名</text><text class="muted">每个账号保留一份记录，提交后确认报名。</text></view><switch color="{{themePrimary}}" checked="{{form.enabled}}" bindchange="field" data-key="enabled" disabled="{{busy}}" /></label></view>
        <block wx:if="{{form.enabled}}">
          <view class="task-section"><text class="task-section-title">报名说明与开放时间</text><view class="field"><text class="field-label">报名说明（可选）</text><textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{form.intro}}" maxlength="1000" bindinput="field" data-key="intro" placeholder="说明参与条件与填写用途" disabled="{{busy}}" /></view>
            <view class="field"><text class="field-label">报名开始（可选）</text><view class="date-time-fields"><picker mode="date" value="{{startDate}}" bindchange="time" data-key="start" data-part="date" disabled="{{busy}}"><view class="picker-value">{{startDate || '选择日期'}}</view></picker><picker mode="time" value="{{startTime}}" bindchange="time" data-key="start" data-part="time" disabled="{{busy}}"><view class="picker-value">{{startTime || '选择时间'}}</view></picker></view><button class="plain" bindtap="clearTime" data-key="start" disabled="{{busy}}">不设开始时间</button></view>
            <view class="field"><text class="field-label">报名截止（可选）</text><view class="date-time-fields"><picker mode="date" value="{{endDate}}" bindchange="time" data-key="end" data-part="date" disabled="{{busy}}"><view class="picker-value">{{endDate || '选择日期'}}</view></picker><picker mode="time" value="{{endTime}}" bindchange="time" data-key="end" data-part="time" disabled="{{busy}}"><view class="picker-value">{{endTime || '选择时间'}}</view></picker></view><button class="plain" bindtap="clearTime" data-key="end" disabled="{{busy}}">不设截止时间</button></view>
            <label class="selection-label"><view><text class="field-label">暂停接收报名</text><text class="muted">已提交的报名记录保留。</text></view><switch color="{{themePrimary}}" checked="{{form.closed}}" bindchange="field" data-key="closed" disabled="{{busy}}" /></label>
          </view>
          <view class="task-section"><text class="task-section-title">报名题目（{{editQuestions.length}}）</text><text class="muted">按填写顺序排列。已有报名保留提交时的题目和答案。</text><view wx:for="{{editQuestions}}" wx:key="id" class="question-editor"><text class="question-position">第 {{index+1}} 题</text><view class="field"><text class="field-label">题目标题 *</text><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{item.label}}" maxlength="120" bindinput="question" data-index="{{index}}" data-key="label" placeholder="填写题目" disabled="{{busy}}" /></view><view class="field"><text class="field-label">题型</text><picker range="{{typeLabels}}" value="{{item.typeIndex}}" bindchange="question" data-index="{{index}}" data-key="type" disabled="{{busy}}"><view>{{typeLabels[item.typeIndex]}} ▾</view></picker></view><label class="selection-label"><text class="field-label">此题必填</text><switch color="{{themePrimary}}" checked="{{item.required}}" bindchange="question" data-index="{{index}}" data-key="required" disabled="{{busy}}" /></label><view wx:if="{{item.type === 'single' || item.type === 'multiple'}}" class="field"><text class="field-label">选项（每行一个）</text><textarea cursor-spacing="24" value="{{item.optionsText}}" maxlength="2400" bindinput="question" data-index="{{index}}" data-key="options" disabled="{{busy}}" /></view><view class="compact-actions"><button class="plain" disabled="{{busy || index === 0}}" bindtap="move" data-index="{{index}}" data-direction="-1">上移</button><button class="plain" disabled="{{busy || index === editQuestions.length-1}}" bindtap="move" data-index="{{index}}" data-direction="1">下移</button><button class="danger" bindtap="remove" data-index="{{index}}" disabled="{{busy}}">删除此题</button></view></view><button class="secondary section" bindtap="add" disabled="{{busy}}">添加题目</button></view>
        </block>
        <view class="form-footer"><text class="field-note editor-save-note">确认报名时间与题目后，保存本次设置。</text><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存报名问卷</button></view>
      </block>
      <block wx:elif="{{info.canViewSignups && tab === 'entries'}}">
        <view class="section-head section"><text class="section-title">已提交报名</text><text class="muted">共 {{total}} 人</text></view><text wx:if="{{busy}}" class="task-note" aria-role="status">正在读取报名名单…</text><view class="record-list"><view wx:for="{{entries}}" wx:key="id" class="task-record"><view class="record-heading"><text class="section-title">{{item.memberName}}</text><text class="record-id">报名 {{item.id}}</text></view><button class="plain disclosure" bindtap="toggleEntry" data-id="{{item.id}}" disabled="{{busy}}" aria-expanded="{{expandedEntryId === item.id}}"><text>{{expandedEntryId === item.id ? '收起报名资料' : '查看已提交资料'}}</text><text>{{expandedEntryId === item.id ? '−' : '＋'}}</text></button><view wx:if="{{expandedEntryId === item.id}}"><view wx:for="{{item.rows}}" wx:for-item="answer" wx:key="label" class="answer"><text class="answer-label">{{answer.label}}</text><text selectable>{{answer.answer}}</text></view></view></view></view><view wx:if="{{!entries.length && !busy}}" class="empty"><text class="state-title">暂无报名</text><text class="muted">已提交的报名资料会显示在这里。</text></view><view wx:if="{{pages > 1}}" class="pagination"><button bindtap="previous" disabled="{{busy || page <= 1}}">上一页</button><text>{{page}} / {{pages}}</text><button bindtap="next" disabled="{{busy || page >= pages}}">下一页</button></view>
      </block>
    </block>
    <block wx:else>
      <view wx:if="{{(!applicationMode && (info.canManage || info.canViewSignups)) || (staff && info.actions.review) || (team && info.actions.review)}}" class="compact-actions signup-tools"><button wx:if="{{!applicationMode && (info.canManage || info.canViewSignups)}}" class="plain" bindtap="manage">{{info.canManage ? '管理报名问卷' : '查看报名名单'}}</button><button wx:if="{{staff && info.actions.review}}" class="plain" bindtap="staffReview">骨干申请审核</button><button wx:if="{{team && info.actions.review}}" class="plain" bindtap="teamReview">代表队申请审核</button></view>
      <view wx:if="{{recoveryRows.length}}" class="business-summary signup-recovery"><text class="section-title">尚未保存的内容</text><text class="muted">当前状态无法提交，内容仅在本页保留。可重新加载核对申请状态。</text><view wx:for="{{recoveryRows}}" wx:key="id" class="answer"><text class="answer-label">{{item.label}}</text><text selectable>{{item.answer}}</text></view></view>
      <view wx:if="{{receipt && !responseEditing}}" class="receipt-panel">
        <view class="business-summary signup-receipt"><text class="task-context">本人{{applicationMode ? '申请' : '报名'}}回执</text><text class="section-title">{{applicationMode ? receipt.statusText : '已报名'}}</text><view class="record-meta"><text>编号 {{receipt.id}}</text><text wx:if="{{applicationMode}}">更新于 {{receipt.updatedText}}</text></view><view wx:if="{{receipt.feedback}}" class="task-feedback"><text class="task-feedback-label">处理反馈</text><text class="body">{{receipt.feedback}}</text></view><view wx:if="{{(applicationMode ? info.actions.edit : info.state === '报名开放') || (applicationMode && info.actions.withdraw)}}" class="actions"><button wx:if="{{applicationMode ? info.actions.edit : info.state === '报名开放'}}" class="primary" disabled="{{busy}}" bindtap="editAnswers">{{applicationMode ? team && receipt.status === 'draft' ? '继续填写草稿' : receipt.status === 'withdrawn' ? '重新提交申请' : '修改申请' : '修改作答'}}</button><button wx:if="{{applicationMode && info.actions.withdraw}}" class="plain" disabled="{{busy}}" bindtap="withdraw">撤回申请</button></view><text wx:if="{{!(applicationMode ? info.actions.edit : info.state === '报名开放')}}" class="task-note">当前回执只读。{{info.state}}</text><button class="plain" disabled="{{busy}}" bindtap="retry">重新加载已提交内容</button></view>
        <view class="task-section"><text class="task-section-title">{{team && receipt.status === 'draft' ? '已保存的草稿' : '已提交内容'}}</text><view wx:for="{{receipt.rows}}" wx:key="id" class="answer"><text class="answer-label">{{item.label}}</text><text selectable>{{item.answer}}</text></view></view>
      </view>
      <block wx:else>
        <text wx:if="{{form.intro}}" class="body signup-intro">{{form.intro}}</text>
        <view class="signup-privacy"><text wx:if="{{staff}}" class="task-note">{{info.privacy}}</text><text wx:if="{{staff && info.deadlinePolicy}}" class="muted">{{info.deadlinePolicy}}</text><text wx:if="{{team}}" class="task-note">申请资料用于本队选拔，仅供本人及当前有权限的管理者查看。保存草稿后仍需提交，录取不授予平台或社群任职，也不代替公开简介授权。</text><text wx:if="{{team && info.historyNote}}" class="muted">{{info.historyNote}}</text><text wx:if="{{!applicationMode}}" class="task-note">提交的答案仅供本人和有权限的活动管理者查看，用于本次活动组织。</text></view>
        <block wx:if="{{form.enabled && (team ? (info.actions.draft || info.actions.submit) : staff ? (responseEditing ? info.actions.edit : info.actions.submit) : info.state === '报名开放')}}">
          <view class="answer-progress">
            <view class="signup-stages" aria-label="填写、核对、查看回执">
              <text class="signup-stage {{!review ? 'current' : ''}}">填写资料</text>
              <text class="signup-stage {{review ? 'current' : ''}}">核对提交</text>
              <text class="signup-stage">查看回执</text>
            </view>
            <view class="progress-label"><text class="section-title">{{review ? '核对提交内容' : responseEditing ? team && receipt.status === 'draft' ? '继续填写草稿' : '修改已提交资料' : applicationMode ? '填写申请资料' : '填写报名资料'}}</text><text class="muted">已填写 {{completed}} / {{answerTotal}} 题</text></view>
            <progress percent="{{progress}}" activeColor="{{themePrimary}}" backgroundColor="{{themeLine}}" stroke-width="3" />
            <text class="field-note">带 * 为必填。{{review ? '确认本页内容后，使用下方按钮提交。' : answerPages > 1 ? '翻页时会保留已填内容，完成后再核对提交。' : '完成后可先核对，再提交。'}}</text>
          </view>
          <view wx:if="{{review}}" class="review-answers"><text class="muted review-intro">以下内容将用于本次{{applicationMode ? '申请' : '报名'}}。如需调整，可在下方返回修改。</text><view wx:for="{{reviewRows}}" wx:key="id" class="answer"><text class="answer-label">{{item.label}}</text><text selectable>{{item.answer}}</text></view></view>
          <block wx:else><text wx:if="{{answerPages > 1}}" class="question-page-label">第 {{step+1}} / {{answerPages}} 页</text><block wx:for="{{questions}}" wx:for-item="question" wx:key="id"><template is="questionnaire-question" data="{{question,busy,theme,themePrimary,themeMuted}}" /></block><text wx:if="{{branchNotice}}" class="branch-notice">{{branchNotice}}</text></block>
          <view class="form-footer signup-submit"><text wx:if="{{team && info.actions.draft}}" class="muted">保存草稿不会进入审核队列，完成后仍需核对提交。</text><text wx:if="{{busy}}" class="field-note" aria-role="status">正在保存，请稍候。</text><view class="action-bar"><button wx:if="{{review || step > 0}}" class="secondary" disabled="{{busy}}" bindtap="answerPrevious">{{review ? '返回修改' : '上一页'}}</button><button wx:if="{{!review}}" class="primary" disabled="{{busy}}" bindtap="answerNext">{{step < answerPages-1 ? '下一页' : '核对填写内容'}}</button><button wx:else class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || (team && !info.actions.submit)}}">{{team ? '提交代表队申请' : staff ? '保存并提交骨干申请' : responseEditing ? '提交修改' : '提交并确认报名'}}</button></view><button wx:if="{{team && info.actions.draft}}" class="plain" bindtap="saveDraft" loading="{{busy}}" disabled="{{busy}}">保存草稿，稍后继续</button></view>
        </block>
        <view wx:else class="state signup-unavailable">
          <text class="state-title">{{form.enabled ? '当前暂不能填写' : '当前未开放问卷'}}</text>
          <text class="muted">{{info.state || '请重新读取当前状态，核对允许的操作。'}}</text>
          <button class="secondary" bindtap="retry" disabled="{{busy}}">重新读取状态</button>
        </view>
      </block>
      <button wx:if="{{team}}" class="plain section" bindtap="openPage" data-page="team">代表队招新与我的成员记录</button>
    </block>
  </block>
</view>
