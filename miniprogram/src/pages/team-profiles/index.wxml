<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page team-profiles-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{t.kicker}}</text>
      <text class="zj-hero-title">{{t.title}}</text>
      <text class="zj-hero-lead">{{t.lead}}</text>
    </view>
  </view>
  <template is="feedback" data="{{loading,error,needsLogin,t}}" />
  <view wx:if="{{operationError || message || locked || conflict || confirmationPending}}" class="profiles-feedback">
    <text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text>
    <text wx:if="{{message}}" class="zj-callout zj-callout-success" aria-role="status">{{message}}</text>
    <text wx:if="{{locked}}" class="zj-callout zj-callout-warning">{{t.locked}}</text>
    <text wx:if="{{conflict}}" class="zj-callout zj-callout-warning">{{t.conflict}}</text>
    <text wx:if="{{confirmationPending}}" class="zj-callout zj-callout-warning">{{t.pending}}</text>
    <button wx:if="{{confirmationPending}}" class="secondary" bindtap="retry" disabled="{{busy || loading}}">{{t.refreshSave}}</button>
    <button wx:if="{{locked || conflict}}" class="secondary" bindtap="reload" disabled="{{busy || loading}}">{{t.reloadSaved}}</button>
  </view>

  <view wx:if="{{loaded && !needsLogin && !editing}}" class="zj-sheet profiles-own">
    <text class="zj-sheet-title">{{t.mine}}</text>
    <text wx:if="{{eligible && !locked}}" class="zj-pill {{draft.visible ? 'zj-pill-success' : 'zj-pill-neutral'}}">{{draft.visible ? t.showing : t.hidden}}</text>
    <text wx:if="{{eligible && !locked}}" class="zj-form-hint">{{draft.visible ? t.showingHint : t.hiddenHint}}</text>
    <text wx:if="{{!eligible && !locked}}" class="zj-form-hint">{{t.ineligible}}</text>
    <button wx:if="{{eligible && !locked}}" class="primary" bindtap="edit" disabled="{{busy || loading}}">{{t.edit}}</button>
  </view>

  <view wx:if="{{editing}}" class="profiles-editor">
    <view class="profiles-steps"><text class="profiles-step {{!previewing ? 'current' : 'done'}}">{{t.stepEdit}}</text><text class="profiles-step {{previewing ? 'current' : ''}}">{{t.stepReview}}</text></view>
    <text class="zj-callout">{{t.publicOnly}}</text>
    <block wx:if="{{!previewing}}">
      <view class="zj-sheet">
        <text class="zj-sheet-title">{{t.nickname}}</text>
        <view class="field"><text class="field-label">{{t.nicknameLabel}}</text><input cursor-spacing="24" value="{{draft.displayName}}" maxlength="40" bindinput="input" data-field="displayName" disabled="{{busy || loading || locked || confirmationPending}}" /><text class="zj-form-hint">{{t.nicknameHint}}</text></view>
      </view>
      <view class="zj-sheet">
        <text class="zj-sheet-title">{{t.extra}}</text>
        <text class="zj-form-hint">{{t.extraHint}}</text>
        <view class="field"><text class="field-label">{{t.position}}</text><input cursor-spacing="24" value="{{draft.position}}" maxlength="60" bindinput="input" data-field="position" disabled="{{busy || loading || locked || confirmationPending}}" /></view>
        <view class="field"><text class="field-label">{{t.bio}}</text><textarea cursor-spacing="24" value="{{draft.biography}}" maxlength="400" auto-height bindinput="input" data-field="biography" disabled="{{busy || loading || locked || confirmationPending}}" /><text class="zj-form-hint">{{t.bioHint}}</text></view>
        <view class="field">
          <text class="field-label">{{t.avatar}}</text>
          <view class="profiles-avatar-editor">
            <image wx:if="{{draftAvatar}}" class="profiles-avatar" src="{{draftAvatar}}" mode="aspectFill" aria-label="{{t.avatarPreview}}" />
            <text wx:else class="profiles-avatar profiles-avatar-empty">{{draft.displayName ? draft.displayName[0] : '?'}}</text>
            <view class="profiles-avatar-actions"><button class="secondary" bindtap="chooseAvatar" disabled="{{busy || loading || locked || confirmationPending}}">{{draft.hasAvatar ? t.changeAvatar : t.chooseAvatar}}</button><button wx:if="{{draft.hasAvatar}}" class="plain" bindtap="removeAvatar" disabled="{{busy || loading || locked || confirmationPending}}">{{t.removeAvatar}}</button></view>
          </view>
          <text class="zj-form-hint">{{t.avatarHint}}</text>
          <button class="plain" bindtap="openPrivacy" disabled="{{busy}}">{{t.privacyGuide}}</button>
        </view>
      </view>
      <view class="zj-sheet">
        <text class="zj-sheet-title">{{t.displayChoice}}</text>
        <label class="consent profiles-consent"><view><text>{{t.consentLabel}}</text><text class="zj-form-hint">{{t.consentHint}}</text></view><switch color="{{themePrimary}}" checked="{{draft.visible}}" bindchange="consent" disabled="{{busy || loading || locked || confirmationPending}}" aria-label="{{t.consentLabel}}" /></label>
        <text class="zj-form-hint">{{t.consentNote}}</text>
      </view>
      <view class="zj-dock"><button class="primary" bindtap="preview" disabled="{{busy || loading}}">{{t.previewAction}}</button><button class="plain" bindtap="cancel" disabled="{{busy || loading}}">{{t.cancel}}</button></view>
    </block>
    <view wx:else class="profiles-preview">
      <view class="profiles-card">
        <image wx:if="{{draftAvatar}}" class="profiles-avatar" src="{{draftAvatar}}" mode="aspectFill" aria-label="{{t.previewAvatar}}" />
        <text wx:else class="profiles-avatar profiles-avatar-empty">{{draft.displayName ? draft.displayName[0] : '?'}}</text>
        <view class="profiles-card-main"><text class="zj-card-title">{{draft.displayName}}</text><text wx:if="{{draft.position}}" class="zj-pill zj-pill-action">{{draft.position}}</text><text wx:if="{{draft.biography}}" class="zj-card-summary biography" selectable>{{draft.biography}}</text></view>
      </view>
      <view class="zj-sheet">
        <view class="zj-record-head"><text class="field-label">{{t.savedChoice}}</text><text class="zj-pill {{draft.visible ? 'zj-pill-success' : 'zj-pill-neutral'}}">{{draft.visible ? t.showProfile : t.hideProfile}}</text></view>
        <text class="zj-form-hint">{{confirmationPending ? t.pendingNote : draft.visible ? t.showNote : t.hideNote}}</text>
      </view>
      <view class="zj-dock"><button class="secondary" bindtap="returnToEdit" disabled="{{busy}}">{{t.backToEdit}}</button><button class="primary" bindtap="save" disabled="{{busy || loading || locked || conflict || confirmationPending}}" loading="{{busy}}">{{t.save}}</button><button class="plain" bindtap="cancel" disabled="{{busy || loading}}">{{t.cancel}}</button></view>
    </view>
  </view>

  <view wx:if="{{loaded && !loading && !needsLogin}}" class="zj-section">
    <view class="zj-section-head"><view><text class="zj-section-title">{{t.publicProfiles}}</text><text class="zj-small">{{t.publicHint}}</text></view><button class="plain zj-more" bindtap="retry" disabled="{{busy || loading}}">{{t.refresh}}</button></view>
    <view wx:if="{{!profiles.length}}" class="zj-empty"><text class="zj-empty-icon">👤</text><text class="zj-empty-title">{{t.emptyTitle}}</text><text class="zj-small">{{t.emptyBody}}</text></view>
    <view class="zj-list">
      <view wx:for="{{profiles}}" wx:key="id" class="profiles-card">
        <image wx:if="{{item.avatarPath}}" class="profiles-avatar" src="{{item.avatarPath}}" mode="aspectFill" aria-label="{{item.displayName}}{{t.avatarOfSuffix}}" />
        <text wx:else class="profiles-avatar profiles-avatar-empty">{{item.displayName[0]}}</text>
        <view class="profiles-card-main"><text class="zj-card-title">{{item.displayName}}</text><text wx:if="{{item.position}}" class="zj-pill zj-pill-action">{{item.position}}</text><text wx:if="{{item.biography}}" class="zj-card-summary biography" selectable>{{item.biography}}</text></view>
      </view>
    </view>
    <text wx:if="{{imageError}}" class="zj-form-hint">{{imageError}}</text>
  </view>
</view>
<privacy-consent id="privacyConsent" />
