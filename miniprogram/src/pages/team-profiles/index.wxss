@import "../../templates/business.wxss";
@import "../../styles/native-forms.wxss";

/* V2 member profile: two-step editor (edit → review), profile cards, roster. */
.team-profiles-v2 { padding-top: 0; }
.profiles-feedback { display: flex; flex-direction: column; gap: 10rpx; }
.profiles-own { gap: 12rpx; }
.profiles-own .zj-pill { align-self: flex-start; }
.profiles-steps { display: flex; gap: 10rpx; margin-bottom: 8rpx; }
.profiles-step { flex: 1; padding: 12rpx 8rpx; border-radius: 999rpx; background: var(--z-disabled-bg); color: var(--z-muted); font-size: 24rpx; font-weight: 800; text-align: center; }
.profiles-step.current { background: var(--z-primary); color: var(--z-on-primary); }
.profiles-step.done { background: var(--z-success-bg); color: var(--z-success); }
.profiles-avatar-editor { display: flex; align-items: center; gap: 20rpx; }
.profiles-avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 120rpx; height: 120rpx; border-radius: 50%; background: var(--z-media); }
.profiles-avatar-empty { background: linear-gradient(135deg, var(--z-primary), var(--z-stage2)); color: #fff; font-size: 48rpx; font-weight: 900; }
.profiles-avatar-actions { display: flex; flex-direction: column; gap: 8rpx; }
.profiles-consent { align-items: center; justify-content: space-between; }
.profiles-preview { display: flex; flex-direction: column; gap: 4rpx; }
.profiles-card { display: flex; gap: 22rpx; padding: 26rpx; border: 1rpx solid var(--z-line); border-radius: 32rpx; background: var(--z-surface); }
.profiles-card-main { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 8rpx; }
.biography { white-space: pre-wrap; }
