<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page business-page team-honor-workspace-page">
  <button class="plain back" bindtap="back">返回</button><view class="page-heading"><text class="title">{{view === 'review' ? '荣誉审核工作台' : '我的荣誉投稿'}}</text><text class="subtitle">{{view === 'review' ? '核对本次文字与成果材料，再决定是否进入公开档案。' : '继续草稿、查看审核反馈，记录队伍的共同成果。'}}</text></view><template is="feedback" data="{{needsLogin}}" />
  <block wx:if="{{!needsLogin}}">
    <view class="scope-switch"><button class="scope-tab {{view === 'mine' ? 'selected' : ''}}" bindtap="view" data-view="mine" disabled="{{busy || loading}}">我的记录</button><button wx:if="{{actions.review}}" class="scope-tab {{view === 'review' ? 'selected' : ''}}" bindtap="view" data-view="review" disabled="{{busy || loading}}">社群审核</button></view>
    <view wx:if="{{view === 'mine' && actions.create && teams.length}}" class="honor-create"><button class="primary" bindtap="create" disabled="{{busy || loading || !ready}}">新建荣誉投稿</button><text class="field-note">现任队员可投稿，由本社群其他有权限的管理员审核。</text></view><text wx:if="{{view === 'mine' && ready && !teams.length}}" class="task-note">当前暂无可投稿的有效队伍，本人历史记录仍保留。</text>
    <text wx:if="{{busy}}" class="task-note">本次确认、读取或保存尚未结束，请稍候。</text><text wx:if="{{loading}}" class="muted">正在核对荣誉与操作权限…</text><view wx:if="{{error}}"><text class="error">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{busy || loading}}">重新加载</button></view><text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text><text wx:if="{{message}}" class="result-message" aria-role="status">{{message}}</text>
    <view class="section-head section"><view><text class="section-title">{{view === 'review' ? '当前授权范围的记录' : '投稿回执'}}</text><text wx:if="{{ready}}" class="muted">共 {{totalDocs}} 条，已加载至第 {{page}} 页</text></view><button class="plain" bindtap="retry" disabled="{{busy || loading}}">刷新核对</button></view>
    <view class="record-list"><view wx:for="{{docs}}" wx:for-item="entry" wx:key="id" id="honor-record-{{entry.id}}" class="task-record honor-work-record {{detail && detail.id === entry.id ? 'is-open' : ''}}">
      <view class="record-heading"><view><text class="task-context">{{entry.date || '日期待补充'}}</text><text class="section-title">{{entry.title}}</text></view><text class="badge">{{entry.statusText}}</text></view><view class="honor-result"><text>{{entry.competition || '赛事待补充'}}</text><text>{{entry.placing || '奖项待补充'}}</text></view><view class="record-meta"><text>队伍 {{entry.team}}</text><text>投稿 {{entry.id}}</text><text>修订 {{entry.revision}}</text></view><text class="muted">投稿人：{{entry.authorName}}</text>
      <view wx:if="{{entry.reviewNote}}" class="task-feedback"><text class="task-feedback-label">处理反馈</text><text class="body">{{entry.reviewNote}}</text></view>
      <button wx:if="{{!detail || detail.id !== entry.id}}" class="secondary disclosure" bindtap="inspect" data-id="{{entry.id}}" disabled="{{busy || loading}}"><text>查看文字与本次证据</text><text>＋</text></button>
      <view wx:if="{{detail && detail.id === entry.id}}" class="record-detail evidence-detail"><view class="section-head"><text class="section-title">本次审核材料</text><button class="plain" bindtap="closeDetail" disabled="{{busy}}">收起</button></view><text class="muted">批准前仅本人及当前有权审核者可读；获批材料随荣誉档案公开。</text><text wx:if="{{detail.description}}" class="body" selectable>{{detail.description}}</text><text class="material-title">图片 {{entry.imageCount}} 份{{entry.hasVideo ? '，含视频' : ''}}</text>
        <view wx:for="{{detailImages}}" wx:key="index" class="honor-evidence"><button class="image-button" hover-class="pressed" wx:if="{{item.path}}" bindtap="previewEvidence" data-path="{{item.path}}" aria-label="{{item.caption || '荣誉证据图片'}}"><image class="photo" mode="widthFix" src="{{item.path}}" aria-label="{{item.caption || '荣誉证据图片'}}" /></button><text class="muted">{{item.caption}}</text></view><text wx:if="{{imageError}}" class="task-note">{{imageError}}</text>
        <button wx:if="{{detail.hasVideo}}" class="secondary section" bindtap="viewVideo" disabled="{{busy || loading}}">读取本次视频证据</button><video wx:if="{{videoSource}}" id="honor-evidence" class="evidence-video" src="{{videoSource}}" controls autoplay="{{false}}" binderror="videoError" data-id="{{detail.id}}" data-revision="{{detail.revision}}" aria-label="本次荣誉视频证据" /><text wx:if="{{videoError}}" class="error">{{videoError}}</text><button wx:if="{{detail.hasVideo}}" class="plain" bindtap="websiteEvidence" disabled="{{busy}}">复制网站证据页地址</button>
        <view wx:if="{{entry.decisions.length || entry.actions.hide}}" class="review-actions"><text class="section-title">处理这份荣誉</text><text class="muted">请核对本修订的材料与公开范围。批准后进入队伍荣誉档案，并显示在对应社群的荣誉索引中。</text><view class="field"><text class="field-label">处理说明</text><textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{entry.noteDraft}}" maxlength="1000" bindinput="note" data-id="{{entry.id}}" placeholder="退回、拒绝或隐藏时必填具体原因" disabled="{{busy || loading || !ready}}" /></view><view class="actions"><button wx:for="{{entry.decisions}}" wx:key="action" class="{{item.action === 'approve' ? 'primary' : item.action === 'reject' ? 'danger' : 'secondary'}}" bindtap="perform" data-action="{{item.action}}" data-id="{{entry.id}}" disabled="{{busy || loading || !ready}}">{{item.label}}</button><button wx:if="{{entry.actions.hide}}" class="danger" bindtap="perform" data-action="hide" data-id="{{entry.id}}" disabled="{{busy || loading || !ready}}">隐藏荣誉</button></view></view>
      </view>
      <view class="actions"><button wx:if="{{entry.actions.edit}}" class="secondary" bindtap="edit" data-id="{{entry.id}}" disabled="{{busy || loading || !ready}}">{{entry.state === 'draft' ? '继续编辑草稿' : '修改 / 重新提交'}}</button><button wx:if="{{entry.actions.withdraw}}" class="plain" bindtap="perform" data-action="withdraw" data-id="{{entry.id}}" disabled="{{busy || loading || !ready}}">撤回投稿</button></view><text wx:if="{{!ready}}" class="task-note">当前回执只读，请重新加载核对操作。</text>
    </view></view>
    <view wx:if="{{!docs.length && ready && !loading}}" class="empty"><text class="state-title">{{view === 'review' ? '当前范围暂无荣誉记录' : '尚无本人荣誉投稿'}}</text><text class="muted">{{view === 'review' ? '可刷新核对最新投稿与权限。' : '有可投稿的队伍时，可从上方新建一份荣誉。'}}</text></view><button wx:if="{{hasMore}}" class="plain section" bindtap="onReachBottom" disabled="{{busy || loading || !ready}}">加载更多记录</button>
  </block>
</view>
