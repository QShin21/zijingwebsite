.archive-gateway { border-top: 2rpx solid var(--z-text); border-bottom: 1rpx solid var(--z-line); }
.mini-page .archive-main { display: block; padding: 30rpx 0; border-bottom: 1rpx solid var(--z-line); }
.archive-main:last-child { border-bottom: 0; }
.archive-title { display: block; font-size: 42rpx; font-weight: 700; line-height: 1.4; margin-bottom: 12rpx; }
.archive-main .entry-link { display: block; margin-top: 16rpx; color: var(--z-link); font-size: 28rpx; }
.about-links { display: flex; flex-wrap: wrap; column-gap: 32rpx; }
.about-links > button { flex: 1; min-width: 220rpx; text-align: left; }
