.archive-portals { display: flex; align-items: stretch; gap: 12px; }
.mini-page.native-page .archive-portal { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 20px 16px 16px; border: 1px solid var(--z-line); border-left: 4px solid var(--z-primary); border-radius: 4px 12px 12px 4px; background: var(--z-surface); }
.mini-page.native-page .archive-honors { border-left-color: var(--z-secondary-border); background: var(--z-secondary-bg); }
.archive-book-top { width: 32px; height: 4px; margin-bottom: 16px; background: var(--z-primary); opacity: .4; }
.archive-honors .archive-book-top { width: 20px; border-radius: 0 0 6px 6px; height: 12px; margin-bottom: 8px; }
.archive-portal-title { display: block; font-size: 21px; line-height: 1.4; font-weight: 650; word-break: break-word; }
.archive-portal-description { display: block; flex: 1; margin-top: 12px; color: var(--z-subtitle); font-size: 14px; line-height: 1.75; word-break: break-word; }
.archive-portal-action { display: block; margin-top: 20px; color: var(--z-link); font-size: 15px; line-height: 1.5; }
.archive-group .native-section-head { margin-bottom: 8px; }
.mini-page.native-page .archive-index-item { display: flex; align-items: center; gap: 16px; width: 100%; padding: 16px 0; }
.archive-index-copy { flex: 1; min-width: 0; }
.archive-index-copy .native-summary { margin-top: 4px; }
.archive-index-sign { flex-shrink: 0; color: var(--z-link); font-size: 24px; }
.archive-index-mark { position: relative; flex-shrink: 0; width: 44px; height: 44px; background: var(--z-secondary-bg); border-radius: 8px; color: var(--z-primary); }
.archive-mark-shape { position: absolute; top: 11px; left: 12px; width: 20px; height: 22px; border: 1px solid currentColor; border-radius: 2px; }
.archive-mark-line { position: absolute; top: 17px; left: 16px; width: 12px; height: 8px; border-top: 1px solid currentColor; border-bottom: 1px solid currentColor; }
.archive-mark-albums .archive-mark-shape { width: 24px; height: 18px; left: 10px; top: 13px; }
.archive-mark-albums .archive-mark-line { width: 8px; height: 8px; left: 17px; top: 18px; border: 1px solid currentColor; transform: rotate(45deg); }
.archive-mark-club-showcase .archive-mark-shape { width: 22px; height: 22px; left: 11px; border-radius: 50%; }
.archive-mark-club-showcase .archive-mark-line { border-bottom: 0; width: 12px; height: 0; left: 16px; top: 22px; }
.archive-participate { padding-top: 24px; border-top: 1px solid var(--z-line); }
.archive-participate .native-section-head { margin-bottom: 0; }
.archive-participate .shortcut:last-child { border-bottom: 0; }
.archive-about-links { display: flex; flex-wrap: wrap; gap: 0 16px; margin-top: 12px; }
.mini-page.native-page .archive-about-links > button { flex: 1 1 calc(50% - 16px); min-width: 120px; text-align: left; }
@media (max-width: 359px) { .mini-page.native-page .archive-portal { padding-left: 12px; padding-right: 12px; } .archive-portal-title { font-size: 20px; } }
