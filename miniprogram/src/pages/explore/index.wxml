<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page explore-page">
  <view class="page-heading"><text class="eyebrow">紫荆目录</text><text class="title">赛场与日常</text><text class="subtitle">从代表队、荣誉与影像，读到社团每一段已发布的记录。</text></view><template is="feedback" data="{{needsLogin}}" />
  <view class="directory-block"><button class="content-link directory-row" bindtap="openWebsite" data-url="/teams/recruitment"><view class="directory-main"><text class="directory-title">代表队招新与我的记录</text><text class="muted">查看选拔批次、本人申请及成员关系。</text></view><text class="directory-arrow">→</text></button><button class="content-link directory-row" bindtap="openWebsite" data-url="/teams/honors"><view class="directory-main"><text class="directory-title">荣誉投稿与审核</text><text class="muted">当前队员投稿，有权管理员审核。</text></view><text class="directory-arrow">→</text></button></view>
  <view wx:for="{{groups}}" wx:key="title" class="section"><text class="section-title">{{item.title}}</text><button wx:for="{{item.items}}" wx:for-item="entry" wx:key="collection" class="content-link directory-row" bindtap="openCollection" data-collection="{{entry.collection}}"><text class="directory-index">{{entry.mark}}</text><view class="directory-main"><text class="directory-title">{{entry.title}}</text><text class="muted">{{entry.subtitle}}</text></view><text class="directory-arrow">→</text></button></view>
  <view class="section"><text class="section-title">关于社团</text><button class="content-link directory-row" bindtap="openWebsite" data-url="/about"><text class="directory-main">关于紫荆</text><text class="directory-arrow">→</text></button><button class="content-link directory-row" bindtap="openWebsite" data-url="/join"><text class="directory-main">加入紫荆</text><text class="directory-arrow">→</text></button><button class="content-link directory-row" bindtap="openWebsite" data-url="/contact"><text class="directory-main">联系与合作</text><text class="directory-arrow">→</text></button><button class="content-link directory-row" bindtap="openWebsite" data-url="/privacy"><text class="directory-main">隐私说明</text><text class="directory-arrow">→</text></button></view>
</view>
