<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page explore-page">
  <view class="page-heading"><text class="title">代表队与荣誉</text><text class="subtitle">认识并肩上场的队伍，查阅赛事成果和社团日常。</text></view>
  <template is="feedback" data="{{needsLogin}}" />
  <view class="archive-gateway"><button class="content-link archive-main" bindtap="openCollection" data-collection="teams"><text class="archive-title">代表队档案</text><text class="muted">队伍介绍、赛季阵容与公开资料</text><text class="entry-link">查看队伍</text></button><button class="content-link archive-main" bindtap="openCollection" data-collection="honors"><text class="archive-title">荣誉年鉴</text><text class="muted">按年份与项目查阅核验成果</text><text class="entry-link">查阅档案</text></button></view>
  <view class="section"><view class="section-heading"><text class="section-title">参与代表队</text></view><button class="content-link shortcut" bindtap="openWebsite" data-url="/teams/recruitment"><view class="shortcut-main"><text class="shortcut-title">招新与我的队伍</text><text class="muted">选拔批次、入队申请、成员记录。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button><button class="content-link shortcut" bindtap="openWebsite" data-url="/teams/honors"><view class="shortcut-main"><text class="shortcut-title">荣誉投稿与审核</text><text class="muted">现任队员投稿，查看自己的处理进度。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button></view>
  <view wx:for="{{groups}}" wx:key="title" class="section"><view class="section-heading"><text class="section-title">{{item.title}}</text></view><button wx:for="{{item.items}}" wx:for-item="entry" wx:key="collection" class="content-link shortcut" bindtap="openCollection" data-collection="{{entry.collection}}"><view class="shortcut-main"><text class="shortcut-title">{{entry.title}}</text><text class="muted">{{entry.subtitle}}</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button></view>
  <view class="section"><view class="section-heading"><text class="section-title">关于社团</text></view><view class="about-links"><button class="plain" bindtap="openWebsite" data-url="/about">关于紫荆</button><button class="plain" bindtap="openWebsite" data-url="/join">加入紫荆</button><button class="plain" bindtap="openWebsite" data-url="/contact">联系与合作</button><button class="plain" bindtap="openWebsite" data-url="/privacy">隐私说明</button></view></view>
</view>
