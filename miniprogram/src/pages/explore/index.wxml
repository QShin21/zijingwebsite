<import src="../../templates/common.wxml" />
<view class="page mini-page explore-page"><text class="eyebrow">EXPLORE ZIJING</text><text class="title">每一段热爱，
都有回声。</text><text class="subtitle">了解社团，回看赛场与日常。</text><template is="feedback" data="{{needsLogin}}" /><button class="secondary section" bindtap="openWebsite" data-url="/teams/recruitment">代表队招新与我的记录 →</button><button class="plain" bindtap="openWebsite" data-url="/teams/honors">我的荣誉投稿 / 当前审核入口 →</button><view wx:for="{{groups}}" wx:key="title" class="section"><text class="section-title">{{item.title}}</text><view class="explore-list panel"><button wx:for="{{item.items}}" wx:for-item="entry" wx:key="collection" class="explore-row content-link" bindtap="openCollection" data-collection="{{entry.collection}}" hover-class="pressed"><text class="explore-mark">{{entry.mark}}</text><view class="explore-main"><text class="explore-title">{{entry.title}}</text><text class="muted">{{entry.subtitle}}</text></view><text class="more">↗</text></button></view></view><view class="section panel"><button class="explore-row content-link" bindtap="openWebsite" data-url="/about" hover-class="pressed"><text class="explore-title">关于紫荆</text><text>→</text></button><button class="explore-row content-link" bindtap="openWebsite" data-url="/join" hover-class="pressed"><text class="explore-title">加入紫荆</text><text>→</text></button><button class="explore-row content-link" bindtap="openWebsite" data-url="/contact" hover-class="pressed"><text class="explore-title">联系与合作</text><text>→</text></button><button class="explore-row content-link" bindtap="openWebsite" data-url="/privacy" hover-class="pressed"><text class="explore-title">隐私说明</text><text>→</text></button></view></view>
