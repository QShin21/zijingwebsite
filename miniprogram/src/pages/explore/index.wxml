<page-meta page-style="{{themePageStyle}}" />
<view class="page mini-page">
  <view class="state">
    <view class="state-dot"></view>
    <text class="state-title">{{t.title}}</text>
    <text class="muted">{{t.body}}</text>
    <button class="primary" bindtap="go">{{t.go}}</button>
  </view>
</view>
