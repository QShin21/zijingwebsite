<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page native-page explore-page">
  <view class="native-tab-heading"><text class="title">紫荆档案</text><text class="subtitle">认识并肩上场的队伍，翻看比赛与社团生活的记录。</text></view>
  <template is="feedback" data="{{needsLogin}}" />
  <view class="archive-portals">
    <button class="content-link archive-portal archive-teams" bindtap="openCollection" data-collection="teams" hover-class="pressed"><view class="archive-book-top" aria-hidden="true"></view><text class="archive-portal-title">代表队档案</text><text class="archive-portal-description">队伍介绍、赛季阵容与公开资料</text><text class="archive-portal-action">查看队伍</text></button>
    <button class="content-link archive-portal archive-honors" bindtap="openCollection" data-collection="honors" hover-class="pressed"><view class="archive-book-top" aria-hidden="true"></view><text class="archive-portal-title">荣誉年鉴</text><text class="archive-portal-description">按年份与项目查阅已核验成果</text><text class="archive-portal-action">查阅档案</text></button>
  </view>
  <view wx:for="{{groups}}" wx:key="title" class="native-section archive-group"><view class="native-section-head"><text class="section-title">{{item.title}}</text></view><button wx:for="{{item.items}}" wx:for-item="entry" wx:key="collection" class="content-link archive-index-item" bindtap="openCollection" data-collection="{{entry.collection}}" hover-class="pressed"><view class="archive-index-mark archive-mark-{{entry.collection}}" aria-hidden="true"><view class="archive-mark-shape"></view><view class="archive-mark-line"></view></view><view class="archive-index-copy"><text class="native-entry-title">{{entry.title}}</text><text class="native-summary">{{entry.subtitle}}</text></view><text class="archive-index-sign" aria-hidden="true">›</text></button></view>
  <view class="native-section archive-participate"><view class="native-section-head"><text class="section-title">参与代表队</text></view><button class="content-link shortcut" bindtap="openWebsite" data-url="/teams/recruitment"><view class="shortcut-main"><text class="shortcut-title">招新与我的队伍</text><text class="muted">选拔批次、入队申请、成员记录。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button><button class="content-link shortcut" bindtap="openWebsite" data-url="/teams/honors"><view class="shortcut-main"><text class="shortcut-title">荣誉投稿与审核</text><text class="muted">现任队员投稿，查看自己的处理进度。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button></view>
  <view class="native-section archive-about"><text class="section-title">关于社团</text><view class="archive-about-links"><button class="plain" bindtap="openWebsite" data-url="/about">关于紫荆</button><button class="plain" bindtap="openWebsite" data-url="/join">加入紫荆</button><button class="plain" bindtap="openWebsite" data-url="/contact">联系与合作</button><button class="plain" bindtap="openWebsite" data-url="/privacy">隐私说明</button></view></view>
</view>
