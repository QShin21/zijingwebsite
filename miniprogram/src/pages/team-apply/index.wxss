@import "../../templates/business.wxss";
@import "../../styles/native-forms.wxss";

/* V2 team establishment application. */
.team-apply-v2 { padding-top: 0; }
.team-apply-tools { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.team-apply-tools > button { flex: 1; min-width: 220rpx; }
.team-apply-editor { border-top: 8rpx solid var(--z-primary); }
.team-apply-context { align-self: flex-start; }
.team-apply-picker { display: flex; align-items: center; justify-content: space-between; }
.team-apply-plan { height: 320rpx; }
.team-apply-label { display: block; font-weight: 900; }
.mini-page .team-apply-disclosure { display: flex; justify-content: space-between; width: 100%; padding: 10rpx 0; }
.team-apply-plan-text { padding: 18rpx; border-radius: 20rpx; background: var(--z-raised); }
.mini-page .team-apply-more { display: block; width: 100%; margin-top: 16rpx; }
