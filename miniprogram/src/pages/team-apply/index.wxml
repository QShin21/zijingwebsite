<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page team-apply-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">‹ 返回</button>
      <text class="zj-hero-kicker">TEAMS · 建队</text>
      <text class="zj-hero-title">建队申请</text>
      <text class="zj-hero-lead">由有建队权限的社群管理员提交组织与训练计划，负责人批准后成立。</text>
    </view>
  </view>
  <template is="feedback" data="{{needsLogin}}" />
  <block wx:if="{{!needsLogin}}">
    <text wx:if="{{busy}}" class="zj-callout" aria-role="status">本次确认或保存尚未完成，完成后会核对最新记录。</text>
    <text wx:if="{{done}}" class="zj-callout zj-callout-success" aria-role="status">{{done}}</text>
    <text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text>
    <view wx:if="{{loading}}" class="zj-skeleton" aria-role="status" aria-label="正在核对权限与回执"><view wx:if="{{!docs.length && !apply}}" class="zj-skeleton-row"><view class="zj-skeleton-date"></view><view class="zj-skeleton-lines"><view></view><view></view><view></view></view></view></view>
    <view wx:if="{{error}}" class="zj-alert"><text class="zj-small" aria-role="alert">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">重试读取</button></view>
    <view class="team-apply-tools">
      <button wx:if="{{actions.establish && !apply && !title && !reason}}" class="primary" bindtap="newApplication" disabled="{{loading || busy}}">填写建队申请</button>
      <button wx:if="{{!apply && (title || reason)}}" class="primary" bindtap="toggle" disabled="{{loading || busy}}">继续填写建队申请</button>
      <button wx:if="{{apply}}" class="secondary" bindtap="toggle" disabled="{{busy}}">收起填写内容</button>
      <button wx:if="{{actions.reviewEstablishments}}" class="secondary" bindtap="review" disabled="{{loading || busy}}">建队申请审核</button>
    </view>

    <view wx:if="{{apply}}" id="team-application-editor" class="zj-sheet team-apply-editor">
      <text class="zj-pill zj-pill-action team-apply-context">{{editId ? '申请 ' + editId : '本人建队计划'}}</text>
      <text class="zj-sheet-title">{{pendingEdit ? '查找本人申请' : editId ? '补充计划，重新提交' : '组织一支代表队'}}</text>
      <text wx:if="{{editId}}" class="zj-form-hint">沿用原社群与申请编号，补充内容后重新交给负责人审核。</text>
      <text wx:if="{{pendingEdit}}" class="zj-form-hint">正在查找申请 {{pendingEdit}}。可继续加载下方本人记录，找到可编辑的回执后带入改稿。</text>
      <view wx:if="{{formError}}" class="zj-alert"><text class="zj-small" aria-role="alert">{{formError}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">刷新回执核对</button></view>
      <block wx:if="{{!pendingEdit}}">
        <view class="field"><text class="field-label">所属游戏社群 · 必选</text><picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="game" disabled="{{editId || loading || busy}}"><view class="picker-value team-apply-picker"><text>{{gameTitle || '请选择可申请的社群'}}</text><text>▾</text></view></picker><text wx:if="{{editId}}" class="zj-form-hint">修改时沿用原申请所属社群。</text></view>
        <view class="field"><text class="field-label">拟用队名 · 必填</text><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{title}}" bindinput="input" data-field="title" maxlength="80" placeholder="填写拟用队名" disabled="{{busy}}" /><text class="zj-form-hint">2–80 字，便于负责人识别这支队伍。</text></view>
        <view class="field"><text class="field-label">组织与训练计划 · 必填</text><text class="zj-form-hint">说明组队目的、队员组织方式与日常训练安排。</text><textarea class="team-apply-plan" cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{reason}}" bindinput="input" data-field="reason" maxlength="3000" placeholder="填写计划说明，10–3000 字" disabled="{{busy}}" /></view>
        <text class="zj-form-hint">提交内容仅供本人及有权限的审批负责人查看。批准后可安排招新与人工选拔。</text>
        <button class="plain" bindtap="openPage" data-page="fixed" data-params="{{ {key: 'privacy'} }}">阅读社团隐私说明</button>
        <text wx:if="{{!canSubmit && !loading}}" class="zj-callout zj-callout-warning">当前暂无可提交权限，请刷新回执及社群选项；已填内容会保留。</text>
        <view class="zj-dock"><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || loading || !canSubmit}}">{{editId ? '保存并重新提交' : '提交建队申请'}}</button></view>
      </block>
    </view>
    <view wx:if="{{!apply && formError}}" class="zj-alert"><text class="zj-small" aria-role="alert">{{formError}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">刷新回执核对</button></view>

    <view class="zj-section">
      <view class="zj-section-head"><text class="zj-section-title">我的建队申请</text><button class="plain zj-more" bindtap="retry" disabled="{{loading || busy}}">刷新核对</button></view>
      <text wx:if="{{!games.length && !loading && !error}}" class="zj-form-hint">暂无可申请建队的社群，本人历史回执仍可查看。</text>
      <view wx:for="{{docs}}" wx:key="id" class="zj-record">
        <view class="zj-record-head"><text class="zj-pill zj-pill-action">{{item.statusText}}</text><text class="zj-small">申请 {{item.id}}</text></view>
        <text class="zj-record-title">{{item.title}}</text>
        <text wx:if="{{item.dateText}}" class="zj-small">更新于 {{item.dateText}}</text>
        <view wx:if="{{item.reviewNote}}" class="zj-callout zj-callout-warning"><text class="team-apply-label">负责人反馈</text><text selectable>{{item.reviewNote}}</text></view>
        <button class="plain team-apply-disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? '收起组织与训练计划' : '查看已提交计划'}}</text><text>{{expandedId === item.id ? '−' : '＋'}}</text></button>
        <text wx:if="{{expandedId === item.id}}" class="body team-apply-plan-text" selectable>{{item.reason}}</text>
        <view class="zj-record-actions"><button wx:if="{{item.actions.edit}}" class="secondary" bindtap="openForm" data-id="{{item.id}}" disabled="{{loading || busy}}">修改并重新提交</button><button wx:if="{{item.actions.withdraw}}" class="danger" bindtap="withdraw" data-id="{{item.id}}" disabled="{{loading || busy}}">撤回建队申请</button></view>
      </view>
      <view wx:if="{{!docs.length && !loading && !error}}" class="zj-empty"><text class="zj-empty-icon">🛡</text><text class="zj-empty-title">暂无本人建队申请</text><text class="zj-small">申请提交后，可在这里查看处理进度。</text></view>
      <button wx:if="{{hasMore}}" class="secondary team-apply-more" bindtap="onReachBottom" disabled="{{loading || busy}}" loading="{{loading}}">加载更多回执</button>
    </view>
  </block>
</view>
