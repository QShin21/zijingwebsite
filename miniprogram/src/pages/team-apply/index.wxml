<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page team-apply-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{t.kicker}}</text>
      <text class="zj-hero-title">{{t.title}}</text>
      <text class="zj-hero-lead">{{t.lead}}</text>
    </view>
  </view>
  <template is="feedback" data="{{needsLogin,t}}" />
  <block wx:if="{{!needsLogin}}">
    <text wx:if="{{busy}}" class="zj-callout" aria-role="status">{{t.busyNote}}</text>
    <text wx:if="{{done}}" class="zj-callout zj-callout-success" aria-role="status">{{done}}</text>
    <text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text>
    <view wx:if="{{loading}}" class="zj-skeleton" aria-role="status" aria-label="{{t.checking}}"><view wx:if="{{!docs.length && !apply}}" class="zj-skeleton-row"><view class="zj-skeleton-date"></view><view class="zj-skeleton-lines"><view></view><view></view><view></view></view></view></view>
    <view wx:if="{{error}}" class="zj-alert"><text class="zj-small" aria-role="alert">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">{{t.retryRead}}</button></view>
    <view class="team-apply-tools">
      <button wx:if="{{actions.establish && !apply && !title && !reason}}" class="primary" bindtap="newApplication" disabled="{{loading || busy}}">{{t.newApplication}}</button>
      <button wx:if="{{!apply && (title || reason)}}" class="primary" bindtap="toggle" disabled="{{loading || busy}}">{{t.continueApplication}}</button>
      <button wx:if="{{apply}}" class="secondary" bindtap="toggle" disabled="{{busy}}">{{t.collapse}}</button>
      <button wx:if="{{actions.reviewEstablishments}}" class="secondary" bindtap="review" disabled="{{loading || busy}}">{{t.reviewEntry}}</button>
    </view>

    <view wx:if="{{apply}}" id="team-application-editor" class="zj-sheet team-apply-editor">
      <text class="zj-pill zj-pill-action team-apply-context">{{editId ? t.applicationPrefix + editId : t.ownPlan}}</text>
      <text class="zj-sheet-title">{{pendingEdit ? t.findOwn : editId ? t.resubmitTitle : t.newTitle}}</text>
      <text wx:if="{{editId}}" class="zj-form-hint">{{t.editHint}}</text>
      <text wx:if="{{pendingEdit}}" class="zj-form-hint">{{t.findingPrefix}}{{pendingEdit}}{{t.findingSuffix}}</text>
      <view wx:if="{{formError}}" class="zj-alert"><text class="zj-small" aria-role="alert">{{formError}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">{{t.refreshReceipts}}</button></view>
      <block wx:if="{{!pendingEdit}}">
        <view class="field"><text class="field-label">{{t.gameLabel}}</text><picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="game" disabled="{{editId || loading || busy}}"><view class="picker-value team-apply-picker"><text>{{gameTitle || t.pickGame}}</text><text>▾</text></view></picker><text wx:if="{{editId}}" class="zj-form-hint">{{t.gameLocked}}</text></view>
        <view class="field"><text class="field-label">{{t.nameLabel}}</text><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{title}}" bindinput="input" data-field="title" maxlength="80" placeholder="{{t.namePlaceholder}}" disabled="{{busy}}" /><text class="zj-form-hint">{{t.nameHint}}</text></view>
        <view class="field"><text class="field-label">{{t.planLabel}}</text><text class="zj-form-hint">{{t.planHint}}</text><textarea class="team-apply-plan" cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{reason}}" bindinput="input" data-field="reason" maxlength="3000" placeholder="{{t.planPlaceholder}}" disabled="{{busy}}" /></view>
        <text class="zj-form-hint">{{t.privacyNote}}</text>
        <button class="plain" bindtap="openPage" data-page="fixed" data-params="{{ {key: 'privacy'} }}">{{t.readPrivacy}}</button>
        <text wx:if="{{!canSubmit && !loading}}" class="zj-callout zj-callout-warning">{{t.noPermission}}</text>
        <view class="zj-dock"><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || loading || !canSubmit}}">{{editId ? t.saveResubmit : t.submit}}</button></view>
      </block>
    </view>
    <view wx:if="{{!apply && formError}}" class="zj-alert"><text class="zj-small" aria-role="alert">{{formError}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">{{t.refreshReceipts}}</button></view>

    <view class="zj-section">
      <view class="zj-section-head"><text class="zj-section-title">{{t.mine}}</text><button class="plain zj-more" bindtap="retry" disabled="{{loading || busy}}">{{t.refresh}}</button></view>
      <text wx:if="{{!games.length && !loading && !error}}" class="zj-form-hint">{{t.noGames}}</text>
      <view wx:for="{{docs}}" wx:key="id" class="zj-record">
        <view class="zj-record-head"><text class="zj-pill zj-pill-action">{{item.statusText}}</text><text class="zj-small">{{t.applicationPrefix}}{{item.id}}</text></view>
        <text class="zj-record-title">{{item.title}}</text>
        <text wx:if="{{item.dateText}}" class="zj-small">{{t.updatedPrefix}}{{item.dateText}}</text>
        <view wx:if="{{item.reviewNote}}" class="zj-callout zj-callout-warning"><text class="team-apply-label">{{t.reviewerFeedback}}</text><text selectable>{{item.reviewNote}}</text></view>
        <button class="plain team-apply-disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? t.hidePlan : t.showPlan}}</text><text>{{expandedId === item.id ? '−' : '＋'}}</text></button>
        <text wx:if="{{expandedId === item.id}}" class="body team-apply-plan-text" selectable>{{item.reason}}</text>
        <view class="zj-record-actions"><button wx:if="{{item.actions.edit}}" class="secondary" bindtap="openForm" data-id="{{item.id}}" disabled="{{loading || busy}}">{{t.editResubmit}}</button><button wx:if="{{item.actions.withdraw}}" class="danger" bindtap="withdraw" data-id="{{item.id}}" disabled="{{loading || busy}}">{{t.withdraw}}</button></view>
      </view>
      <view wx:if="{{!docs.length && !loading && !error}}" class="zj-empty"><text class="zj-empty-icon">🛡</text><text class="zj-empty-title">{{t.emptyTitle}}</text><text class="zj-small">{{t.emptyBody}}</text></view>
      <button wx:if="{{hasMore}}" class="secondary team-apply-more" bindtap="onReachBottom" disabled="{{loading || busy}}" loading="{{loading}}">{{t.loadMore}}</button>
    </view>
  </block>
</view>
