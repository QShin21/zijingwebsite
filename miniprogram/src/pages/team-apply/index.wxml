<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page team-apply-page"><button class="plain" bindtap="back">返回</button><view class="page-heading"><text class="eyebrow">代表队 · 建队申请</text><text class="title">申请建立代表队</text><text class="subtitle">当前有建队申请权限的社群管理员提交组织与训练计划，由负责人审核批准后成立。</text></view><template is="feedback" data="{{needsLogin}}" />
  <block wx:if="{{!needsLogin}}">
    <text wx:if="{{busy}}" class="muted">本次确认或保存尚未完成，完成后会核对最新记录。</text>
    <view class="actions"><button wx:if="{{actions.establish}}" class="secondary" bindtap="newApplication" disabled="{{loading || busy}}">填写新建队申请</button><button wx:if="{{apply}}" class="plain" bindtap="toggle" disabled="{{busy}}">收起表单</button><button wx:if="{{!apply && (title || reason)}}" class="plain" bindtap="toggle" disabled="{{busy}}">继续填写</button><button wx:if="{{actions.reviewEstablishments}}" class="plain" bindtap="review" disabled="{{loading || busy}}">建队申请审核 →</button></view>
    <view wx:if="{{apply}}" class="form-sheet section"><text class="section-title">{{pendingEdit ? '查找本人申请' : editId ? '修改并重新提交' : '组织与训练计划'}}</text><text wx:if="{{pendingEdit}}" class="muted">正在从本人回执中查找申请 {{pendingEdit}}。可继续加载下方记录；找到可编辑的回执后才带入改稿。</text><block wx:if="{{!pendingEdit}}"><text wx:if="{{editId}}" class="muted">申请 {{editId}}；改稿沿用本编号与原社群。</text>
      <view class="field"><text class="field-label">所属游戏社群</text><picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="game" disabled="{{editId || loading || busy}}"><view>{{gameTitle || '请选择可申请的社群'}} ▾</view></picker></view>
      <view class="field"><text class="field-label">拟用队名</text><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{title}}" bindinput="input" data-field="title" maxlength="80" placeholder="2–80 字" disabled="{{busy}}" /></view><view class="field"><text class="field-label">组织与训练计划</text><textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{reason}}" bindinput="input" data-field="reason" maxlength="3000" placeholder="10–3000 字" disabled="{{busy}}" /></view>
      <text class="muted">提交内容仅供本人及有权限的审批负责人查看，用于建队审核。批准后再安排招新与人工选拔。</text><button class="plain" bindtap="openPage" data-page="fixed" data-params="{{ {key: 'privacy'} }}">阅读社团隐私说明</button>
      <text wx:if="{{!canSubmit && !loading}}" class="muted">当前暂无可提交权限，请刷新回执及社群选项；已填内容会保留。</text><button class="primary section" bindtap="submit" loading="{{busy}}" disabled="{{busy || loading || !canSubmit}}">{{editId ? '保存并重新提交' : '提交建队申请'}}</button></block><text wx:if="{{formError}}" class="error" aria-role="alert">{{formError}}</text>
    </view>
    <text wx:if="{{!apply && formError}}" class="error">{{formError}}</text><text wx:if="{{operationError}}" class="error">{{operationError}}</text><text wx:if="{{done}}" class="body" aria-role="status">{{done}}</text><view class="section-head section"><text class="section-title">我的建队申请</text><button class="plain" bindtap="retry" disabled="{{loading || busy}}">刷新</button></view>
    <text wx:if="{{loading}}" class="muted">正在核对权限与回执…</text><view wx:if="{{error}}"><text class="error">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">重试读取</button></view><text wx:if="{{!games.length && !loading && !error}}" class="muted">暂无可申请建队的社群。本人历史回执仍可在下方查看。</text>
    <view wx:for="{{docs}}" wx:key="id" class="record-sheet"><view class="row"><text class="section-title">{{item.title}}</text><text class="badge">{{item.statusText}}</text></view><text class="muted">申请 {{item.id}} · {{item.dateText}}</text><text class="body">{{item.reason}}</text><text wx:if="{{item.reviewNote}}" class="body">处理意见：{{item.reviewNote}}</text><view class="actions"><button wx:if="{{item.actions.edit}}" class="secondary" bindtap="openForm" data-id="{{item.id}}" disabled="{{loading || busy}}">修改并重新提交</button><button wx:if="{{item.actions.withdraw}}" class="plain" bindtap="withdraw" data-id="{{item.id}}" disabled="{{loading || busy}}">撤回建队申请</button></view></view>
    <view wx:if="{{!docs.length && !loading && !error}}" class="empty"><text>暂无本人建队申请</text></view><button wx:if="{{hasMore}}" class="plain section" bindtap="onReachBottom" disabled="{{loading || busy}}" loading="{{loading}}">加载更多回执</button>
  </block>
</view>
