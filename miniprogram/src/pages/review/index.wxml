<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page review-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{t.kicker}}</text>
      <text class="zj-hero-title">{{t.heroTitle}}</text>
      <text class="zj-hero-lead">{{t.heroLead}}</text>
      <view wx:if="{{allowed && docs.length}}" class="zj-hero-meta"><text class="zj-pill zj-pill-live">{{docs.length}}{{t.countSuffix}}</text><text>{{t.scopeNote}}</text></view>
    </view>
  </view>
  <template is="feedback" data="{{needsLogin,t}}" />
  <view wx:if="{{loading}}" class="zj-skeleton" aria-role="status" aria-label="{{t.checking}}"><view wx:if="{{!docs.length}}" class="zj-skeleton-row"><view class="zj-skeleton-date"></view><view class="zj-skeleton-lines"><view></view><view></view><view></view></view></view></view>
  <view wx:if="{{!needsLogin && !allowed && !loading && !error}}" class="zj-empty"><text class="zj-empty-icon">🔒</text><text class="zj-empty-title">{{t.noPermission}}</text><text class="zj-small">{{t.noPermissionBody}}</text><button class="secondary" bindtap="retry">{{t.recheck}}</button></view>
  <view wx:if="{{error}}" class="zj-alert"><text class="zj-small" aria-role="alert">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">{{t.reload}}</button></view>
  <text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text>
  <view wx:if="{{done}}" class="zj-callout zj-callout-success" aria-role="status"><text class="review-done">{{done}}</text><text wx:if="{{error}}">{{t.doneKept}}</text></view>

  <block wx:if="{{allowed && !needsLogin}}">
    <view class="zj-section-head"><view><text class="zj-section-title">{{done ? t.receiptsTitle : t.pendingTitle}}</text><text class="zj-small">{{t.scopeNoteFull}}</text></view><button class="plain zj-more" bindtap="retry" disabled="{{loading || busy}}">{{t.refresh}}</button></view>
    <text wx:if="{{busy}}" class="zj-form-hint" aria-role="status">{{t.saving}}</text>
    <view wx:for="{{docs}}" wx:key="id" class="zj-record review-record {{expandedId === item.id ? 'review-open' : ''}}">
      <view class="zj-record-head"><text class="zj-pill zj-pill-{{item.status === 'pending' ? 'info' : item.status === 'approved' ? 'success' : item.status === 'returned' ? 'warning' : 'neutral'}}">{{item.statusText}}</text><text class="zj-small">{{item.dateText}}</text></view>
      <text class="zj-record-title">{{item.proposedGame || item.game.title || t.gameFallback}}</text>
      <view class="zj-tags"><text class="zj-small">{{t.applicantPrefix}}{{item.realName}}</text><text class="zj-small">{{t.receiptPrefix}}{{item.id}}</text></view>
      <text class="zj-pill {{item.contactConsent === true ? 'zj-pill-success' : 'zj-pill-warning'}}">{{item.contactConsent === true ? t.consentYes : t.consentNo}}</text>
      <button class="plain review-disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy || imageBusy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? t.collapse : item.actions.review ? t.checkAndHandle : t.viewMaterials}}</text><text aria-hidden="true">{{expandedId === item.id ? '−' : '＋'}}</text></button>

      <view wx:if="{{expandedId === item.id}}" class="review-materials">
        <view class="review-block">
          <text class="field-label">{{t.plan}}</text><text class="body" selectable>{{item.reason}}</text>
          <view class="zj-kv">
            <view class="zj-kv-row"><text class="zj-kv-label">{{t.applicant}}</text><text class="zj-kv-value" selectable>{{item.realName}}</text></view>
            <view class="zj-kv-row"><text class="zj-kv-label">{{t.phone}}</text><text class="zj-kv-value" selectable>{{item.phone}}</text></view>
          </view>
        </view>
        <view class="review-block">
          <text class="field-label">{{t.cardConsent}}</text>
          <text class="zj-small">{{item.contactConsent === true ? t.consentAgreed : t.consentMissing}}</text>
          <text wx:if="{{item.contactConsent !== true}}" class="error" aria-role="alert">{{t.consentRequired}}</text>
          <button wx:if="{{item.actions.review}}" class="secondary" bindtap="inspect" data-id="{{item.id}}" disabled="{{busy || imageBusy}}" loading="{{imageBusy}}">{{imageBusy ? t.readingCard : t.viewCard}}</button>
        </view>
        <view wx:if="{{item.actions.review}}" class="review-decision">
          <text class="zj-sheet-title">{{t.saveDecision}}</text>
          <text class="zj-form-hint">{{t.decisionHint}}</text>
          <view class="field">
            <text class="field-label">{{t.note}}</text>
            <textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{item.reviewDraft}}" bindinput="note" data-id="{{item.id}}" maxlength="1000" placeholder="{{t.notePlaceholder}}" disabled="{{busy}}" />
            <text class="zj-form-hint">{{t.noteHint}}</text>
          </view>
          <view class="actions" wx:if="{{item.actions.review}}">
            <button wx:if="{{item.contactConsent === true}}" class="primary" bindtap="decide" data-id="{{item.id}}" data-decision="approved" disabled="{{busy || imageBusy || loading}}">{{t.approve}}</button>
            <button class="secondary" bindtap="decide" data-id="{{item.id}}" data-decision="returned" disabled="{{busy || imageBusy || loading}}">{{t.returnIt}}</button>
            <button class="danger" bindtap="decide" data-id="{{item.id}}" data-decision="rejected" disabled="{{busy || imageBusy || loading}}">{{t.reject}}</button>
          </view>
        </view>
        <view wx:else class="review-block"><text wx:if="{{item.reviewNote}}" class="body" selectable>{{item.reviewNote}}</text><text class="zj-form-hint">{{t.noActions}}</text></view>
      </view>
    </view>
    <view wx:if="{{!docs.length && !loading && !error}}" class="zj-empty"><text class="zj-empty-icon">✓</text><text class="zj-empty-title">{{t.emptyTitle}}</text><text class="zj-small">{{t.emptyBody}}</text></view>
    <button wx:if="{{hasMore}}" class="secondary review-more" bindtap="onReachBottom" disabled="{{loading || busy}}" loading="{{loading}}">{{t.more}}</button>
  </block>
</view>
