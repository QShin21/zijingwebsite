<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page native-page business-page native-form-page review-page">
  <button class="plain back" bindtap="back">返回</button>
  <view class="page-heading"><text class="title">管理员申请审核</text><text class="subtitle">核对社群计划、申请资料与名片展示同意，再保存审核决定。</text></view>
  <template is="feedback" data="{{needsLogin}}" />
  <view wx:if="{{loading}}" class="review-loading" aria-role="status"><text class="muted">正在核对权限与待审申请…</text><view wx:if="{{!docs.length}}" class="loading-lines" aria-hidden="true"><view class="loading-line"></view><view class="loading-line short"></view></view></view>
  <view wx:if="{{!needsLogin && !allowed && !loading && !error}}" class="empty"><text class="state-title">当前账号没有此管理权限</text><text class="muted">审核入口按当前账号的实际授权开放。</text><button class="secondary" bindtap="retry">重新核对权限</button></view>
  <view wx:if="{{error}}"><text class="error" aria-role="alert">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">重新加载</button></view>
  <text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text>
  <view wx:if="{{done}}" class="native-receipt" aria-role="status"><text class="review-receipt-title">{{done}}</text><text wx:if="{{error}}" class="review-receipt-note">已确认的处理结果保留在下方，刷新后再核对最新列表。</text></view>

  <block wx:if="{{allowed && !needsLogin}}">
    <view class="section-head review-queue-heading"><view><text class="section-title">{{done ? '申请与处理回执' : '待审申请'}}</text><text class="muted">只显示当前有权处理的记录。</text></view><button class="plain" bindtap="retry" disabled="{{loading || busy}}">刷新核对</button></view>
    <text wx:if="{{busy}}" class="review-busy" aria-role="status">正在确认或保存本次决定，请稍候。</text>
    <view class="record-list">
      <view wx:for="{{docs}}" wx:key="id" class="task-record review-record">
        <view class="review-record-status"><text class="badge">{{item.statusText}}</text><text class="review-date">{{item.dateText}}</text></view>
        <text class="section-title">{{item.proposedGame || item.game.title || '游戏社群申请'}}</text>
        <view class="record-meta"><text>申请人 {{item.realName}}</text><text>回执 {{item.id}}</text></view>
        <text class="review-consent-summary">{{item.contactConsent === true ? '已取得本人名片展示同意' : '需由申请人补充名片展示同意'}}</text>
        <button class="plain disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy || imageBusy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? '收起申请材料' : item.actions.review ? '核对材料与处理' : '查看申请材料'}}</text><text class="disclosure-mark" aria-hidden="true">{{expandedId === item.id ? '−' : '＋'}}</text></button>

        <view wx:if="{{expandedId === item.id}}" class="record-detail review-materials">
          <view class="review-material-section">
            <text class="material-title">组织计划</text><text class="body" selectable>{{item.reason}}</text>
            <view class="record-facts">
              <view class="record-fact"><text class="fact-label">申请人</text><text class="fact-value" selectable>{{item.realName}}</text></view>
              <view class="record-fact"><text class="fact-label">手机号</text><text class="fact-value" selectable>{{item.phone}}</text></view>
            </view>
          </view>
          <view class="review-material-section review-contact">
            <text class="material-title">进群名片与本人同意</text>
            <text class="muted">{{item.contactConsent === true ? '申请人已同意展示微信名片作为进群联系方式。' : '申请人尚未同意展示微信名片。'}}</text>
            <text wx:if="{{item.contactConsent !== true}}" class="error" aria-role="alert">申请人尚未同意展示管理联系方式，请退回由本人补充同意后重新提交。</text>
            <button wx:if="{{item.actions.review}}" class="secondary review-qr-action" bindtap="inspect" data-id="{{item.id}}" disabled="{{busy || imageBusy}}" loading="{{imageBusy}}">{{imageBusy ? '正在读取名片…' : '查看微信名片二维码'}}</button>
          </view>

          <view wx:if="{{item.actions.review}}" class="review-actions">
            <text class="section-title">保存审核决定</text>
            <text class="muted">意见会显示在申请人的回执中。批准后开放社群任职，微信群仍需人工建立与拉群。</text>
            <view class="field">
              <text class="field-label">处理意见</text>
              <textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{item.reviewDraft}}" bindinput="note" data-id="{{item.id}}" maxlength="1000" placeholder="写明需要补充的资料或处理原因" disabled="{{busy}}" />
              <text class="field-note">退回补充或拒绝时，请填写具体原因。最多 1000 字。</text>
            </view>
            <view class="actions" wx:if="{{item.actions.review}}">
              <button wx:if="{{item.contactConsent === true}}" class="primary" bindtap="decide" data-id="{{item.id}}" data-decision="approved" disabled="{{busy || imageBusy || loading}}">批准申请</button>
              <button class="secondary" bindtap="decide" data-id="{{item.id}}" data-decision="returned" disabled="{{busy || imageBusy || loading}}">退回补充</button>
              <button class="danger" bindtap="decide" data-id="{{item.id}}" data-decision="rejected" disabled="{{busy || imageBusy || loading}}">拒绝申请</button>
            </view>
          </view>
          <view wx:else class="review-saved-result"><text wx:if="{{item.reviewNote}}" class="body" selectable>{{item.reviewNote}}</text><text class="task-note">当前没有可执行的审核操作。请刷新核对最新状态。</text></view>
        </view>
      </view>
    </view>
    <view wx:if="{{!docs.length && !loading && !error}}" class="empty"><text class="state-title">没有待审核申请</text><text class="muted">新申请提交后会出现在当前授权范围内。</text></view>
    <button wx:if="{{hasMore}}" class="plain review-more" bindtap="onReachBottom" disabled="{{loading || busy}}" loading="{{loading}}">加载更多申请</button>
  </block>
</view>
