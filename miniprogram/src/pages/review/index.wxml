<import src="../../templates/common.wxml" />
<view class="page"><text class="eyebrow">COMMUNITY MANAGEMENT</text><text class="title">{{mode === 'applications' ? '管理员申请审核' : '社群投稿审核'}}</text><template is="feedback" data="{{needsLogin}}" /><view wx:if="{{!needsLogin && !allowed}}" class="empty"><text>当前账号没有此管理权限</text></view><block wx:if="{{allowed}}"><text wx:if="{{error}}" class="error">{{error}}</text><view wx:for="{{docs}}" wx:key="id" class="section panel"><text class="section-title">{{item.proposedGame || item.title}}</text><text class="muted">{{item.authorName || item.applicantName}} · {{item.dateText}}</text><block wx:if="{{mode === 'applications'}}"><text class="body" selectable>{{item.realName}} · {{item.phone}}</text><text class="muted" selectable>{{item.applicantEmail}}</text><text class="body">{{item.reason}}</text><button class="secondary section" bindtap="inspect" data-id="{{item.id}}">查看微信名片二维码</button></block><block wx:else><text class="body">{{item.body}}</text><image wx:for="{{item.localImages}}" wx:for-item="image" wx:key="*this" class="photo" mode="widthFix" src="{{image}}" bindtap="previewImage" data-url="{{image}}" /><button wx:if="{{item.videoURL}}" class="plain" bindtap="copy" data-value="{{item.videoURL}}">复制视频链接 ↗</button></block><view class="actions"><button class="primary" bindtap="decide" data-id="{{item.id}}" data-decision="{{mode === 'applications' ? 'approved' : 'visible'}}" disabled="{{busy}}">通过</button><button class="danger" bindtap="decide" data-id="{{item.id}}" data-decision="rejected" disabled="{{busy}}">退回</button></view></view><view wx:if="{{!docs.length && !loading}}" class="empty"><text>没有待审核内容</text></view><button wx:if="{{hasMore}}" class="plain" bindtap="onReachBottom">加载更多</button><view wx:if="{{mode === 'showcase'}}" class="field"><text class="field-label">审核说明（可选）</text><textarea value="{{note}}" bindinput="note" maxlength="500" placeholder="填写退回原因或审核说明" /></view><view wx:if="{{bans.length}}" class="section panel"><text class="section-title">社群禁言管理</text><view wx:for="{{bans}}" wx:key="id" class="section"><text>成员 #{{item.member}}</text><text class="body">{{item.reason}}</text><button class="secondary" bindtap="unban" data-id="{{item.id}}">解除禁言</button></view></view></block></view>
