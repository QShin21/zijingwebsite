<import src="../../templates/common.wxml" />
<view class="page"><text class="eyebrow">COMMUNITY MANAGEMENT</text><text class="title">管理员申请审核</text><template is="feedback" data="{{needsLogin}}" /><view wx:if="{{!needsLogin && !allowed}}" class="empty"><text>当前账号没有此管理权限</text></view><block wx:if="{{allowed}}"><text wx:if="{{error}}" class="error">{{error}}</text><view wx:for="{{docs}}" wx:key="id" class="section panel"><text class="section-title">{{item.proposedGame || item.title}}</text><text class="muted">{{item.authorName || item.applicantName}} · {{item.dateText}}</text><block><text class="body" selectable>{{item.realName}} · {{item.phone}}</text><text class="muted" selectable>{{item.applicantEmail}}</text><text class="body">{{item.reason}}</text><button class="secondary section" bindtap="inspect" data-id="{{item.id}}">查看微信名片二维码</button></block><view class="actions"><button class="primary" bindtap="decide" data-id="{{item.id}}" data-decision="approved" disabled="{{busy}}">通过</button><button class="danger" bindtap="decide" data-id="{{item.id}}" data-decision="rejected" disabled="{{busy}}">退回</button></view></view><view wx:if="{{!docs.length && !loading}}" class="empty"><text>没有待审核内容</text></view><button wx:if="{{hasMore}}" class="plain" bindtap="onReachBottom">加载更多</button></block></view>
