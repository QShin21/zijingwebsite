<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page business-page review-page">
  <button class="plain back" bindtap="back">返回</button>
  <view class="page-heading"><text class="title">管理员申请审核</text><text class="subtitle">核对社群计划、申请资料与名片展示授权，再保存决定。</text></view>
  <template is="feedback" data="{{needsLogin}}" />
  <text wx:if="{{loading}}" class="muted">正在核对权限与待审申请…</text>
  <view wx:if="{{!needsLogin && !allowed && !loading && !error}}" class="empty"><text class="state-title">当前账号没有此管理权限</text><button class="secondary" bindtap="retry">重新核对权限</button></view>
  <view wx:if="{{error}}"><text class="error">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">重新加载</button></view>
  <text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text><text wx:if="{{done}}" class="result-message" aria-role="status">{{done}}</text>
  <block wx:if="{{allowed && !needsLogin}}">
    <view class="section-head"><view><text class="section-title">待审申请</text><text class="muted">只显示当前有权处理的记录</text></view><button class="plain" bindtap="retry" disabled="{{loading || busy}}">刷新核对</button></view>
    <view class="record-list"><view wx:for="{{docs}}" wx:key="id" class="task-record">
      <view class="record-heading"><view><text class="section-title">{{item.proposedGame || '游戏社群申请'}}</text><view class="record-meta"><text>{{item.realName}}</text><text>{{item.dateText}}</text><text>回执 {{item.id}}</text></view></view><text class="badge">{{item.actions.review ? '待处理' : '已更新'}}</text></view>
      <text class="task-note">{{item.contactConsent === true ? '申请人已授权名片展示' : '缺少名片展示授权，须本人补充'}}</text>
      <button class="secondary disclosure" bindtap="toggleRecord" data-id="{{item.id}}" disabled="{{busy || imageBusy}}" aria-expanded="{{expandedId === item.id}}"><text>{{expandedId === item.id ? '收起材料与处理区' : '查看材料并处理'}}</text><text class="disclosure-mark">{{expandedId === item.id ? '−' : '＋'}}</text></button>
      <view wx:if="{{expandedId === item.id}}" class="record-detail">
        <text class="material-title">组织计划</text><text class="body" selectable>{{item.reason}}</text>
        <view class="record-facts"><view class="record-fact"><text class="fact-label">申请人</text><text class="fact-value" selectable>{{item.realName}}</text></view><view class="record-fact"><text class="fact-label">手机号</text><text class="fact-value" selectable>{{item.phone}}</text></view></view>
        <text class="material-title">进群名片与授权</text><text class="muted">{{item.contactConsent === true ? '申请人已同意展示微信名片作为进群联系方式' : '申请人尚未同意'}}</text><text wx:if="{{item.contactConsent !== true}}" class="error" aria-role="alert">申请人尚未同意展示管理联系方式，请退回由本人补充同意后重新提交。</text>
        <button wx:if="{{item.actions.review}}" class="plain" bindtap="inspect" data-id="{{item.id}}" disabled="{{busy || imageBusy}}" loading="{{imageBusy}}">查看微信名片二维码</button>
        <view wx:if="{{item.actions.review}}" class="review-actions"><text class="section-title">保存审核决定</text><text class="muted">意见会显示在申请人的回执中。批准后开放社群任职，微信群仍需人工建立与拉群。</text><view class="field"><text class="field-label">处理意见</text><textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{item.reviewDraft}}" bindinput="note" data-id="{{item.id}}" maxlength="1000" placeholder="退回或拒绝时必填具体原因" disabled="{{busy}}" /></view><view class="actions" wx:if="{{item.actions.review}}"><button wx:if="{{item.contactConsent === true}}" class="primary" bindtap="decide" data-id="{{item.id}}" data-decision="approved" disabled="{{busy || imageBusy || loading}}">批准申请</button><button class="secondary" bindtap="decide" data-id="{{item.id}}" data-decision="returned" disabled="{{busy || imageBusy || loading}}">退回补充</button><button class="danger" bindtap="decide" data-id="{{item.id}}" data-decision="rejected" disabled="{{busy || imageBusy || loading}}">拒绝申请</button></view></view>
        <text wx:else class="task-note">该申请暂无可执行操作，请刷新列表核对。</text>
      </view>
    </view></view>
    <view wx:if="{{!docs.length && !loading && !error}}" class="empty"><text class="state-title">没有待审核申请</text><text class="muted">新申请提交后会出现在当前授权范围内。</text></view><button wx:if="{{hasMore}}" class="plain" bindtap="onReachBottom" disabled="{{loading || busy}}" loading="{{loading}}">加载更多申请</button>
  </block>
</view>
