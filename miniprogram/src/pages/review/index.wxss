@import "../../templates/business.wxss";
@import "../../styles/native-forms.wxss";

/* V2 review desk: queue records expand into material blocks and a decision panel. */
.review-v2 { padding-top: 0; }
.review-done { display: block; font-weight: 900; }
.review-open { border-color: var(--z-primary); box-shadow: 0 16rpx 48rpx rgba(28, 18, 64, .12); }
.mini-page .review-disclosure { display: flex; justify-content: space-between; width: 100%; padding: 10rpx 0; }
.review-materials { display: flex; flex-direction: column; gap: 18rpx; }
.review-block { display: flex; flex-direction: column; gap: 10rpx; padding: 22rpx; border-radius: 24rpx; background: var(--z-raised); border: 1rpx solid var(--z-line); }
.review-decision { display: flex; flex-direction: column; gap: 8rpx; padding: 24rpx; border-radius: 24rpx; background: var(--z-tint); }
.mini-page .review-more { display: block; width: 100%; margin-top: 16rpx; }
