/* Page-specific structure; shared native primitives live in app.wxss. */
.reading-panel { background: var(--z-surface); padding: 30rpx; border: 1rpx solid var(--z-line); border-radius: 16rpx; }
.section-number { display: block; color: var(--z-positive); font-size: 23rpx; letter-spacing: 3rpx; margin-bottom: 18rpx; }
