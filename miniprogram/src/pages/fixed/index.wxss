/* V2 fixed pages: hero band, join path cards, contact records, reading body. */
.fixed-v2 { padding-top: 0; }
.fixed-cover-record { margin-bottom: 24rpx; }
.fixed-cover { display: block; width: 100%; border-radius: 32rpx; background: var(--z-media); }
.fixed-paths { display: flex; flex-direction: column; gap: 18rpx; }
.fixed-path { display: flex; align-items: flex-start; gap: 22rpx; padding: 28rpx; border: 1rpx solid var(--z-line); border-radius: 32rpx; background: var(--z-surface); }
.fixed-path-index { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 84rpx; height: 84rpx; border-radius: 24rpx; background: var(--z-stage); color: var(--z-accent); font-size: 32rpx; font-weight: 900; }
.fixed-path-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.fixed-path-title { font-size: 33rpx; font-weight: 900; }
.fixed-contacts { margin-top: 20rpx; }
.fixed-body { margin-top: 24rpx; padding: 32rpx 28rpx; border: 1rpx solid var(--z-line); border-radius: 32rpx; background: var(--z-surface); font-size: 31rpx; line-height: 1.9; word-break: break-word; }
.fixed-section .body { margin-top: 12rpx; }
