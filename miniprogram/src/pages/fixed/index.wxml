<import src="../../templates/common.wxml" />
<view class="page"><text class="eyebrow">ZIJING ESPORTS</text><text class="title">{{doc.title || title}}</text><text wx:if="{{doc.summary}}" class="subtitle">{{doc.summary}}</text><template is="feedback" data="{{loading, error, needsLogin}}" /><block wx:if="{{!loading && !error && !needsLogin}}"><view wx:if="{{!doc}}" class="empty"><text>资料待发布</text><text class="muted">经确认的内容会由社团负责人在后台发布。</text></view><view wx:if="{{nodes.length}}" class="body"><rich-text nodes="{{nodes}}" user-select /></view><view wx:for="{{doc.sections}}" wx:key="heading" class="section panel"><text class="section-title">{{item.heading}}</text><text class="body">{{item.text}}</text></view><view wx:for="{{links}}" wx:key="url" class="section panel"><text>{{item.label}}</text><button class="plain" bindtap="copy" data-value="{{item.url}}">复制链接，在浏览器打开 ↗</button></view><view wx:for="{{contacts}}" wx:key="label" class="section panel"><text class="section-title">{{item.label}}</text><text class="body">{{item.text}}</text><button class="plain" bindtap="copy" data-value="{{item.url || item.text}}">复制联系方式</button></view><view wx:if="{{key === 'join'}}" class="section actions"><button class="secondary" bindtap="openWebsite" data-url="/join/members">普通社员</button><button class="secondary" bindtap="openWebsite" data-url="/join/teams">代表队选拔</button><button class="secondary" bindtap="openWebsite" data-url="/join/staff">骨干招新</button></view><view wx:if="{{isJoin}}" class="section"><text class="section-title">招新批次</text><template is="cards" data="{{docs:batches, label:'招新'}}" /></view></block></view>
