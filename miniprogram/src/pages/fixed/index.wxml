<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page fixed-page fixed-page-{{key}}">
  <button class="plain back" bindtap="back">返回</button><view class="page-heading"><text class="title">{{(doc && doc.title) || title}}</text><text wx:if="{{doc.summary}}" class="subtitle">{{doc.summary}}</text></view>
  <template is="feedback" data="{{loading, error, needsLogin}}" />
  <block wx:if="{{!loading && !error && !needsLogin}}">
    <view wx:if="{{key === 'join'}}" class="join-options"><button class="content-link shortcut" bindtap="openWebsite" data-url="/join/members"><view class="shortcut-main"><text class="shortcut-title">寻找游戏社群</text><text class="muted">联系管理员，申请加入微信群。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button><button class="content-link shortcut" bindtap="openWebsite" data-url="/join/teams"><view class="shortcut-main"><text class="shortcut-title">参加代表队选拔</text><text class="muted">了解队伍招新与参与条件。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button><button class="content-link shortcut" bindtap="openWebsite" data-url="/join/staff"><view class="shortcut-main"><text class="shortcut-title">参与社团工作</text><text class="muted">查看执行部与宣传部骨干招新。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button></view>
    <view wx:if="{{contacts.length}}" class="contact-directory"><view wx:for="{{contacts}}" wx:key="label" class="record-row"><text class="section-title">{{item.label}}</text><text class="body" selectable>{{item.text}}</text><button class="secondary" bindtap="copy" data-value="{{item.url || item.text}}">复制联系方式</button></view></view>
    <view wx:if="{{!doc}}" class="empty"><text class="state-title">资料待发布</text><text class="muted">经确认的资料发布后会出现在这里。</text></view>
    <view wx:if="{{nodes.length}}" class="body reading-body"><rich-text nodes="{{nodes}}" user-select /></view>
    <view wx:for="{{doc.sections}}" wx:key="heading" class="reading-section"><text class="section-title">{{item.heading}}</text><text class="body" selectable>{{item.text}}</text></view>
    <view wx:if="{{links.length}}" class="content-links"><text class="section-title">文中链接</text><view wx:for="{{links}}" wx:key="url" class="record-row"><text class="muted">{{item.label}}</text><button class="plain" bindtap="copy" data-value="{{item.url}}">复制链接，在浏览器打开</button></view></view>
    <view wx:if="{{isJoin}}" class="section"><view class="section-heading"><text class="section-title">相关招新批次</text></view><template is="cards" data="{{docs:batches, label:'招新'}}" /></view>
  </block>
</view>
