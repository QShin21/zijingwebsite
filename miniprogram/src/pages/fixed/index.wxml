<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<import src="../../templates/native-content.wxml" />
<view class="page mini-page fixed-v2 fixed-page-{{key}} {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{key === 'join' || isJoin ? t.kickerJoin : key === 'privacy' ? t.kickerPrivacy : key === 'contact' ? t.kickerContact : t.kickerAbout}}</text>
      <text class="zj-hero-title">{{(doc && doc.title) || title}}</text>
      <text wx:if="{{doc.summary}}" class="zj-hero-lead">{{doc.summary}}</text>
      <text wx:if="{{reading.date.known}}" class="zj-hero-meta">{{t.publishedPrefix}}{{reading.date.text}}</text>
    </view>
  </view>
  <template is="feedback" data="{{loading, error, needsLogin, t}}" />
  <block wx:if="{{!loading && !error && !needsLogin}}">
    <view wx:if="{{coverImage}}" class="fixed-cover-record">
      <image wx:if="{{!coverImageFailed}}" class="fixed-cover" src="{{coverImage.url}}" mode="widthFix" aria-label="{{coverImage.alt || doc.title}}" binderror="readingImageError" data-url="{{coverImage.url}}" />
      <view wx:else class="zj-alert"><text class="zj-small">{{t.coverFailed}}</text><button class="secondary" bindtap="retry">{{t.reloadContent}}</button></view>
      <text wx:if="{{coverImage.credit}}" class="zj-credit">{{coverImage.credit}}</text>
    </view>

    <view wx:if="{{key === 'join' && campus}}" class="fixed-paths">
      <view class="fixed-path" hover-class="zj-pressed" bindtap="openWebsite" data-url="/join/members" aria-role="link" aria-label="{{t.pathCommunities}}">
        <text class="fixed-path-index">01</text>
        <view class="fixed-path-copy"><text class="fixed-path-title">{{t.pathCommunities}}</text><text class="zj-small">{{t.pathCommunitiesBody}}</text><text class="zj-card-action">{{t.pathCommunitiesAction}} ›</text></view>
      </view>
      <view class="fixed-path" hover-class="zj-pressed" bindtap="openWebsite" data-url="/join/teams" aria-role="link" aria-label="{{t.pathTeams}}">
        <text class="fixed-path-index">02</text>
        <view class="fixed-path-copy"><text class="fixed-path-title">{{t.pathTeams}}</text><text class="zj-small">{{t.pathTeamsBody}}</text><text class="zj-card-action">{{t.pathTeamsAction}} ›</text></view>
      </view>
      <view class="fixed-path" hover-class="zj-pressed" bindtap="openWebsite" data-url="/join/staff" aria-role="link" aria-label="{{t.pathStaff}}">
        <text class="fixed-path-index">03</text>
        <view class="fixed-path-copy"><text class="fixed-path-title">{{t.pathStaff}}</text><text class="zj-small">{{t.pathStaffBody}}</text><text class="zj-card-action">{{t.pathStaffAction}} ›</text></view>
      </view>
    </view>

    <view wx:if="{{contacts.length}}" class="zj-list fixed-contacts">
      <view wx:for="{{contacts}}" wx:key="label" class="zj-record">
        <text class="zj-record-title">{{item.label}}</text>
        <text class="body" selectable>{{item.text}}</text>
        <view class="zj-record-actions"><button class="secondary" bindtap="copy" data-value="{{item.url || item.text}}">{{t.copyContact}}</button></view>
      </view>
    </view>
    <view wx:if="{{!doc}}" class="zj-empty"><text class="zj-empty-icon">✦</text><text class="zj-empty-title">{{t.pendingTitle}}</text><text class="zj-small">{{t.pendingBody}}</text></view>
    <view wx:if="{{nodes.length}}" class="fixed-body"><rich-text nodes="{{nodes}}" user-select /></view>
    <view wx:for="{{doc.sections}}" wx:key="heading" class="zj-sheet fixed-section">
      <text class="zj-sheet-title">{{item.heading}}</text>
      <text class="body" selectable>{{item.text}}</text>
    </view>
    <template is="native-reading-links" data="{{links, t}}" />
    <view wx:if="{{isJoin}}" class="zj-section">
      <view class="zj-section-head"><text class="zj-section-title">{{t.batches}}</text></view>
      <template is="native-content-records" data="{{docs:batches, emptyTitle:t.batchesEmpty, emptyHint:t.batchesEmptyHint, t:t}}" />
    </view>
  </block>
</view>
