<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page detail-page detail-page-{{collection}}">
  <button class="plain back" bindtap="back">返回</button><template is="feedback" data="{{loading, error, needsLogin}}" />
  <block wx:if="{{!loading && !error && !needsLogin}}">
    <view class="detail-heading"><view class="meta-line"><text>{{doc.kindText || (collection === 'teams' ? '代表队档案' : collection === 'honors' ? '荣誉档案' : collection === 'community-posts' || collection === 'community-showcase' ? '社群内容' : '社团发布')}}</text><text wx:if="{{doc.authorName}}">{{doc.authorName}}</text><text wx:if="{{doc.demo}}" class="badge">演示资料</text></view><text class="title detail-title">{{doc.title}}</text><text wx:if="{{doc.summary}}" class="subtitle">{{doc.summary}}</text>
      <view class="object-facts"><view class="fact-row"><text class="fact-label">{{doc.startAt ? '活动开始' : collection === 'honors' ? '赛事日期' : '发布时间'}}</text><text class="fact-value">{{dateText}}</text></view><view wx:if="{{endDateText}}" class="fact-row"><text class="fact-label">活动结束</text><text class="fact-value">{{endDateText}}</text></view><view wx:if="{{doc.location}}" class="fact-row"><text class="fact-label">地点 / 方式</text><text class="fact-value">{{doc.location}}</text></view><view wx:if="{{doc.statusText}}" class="fact-row"><text class="fact-label">当前状态</text><text class="fact-value">{{doc.statusText}}</text></view><view wx:if="{{registrationStartText}}" class="fact-row"><text class="fact-label">报名开始</text><text class="fact-value">{{registrationStartText}}</text></view><view wx:if="{{registrationEndText}}" class="fact-row"><text class="fact-label">报名截止</text><text class="fact-value">{{registrationEndText}}</text></view></view>
    </view>
    <view wx:if="{{signupInfo.form.enabled || signupInfo.signup || signupInfo.canManage || signupInfo.canViewSignups || signupFailed}}" class="signup-callout"><view class="section-heading"><text class="section-title">活动报名</text><text wx:if="{{signupInfo.state}}" class="badge">{{signupInfo.state}}</text></view><text wx:if="{{signupInfo.signup}}" class="body">已提交报名，可查看本人回执。</text><text wx:elif="{{signupFailed}}" class="muted">报名状态尚未读取，进入报名页重新查询。</text><text wx:if="{{signupStartText}}" class="field-note">问卷开放：{{signupStartText}}</text><text wx:if="{{signupEndText}}" class="field-note">问卷截止：{{signupEndText}}</text><text wx:if="{{doc.requirements}}" class="body">{{doc.requirements}}</text><button class="primary" bindtap="signup">{{signupInfo.signup ? '查看报名回执' : signupFailed ? '查询报名状态' : signupInfo.form.enabled ? '查看并填写报名' : '查看报名与问卷管理'}}</button></view>
    <view wx:if="{{registration}}" class="participation-section"><view class="section-heading"><text class="section-title">参与方式</text><text class="badge">{{registration}}</text></view><text wx:if="{{doc.requirements}}" class="body">{{doc.requirements}}</text><text wx:if="{{doc.channelText}}" class="body" selectable>{{doc.channelText}}</text><image wx:if="{{qr}}" class="qr-image" src="{{qr.url}}" mode="aspectFit" show-menu-by-longpress /><text wx:if="{{doc.contact}}" class="body" selectable>联系人：{{doc.contact}}</text><text wx:if="{{doc.channelCheckedAt}}" class="field-note">渠道核验时间：{{doc.channelCheckedAt}}</text><button wx:if="{{registration === '报名开放'}}" class="primary section" bindtap="register">复制报名渠道</button><text wx:if="{{doc.registrationURL}}" class="field-note">复制外部报名链接后，可在浏览器打开。</text></view>
    <view wx:if="{{doc.competition}}" class="competition-record"><text class="muted">{{doc.competition}}</text><text wx:if="{{doc.division}}" class="field-note">{{doc.division}}</text><text wx:if="{{doc.placing}}" class="honor-placing">{{doc.placing}}</text><button wx:if="{{doc.sourceURL}}" class="plain" bindtap="copy" data-value="{{doc.sourceURL}}">复制公开证明来源</button></view>
    <view wx:if="{{collection === 'teams'}}" class="team-quick-links"><button class="content-link shortcut" bindtap="openWebsite" data-url="/teams/recruitment"><view class="shortcut-main"><text class="shortcut-title">招新与本人队伍记录</text><text class="muted">查看选拔批次、本人申请与成员关系。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button><view class="actions"><button class="plain" bindtap="teamPage" data-page="team-profiles">公开简介与我的设置</button><button class="plain" bindtap="teamPage" data-page="team-honors">队伍荣誉档案</button></view></view>
    <image wx:if="{{coverImage}}" class="photo detail-cover" mode="widthFix" src="{{coverImage.url}}" aria-label="{{coverImage.alt || doc.title}}" /><text wx:if="{{coverImage.credit}}" class="field-note">{{coverImage.credit}}</text>
    <view wx:if="{{nodes.length || social}}" class="body reading-body"><rich-text wx:if="{{nodes.length}}" nodes="{{nodes}}" user-select /><text wx:elif="{{social}}" selectable>{{doc.body}}</text></view>
    <view wx:if="{{doc.members.length}}" class="section"><view class="section-heading"><text class="section-title">赛季阵容</text></view><text class="field-note">历史公开阵容；当前成员关系请在本人队伍记录中查看。</text><view wx:for="{{doc.members}}" wx:key="displayName" class="roster-row"><text class="roster-name">{{item.displayName}}</text><text class="muted">{{item.position}}</text></view></view>
    <view wx:for="{{doc.positions}}" wx:key="name" class="section position-record"><text class="section-title">{{item.name}}</text><text wx:if="{{item.duties}}" class="body">职责：{{item.duties}}</text><text wx:if="{{item.requirements}}" class="body">要求：{{item.requirements}}</text><text wx:if="{{item.commitment}}" class="body">投入：{{item.commitment}}</text><text wx:if="{{item.arrangement}}" class="body">安排：{{item.arrangement}}</text></view>
    <view wx:for="{{photos}}" wx:key="url" class="photo-record"><button class="image-button" hover-class="pressed" bindtap="previewImage" data-url="{{item.url}}" aria-label="{{item.caption || item.alt || '预览图片'}}"><image class="photo" src="{{item.url}}" mode="widthFix" aria-label="{{item.caption || item.alt}}" /></button><text class="field-note">{{item.caption || item.alt}}</text><text wx:if="{{item.credit}}" class="field-note">{{item.credit}}</text></view>
    <video wx:if="{{videoSource}}" class="detail-video" src="{{videoSource}}" controls="{{true}}" autoplay="{{false}}" object-fit="contain" binderror="videoError" /><text wx:if="{{videoError}}" class="error">视频加载失败，请重试或复制链接。</text><button wx:if="{{doc.videoURL}}" class="plain" bindtap="copy" data-value="{{videoSource || doc.videoURL}}">复制视频链接</button>
    <view wx:if="{{links.length}}" class="content-links"><text class="section-title">文中链接</text><view wx:for="{{links}}" wx:key="url" class="record-row"><text class="muted">{{item.label}}</text><button class="plain" bindtap="copy" data-value="{{item.url}}">复制链接</button></view></view>
    <view wx:if="{{related.length}}" class="section"><view class="section-heading"><text class="section-title">赛季与荣誉</text></view><template is="cards" data="{{docs:related, label:'档案'}}" /></view>
    <view wx:if="{{collection === 'teams'}}" class="section"><button class="secondary" bindtap="teamPage" data-page="team-honor-workspace">该队荣誉投稿与审核</button></view>
  </block>
</view>
