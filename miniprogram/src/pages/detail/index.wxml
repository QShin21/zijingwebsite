<import src="../../templates/common.wxml" />
<view class="page"><template is="feedback" data="{{loading, error, needsLogin}}" /><block wx:if="{{!loading && !error && !needsLogin}}"><view class="meta"><text>{{doc.kindText || doc.authorName || '紫荆电竞社'}}</text><text wx:if="{{doc.demo}}" class="badge">演示资料</text><text wx:if="{{doc.statusText}}" class="badge">{{doc.statusText}}</text><text wx:if="{{doc.pinned}}" class="badge">置顶</text><text wx:if="{{doc.featured}}" class="badge">精华</text></view><text class="title detail-title">{{doc.title}}</text><text wx:if="{{doc.summary}}" class="subtitle">{{doc.summary}}</text><view class="meta section"><text>{{dateText}}</text><text wx:if="{{doc.location}}">{{doc.location}}</text></view><image wx:if="{{coverImage}}" class="photo" mode="widthFix" src="{{coverImage.url}}" /><view class="body"><rich-text wx:if="{{nodes.length}}" nodes="{{nodes}}" user-select /><text wx:elif="{{social}}" selectable>{{doc.body}}</text></view><view wx:if="{{endDateText}}" class="section panel"><text class="muted">结束时间</text><text class="body">{{endDateText}}</text></view><view wx:if="{{registration}}" class="section panel"><view class="row"><text class="section-title">参与方式</text><text class="badge">{{registration}}</text></view><text wx:if="{{doc.requirements}}" class="body">{{doc.requirements}}</text><text wx:if="{{doc.channelText}}" class="body" selectable>{{doc.channelText}}</text><image wx:if="{{qr}}" class="qr-image" src="{{qr.url}}" mode="aspectFit" show-menu-by-longpress /><text wx:if="{{doc.contact}}" class="body" selectable>联系人：{{doc.contact}}</text><text wx:if="{{doc.channelCheckedAt}}" class="muted">渠道核验时间：{{doc.channelCheckedAt}}</text><button wx:if="{{registration === '报名开放'}}" class="primary section" bindtap="register">复制报名渠道 ↗</button><text wx:if="{{doc.registrationURL}}" class="muted">外部报名链接可复制到浏览器打开。</text></view><view wx:if="{{doc.competition}}" class="section panel"><text class="section-title">{{doc.competition}}</text><text class="body">{{doc.division}} {{doc.placing}}</text><button wx:if="{{doc.sourceURL}}" class="plain" bindtap="copy" data-value="{{doc.sourceURL}}">复制公开证明来源 ↗</button></view><view wx:if="{{doc.members.length}}" class="section panel"><text class="section-title">赛季阵容</text><view wx:for="{{doc.members}}" wx:key="displayName" class="roster-row"><text>{{item.displayName}}</text><text class="muted">{{item.position}}</text></view></view><view wx:for="{{doc.positions}}" wx:key="name" class="section panel"><text class="section-title">{{item.name}}</text><text wx:if="{{item.duties}}" class="body">职责：{{item.duties}}</text><text wx:if="{{item.requirements}}" class="body">要求：{{item.requirements}}</text><text wx:if="{{item.commitment}}" class="body">投入：{{item.commitment}}</text><text wx:if="{{item.arrangement}}" class="body">安排：{{item.arrangement}}</text></view><view wx:for="{{photos}}" wx:key="url"><image class="photo" src="{{item.url}}" mode="widthFix" bindtap="previewImage" data-url="{{item.url}}" aria-label="{{item.alt}}" /><text class="muted">{{item.caption || item.alt}}</text><text wx:if="{{item.credit}}" class="muted"> · {{item.credit}}</text></view><view wx:for="{{links}}" wx:key="url" class="section panel"><text>{{item.label}}</text><button class="plain" bindtap="copy" data-value="{{item.url}}">复制链接 ↗</button></view><view wx:if="{{related.length}}" class="section"><text class="section-title">赛季与荣誉</text><template is="cards" data="{{docs:related, label:'档案'}}" /></view><view wx:if="{{social}}" class="section actions"><button class="secondary" bindtap="react" data-kind="like">{{reactions.liked ? '已赞' : '点赞'}} {{reactions ? reactions.likes : ''}}</button><button wx:if="{{doc.category === 'event'}}" class="secondary" bindtap="react" data-kind="attend">{{reactions.attending ? '已参与' : '参与'}} {{reactions ? reactions.attends : ''}}</button></view><view wx:if="{{managed}}" class="section panel"><text class="section-title">社群管理</text><view class="actions"><button wx:if="{{collection === 'forum-posts'}}" class="secondary" bindtap="moderate" data-field="pinned">{{doc.pinned ? '取消置顶' : '置顶'}}</button><button wx:if="{{collection === 'forum-posts'}}" class="secondary" bindtap="moderate" data-field="featured">{{doc.featured ? '取消精华' : '设为精华'}}</button><button class="danger" bindtap="moderate" data-field="status">隐藏内容</button></view></view><view wx:if="{{canComment}}" class="section"><text class="section-title">讨论</text><view wx:if="{{!user}}" class="empty"><text class="muted">登录后查看与参与讨论</text><button class="secondary" bindtap="login">登录</button></view><block wx:else><view wx:for="{{comments}}" wx:key="id" class="comment panel"><view class="row"><text class="comment-name">{{item.authorName || '社团成员'}}</text><text class="muted">{{item.dateText}}</text></view><text wx:if="{{item.parent}}" class="muted">回复 #{{item.parent}}</text><text class="body" selectable>{{item.body}}</text><button class="plain" bindtap="reply" data-id="{{item.id}}" data-name="{{item.authorName}}">回复</button></view><button wx:if="{{commentsMore}}" class="plain" bindtap="moreComments" loading="{{commentBusy}}">加载更多评论</button><text wx:if="{{!comments.length}}" class="muted">还没有评论，聊聊你的想法。</text><view class="field"><text wx:if="{{replyTo}}" class="muted" bindtap="cancelReply">回复 {{replyName}} · 点此取消</text><textarea value="{{comment}}" bindinput="commentInput" placeholder="友好交流，最多 5000 字" maxlength="5000" /></view><text wx:if="{{commentError}}" class="error">{{commentError}}</text><button class="primary" bindtap="sendComment" loading="{{commentBusy}}" disabled="{{commentBusy || !comment}}">发送评论</button></block></view></block></view>
