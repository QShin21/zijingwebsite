<import src="../../templates/common.wxml" />
<view class="page"><button class="plain" bindtap="back">返回</button><template is="feedback" data="{{loading, error, needsLogin}}" /><block wx:if="{{!loading && !error && !needsLogin}}"><view class="meta"><text>{{doc.kindText || doc.authorName || '竞在紫荆'}}</text><text wx:if="{{doc.demo}}" class="badge">演示资料</text><text wx:if="{{doc.statusText}}" class="badge">{{doc.statusText}}</text></view><text class="title detail-title">{{doc.title}}</text><text wx:if="{{doc.summary}}" class="subtitle">{{doc.summary}}</text><view class="meta section"><text>{{dateText}}</text><text wx:if="{{doc.location}}">{{doc.location}}</text></view><image wx:if="{{coverImage}}" class="photo" mode="widthFix" src="{{coverImage.url}}" /><view class="body"><rich-text wx:if="{{nodes.length}}" nodes="{{nodes}}" user-select /><text wx:elif="{{social}}" selectable>{{doc.body}}</text></view><view wx:if="{{endDateText}}" class="section panel"><text class="muted">结束时间</text><text class="body">{{endDateText}}</text></view><view wx:if="{{signupInfo.form.enabled || signupInfo.signup || signupInfo.canManage || signupInfo.canViewSignups || signupFailed}}" class="section panel"><text class="section-title">活动报名</text><text class="body">{{signupInfo.signup ? '已报名' : signupInfo.state}}</text><button class="primary" bindtap="signup">{{signupInfo.signup ? '查看报名确认' : signupInfo.form.enabled ? '填写报名信息' : '查看报名与问卷管理'}} →</button></view><view wx:if="{{registration}}" class="section panel"><view class="row"><text class="section-title">参与方式</text><text class="badge">{{registration}}</text></view><text wx:if="{{doc.requirements}}" class="body">{{doc.requirements}}</text><text wx:if="{{doc.channelText}}" class="body" selectable>{{doc.channelText}}</text><image wx:if="{{qr}}" class="qr-image" src="{{qr.url}}" mode="aspectFit" show-menu-by-longpress /><text wx:if="{{doc.contact}}" class="body" selectable>联系人：{{doc.contact}}</text><text wx:if="{{doc.channelCheckedAt}}" class="muted">渠道核验时间：{{doc.channelCheckedAt}}</text><button wx:if="{{registration === '报名开放'}}" class="primary section" bindtap="register">复制报名渠道 ↗</button><text wx:if="{{doc.registrationURL}}" class="muted">外部报名链接可复制到浏览器打开。</text></view><view wx:if="{{doc.competition}}" class="section panel"><text class="section-title">{{doc.competition}}</text><text class="body">{{doc.division}} {{doc.placing}}</text><button wx:if="{{doc.sourceURL}}" class="plain" bindtap="copy" data-value="{{doc.sourceURL}}">复制公开证明来源 ↗</button></view><view wx:if="{{doc.members.length}}" class="section panel"><text class="section-title">赛季阵容</text><view wx:for="{{doc.members}}" wx:key="displayName" class="roster-row"><text>{{item.displayName}}</text><text class="muted">{{item.position}}</text></view></view><view wx:for="{{doc.positions}}" wx:key="name" class="section panel"><text class="section-title">{{item.name}}</text><text wx:if="{{item.duties}}" class="body">职责：{{item.duties}}</text><text wx:if="{{item.requirements}}" class="body">要求：{{item.requirements}}</text><text wx:if="{{item.commitment}}" class="body">投入：{{item.commitment}}</text><text wx:if="{{item.arrangement}}" class="body">安排：{{item.arrangement}}</text></view><view wx:for="{{photos}}" wx:key="url"><image class="photo" src="{{item.url}}" mode="widthFix" bindtap="previewImage" data-url="{{item.url}}" aria-label="{{item.alt}}" /><text class="muted">{{item.caption || item.alt}}</text><text wx:if="{{item.credit}}" class="muted"> · {{item.credit}}</text></view><video wx:if="{{videoSource}}" class="photo" src="{{videoSource}}" controls="{{true}}" autoplay="{{false}}" object-fit="contain" binderror="videoError" /><text wx:if="{{videoError}}" class="error">视频加载失败，请重试或复制链接。</text><button wx:if="{{doc.videoURL}}" class="plain" bindtap="copy" data-value="{{videoSource || doc.videoURL}}">复制视频链接</button><view wx:for="{{links}}" wx:key="url" class="section panel"><text>{{item.label}}</text><button class="plain" bindtap="copy" data-value="{{item.url}}">复制链接 ↗</button></view><view wx:if="{{related.length}}" class="section"><text class="section-title">赛季与荣誉</text><template is="cards" data="{{docs:related, label:'档案'}}" /></view></block></view>
