/* Page-specific structure; shared native primitives live in app.wxss. */
.detail-heading { padding: 8rpx 0 30rpx; border-bottom: 1rpx solid var(--z-control-border); }
.mini-page .detail-title { font-size: 48rpx; margin-top: 26rpx; }
.detail-meta { margin-top: 26rpx; }
.article-body { padding: 30rpx; background: var(--z-surface); border: 1rpx solid var(--z-line); border-radius: 16rpx; }
.signup-callout { border-top: 3rpx solid var(--z-primary); }
.signup-callout .primary { width: 100%; margin-top: 26rpx; }
.honor-record { border-top: 3rpx solid var(--z-positive); }
.honor-placing { display: block; color: var(--z-positive); font-size: 56rpx; font-weight: 650; line-height: 1.35; margin-top: 28rpx; word-break: break-word; }
.qr-image { display: block; width: 380rpx; max-width: 100%; height: 380rpx; margin: 28rpx auto; padding: 14rpx; background: #fff; border-radius: 12rpx; }
.roster-row { display: flex; align-items: center; gap: 18rpx; padding: 26rpx 0; border-bottom: 1rpx solid var(--z-line); }
.roster-row:last-child { border-bottom: 0; padding-bottom: 0; }
.roster-index { color: var(--z-positive); font-size: 23rpx; flex-shrink: 0; }
.roster-name { flex: 1; min-width: 0; word-break: break-word; }
.photo-record { margin-top: 30rpx; }
@media (min-width: 600px) { .mini-page .detail-title { font-size: 30px; } .honor-placing { font-size: 36px; } }
