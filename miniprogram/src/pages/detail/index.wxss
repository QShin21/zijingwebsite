/* V2 detail: hero band, fact sheet, sign-up card + sticky dock, trophy block, gallery. */
.detail-v2 { padding-top: 0; }
.detail-when { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx 18rpx; margin-top: 8rpx; padding: 18rpx 22rpx; border: 1rpx solid var(--z-stage-line); border-radius: 24rpx; background: rgba(255, 255, 255, .06); }
.detail-when-label { color: var(--z-accent); font-size: 22rpx; font-weight: 900; letter-spacing: 4rpx; }
.detail-when-value { font-size: 32rpx; font-weight: 800; }
.detail-signup { border-top: 8rpx solid var(--z-primary); }
.detail-trophy { margin-top: 24rpx; }
.detail-trophy .zj-stage-ghost { align-self: flex-start; margin-top: 8rpx; }
.detail-cover-record { margin-top: 24rpx; }
.detail-cover { display: block; width: 100%; border-radius: 32rpx; background: var(--z-media); }
.detail-body { margin-top: 32rpx; padding: 32rpx 28rpx; border-radius: 32rpx; background: var(--z-surface); border: 1rpx solid var(--z-line); font-size: 31rpx; line-height: 1.9; word-break: break-word; }
.reading-text { white-space: pre-wrap; }
.detail-photo { display: flex; flex-direction: column; gap: 6rpx; }
.detail-video { width: 100%; height: 400rpx; border-radius: 24rpx; }
.qr-image { width: 400rpx; height: 400rpx; padding: 16rpx; margin: 20rpx auto; background: #fff; border-radius: 24rpx; }
.mini-page .detail-workspace { width: 100%; }
.detail-publication-gallery { padding: 20rpx; }
.detail-publication-swiper { height: 760rpx; }
.detail-publication-slide { width: 100%; height: 100%; }
.detail-publication-article-image { display: block; width: 100%; margin: 20rpx 0; }
