<import src="../../templates/common.wxml" />
<view class="page"><text class="eyebrow">ZIJING ARCHIVE</text><text class="title">{{title}}</text><view class="search"><input value="{{search}}" bindinput="input" bindconfirm="search" placeholder="搜索标题" confirm-type="search" maxlength="80" /><button class="secondary" bindtap="search">搜索</button></view><view wx:if="{{collection === 'honors'}}" class="actions"><picker range="{{years}}" bindchange="changeYear"><view class="chip">{{year}} ▾</view></picker><picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="changeGame"><view class="chip">{{games[gameIndex].title}} ▾</view></picker></view><scroll-view wx:if="{{collection === 'recruitment'}}" scroll-x class="chips"><view wx:for="{{kinds}}" wx:key="*this" class="chip {{kind === item ? 'active' : ''}}" bindtap="changeKind" data-kind="{{item}}">{{item}}</view></scroll-view><template is="feedback" data="{{loading, error, needsLogin}}" /><template wx:if="{{!loading && !error && !needsLogin}}" is="cards" data="{{docs, label:title}}" /><button wx:if="{{hasMore && !loading}}" class="plain" bindtap="onReachBottom" loading="{{loadingMore}}">加载更多</button></view>
