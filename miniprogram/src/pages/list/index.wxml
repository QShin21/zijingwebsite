<import src="../../templates/common.wxml" />
<import src="../../templates/club.wxml" />
<view class="page"><button class="plain" bindtap="back">返回</button><text class="eyebrow">ZIJING ARCHIVE</text><text class="title">{{title}}</text><view wx:if="{{collection !== 'club-showcase'}}" class="search"><input value="{{search}}" bindinput="input" bindconfirm="search" placeholder="搜索标题" confirm-type="search" maxlength="80" /><button class="secondary" bindtap="search">搜索</button></view><view wx:if="{{collection === 'honors'}}" class="actions"><picker range="{{years}}" bindchange="changeYear"><view class="chip">{{year}} ▾</view></picker><picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="changeGame"><view class="chip">{{games[gameIndex].title}} ▾</view></picker></view><scroll-view wx:if="{{collection === 'recruitment'}}" scroll-x class="chips"><view wx:for="{{kinds}}" wx:key="*this" class="chip {{kind === item ? 'active' : ''}}" bindtap="changeKind" data-kind="{{item}}">{{item}}</view></scroll-view><template is="feedback" data="{{loading, error, needsLogin}}" /><block wx:if="{{!loading && !error && !needsLogin}}"><block wx:if="{{collection === 'club-showcase'}}"><text class="muted">由社群提出、经审批的社团展示；原社群内容继续保留。</text><template is="promotion-cards" data="{{docs}}" /><view wx:if="{{!docs.length}}" class="empty"><text>暂无已审批社群风采</text></view></block><template wx:else is="cards" data="{{docs, label:title}}" /></block><button wx:if="{{hasMore && !loading}}" class="plain" bindtap="onReachBottom" loading="{{loadingMore}}">加载更多</button></view>
