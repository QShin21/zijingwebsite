<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<import src="../../templates/club.wxml" />
<view class="page mini-page list-page list-page-{{collection}}">
  <button class="plain back" bindtap="back">返回</button><view class="page-heading"><text class="title">{{title}}</text><text class="subtitle">{{collection === 'honors' ? '按赛事日期查阅已核验的项目与成果。' : collection === 'teams' ? '认识代表队，查阅队伍介绍、赛季与公开资料。' : collection === 'club-showcase' ? '来自游戏社群的共同经历。每条记录保留原社群与原文。' : collection === 'albums' ? '浏览活动相册，回到那些一起在场的时刻。' : collection === 'recruitment' ? '查看参与条件、截止时间与报名渠道。' : '查阅已经发布的社团记录。'}}</text></view>
  <view wx:if="{{collection === 'teams'}}" class="list-context"><button class="content-link shortcut" bindtap="openPage" data-page="team"><view class="shortcut-main"><text class="shortcut-title">代表队招新与我的记录</text><text class="muted">选拔批次、本人申请与成员关系。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button></view>
  <view wx:if="{{collection !== 'club-showcase'}}" class="filter-group"><text class="filter-label">搜索{{title}}</text><view class="search"><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{search}}" bindinput="input" bindconfirm="search" placeholder="输入标题关键词" aria-label="搜索当前栏目标题" confirm-type="search" maxlength="80" /><button class="secondary" bindtap="search">搜索</button></view>
    <view wx:if="{{collection === 'honors' || collection === 'teams'}}" class="row archive-filters"><view wx:if="{{collection === 'honors'}}" class="filter-field"><text class="filter-label">赛事年份</text><picker range="{{years}}" value="{{yearIndex}}" bindchange="changeYear"><view class="picker-value">{{year}} ▾</view></picker></view><view class="filter-field"><text class="filter-label">游戏项目</text><picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="changeGame"><view class="picker-value">{{games[gameIndex].title}} ▾</view></picker></view></view>
    <scroll-view wx:if="{{collection === 'recruitment'}}" scroll-x class="chips"><button wx:for="{{kinds}}" wx:key="*this" class="chip {{kind === item ? 'active' : ''}}" bindtap="changeKind" data-kind="{{item}}">{{item}}</button></scroll-view><button wx:if="{{search || yearIndex || gameIndex || kind !== '全部'}}" class="plain" bindtap="clearFilters">清除筛选</button>
  </view>
  <template is="feedback" data="{{loading, error, needsLogin}}" />
  <block wx:if="{{!loading && !error && !needsLogin}}"><block wx:if="{{collection === 'club-showcase'}}"><template is="promotion-cards" data="{{docs}}" /><view wx:if="{{!docs.length}}" class="empty"><text class="state-title">暂无已审批社群风采</text><text class="muted">新的记录发布后会出现在这里。</text></view></block><block wx:else><view class="section-heading"><text class="section-title">{{collection === 'honors' ? year : '已发布内容'}}</text><text class="muted">已加载 {{docs.length}} 条</text></view><template is="cards" data="{{docs, label:title, emptyTitle:'暂无符合条件的内容', emptyHint:'可清除筛选查看全部，或稍后下拉刷新。'}}" /></block></block>
  <button wx:if="{{hasMore && !loading}}" class="secondary section" bindtap="onReachBottom" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button><text wx:if="{{docs.length && !hasMore && !loading}}" class="result-caption">已展示全部结果</text>
</view>
