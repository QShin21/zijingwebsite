<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<import src="../../templates/club.wxml" />
<view class="page mini-page list-page">
  <button class="plain back" bindtap="back">← 返回</button><view class="page-heading"><text class="eyebrow">紫荆年鉴</text><text class="title">{{title}}</text><text class="subtitle">{{collection === 'honors' ? '按年份与项目查阅经过核验的赛事成绩。' : collection === 'teams' ? '认识代表队，查看赛季、队员公开资料与荣誉。' : collection === 'club-showcase' ? '由社群提出、经审批展示，原社群内容与归属继续保留。' : '按目录查阅社团已经发布的记录。'}}</text></view>
  <view wx:if="{{collection !== 'club-showcase'}}" class="search"><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{search}}" bindinput="input" bindconfirm="search" placeholder="搜索标题" aria-label="搜索当前栏目标题" confirm-type="search" maxlength="80" /><button class="secondary" bindtap="search">搜索</button></view>
  <view wx:if="{{collection === 'honors'}}" class="row filters archive-filters"><view class="filter-field"><text class="field-note">年份</text><picker range="{{years}}" bindchange="changeYear"><view class="picker-value">{{year}} ▾</view></picker></view><view class="filter-field"><text class="field-note">游戏项目</text><picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="changeGame"><view class="picker-value">{{games[gameIndex].title}} ▾</view></picker></view></view>
  <scroll-view wx:if="{{collection === 'recruitment'}}" scroll-x class="chips"><button wx:for="{{kinds}}" wx:key="*this" class="chip {{kind === item ? 'active' : ''}}" bindtap="changeKind" data-kind="{{item}}">{{item}}</button></scroll-view>
  <template is="feedback" data="{{loading, error, needsLogin}}" />
  <block wx:if="{{!loading && !error && !needsLogin}}"><block wx:if="{{collection === 'club-showcase'}}"><template is="promotion-cards" data="{{docs}}" /><view wx:if="{{!docs.length}}" class="empty"><text class="state-title">暂无已审批社群风采</text><text class="muted">新的展示发布后会出现在这里。</text></view></block><block wx:else><view class="section-head"><text class="section-kicker">{{collection === 'honors' ? year : '目录'}}</text><text class="muted">已加载至第 {{page}} 页</text></view><template is="cards" data="{{docs, label:title}}" /></block></block>
  <button wx:if="{{hasMore && !loading}}" class="plain section" bindtap="onReachBottom" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
</view>
