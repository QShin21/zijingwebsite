<page-meta page-style="{{themePageStyle}}" />
<template name="visual-cards">
  <button wx:for="{{docs}}" wx:key="id" class="card content-link" bindtap="openContent" data-doc="{{item}}" hover-class="pressed">
    <image wx:if="{{item.coverImage}}" class="card-image" src="{{item.coverImage.url}}" mode="aspectFill" aria-label="{{item.coverImage.alt}}" />
    <view class="card-body"><view class="meta"><text>{{item.kindText || label}}</text><text wx:if="{{item.statusText}}" class="badge">{{item.statusText}}</text><text wx:if="{{item.demo}}" class="badge">演示资料</text></view><text class="card-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="card-summary">{{item.summary}}</text><view class="meta card-footer"><text>{{item.dateText}}</text><text>{{item.location || '查看详情 →'}}</text></view></view>
  </button>
  <view wx:if="{{!docs.length}}" class="empty"><text>内容正在准备中</text><text class="muted">新内容发布后会出现在这里。</text></view>
</template>

<import src="../../templates/common.wxml" />
<import src="../../templates/club.wxml" />
<view class="page mini-page list-page"><button class="plain" bindtap="back">返回</button><text class="eyebrow">ZIJING ARCHIVE</text><text class="title">{{title}}</text><view wx:if="{{collection !== 'club-showcase'}}" class="search"><input placeholder-style="color:{{theme === 'dark' ? '#aaa5b9' : '#6c6179'}}" value="{{search}}" bindinput="input" bindconfirm="search" placeholder="搜索标题" confirm-type="search" maxlength="80" /><button class="secondary" bindtap="search">搜索</button></view><view wx:if="{{collection === 'honors'}}" class="actions"><picker range="{{years}}" bindchange="changeYear"><view class="chip">{{year}} ▾</view></picker><picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="changeGame"><view class="chip">{{games[gameIndex].title}} ▾</view></picker></view><scroll-view wx:if="{{collection === 'recruitment'}}" scroll-x class="chips"><button wx:for="{{kinds}}" wx:key="*this" class="chip {{kind === item ? 'active' : ''}}" bindtap="changeKind" data-kind="{{item}}" hover-class="pressed">{{item}}</button></scroll-view><template is="feedback" data="{{loading, error, needsLogin}}" /><block wx:if="{{!loading && !error && !needsLogin}}"><block wx:if="{{collection === 'club-showcase'}}"><text class="muted">由社群提出、经审批的社团展示；原社群内容继续保留。</text><template is="promotion-cards" data="{{docs}}" /><view wx:if="{{!docs.length}}" class="empty"><text>暂无已审批社群风采</text></view></block><template wx:else is="visual-cards" data="{{docs, label:title}}" /></block><button wx:if="{{hasMore && !loading}}" class="plain" bindtap="onReachBottom" loading="{{loadingMore}}">加载更多</button></view>
