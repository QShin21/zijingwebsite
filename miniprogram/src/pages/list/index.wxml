<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<import src="../../templates/native.wxml" />
<import src="../../templates/native-content.wxml" />
<view class="page mini-page native-page reading-page list-page list-page-{{collection}}">
  <button class="plain back" bindtap="back">返回</button>
  <view class="reading-page-heading"><view class="reading-heading-copy"><text class="title">{{title}}</text><text class="subtitle">{{catalog.intro}}</text></view><template is="native-reading-mark" /></view>
  <view wx:if="{{collection === 'teams'}}" class="list-context"><button class="content-link list-team-entry" bindtap="openPage" data-page="team"><view class="reading-heading-copy"><text class="section-title">招新与我的队伍</text><text class="muted">查看选拔批次、本人申请与成员关系。</text></view><text class="list-entry-sign" aria-hidden="true">›</text></button></view>
  <view wx:if="{{collection !== 'club-showcase'}}" class="filter-group"><text class="filter-label">搜索{{title}}</text><view class="search"><input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{search}}" bindinput="input" bindconfirm="search" placeholder="输入标题关键词" aria-label="搜索当前栏目标题" confirm-type="search" maxlength="80" /><button class="secondary" bindtap="search">搜索</button></view>
    <view wx:if="{{collection === 'honors' || collection === 'teams'}}" class="row archive-filters"><view wx:if="{{collection === 'honors'}}" class="filter-field"><text class="filter-label">赛事年份</text><picker range="{{years}}" value="{{yearIndex}}" bindchange="changeYear"><view class="picker-value">{{year}} ▾</view></picker></view><view class="filter-field"><text class="filter-label">游戏项目</text><picker range="{{games}}" range-key="title" value="{{gameIndex}}" bindchange="changeGame"><view class="picker-value">{{games[gameIndex].title}} ▾</view></picker></view></view>
    <scroll-view wx:if="{{collection === 'recruitment'}}" scroll-x class="chips"><button wx:for="{{kinds}}" wx:key="*this" class="chip {{kind === item ? 'active' : ''}}" bindtap="changeKind" data-kind="{{item}}">{{item}}</button></scroll-view><button wx:if="{{search || yearIndex || gameIndex || kind !== '全部'}}" class="plain list-clear" bindtap="clearFilters">清除筛选</button>
  </view>
  <template is="feedback" data="{{loading, error, needsLogin}}" />
  <block wx:if="{{!loading && !error && !needsLogin}}">
    <view class="section-heading list-result-heading"><text class="section-title">{{collection === 'honors' && yearIndex ? year + '年荣誉' : catalog.resultTitle}}</text><text wx:if="{{docs.length}}" class="list-count">已加载 {{docs.length}} 条</text></view>
    <block wx:if="{{collection === 'club-showcase'}}"><template is="native-promotions" data="{{docs, compact:false}}" /><view wx:if="{{!docs.length}}" class="empty"><text class="state-title">暂无已审批社群风采</text><text class="muted">新的记录发布后会出现在这里。</text></view></block>
    <template wx:elif="{{collection === 'events'}}" is="native-events" data="{{docs, featured:false, compact:false, showNotices:false, emptyTitle:'暂无符合条件的活动', emptyHint:'可清除筛选查看全部，或稍后下拉刷新。'}}" />
    <template wx:else is="native-content-records" data="{{docs, emptyTitle:'暂无符合条件的内容', emptyHint:'可清除筛选查看全部，或稍后下拉刷新。'}}" />
    <text wx:if="{{loadMoreError}}" class="error" aria-role="alert">{{loadMoreError}}</text>
    <button wx:if="{{hasMore}}" class="secondary list-more" bindtap="onReachBottom" loading="{{loadingMore}}" disabled="{{loadingMore}}">{{loadMoreError ? '重试加载更多' : '加载更多'}}</button>
    <text wx:if="{{docs.length && !hasMore}}" class="result-caption">已展示全部结果</text>
  </block>
</view>
