/* V2 list: hero band, search + pickers, V2 record templates. */
.list-v2 { padding-top: 0; }
.list-team-entry { margin-bottom: 20rpx; }
.list-filters { display: flex; flex-direction: column; gap: 6rpx; margin-bottom: 8rpx; }
.list-pickers { display: flex; gap: 14rpx; }
.list-pickers picker { flex: 1; min-width: 0; }
.list-picker { display: flex; flex-direction: column; gap: 4rpx; padding: 16rpx 22rpx; border: 3rpx solid var(--z-line); border-radius: 24rpx; background: var(--z-surface); }
.list-picker-value { color: var(--z-primary); font-size: 28rpx; font-weight: 800; }
.mini-page .list-clear { align-self: flex-start; }
.list-result-heading { margin-top: 28rpx; }
.mini-page .list-more { display: block; width: 100%; margin-top: 20rpx; }
.list-end { text-align: center; }
