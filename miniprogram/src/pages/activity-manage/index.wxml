<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page activity-manage-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{t.kicker}}</text>
      <text class="zj-hero-title">{{t.title}}</text>
      <text class="zj-hero-lead">{{t.lead}}</text>
    </view>
  </view>

  <view class="zj-segments" aria-role="tablist">
    <button class="zj-segment {{kind === 'community-posts' ? 'active' : ''}}" bindtap="area" data-kind="community-posts" hover-class="zj-pressed" disabled="{{loading}}">{{t.communityEvents}}</button>
    <button class="zj-segment {{kind === 'events' ? 'active' : ''}}" bindtap="area" data-kind="events" hover-class="zj-pressed" disabled="{{loading}}">{{t.siteEvents}}</button>
  </view>
  <text class="zj-form-hint">{{kind === 'community-posts' ? t.communityHint : t.siteHint}}</text>
  <template is="feedback" data="{{loading,error,needsLogin,t}}" />

  <block wx:if="{{!loading && !error && !needsLogin}}">
    <view class="zj-section-head"><text class="zj-section-title">{{kind === 'community-posts' ? t.communityEvents : t.siteTitle}}</text><text class="zj-small">{{t.pagePrefix}}{{page}}{{t.pageSuffix}}</text></view>
    <view class="zj-list">
      <button wx:for="{{docs}}" wx:key="id" class="content-link zj-record manage-item {{!item.canManage && !item.canViewSignups ? 'manage-readonly' : ''}}" bindtap="open" data-id="{{item.id}}" hover-class="zj-pressed" disabled="{{!item.canManage && !item.canViewSignups}}">
        <view class="zj-record-head">
          <text class="zj-pill {{item._status === 'draft' ? 'zj-pill-warning' : item.status === 'hidden' ? 'zj-pill-neutral' : 'zj-pill-success'}}">{{item._status === 'draft' ? t.draft : item.status === 'hidden' ? t.hidden : t.public}}</text>
          <text class="zj-arrow">›</text>
        </view>
        <text class="zj-record-title">{{item.title}}</text>
        <text wx:if="{{item._status === 'draft'}}" class="zj-form-hint">{{t.draftHint}}</text>
        <text class="manage-capability">{{item.canManage ? item.canViewSignups ? t.manageBoth : t.editForm : item.canViewSignups ? t.viewList : t.readonly}}</text>
      </button>
    </view>
    <view wx:if="{{!docs.length}}" class="zj-empty">
      <text class="zj-empty-icon">📋</text>
      <text class="zj-empty-title">{{t.emptyTitle}}</text>
      <text class="zj-small">{{t.emptyBody}}</text>
    </view>
    <view wx:if="{{page > 1 || hasNextPage}}" class="manage-pager">
      <button class="secondary" bindtap="previous" disabled="{{page <= 1 || loading}}">{{t.previous}}</button>
      <text class="manage-page">{{t.pagePrefix}}{{page}}{{t.pageSuffix}}</text>
      <button class="secondary" bindtap="next" disabled="{{!hasNextPage || loading}}">{{t.next}}</button>
    </view>
  </block>
</view>
