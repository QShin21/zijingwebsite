<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" /><view class="page mini-page activity-manage-page"><button class="plain" bindtap="back">返回</button><view class="page-heading"><text class="eyebrow">活动管理 · 当前范围</text><text class="title">问卷与报名工作台</text><text class="subtitle">按活动进入问卷或名单，每个入口以当前活动授权为准。</text></view><view class="chips"><button class="chip {{kind === 'community-posts' ? 'active' : ''}}" bindtap="area" data-kind="community-posts" hover-class="pressed">社群活动</button><button class="chip {{kind === 'events' ? 'active' : ''}}" bindtap="area" data-kind="events" hover-class="pressed">站点活动 / 草稿</button></view><template is="feedback" data="{{loading,error,needsLogin}}"/><block wx:if="{{!loading && !error && !needsLogin}}"><button wx:for="{{docs}}" wx:key="id" class="content-link directory-row managed-activity" bindtap="open" data-id="{{item.id}}" hover-class="pressed"><view class="directory-main"><text class="directory-title">{{item.title}}</text><text class="muted">{{item._status === 'draft' ? '草稿，需审核发布' : item.status === 'hidden' ? '已隐藏' : '已公开'}} · {{item.canManage ? '编辑报名问卷' : item.canViewSignups ? '查看报名名单' : '只读'}}</text></view><text class="directory-arrow">→</text></button><text wx:if="{{!docs.length}}" class="empty">暂无可管理的活动。可先在网页中创建活动或保存草稿。</text><view class="row section"><button wx:if="{{page > 1}}" bindtap="previous">上一页</button><button wx:if="{{hasNextPage}}" bindtap="next">下一页</button></view></block></view>