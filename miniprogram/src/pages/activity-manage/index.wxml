<import src="../../templates/common.wxml" /><view class="page"><button class="plain" bindtap="back">返回</button><text class="title">活动问卷管理</text><text class="subtitle">编辑已保存活动的报名问卷，查看报名名单。</text><view class="chips"><view class="chip {{kind === 'community-posts' ? 'active' : ''}}" bindtap="area" data-kind="community-posts">社群活动</view><view class="chip {{kind === 'events' ? 'active' : ''}}" bindtap="area" data-kind="events">站点活动 / 草稿</view></view><template is="feedback" data="{{loading,error,needsLogin}}"/><block wx:if="{{!loading && !error && !needsLogin}}"><view wx:for="{{docs}}" wx:key="id" class="panel section" bindtap="open" data-id="{{item.id}}"><text class="section-title">{{item.title}}</text><text class="muted">{{item._status === 'draft' ? '草稿，需审核发布' : item.status === 'hidden' ? '已隐藏' : '已公开'}} · {{item.canManage ? '编辑报名问卷' : item.canViewSignups ? '查看报名名单' : '只读'}} →</text></view><text wx:if="{{!docs.length}}" class="empty">暂无可管理的活动。可先在网页中创建活动或保存草稿。</text><view class="row section"><button wx:if="{{page > 1}}" bindtap="previous">上一页</button><button wx:if="{{hasNextPage}}" bindtap="next">下一页</button></view></block></view>