@import "../../templates/business.wxss";
@import "../../styles/native-forms.wxss";

/* V2 activity workbench: scope segments, activity records with capability line. */
.activity-manage-v2 { padding-top: 0; }
.mini-page .manage-item { display: flex; flex-direction: column; align-items: stretch; width: 100%; margin-bottom: 0; text-align: left; font-weight: 400; }
.manage-readonly { opacity: .7; }
.manage-capability { align-self: flex-start; padding: 4rpx 16rpx; border-radius: 999rpx; background: var(--z-tint); color: var(--z-primary); font-size: 24rpx; font-weight: 800; }
.manage-pager { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 24rpx; }
.manage-page { font-weight: 900; }
