<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<import src="../../templates/native.wxml" />
<view class="page mini-page community-v2 {{theme === 'dark' ? 'zj-dark' : ''}} {{palette === 'simple' ? 'community-simple' : ''}}">
  <view class="zj-hero community-hero">
    <image wx:if="{{scene}}" class="community-hero-scene" src="{{scene}}" mode="aspectFill" aria-hidden="true" />
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <block wx:if="{{!loading && !error && !needsLogin}}">
        <view class="community-identity">
          <view class="community-crest" aria-hidden="true">
            <image wx:if="{{iconKey && img[iconKey]}}" class="community-crest-image {{iconIsDefault ? 'community-crest-default' : ''}}" src="{{img[iconKey]}}" mode="aspectFit" binderror="imageError" data-key="{{iconKey}}" data-url="{{img[iconKey]}}" />
            <text wx:else>{{game.title ? game.title[0] : t.crestFallback}}</text>
          </view>
          <view class="community-titles">
            <text class="zj-hero-kicker">{{t.kicker}}</text>
            <text class="zj-hero-title">{{game.title}}</text>
          </view>
        </view>
        <text wx:if="{{game.summary}}" class="zj-hero-lead">{{game.summary}}</text>
        <view class="community-actions">
          <button wx:if="{{contactsLoading}}" class="zj-stage-ghost" disabled="{{true}}" loading="{{true}}">{{t.readingContacts}}</button>
          <button wx:elif="{{contactsError}}" class="zj-stage-ghost" bindtap="retryContacts">{{t.retryContacts}}</button>
          <button wx:elif="{{contactAvailable}}" class="accent" bindtap="contactAdmins">{{t.contactAdmins}}</button>
          <button wx:else class="zj-stage-ghost" bindtap="retryContacts">{{t.refreshContacts}}</button>
          <button wx:if="{{nodes.length}}" class="zj-stage-ghost intro-toggle" bindtap="toggleIntro">{{introOpen ? t.introClose : t.introOpen}}</button>
        </view>
        <text wx:if="{{!contactsLoading && contactsError}}" class="community-contact-note">{{t.contactsErrorNote}}</text>
        <text wx:elif="{{!contactsLoading && !contactAvailable && contacts.length}}" class="community-contact-note">{{t.contactsImageNote}}</text>
        <text wx:elif="{{!contactsLoading && !contactAvailable}}" class="community-contact-note">{{t.contactsNoneNote}}</text>
      </block>
    </view>
  </view>
  <template is="feedback" data="{{loading, error, needsLogin, t}}" />
  <block wx:if="{{!loading && !error && !needsLogin}}">
    <view wx:if="{{introOpen && nodes.length}}" class="zj-sheet community-intro"><text class="zj-sheet-title">{{t.intro}}</text><rich-text nodes="{{nodes}}" user-select /></view>
    <view class="zj-segments community-tabs" aria-role="tablist">
      <button class="zj-segment {{area === 'contacts' ? 'active' : ''}}" bindtap="area" data-area="contacts" aria-label="{{t.contactAdmins}}{{area === 'contacts' ? t.selectedSuffix : ''}}">{{t.contactAdmins}}</button>
      <button class="zj-segment {{area === 'updates' ? 'active' : ''}}" bindtap="area" data-area="updates" aria-label="{{t.updates}}{{area === 'updates' ? t.selectedSuffix : ''}}">{{t.updates}}</button>
      <button class="zj-segment {{area === 'showcase' ? 'active' : ''}}" bindtap="area" data-area="showcase" aria-label="{{t.showcase}}{{area === 'showcase' ? t.selectedSuffix : ''}}">{{t.showcase}}</button>
    </view>

    <block wx:if="{{area === 'contacts'}}">
      <view id="community-contacts" class="zj-section">
        <view class="zj-section-head"><view><text class="zj-section-title">{{t.contactAdmins}}</text><text class="zj-small">{{t.contactsHint}}</text></view><button class="plain zj-more" bindtap="retryContacts" disabled="{{contactsLoading}}">{{t.refreshCards}}</button></view>
        <view wx:if="{{contactsLoading}}" class="zj-skeleton" aria-role="status" aria-label="{{t.readingAuthorizedCards}}"><view class="zj-skeleton-row"><view class="zj-skeleton-date"></view><view class="zj-skeleton-lines"><view></view><view></view><view></view></view></view></view>
        <view wx:if="{{contactsError}}" class="zj-alert"><text class="zj-small" aria-role="alert">{{contactsError}}</text><button class="secondary" bindtap="retryContacts" disabled="{{contactsLoading}}">{{t.retryContacts}}</button></view>
        <view wx:if="{{!contacts.length && !contactsLoading && !contactsError}}" class="zj-empty"><text class="zj-empty-icon">🪪</text><text class="zj-empty-title">{{t.noCardsTitle}}</text><text class="zj-small">{{t.noCardsBody}}</text></view>
        <view class="community-contacts">
          <view wx:for="{{contacts}}" wx:key="id" class="community-contact">
            <view class="community-contact-head"><text class="community-contact-avatar">{{item.name[0]}}</text><view><text class="zj-card-title">{{item.name}}</text><text class="zj-small">{{t.adminAuthorized}}</text></view></view>
            <button class="image-button" hover-class="zj-pressed" wx:if="{{item.image && !item.imageError}}" bindtap="previewImage" data-url="{{item.image}}" aria-label="{{t.previewPrefix}}{{item.name}}{{t.cardSuffix}}"><image class="contact-qr" mode="aspectFit" src="{{item.image}}" show-menu-by-longpress aria-label="{{item.name}}{{t.cardSuffix}}" binderror="contactImageError" data-id="{{item.id}}" data-url="{{item.image}}" /></button>
            <text wx:else class="zj-small">{{item.imageError ? t.cardFailed : t.cardUnavailable}}</text>
            <text wx:if="{{item.image && !item.imageError}}" class="zj-small community-qr-caption">{{t.tapPreview}}</text>
            <text class="zj-callout">{{t.addFriendHint}}</text>
          </view>
        </view>
      </view>
      <view class="zj-sheet community-organize">
        <text class="zj-sheet-title">{{t.organizeTitle}}</text>
        <text class="zj-small">{{t.organizeBody}}</text>
        <button class="secondary" bindtap="apply">{{t.applyAdmin}}</button>
      </view>
    </block>

    <block wx:else>
      <view class="zj-section-head"><text class="zj-section-title">{{area === 'updates' ? t.recentUpdates : t.sharedMoments}}</text><button class="plain zj-more" bindtap="retryContent" disabled="{{loadingMore}}">{{t.refresh}}</button></view>
      <button wx:if="{{area === 'showcase'}}" class="accent community-showcase-new" bindtap="openPage" data-page="showcase-new" data-params="{{showcaseParams}}">{{t.newShowcase}}</button>
      <view wx:if="{{area === 'showcase'}}" class="zj-sheet honor-pins">
        <view class="zj-record-head"><text class="zj-sheet-title">{{t.teamHonors}}</text><button class="plain" bindtap="loadHonorPins" disabled="{{honorsLoading}}">{{t.refreshArchive}}</button></view>
        <text class="zj-small">{{t.honorsHint}}</text>
        <text wx:if="{{honorsLoading}}" class="zj-small" aria-role="status">{{t.readingHonors}}</text>
        <view wx:if="{{honorsError}}" class="zj-alert"><text class="zj-small">{{honorsError}}</text><button class="secondary" bindtap="loadHonorPins" disabled="{{honorsLoading}}">{{t.retryHonors}}</button></view>
        <view wx:for="{{honorPins}}" wx:key="id" class="zj-honor community-pin" hover-class="zj-pressed" bindtap="openHonorArchive" data-id="{{item.id}}" aria-role="link" aria-label="{{item.title}}">
          <view class="zj-honor-top"><text class="zj-trophy">🏆</text><text class="zj-placing">{{item.count}}{{t.itemsSuffix}}</text></view>
          <text class="zj-honor-title">{{item.title}}</text>
          <text class="zj-honor-meta">{{item.latestTitle}}<block wx:if="{{item.latestDate}}"> · {{item.latestDate}}</block></text>
        </view>
        <text wx:if="{{!honorPins.length && !honorsLoading && !honorsError}}" class="zj-small">{{t.noHonors}}</text>
      </view>
      <view wx:if="{{contentError}}" class="zj-alert"><text class="zj-small">{{contentError}}</text><button class="secondary" bindtap="retryContent" disabled="{{loadingMore}}">{{t.retryContent}}</button></view>
      <text wx:if="{{loadingMore}}" class="zj-small" aria-role="status">{{t.readingContent}}</text>
      <view class="zj-list">
        <view wx:for="{{docs}}" wx:key="id" class="community-record">
          <view wx:if="{{area === 'updates'}}" class="zj-record" hover-class="zj-pressed" bindtap="openContent" data-doc="{{item}}" aria-role="link" aria-label="{{item.title}}">
            <view class="zj-tags"><text class="zj-kind">{{item.kindText}}</text><text class="zj-small">{{item.dateText}}</text><text wx:if="{{item.authorName}}" class="zj-small">{{item.authorName}}</text></view>
            <text class="zj-record-title">{{item.title}}</text>
            <text class="zj-card-summary zj-clamp">{{item.body}}</text>
            <text class="zj-card-action">{{t.viewDetails}}{{item.category === 'event' ? t.andSignupSuffix : ''}} ›</text>
          </view>
          <view wx:else class="zj-record showcase-record">
            <view class="zj-tags"><text class="zj-kind">{{t.highlight}}</text><text class="zj-small">{{item.dateText}}</text><text wx:if="{{item.authorName}}" class="zj-small">{{item.authorName}}</text></view>
            <text class="zj-record-title">{{item.title}}</text>
            <text class="body">{{item.body}}</text>
            <view wx:for="{{item.localImages}}" wx:for-item="photo" wx:key="source" class="showcase-photo">
              <button class="image-button" hover-class="zj-pressed" wx:if="{{photo.source && !photo.imageError}}" bindtap="previewImage" data-url="{{photo.source}}" aria-label="{{t.previewImage}}"><image class="showcase-image" src="{{photo.source}}" mode="widthFix" binderror="showcaseImageError" data-id="{{item.id}}" data-url="{{photo.source}}" /></button>
              <view wx:elif="{{photo.imageError}}" class="zj-alert"><text class="zj-small">{{t.photoFailed}}</text></view>
              <text wx:if="{{photo.caption}}" class="zj-small">{{photo.caption}}</text>
            </view>
            <video id="showcase-video-{{index}}" wx:if="{{item.videoSource}}" class="showcase-video" src="{{item.videoSource}}" controls="{{true}}" autoplay="{{false}}" object-fit="contain" show-center-play-btn="{{true}}" binderror="videoError" data-index="{{index}}" />
            <text wx:if="{{item.videoError}}" class="error">{{t.videoFailed}}</text>
            <text wx:if="{{item.videoURL && !item.videoSource}}" class="zj-small">{{t.externalVideo}}</text>
            <button wx:if="{{item.videoURL}}" class="secondary" bindtap="copy" data-value="{{item.videoSource || item.videoURL}}">{{t.copyVideo}}</button>
          </view>
        </view>
      </view>
      <view wx:if="{{!docs.length && !loadingMore && !contentError}}" class="zj-empty"><text class="zj-empty-icon">✦</text><text class="zj-empty-title">{{t.emptyTitle}}</text><text class="zj-small">{{t.emptyBody}}</text></view>
      <button wx:if="{{hasMore}}" class="secondary community-load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="onReachBottom">{{t.loadMore}}</button>
    </block>

    <view class="zj-section">
      <view class="zj-section-head"><text class="zj-section-title">{{t.playTogether}}</text></view>
      <view class="zj-call" hover-class="zj-pressed" bindtap="openWebsite" data-url="/teams/recruitment" aria-role="link"><text class="zj-kind">{{t.teamTrials}}</text><text class="zj-card-title">{{t.teamRecruitment}}</text><text class="zj-small">{{t.teamRecruitmentBody}}</text></view>
      <button class="secondary community-wide" bindtap="honorWorkspace" disabled="{{loading || joinBusy}}">{{t.honorWorkspace}}</button>
    </view>
    <view class="zj-section">
      <view class="zj-section-head"><view><text class="zj-section-title">{{t.staffTitle}}</text><text class="zj-small">{{t.staffHint}}</text></view><text class="zj-more" bindtap="staff" aria-role="link">{{t.staffMore}}</text></view>
      <view class="zj-list">
        <view wx:for="{{staffBatches}}" wx:key="id" class="zj-call" hover-class="zj-pressed" bindtap="applyStaff" data-id="{{item.id}}" aria-role="link" aria-label="{{item.title}}">
          <view class="zj-tags"><text class="zj-kind">{{t.staffKind}}</text><text class="zj-pill zj-pill-success">{{item.stateText}}</text></view>
          <text class="zj-card-title">{{item.title}}</text>
          <text wx:if="{{item.description}}" class="zj-card-summary zj-clamp">{{item.description}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{promotions.length}}" class="zj-section"><view class="zj-section-head"><text class="zj-section-title">{{t.recommended}}</text></view><template is="native-promotions" data="{{docs:promotions, compact:true, t}}" /></view>
    <text wx:if="{{clubLoading}}" class="zj-small" aria-role="status">{{t.readingClub}}</text>
    <view wx:if="{{clubError}}" class="zj-alert"><text class="zj-small">{{clubError}}</text><button class="secondary" bindtap="retryClub" disabled="{{clubLoading}}">{{t.retryClub}}</button></view>
  </block>
</view>
