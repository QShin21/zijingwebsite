<import src="../../templates/common.wxml" />
<view class="page">
  <template is="feedback" data="{{loading, error, needsLogin}}" />
  <block wx:if="{{!loading && !error && !needsLogin}}">
    <text class="eyebrow">YOUR COMMUNITY</text><text class="title">{{game.title}}</text>
    <text wx:if="{{game.summary}}" class="subtitle">{{game.summary}}</text>
    <view wx:if="{{nodes.length}}" class="body"><rich-text nodes="{{nodes}}" /></view>
    <scroll-view scroll-x class="chips">
      <view class="chip {{area === 'updates' ? 'active' : ''}}" bindtap="area" data-area="updates">活动与通知</view>
      <view class="chip {{area === 'showcase' ? 'active' : ''}}" bindtap="area" data-area="showcase">社群风采</view>
    </scroll-view>
    <text wx:if="{{contentError}}" class="error">{{contentError}}</text>
    <view wx:for="{{docs}}" wx:key="id" class="card community-card">
      <view wx:if="{{area === 'updates'}}" class="card-body" bindtap="openContent" data-doc="{{item}}">
        <view class="meta"><text>{{item.authorName}}</text><text>{{item.dateText}}</text></view>
        <text class="card-title">{{item.title}}</text><text class="card-summary">{{item.body}}</text><text class="more">查看详情 →</text>
      </view>
      <view wx:else class="card-body">
        <text class="card-title">{{item.title}}</text><text class="meta">{{item.authorName}} · {{item.dateText}}</text><text class="body">{{item.body}}</text>
        <view wx:for="{{item.localImages}}" wx:for-item="photo" wx:key="source">
          <image class="photo" src="{{photo.source}}" mode="widthFix" bindtap="previewImage" data-url="{{photo.source}}" /><text wx:if="{{photo.caption}}" class="muted">{{photo.caption}}</text>
        </view>
        <button wx:if="{{item.videoURL}}" class="plain" bindtap="copy" data-value="{{item.videoURL}}">复制视频链接 ↗</button>
      </view>
    </view>
    <view wx:if="{{!docs.length && !loadingMore && !contentError}}" class="empty"><text>还没有内容</text><text class="muted">新的活动与记录会出现在这里。</text></view>
    <button wx:if="{{hasMore}}" class="plain" loading="{{loadingMore}}" bindtap="onReachBottom">加载更多</button>
    <view wx:if="{{contacts.length}}" class="section panel"><text class="section-title">联系社群管理员</text>
      <view wx:for="{{contacts}}" wx:key="name" class="contact"><text>{{item.name}}</text><image wx:if="{{item.image}}" class="contact-qr" mode="aspectFit" src="{{item.image}}" show-menu-by-longpress bindtap="previewImage" data-url="{{item.image}}" /></view>
    </view>
  </block>
</view>
