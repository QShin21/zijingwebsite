<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<import src="../../templates/native.wxml" />
<view class="page mini-page native-page community-page">
  <button class="plain back" bindtap="back">返回</button>
  <template is="feedback" data="{{loading, error, needsLogin}}" />
  <block wx:if="{{!loading && !error && !needsLogin}}">
    <view class="community-heading">
      <text class="community-kind">游戏社群</text><text class="title">{{game.title}}</text>
      <text wx:if="{{game.summary}}" class="subtitle">{{game.summary}}</text>
      <view class="community-heading-actions"><button wx:if="{{contactsLoading}}" class="secondary" disabled="{{true}}" loading="{{true}}">正在读取名片</button><button wx:elif="{{contactsError}}" class="secondary" bindtap="retryContacts">重试管理员名片</button><button wx:elif="{{contactAvailable}}" class="primary" bindtap="contactAdmins">联系管理员</button><button wx:else class="plain" bindtap="retryContacts">刷新管理员名片</button><button wx:if="{{nodes.length}}" class="plain intro-toggle" bindtap="toggleIntro">{{introOpen ? '收起社群介绍' : '完整社群介绍'}}</button></view>
      <text wx:if="{{!contactsLoading && contactsError}}" class="community-contact-note">暂时无法读取联系方式，重试后再联系管理员。</text><text wx:elif="{{!contactsLoading && !contactAvailable && contacts.length}}" class="community-contact-note">名片图片暂不可用，请刷新后联系管理员。</text><text wx:elif="{{!contactsLoading && !contactAvailable}}" class="community-contact-note">暂无授权名片，当前没有可展示的联系方式。可稍后刷新。</text>
      <view wx:if="{{introOpen && nodes.length}}" class="body community-intro"><rich-text nodes="{{nodes}}" user-select /></view>
    </view>
    <scroll-view scroll-x class="community-tabs"><button class="community-tab {{area === 'contacts' ? 'active' : ''}}" bindtap="area" data-area="contacts" aria-label="联系管理员{{area === 'contacts' ? '，已选择' : ''}}">联系管理员</button><button class="community-tab {{area === 'updates' ? 'active' : ''}}" bindtap="area" data-area="updates" aria-label="活动与通知{{area === 'updates' ? '，已选择' : ''}}">活动与通知</button><button class="community-tab {{area === 'showcase' ? 'active' : ''}}" bindtap="area" data-area="showcase" aria-label="社群风采{{area === 'showcase' ? '，已选择' : ''}}">社群风采</button></scroll-view>
    <block wx:if="{{area === 'contacts'}}">
      <view id="community-contacts" class="native-section contact-panel">
        <view class="native-section-head"><text class="section-title">联系管理员</text><button class="more" bindtap="retryContacts" disabled="{{contactsLoading}}">刷新名片</button></view>
        <text class="muted">微信名片由在任管理员本人授权展示。点按预览，按微信提供的图片菜单操作。</text>
        <view wx:if="{{contactsLoading}}" class="contact-loading" aria-role="status"><text class="muted">正在读取授权名片…</text><view class="loading-lines" aria-hidden="true"><view class="loading-line"></view><view class="loading-line short"></view></view></view>
        <view wx:if="{{contactsError}}" class="contact-feedback"><text class="error" aria-role="alert">{{contactsError}}</text><button class="secondary" bindtap="retryContacts" disabled="{{contactsLoading}}">重试管理员名片</button></view>
        <view wx:if="{{!contacts.length && !contactsLoading && !contactsError}}" class="native-feedback contact-feedback"><text class="state-title">暂无授权名片</text><text class="muted">当前没有可展示的管理员联系方式。可稍后刷新，也可申请参与社群组织。</text></view>
        <view wx:for="{{contacts}}" wx:key="id" class="contact">
          <view class="contact-heading"><text class="contact-name">{{item.name}}</text><text class="contact-permission">在任管理员 · 已授权展示</text></view>
          <button class="image-button" hover-class="pressed" wx:if="{{item.image && !item.imageError}}" bindtap="previewImage" data-url="{{item.image}}" aria-label="预览{{item.name}}的微信名片"><image class="contact-qr" mode="aspectFit" src="{{item.image}}" show-menu-by-longpress aria-label="{{item.name}}的微信名片" binderror="contactImageError" data-id="{{item.id}}" data-url="{{item.image}}" /></button>
          <text wx:else class="muted contact-image-missing">{{item.imageError ? '名片图片加载失败，请刷新重试。' : '名片图片暂时无法显示，请刷新重试。'}}</text>
          <text wx:if="{{item.image && !item.imageError}}" class="qr-caption">点按预览微信名片</text><text class="contact-remark">添加好友时，请备注昵称和游戏项目。</text>
        </view>
      </view>
      <view class="native-section community-organize"><text class="section-title">参与组织这个社群</text><text class="native-summary">申请和修改重提时，需要本人主动同意展示微信名片作为进群联系方式；默认不勾选，获批后仍可关闭展示。</text><button class="secondary" bindtap="apply">申请社群管理员</button></view>
    </block>
    <block wx:else>
      <view class="native-section-head community-content-heading"><text class="section-title">{{area === 'updates' ? '社群近况' : '共同经历'}}</text><button class="more" bindtap="retryContent" disabled="{{loadingMore}}">刷新</button></view>
      <view wx:if="{{area === 'showcase'}}" class="honor-pins">
        <view class="native-section-head"><text class="section-title">代表队荣誉</text><button class="more" bindtap="loadHonorPins" disabled="{{honorsLoading}}">刷新档案</button></view>
        <text class="muted">社群风采中的置顶档案，按现有公开记录展示。</text><text wx:if="{{honorsLoading}}" class="result-caption" aria-role="status">正在读取已核验档案…</text>
        <view wx:if="{{honorsError}}"><text class="error">{{honorsError}}</text><button class="secondary" bindtap="loadHonorPins" disabled="{{honorsLoading}}">重试荣誉档案</button></view>
        <button wx:for="{{honorPins}}" wx:key="id" class="content-link shortcut" bindtap="openHonorArchive" data-id="{{item.id}}"><view class="shortcut-main"><text class="shortcut-title">{{item.title}}</text><text class="native-result">{{item.latestTitle}}</text><view class="native-meta"><text wx:if="{{item.latestDate}}">{{item.latestDate}}</text><text>{{item.count}} 项已核验荣誉</text></view></view><text class="shortcut-sign" aria-hidden="true">›</text></button>
        <text wx:if="{{!honorPins.length && !honorsLoading && !honorsError}}" class="result-caption">该社群暂无已公开的代表队荣誉。</text>
      </view>
      <view wx:if="{{contentError}}"><text class="error">{{contentError}}</text><button class="secondary" bindtap="retryContent" disabled="{{loadingMore}}">重试社群内容</button></view><text wx:if="{{loadingMore}}" class="result-caption" aria-role="status">正在读取社群内容…</text>
      <view wx:for="{{docs}}" wx:key="id" class="community-record">
        <button wx:if="{{area === 'updates'}}" class="content-link community-update" bindtap="openContent" data-doc="{{item}}" hover-class="pressed"><view class="native-meta"><text>{{item.dateText}}</text><text>{{item.kindText}}</text><text wx:if="{{item.authorName}}">{{item.authorName}}</text></view><text class="native-entry-title">{{item.title}}</text><text class="native-summary">{{item.body}}</text><text class="native-entry-action">查看详情{{item.category === 'event' ? '与报名' : ''}}</text></button>
        <view wx:else class="showcase-record"><view class="native-meta"><text>{{item.dateText}}</text><text wx:if="{{item.authorName}}">{{item.authorName}}</text></view><text class="native-entry-title">{{item.title}}</text><text class="body">{{item.body}}</text><view wx:for="{{item.localImages}}" wx:for-item="photo" wx:key="source"><button class="image-button" hover-class="pressed" wx:if="{{photo.source && !photo.imageError}}" bindtap="previewImage" data-url="{{photo.source}}" aria-label="预览图片"><image class="photo" src="{{photo.source}}" mode="widthFix" binderror="showcaseImageError" data-id="{{item.id}}" data-url="{{photo.source}}" /></button><view wx:elif="{{photo.imageError}}" class="native-media-fallback"><view class="native-media-field"><template is="native-field-graphic" /></view><text class="native-media-error">这张图片暂时无法显示，可刷新社群内容重试。</text></view><text wx:if="{{photo.caption}}" class="field-note">{{photo.caption}}</text></view><video id="showcase-video-{{index}}" wx:if="{{item.videoSource}}" class="showcase-video" src="{{item.videoSource}}" controls="{{true}}" autoplay="{{false}}" object-fit="contain" show-center-play-btn="{{true}}" binderror="videoError" data-index="{{index}}" /><text wx:if="{{item.videoError}}" class="error">视频暂时无法播放，请检查网络或使用下方链接。</text><text wx:if="{{item.videoURL && !item.videoSource}}" class="field-note">此内容使用外部视频页面，可复制链接到浏览器打开。</text><button wx:if="{{item.videoURL}}" class="plain" bindtap="copy" data-value="{{item.videoSource || item.videoURL}}">复制视频链接</button></view>
      </view>
      <view wx:if="{{!docs.length && !loadingMore && !contentError}}" class="empty"><text class="state-title">该社群还没有公开内容</text><text class="muted">新的活动、通知与风采发布后会出现在这里。</text></view><button wx:if="{{hasMore}}" class="secondary community-load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="onReachBottom">加载更多</button>
    </block>
    <view class="native-section community-opportunities"><view class="native-section-head"><text class="section-title">一起上场</text></view><button class="content-link shortcut" bindtap="openWebsite" data-url="/teams/recruitment"><view class="shortcut-main"><text class="shortcut-title">代表队招新与本人记录</text><text class="muted">查看队伍选拔、入队申请及成员关系。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button><button class="plain" bindtap="honorWorkspace" disabled="{{loading || joinBusy}}">本社群荣誉投稿与审核</button></view>
    <view class="native-section community-staff"><view class="native-section-head"><text class="section-title">社团骨干招新</text><button class="more" bindtap="staff">批次与我的申请</button></view><text class="muted">各社群入口使用同一批次申请与回执。</text><button wx:for="{{staffBatches}}" wx:key="id" class="content-link shortcut" bindtap="applyStaff" data-id="{{item.id}}"><view class="shortcut-main"><text class="badge">{{item.state}}</text><text class="shortcut-title">{{item.title}}</text><text wx:if="{{item.description}}" class="muted">{{item.description}}</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button></view>
    <view wx:if="{{promotions.length}}" class="native-section"><view class="native-section-head"><text class="section-title">社群推荐</text></view><template is="native-promotions" data="{{docs:promotions, compact:true}}" /></view>
    <text wx:if="{{clubLoading}}" class="result-caption" aria-role="status">正在读取招新与推荐…</text><view wx:if="{{clubError}}" class="native-section native-feedback"><text class="error">{{clubError}}</text><button class="secondary" bindtap="retryClub" disabled="{{clubLoading}}">重试社团信息</button></view>
  </block>
</view>
