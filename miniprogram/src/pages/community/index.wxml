<import src="../../templates/common.wxml" />
<view class="page"><template is="feedback" data="{{loading, error, needsLogin}}" /><block wx:if="{{!loading && !error && !needsLogin}}"><text class="eyebrow">YOUR COMMUNITY</text><text class="title">{{game.title}}</text><text wx:if="{{game.summary}}" class="subtitle">{{game.summary}}</text><view wx:if="{{nodes.length}}" class="body"><rich-text nodes="{{nodes}}" /></view><view class="actions section"><button class="primary" bindtap="chat">进入社群聊天 →</button><button wx:if="{{managed}}" class="secondary" bindtap="review">投稿审核</button></view><scroll-view scroll-x class="chips"><view class="chip {{area === 'updates' ? 'active' : ''}}" bindtap="area" data-area="updates">活动与通知</view><view class="chip {{area === 'forum' ? 'active' : ''}}" bindtap="area" data-area="forum">社群论坛</view><view class="chip {{area === 'showcase' ? 'active' : ''}}" bindtap="area" data-area="showcase">社群风采</view></scroll-view><view wx:if="{{area === 'forum'}}" class="row"><view class="actions"><text class="chip {{sort === 'latest' ? 'active' : ''}}" bindtap="sort" data-sort="latest">最新</text><text class="chip {{sort === 'hot' ? 'active' : ''}}" bindtap="sort" data-sort="hot">热度</text></view><text class="more" bindtap="compose">发帖 ＋</text></view><button wx:if="{{area === 'showcase' || managed && area === 'updates'}}" class="secondary" bindtap="compose">{{area === 'showcase' ? '分享社群风采 ＋' : '发布活动或通知 ＋'}}</button><text wx:if="{{contentError}}" class="error">{{contentError}}</text><view wx:for="{{docs}}" wx:key="id" class="card community-card"><view wx:if="{{area !== 'showcase'}}" class="card-body" bindtap="openContent" data-doc="{{item}}"><view class="meta"><text>{{item.authorName}}</text><text class="badge" wx:if="{{item.pinned}}">置顶</text><text class="badge" wx:if="{{item.featured}}">精华</text><text>{{item.dateText}}</text></view><text class="card-title">{{item.title}}</text><text class="card-summary">{{item.body}}</text><text class="more">查看讨论 →</text></view><view wx:else class="card-body"><text class="card-title">{{item.title}}</text><text class="meta">{{item.authorName}} · {{item.dateText}}</text><text class="body">{{item.body}}</text><view wx:for="{{item.localImages}}" wx:for-item="photo" wx:key="source"><image class="photo" src="{{photo.source}}" mode="widthFix" bindtap="previewImage" data-url="{{photo.source}}" /><text wx:if="{{photo.caption}}" class="muted">{{photo.caption}}</text></view><button wx:if="{{item.videoURL}}" class="plain" bindtap="copy" data-value="{{item.videoURL}}">复制视频链接 ↗</button><button wx:if="{{managed}}" class="plain" bindtap="manageShowcase" data-id="{{item.id}}">隐藏投稿</button></view></view><view wx:if="{{!docs.length && !loadingMore && !contentError}}" class="empty"><text>还没有内容</text><text class="muted">新的讨论与活动会出现在这里。</text></view><button wx:if="{{hasMore}}" class="plain" loading="{{loadingMore}}" bindtap="onReachBottom">加载更多</button><view wx:if="{{contacts.length}}" class="section panel"><text class="section-title">联系社群管理员</text><view wx:for="{{contacts}}" wx:key="name" class="contact"><text>{{item.name}}</text><image wx:if="{{item.image}}" class="contact-qr" mode="aspectFit" src="{{item.image}}" show-menu-by-longpress bindtap="previewImage" data-url="{{item.image}}" /></view></view></block></view>
