<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<import src="../../templates/club.wxml" />
<view class="page mini-page community-page">
  <button class="plain back" bindtap="back">返回</button><template is="feedback" data="{{loading, error, needsLogin}}" />
  <block wx:if="{{!loading && !error && !needsLogin}}">
    <view class="page-heading"><text class="eyebrow">游戏社群</text><text class="title">{{game.title}}</text><text wx:if="{{game.summary}}" class="subtitle">{{game.summary}}</text><button wx:if="{{nodes.length}}" class="plain intro-toggle" bindtap="toggleIntro">{{introOpen ? '收起社群介绍 −' : '完整社群介绍 +'}}</button><view wx:if="{{introOpen && nodes.length}}" class="body community-intro"><rich-text nodes="{{nodes}}" user-select /></view></view>
    <scroll-view scroll-x class="chips section-tabs"><button class="chip section-tab {{area === 'contacts' ? 'active' : ''}}" bindtap="area" data-area="contacts">联系与进群</button><button class="chip section-tab {{area === 'updates' ? 'active' : ''}}" bindtap="area" data-area="updates">活动与通知</button><button class="chip section-tab {{area === 'showcase' ? 'active' : ''}}" bindtap="area" data-area="showcase">社群风采</button></scroll-view>
    <block wx:if="{{area === 'contacts'}}">
      <view class="join-progress {{join ? 'has-record' : ''}}"><view class="section-heading"><text class="section-title">我的进群进度</text><button class="more" bindtap="retryJoin" disabled="{{joinLoading || joinBusy}}">刷新</button></view><text class="status-title">{{join ? join.statusText : '尚未记录加入意向'}}</text><text wx:if="{{join.note}}" class="body">管理员说明：{{join.note}}</text><text wx:if="{{join.confirmedText}}" class="field-note">人工确认时间：{{join.confirmedText}}</text><text wx:if="{{joinLoading}}" class="field-note" aria-role="status">正在读取进度…</text><text wx:if="{{joinError}}" class="error">{{joinError}}</text><text wx:if="{{joinDone}}" class="body" aria-role="status">{{joinDone}}</text><text class="field-note">好友与群成员状态以微信中的实际情况为准。</text><view wx:if="{{joinActions.reportFriend || joinActions.withdraw}}" class="actions"><button wx:if="{{joinActions.reportFriend}}" class="primary" bindtap="joinAction" data-action="reportFriend" disabled="{{joinBusy || joinLoading}}">我已发送好友申请</button><button wx:if="{{joinActions.withdraw}}" class="plain" bindtap="joinAction" data-action="withdraw" disabled="{{joinBusy || joinLoading}}">撤回网站意向</button></view><text wx:if="{{join.status === 'joined'}}" class="field-note">退出微信群或更正实际成员情况，请联系管理员。</text><button wx:if="{{canHandle}}" class="secondary section" bindtap="manageJoins" disabled="{{joinBusy}}">人工进群管理</button></view>
      <view class="section contact-panel"><view class="section-heading"><text class="section-title">联系管理员，申请加入微信群</text><button class="more" bindtap="retryContacts" disabled="{{contactsLoading || joinBusy}}">刷新</button></view><text class="field-note">以下微信名片由在任管理员本人授权展示。点按预览，按微信提供的图片菜单操作；添加好友时请备注昵称和游戏项目。</text><text wx:if="{{contactsLoading}}" class="result-caption">正在读取授权名片…</text><view wx:if="{{contactsError}}"><text class="error">{{contactsError}}</text><button class="secondary" bindtap="retryContacts" disabled="{{contactsLoading}}">重试管理员名片</button></view><view wx:if="{{!contacts.length && !contactsLoading && !contactsError}}" class="empty"><text class="state-title">暂无授权名片</text><text class="muted">可稍后刷新，或申请参与社群组织。</text></view>
        <view wx:for="{{contacts}}" wx:key="id" class="contact"><view class="contact-heading"><text class="section-title">{{item.name}}</text><text class="field-note">在任管理员 / 已授权展示</text></view><button class="image-button" hover-class="pressed" wx:if="{{item.image}}" bindtap="previewImage" data-url="{{item.image}}" aria-label="预览{{item.name}}的微信名片"><image class="contact-qr" mode="aspectFit" src="{{item.image}}" show-menu-by-longpress aria-label="{{item.name}}的微信名片" /></button><text wx:else class="muted">名片图片暂时无法显示，请刷新重试。</text><text wx:if="{{item.image}}" class="qr-caption">点按预览微信名片</text><button wx:if="{{joinActions.request && item.image && item.id}}" class="primary contact-action" bindtap="joinAction" data-action="request" data-contact="{{item.id}}" disabled="{{joinBusy || joinLoading}}">记录联系这位管理员的加入意向</button></view>
      </view>
      <view class="join-guide"><text class="section-title">接下来怎样进群</text><view class="join-steps"><view><text class="join-step-number">1</text><text>查看管理员名片</text></view><view><text class="join-step-number">2</text><text>到微信手动发送好友申请</text></view><view><text class="join-step-number">3</text><text>等待管理员人工拉群</text></view></view><text class="muted">查看、保存名片或记录意向均不会自动进群。</text></view>
      <view class="section community-organize"><text class="section-title">参与组织这个社群</text><text class="field-note">申请和修改重提时，需要本人主动同意展示微信名片作为进群联系方式；默认不勾选，获批后仍可关闭展示。</text><button class="secondary section" bindtap="apply">申请社群管理员</button></view>
    </block>
    <block wx:else>
      <view class="section-heading"><text class="section-title">{{area === 'updates' ? '社群近况' : '共同经历'}}</text><button class="more" bindtap="retryContent" disabled="{{loadingMore}}">刷新</button></view>
      <view wx:if="{{area === 'showcase'}}" class="honor-pins"><view class="section-heading"><text class="section-title">代表队荣誉</text><button class="more" bindtap="loadHonorPins" disabled="{{honorsLoading}}">刷新档案</button></view><text class="field-note">社群风采中的置顶档案，按现有公开记录展示。</text><text wx:if="{{honorsLoading}}" class="result-caption">正在读取已核验档案…</text><view wx:if="{{honorsError}}"><text class="error">{{honorsError}}</text><button class="secondary" bindtap="loadHonorPins" disabled="{{honorsLoading}}">重试荣誉档案</button></view><button wx:for="{{honorPins}}" wx:key="id" class="content-link shortcut" bindtap="openHonorArchive" data-id="{{item.id}}"><view class="shortcut-main"><text class="shortcut-title">{{item.title}}</text><text class="muted">{{item.latestTitle}}</text><view class="meta-line"><text wx:if="{{item.latestDate}}">{{item.latestDate}}</text><text>{{item.count}} 项已核验荣誉</text></view></view><text class="shortcut-sign" aria-hidden="true">›</text></button><text wx:if="{{!honorPins.length && !honorsLoading && !honorsError}}" class="result-caption">该社群暂无已公开的代表队荣誉。</text></view>
      <view wx:if="{{contentError}}"><text class="error">{{contentError}}</text><button class="secondary" bindtap="retryContent" disabled="{{loadingMore}}">重试社群内容</button></view><text wx:if="{{loadingMore}}" class="result-caption">正在读取社群内容…</text>
      <view wx:for="{{docs}}" wx:key="id" class="community-record"><button wx:if="{{area === 'updates'}}" class="content-link community-update" bindtap="openContent" data-doc="{{item}}" hover-class="pressed"><view class="meta-line"><text>{{item.dateText}}</text><text>{{item.kindText}}</text><text wx:if="{{item.authorName}}">{{item.authorName}}</text></view><text class="card-title">{{item.title}}</text><text class="card-summary">{{item.body}}</text><text class="entry-link">查看详情{{item.category === 'event' ? '与报名' : ''}}</text></button>
        <view wx:else class="showcase-record"><view class="meta-line"><text>{{item.dateText}}</text><text wx:if="{{item.authorName}}">{{item.authorName}}</text></view><text class="card-title">{{item.title}}</text><text class="body">{{item.body}}</text><view wx:for="{{item.localImages}}" wx:for-item="photo" wx:key="source"><button class="image-button" hover-class="pressed" wx:if="{{photo.source}}" bindtap="previewImage" data-url="{{photo.source}}" aria-label="预览图片"><image class="photo" src="{{photo.source}}" mode="widthFix" /></button><text wx:if="{{photo.caption}}" class="field-note">{{photo.caption}}</text></view><video id="showcase-video-{{index}}" wx:if="{{item.videoSource}}" class="showcase-video" src="{{item.videoSource}}" controls="{{true}}" autoplay="{{false}}" object-fit="contain" show-center-play-btn="{{true}}" binderror="videoError" data-index="{{index}}" /><text wx:if="{{item.videoError}}" class="error">视频暂时无法播放，请检查网络或使用下方链接。</text><text wx:if="{{item.videoURL && !item.videoSource}}" class="field-note">此内容使用外部视频页面，可复制链接到浏览器打开。</text><button wx:if="{{item.videoURL}}" class="plain" bindtap="copy" data-value="{{item.videoSource || item.videoURL}}">复制视频链接</button></view>
      </view>
      <view wx:if="{{!docs.length && !loadingMore && !contentError}}" class="empty"><text class="state-title">该社群还没有公开内容</text><text class="muted">新的活动、通知与风采发布后会出现在这里。</text></view><button wx:if="{{hasMore}}" class="secondary section" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="onReachBottom">加载更多</button>
    </block>
    <view class="section"><view class="section-heading"><text class="section-title">一起上场</text></view><button class="content-link shortcut" bindtap="openWebsite" data-url="/teams/recruitment"><view class="shortcut-main"><text class="shortcut-title">代表队招新与本人记录</text><text class="muted">查看队伍选拔、入队申请及成员关系。</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button><button class="plain" bindtap="honorWorkspace" disabled="{{loading || joinBusy}}">本社群荣誉投稿与审核</button></view>
    <view class="section"><view class="section-heading"><text class="section-title">社团骨干招新</text><button class="more" bindtap="staff">批次与我的申请</button></view><text class="field-note">各社群入口使用同一批次申请与回执。</text><button wx:for="{{staffBatches}}" wx:key="id" class="content-link shortcut" bindtap="applyStaff" data-id="{{item.id}}"><view class="shortcut-main"><text class="badge">{{item.state}}</text><text class="shortcut-title">{{item.title}}</text><text wx:if="{{item.description}}" class="muted">{{item.description}}</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button></view>
    <view wx:if="{{promotions.length}}" class="section"><view class="section-heading"><text class="section-title">社群推荐</text></view><template is="promotion-cards" data="{{docs:promotions}}" /></view><text wx:if="{{clubLoading}}" class="result-caption">正在读取招新与推荐…</text><view wx:if="{{clubError}}" class="section"><text class="error">{{clubError}}</text><button class="secondary" bindtap="retryClub" disabled="{{clubLoading}}">重试社团信息</button></view>
  </block>
</view>
