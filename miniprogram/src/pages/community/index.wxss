.community-page .page-heading { margin-bottom: 22rpx; }
.community-page .body:first-child { margin-top: 0; }
.join-guide { padding: 28rpx 0; border-bottom: 1rpx solid var(--z-line); }
.contact { padding: 28rpx 0; margin-top: 26rpx; border-top: 1rpx solid var(--z-line); }
.contact-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.contact-qr { width: 312rpx; height: 312rpx; }
.qr-caption { display: block; text-align: center; font-size: 25rpx; color: var(--z-muted); }
.status-title { display: block; font-size: 32rpx; line-height: 1.7; font-weight: 600; }
.honor-pins { border-top: 2rpx solid var(--z-primary); padding-top: 26rpx; margin-bottom: 36rpx; }
.community-card .body { font-size: 30rpx; }
