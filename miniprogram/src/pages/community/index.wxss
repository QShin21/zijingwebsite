/* V2 community home: campus scene, segmented areas, contact cards, showcase records. */
.community-v2 { padding-top: 0; }
.community-hero { background: var(--z-stage); }
.community-hero-scene { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; opacity: .36; pointer-events: none; }
.community-hero .zj-hero-kicker, .community-hero .zj-hero-lead { color: var(--z-stage-ink); }
.community-identity { display: flex; align-items: center; gap: 22rpx; }
.community-crest { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 152rpx; height: 152rpx; background: radial-gradient(ellipse at center, rgba(255, 255, 255, .14), transparent 70%); color: var(--z-stage-ink); font-size: 56rpx; font-weight: 900; }
.community-simple .community-crest { background: radial-gradient(ellipse at center, rgba(57, 50, 67, .48), rgba(57, 50, 67, .12) 42%, transparent 72%); }
.community-crest-image { display: block; width: 100%; height: 100%; filter: drop-shadow(0 0 3rpx rgba(0, 0, 0, .9)) drop-shadow(0 0 3rpx rgba(255, 255, 255, .8)); }
.community-crest-default { transform: scale(1.4); }
.community-titles { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.community-actions { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 8rpx; }
.community-contact-note { color: var(--z-stage-ink); font-size: 24rpx; }
.community-intro { margin-top: 0; font-size: 30rpx; line-height: 1.85; }
.community-tabs { margin-top: 24rpx; }
.community-contacts { display: flex; flex-direction: column; gap: 18rpx; }
.community-contact { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 28rpx; border: 1rpx solid var(--z-line); border-radius: 32rpx; background: var(--z-surface); }
.community-contact-head { display: flex; align-items: center; gap: 18rpx; align-self: stretch; }
.community-contact-avatar { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border-radius: 50%; background: linear-gradient(135deg, var(--z-primary), var(--z-stage2)); color: #fff; font-size: 34rpx; font-weight: 900; }
.community-qr-caption { text-align: center; }
.community-organize { margin-top: 28rpx; gap: 14rpx; }
.honor-pins { gap: 14rpx; margin-bottom: 20rpx; }
.community-pin { margin-top: 6rpx; }
.showcase-photo { display: flex; flex-direction: column; gap: 6rpx; }
.showcase-image { display: block; width: 100%; border-radius: 24rpx; background: var(--z-media); }
.showcase-video { width: 100%; height: 380rpx; border-radius: 24rpx; }
.mini-page .community-load-more, .mini-page .community-wide { display: block; width: 100%; margin-top: 18rpx; }
