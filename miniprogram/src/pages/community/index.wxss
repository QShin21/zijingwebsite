.community-card { margin-top: 24rpx; }
.contact { display: flex; flex-direction: column; align-items: flex-start; gap: 18rpx; margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid #eae3f0; }
.contact-qr { width: 220rpx; height: 220rpx; }

.showcase-video { display: block; width: 100%; height: 400rpx; margin-top: 24rpx; border-radius: 16rpx; background: #17131d; }

.panel > .section-title, .panel > .muted { display: block; }
.panel > .muted { margin-top: 12rpx; }
.staff-row { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid #eae3f0; }
.staff-row > .muted, .contact .muted { display: block; }
