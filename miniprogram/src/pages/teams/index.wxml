<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/v2.wxml" />
<view wx:if="{{campus}}" class="page mini-page zj-tab-page {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="page-heading {{scene ? 'page-heading-scenic' : ''}}">
    <zj-campus scene="{{scene}}" palette="{{palette}}" />
    <text class="eyebrow">TEAMS · 代表队中心</text>
    <text class="title">代表队</text>
    <text class="subtitle">队伍、荣誉墙与选拔中心。想上场？到选拔中心找开放批次。</text>
  </view>
  <view class="zj-segments" aria-role="tablist">
    <button class="zj-segment {{view === 'teams' ? 'active' : ''}}" bindtap="switchView" data-view="teams" aria-selected="{{view === 'teams'}}">队伍</button>
    <button class="zj-segment {{view === 'honors' ? 'active' : ''}}" bindtap="switchView" data-view="honors" aria-selected="{{view === 'honors'}}">荣誉墙</button>
    <button class="zj-segment {{view === 'recruitment' ? 'active' : ''}}" bindtap="switchView" data-view="recruitment" aria-selected="{{view === 'recruitment'}}">选拔中心</button>
  </view>

  <template wx:if="{{view !== 'recruitment' && !user}}" is="zj-login" data="{{title: '登录后查看代表队与荣誉', body: '队员简介与荣誉档案仅向社团成员展示；选拔中心可直接浏览。'}}" />
  <template wx:elif="{{loading}}" is="zj-loading" />
  <template wx:elif="{{error}}" is="zj-error" data="{{error}}" />

  <block wx:elif="{{view === 'teams'}}">
    <view wx:if="{{docs.length}}" class="zj-list">
      <block wx:for="{{docs}}" wx:key="key"><template is="zj-team" data="{{item}}" /></block>
    </view>
    <template wx:else is="zj-empty" data="{{title: '还没有公开的代表队', body: '代表队由社群管理员申请建立，审核通过后出现在这里。', icon: '🏆'}}" />
    <view class="teams-tools">
      <button class="secondary" bindtap="openWorkspace">我的代表队事务</button>
    </view>
  </block>

  <block wx:elif="{{view === 'honors'}}">
    <view wx:for="{{groups}}" wx:for-item="group" wx:key="key">
      <view class="zj-day-head"><text>{{group.key}}</text></view>
      <view class="zj-list">
        <block wx:for="{{group.items}}" wx:key="key"><template is="zj-honor" data="{{item, img}}" /></block>
      </view>
    </view>
    <template wx:if="{{!groups.length}}" is="zj-empty" data="{{title: '暂无已核验的荣誉', body: '现任队员可以投稿比赛荣誉，经审核后上墙。', icon: '🏆'}}" />
    <view class="teams-tools"><button class="secondary" bindtap="openHonorWorkspace">我的荣誉投稿与审核</button></view>
  </block>

  <block wx:else>
    <view class="zj-section">
      <template is="zj-section" data="{{title: '骨干招新', count: staff.length}}" />
      <view wx:if="{{staff.length}}" class="zj-list">
        <block wx:for="{{staff}}" wx:key="key"><template is="zj-call" data="{{item}}" /></block>
      </view>
      <template wx:else is="zj-empty" data="{{title: '当前没有骨干招新批次', body: '新的批次发布后会出现在这里。', icon: '🚩'}}" />
    </view>
    <view wx:if="{{user}}" class="zj-section">
      <template is="zj-section" data="{{title: '代表队选拔', count: calls.length}}" />
      <view wx:if="{{calls.length}}" class="zj-list">
        <block wx:for="{{calls}}" wx:key="key"><template is="zj-call" data="{{item}}" /></block>
      </view>
      <template wx:else is="zj-empty" data="{{title: '当前没有开放的代表队选拔', body: '可以先浏览代表队与往期安排。', icon: '🏆'}}" />
    </view>
    <view wx:if="{{mine.length}}" class="zj-section">
      <template is="zj-section" data="{{title: '我的申请进度'}}" />
      <view class="zj-list">
        <block wx:for="{{mine}}" wx:key="key"><template is="zj-application" data="{{item}}" /></block>
      </view>
    </view>
    <view class="teams-tools">
      <button wx:if="{{user}}" class="secondary" bindtap="openWorkspace">入队申请与成员记录</button>
      <button class="secondary" bindtap="openStaff">骨干招新与我的回执</button>
      <button wx:if="{{!user}}" class="primary" bindtap="login">登录查看代表队选拔</button>
    </view>
  </block>
  <text wx:if="{{loadMoreError && !loading}}" class="error">{{loadMoreError}}</text>
  <button wx:if="{{view !== 'recruitment' && user && (hasMore || loadMoreError)}}" class="secondary teams-more" bindtap="onReachBottom" disabled="{{loadingMore}}">{{loadingMore ? '加载中…' : (loadMoreError ? '重试加载更多' : '加载更多')}}</button>
</view>
