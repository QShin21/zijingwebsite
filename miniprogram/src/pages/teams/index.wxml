<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/v2.wxml" />
<view wx:if="{{campus}}" class="page mini-page zj-tab-page {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="page-heading {{scene ? 'page-heading-scenic' : ''}}">
    <zj-campus scene="{{scene}}" palette="{{palette}}" />
    <text class="eyebrow">{{t.eyebrow}}</text>
    <text class="title">{{t.title}}</text>
    <text class="subtitle">{{t.subtitle}}</text>
  </view>
  <view class="zj-segments" aria-role="tablist">
    <button class="zj-segment {{view === 'teams' ? 'active' : ''}}" bindtap="switchView" data-view="teams" aria-selected="{{view === 'teams'}}">{{t.tabTeams}}</button>
    <button class="zj-segment {{view === 'honors' ? 'active' : ''}}" bindtap="switchView" data-view="honors" aria-selected="{{view === 'honors'}}">{{t.tabHonors}}</button>
    <button class="zj-segment {{view === 'recruitment' ? 'active' : ''}}" bindtap="switchView" data-view="recruitment" aria-selected="{{view === 'recruitment'}}">{{t.tabRecruitment}}</button>
  </view>

  <template wx:if="{{view !== 'recruitment' && !user}}" is="zj-login" data="{{title: t.loginTitle, body: t.loginBody, t}}" />
  <template wx:elif="{{loading}}" is="zj-loading" data="{{t: t}}" />
  <template wx:elif="{{error}}" is="zj-error" data="{{error, t}}" />

  <block wx:elif="{{view === 'teams'}}">
    <view wx:if="{{docs.length}}" class="zj-list">
      <block wx:for="{{docs}}" wx:key="key"><template is="zj-team" data="{{item, t}}" /></block>
    </view>
    <template wx:else is="zj-empty" data="{{title: t.teamsEmptyTitle, body: t.teamsEmptyBody, icon: '🏆'}}" />
    <view class="teams-tools">
      <button class="secondary" bindtap="openWorkspace">{{t.myTeamWork}}</button>
    </view>
  </block>

  <block wx:elif="{{view === 'honors'}}">
    <view wx:for="{{groups}}" wx:for-item="group" wx:key="key">
      <view class="zj-day-head"><text>{{group.key}}</text></view>
      <view class="zj-list">
        <block wx:for="{{group.items}}" wx:key="key"><template is="zj-honor" data="{{item, img, t}}" /></block>
      </view>
    </view>
    <template wx:if="{{!groups.length}}" is="zj-empty" data="{{title: t.honorsEmptyTitle, body: t.honorsEmptyBody, icon: '🏆'}}" />
    <view class="teams-tools"><button class="secondary" bindtap="openHonorWorkspace">{{t.honorWorkspace}}</button></view>
  </block>

  <block wx:else>
    <view class="zj-section">
      <template is="zj-section" data="{{title: t.staffTitle, count: staff.length}}" />
      <view wx:if="{{staff.length}}" class="zj-list">
        <block wx:for="{{staff}}" wx:key="key"><template is="zj-call" data="{{item, t}}" /></block>
      </view>
      <template wx:else is="zj-empty" data="{{title: t.staffEmptyTitle, body: t.staffEmptyBody, icon: '🚩'}}" />
    </view>
    <view wx:if="{{user}}" class="zj-section">
      <template is="zj-section" data="{{title: t.callsTitle, count: calls.length}}" />
      <view wx:if="{{calls.length}}" class="zj-list">
        <block wx:for="{{calls}}" wx:key="key"><template is="zj-call" data="{{item, t}}" /></block>
      </view>
      <template wx:else is="zj-empty" data="{{title: t.callsEmptyTitle, body: t.callsEmptyBody, icon: '🏆'}}" />
    </view>
    <view wx:if="{{mine.length}}" class="zj-section">
      <template is="zj-section" data="{{title: t.mineTitle}}" />
      <view class="zj-list">
        <block wx:for="{{mine}}" wx:key="key"><template is="zj-application" data="{{item, t}}" /></block>
      </view>
    </view>
    <view class="teams-tools">
      <button wx:if="{{user}}" class="secondary" bindtap="openWorkspace">{{t.workspace}}</button>
      <button class="secondary" bindtap="openStaff">{{t.staffPage}}</button>
      <button wx:if="{{!user}}" class="primary" bindtap="login">{{t.loginCalls}}</button>
    </view>
  </block>
  <text wx:if="{{loadMoreError && !loading}}" class="error">{{loadMoreError}}</text>
  <button wx:if="{{view !== 'recruitment' && user && (hasMore || loadMoreError)}}" class="secondary teams-more" bindtap="onReachBottom" disabled="{{loadingMore}}">{{loadingMore ? t.loadingMore : (loadMoreError ? t.retryMore : t.loadMore)}}</button>
</view>
