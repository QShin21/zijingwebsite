<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page team-honors-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero honors-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{t.kickerPrefix}}{{team.gameTitle || t.archive}}</text>
      <text class="zj-hero-title">{{team.title || t.titleFallback}}</text>
      <text class="zj-hero-lead">{{t.lead}}</text>
      <view wx:if="{{validTeam}}" class="honors-actions">
        <button class="accent" bindtap="submitHonor">{{t.submit}}</button>
        <button class="zj-stage-ghost" bindtap="workspace">{{t.workspace}}</button>
      </view>
    </view>
  </view>
  <template is="feedback" data="{{loading,error,needsLogin:false,t}}" />
  <view wx:if="{{loaded && !records.length && !loading && !error}}" class="zj-empty">
    <text class="zj-empty-icon">🏆</text>
    <text class="zj-empty-title">{{t.emptyTitle}}</text><text class="zj-small">{{t.emptyBody}}</text>
    <button class="secondary" bindtap="retry">{{t.reload}}</button>
  </view>
  <view class="honors-timeline">
    <block wx:for="{{records}}" wx:key="key">
      <view wx:if="{{item.archiveYear && (index === 0 || item.archiveYear !== records[index - 1].archiveYear)}}" class="zj-day-head honors-year"><text>{{item.archiveYear}}</text><text class="zj-small">{{t.yearRecords}}</text></view>
      <view class="zj-honor honors-record">
        <view class="zj-honor-top">
          <view class="honors-date"><text class="honors-date-value">{{item.archiveDate || item.dateText}}</text><text class="honors-date-label">{{t.matchDate}}</text></view>
          <text wx:if="{{item.placing}}" class="zj-placing">{{item.placing}}</text>
        </view>
        <text wx:if="{{item.competition}}" class="zj-honor-meta">{{item.competition}}</text>
        <text class="zj-honor-title">{{item.title}}</text>
        <text wx:if="{{item.legacy}}" class="zj-pill zj-pill-warning">{{t.legacy}}</text>
        <text wx:if="{{item.description}}" class="honors-description" selectable>{{item.description}}</text>
        <text wx:if="{{item.authorName}}" class="zj-honor-meta">{{t.recordedByPrefix}}{{item.authorName}}</text>
        <text wx:if="{{item.mediaLoading}}" class="zj-honor-meta">{{t.loadingImages}}</text>
        <view wx:if="{{item.localImages.length}}" class="honors-gallery">
          <view wx:for="{{item.localImages}}" wx:for-item="picture" wx:key="url" class="honors-picture"><button class="image-button" hover-class="zj-pressed" bindtap="preview" data-url="{{picture.url}}" aria-label="{{picture.caption || t.previewImage}}"><image class="honors-image" src="{{picture.url}}" mode="aspectFill" aria-label="{{picture.caption}}" /></button><text class="zj-honor-meta">{{picture.caption}}</text></view>
        </view>
        <text wx:if="{{item.mediaError}}" class="error">{{item.mediaError}}</text>
        <video wx:if="{{item.videoSource}}" id="honor-video-{{index}}" class="honor-video" src="{{item.videoSource}}" controls="{{true}}" autoplay="{{false}}" object-fit="contain" binderror="videoError" data-key="{{item.key}}" data-source="{{item.videoSource}}" />
        <text wx:if="{{item.videoError}}" class="error">{{item.videoError}}</text>
        <button wx:if="{{item.mediaError || item.videoError}}" class="zj-stage-ghost" bindtap="retry" disabled="{{loading}}">{{t.reloadArchive}}</button>
        <button wx:if="{{item.sourceHref}}" class="zj-stage-ghost" bindtap="source" data-key="{{item.key}}">{{t.viewSource}}</button>
      </view>
    </block>
  </view>
  <view wx:if="{{loaded && records.length}}" class="honors-footer"><button class="secondary" bindtap="retry" disabled="{{loading}}">{{t.refresh}}</button></view>
</view>
