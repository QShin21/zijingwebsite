<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page team-honors-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero honors-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">‹ 返回队伍</button>
      <text class="zj-hero-kicker">HALL OF FAME · {{team.gameTitle || '队伍档案'}}</text>
      <text class="zj-hero-title">{{team.title || '队伍荣誉档案'}}</text>
      <text class="zj-hero-lead">现任队员可提交荣誉。经审核的成绩按赛事日期归档。</text>
      <view wx:if="{{validTeam}}" class="honors-actions">
        <button class="accent" bindtap="submitHonor">提交代表队荣誉</button>
        <button class="zj-stage-ghost" bindtap="workspace">我的荣誉投稿与工作台</button>
      </view>
    </view>
  </view>
  <template is="feedback" data="{{loading,error,needsLogin:false}}" />
  <view wx:if="{{loaded && !records.length && !loading && !error}}" class="zj-empty">
    <text class="zj-empty-icon">🏆</text>
    <text class="zj-empty-title">暂无已公开的荣誉档案</text><text class="zj-small">队伍的荣誉记录核验并发布后会出现在这里。</text>
    <button class="secondary" bindtap="retry">重新加载</button>
  </view>
  <view class="honors-timeline">
    <block wx:for="{{records}}" wx:key="key">
      <view wx:if="{{item.archiveYear && (index === 0 || item.archiveYear !== records[index - 1].archiveYear)}}" class="zj-day-head honors-year"><text>{{item.archiveYear}}</text><text class="zj-small">赛场记录</text></view>
      <view class="zj-honor honors-record">
        <view class="zj-honor-top">
          <view class="honors-date"><text class="honors-date-value">{{item.archiveDate || item.dateText}}</text><text class="honors-date-label">赛事日期</text></view>
          <text wx:if="{{item.placing}}" class="zj-placing">{{item.placing}}</text>
        </view>
        <text wx:if="{{item.competition}}" class="zj-honor-meta">{{item.competition}}</text>
        <text class="zj-honor-title">{{item.title}}</text>
        <text wx:if="{{item.legacy}}" class="zj-pill zj-pill-warning">历史荣誉档案</text>
        <text wx:if="{{item.description}}" class="honors-description" selectable>{{item.description}}</text>
        <text wx:if="{{item.authorName}}" class="zj-honor-meta">记录：{{item.authorName}}</text>
        <text wx:if="{{item.mediaLoading}}" class="zj-honor-meta">正在加载公开图片…</text>
        <view wx:if="{{item.localImages.length}}" class="honors-gallery">
          <view wx:for="{{item.localImages}}" wx:for-item="picture" wx:key="url" class="honors-picture"><button class="image-button" hover-class="zj-pressed" bindtap="preview" data-url="{{picture.url}}" aria-label="{{picture.caption || '预览荣誉图片'}}"><image class="honors-image" src="{{picture.url}}" mode="aspectFill" aria-label="{{picture.caption}}" /></button><text class="zj-honor-meta">{{picture.caption}}</text></view>
        </view>
        <text wx:if="{{item.mediaError}}" class="error">{{item.mediaError}}</text>
        <video wx:if="{{item.videoSource}}" id="honor-video-{{index}}" class="honor-video" src="{{item.videoSource}}" controls="{{true}}" autoplay="{{false}}" object-fit="contain" binderror="videoError" data-key="{{item.key}}" data-source="{{item.videoSource}}" />
        <text wx:if="{{item.videoError}}" class="error">{{item.videoError}}</text>
        <button wx:if="{{item.mediaError || item.videoError}}" class="zj-stage-ghost" bindtap="retry" disabled="{{loading}}">重新加载档案</button>
        <button wx:if="{{item.sourceHref}}" class="zj-stage-ghost" bindtap="source" data-key="{{item.key}}">查看历史荣誉原文</button>
      </view>
    </block>
  </view>
  <view wx:if="{{loaded && records.length}}" class="honors-footer"><button class="secondary" bindtap="retry" disabled="{{loading}}">刷新档案</button></view>
</view>
