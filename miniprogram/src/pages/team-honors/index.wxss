.team-honors-page .page-heading { border-bottom: 2rpx solid var(--z-text); }
.archive-year { display: block; font-size: 60rpx; line-height: 1.2; font-weight: 700; font-variant-numeric: tabular-nums; margin: 40rpx 0 16rpx; }
.archive-record { padding: 30rpx 0; border-bottom: 1rpx solid var(--z-line); }
.archive-record-head { display: flex; align-items: flex-start; gap: 24rpx; }
.archive-date-rail { flex-shrink: 0; width: 132rpx; color: var(--z-muted); font-size: 28rpx; font-variant-numeric: tabular-nums; word-break: break-word; }
.archive-date-rail .field-note { margin-top: 8rpx; font-size: 23rpx; }
.archive-record-main { flex: 1; min-width: 0; }
.honor-title { margin: 10rpx 0; font-size: 34rpx; }
.honor-placing { font-size: 42rpx; line-height: 1.4; margin: 12rpx 0; }
.archive-record-body { margin-top: 12rpx; }
.archive-record-body .body { margin-top: 18rpx; }
@media (max-width: 359px) { .archive-date-rail { width: 124rpx; font-size: 13px; } .archive-date-rail .field-note { font-size: 12px; } .honor-title { font-size: 17px; } }
