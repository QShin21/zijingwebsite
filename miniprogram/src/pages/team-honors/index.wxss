/* V2 team hall of fame: year heads + trophy cards. */
.team-honors-v2 { padding-top: 0; }
.honors-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 8rpx; }
.honors-timeline { display: flex; flex-direction: column; gap: 18rpx; }
.honors-year { font-size: 36rpx; }
.honors-date { display: flex; flex-direction: column; }
.honors-date-value { color: var(--z-stage-ink); font-size: 30rpx; font-weight: 900; }
.honors-date-label { color: var(--z-stage-muted); font-size: 21rpx; font-weight: 800; }
.honors-description { color: var(--z-stage-ink); font-size: 27rpx; line-height: 1.75; white-space: pre-wrap; }
.honors-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.honors-picture { display: flex; flex-direction: column; gap: 6rpx; }
.honors-image { width: 100%; height: 240rpx; border-radius: 20rpx; background: rgba(255, 255, 255, .06); }
.honor-video { width: 100%; height: 360rpx; border-radius: 20rpx; }
.honors-footer { margin-top: 24rpx; }
.honors-footer > button { width: 100%; }
