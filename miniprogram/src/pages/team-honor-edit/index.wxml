<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page honor-edit-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{t.kicker}}</text>
      <text class="zj-hero-title">{{record ? t.titleRecord : t.titleNew}}</text>
      <text class="zj-hero-lead">{{t.lead}}</text>
    </view>
  </view>
  <template is="feedback" data="{{needsLogin,t}}" />
  <text wx:if="{{loading}}" class="zj-form-hint" aria-role="status">{{t.checking}}</text>
  <text wx:if="{{busy && !videoUploading}}" class="zj-callout">{{t.busyNote}}</text>
  <view wx:if="{{error}}" class="zj-alert"><text class="zj-small">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{busy || loading}}">{{t.rereadReceipt}}</button></view>
  <block wx:if="{{!needsLogin}}">
    <text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text>
    <text wx:if="{{message}}" class="zj-callout zj-callout-success" aria-role="status">{{message}}</text>
    <view wx:if="{{record}}" class="zj-honor honor-edit-receipt">
      <view class="zj-honor-top"><view><text class="zj-honor-meta">{{t.currentStatus}}</text><text class="zj-honor-title">{{record.statusText}}</text></view><text class="zj-placing honor-edit-id">#{{record.id}}</text></view>
      <text class="zj-honor-meta">{{teamTitle}}{{t.revisionPrefix}}{{record.revision}}<block wx:if="{{record.season}}">{{t.seasonPrefix}}{{record.season}}</block></text>
      <view wx:if="{{record.reviewNote}}" class="honor-edit-feedback"><text class="honor-edit-label">{{t.reviewFeedback}}</text><text>{{record.reviewNote}}</text></view>
      <text class="zj-honor-meta">{{record.state === 'approved' ? t.stateApproved : record.state === 'pending' ? t.statePending : t.stateDraft}}</text>
      <button wx:if="{{record.state === 'approved'}}" class="zj-stage-ghost" bindtap="archive" disabled="{{busy || loading}}">{{t.viewArchive}}</button>
    </view>
    <view wx:if="{{uncertainCreate}}" class="zj-sheet">
      <text class="zj-sheet-title">{{t.checkCreate}}</text>
      <text class="zj-callout zj-callout-warning">{{t.checkCreateBody}}</text>
      <button class="secondary" bindtap="mine" disabled="{{busy || loading}}">{{t.viewMine}}</button>
      <view wx:for="{{recentDocs}}" wx:key="id" class="zj-record"><view class="zj-record-head"><text class="zj-record-title">{{item.title}}</text><text class="zj-pill zj-pill-action">{{item.statusText}}</text></view><text class="zj-small">{{t.submissionPrefix}}{{item.id}}{{t.teamMiddle}}{{item.team}}</text><button class="plain" bindtap="openRecent" data-id="{{item.id}}" disabled="{{busy}}">{{t.checkReceipt}}</button></view>
    </view>
    <view wx:if="{{ready && !record && !teams.length && !uncertainCreate}}" class="zj-empty">
      <text class="zj-empty-icon">🛡</text>
      <text class="zj-empty-title">{{t.needMemberTitle}}</text>
      <text class="zj-small">{{t.needMemberBody}}</text>
      <button class="secondary" bindtap="recruitments">{{t.viewRecruitment}}</button>
    </view>
    <view wx:else class="honor-edit-form">
      <view class="zj-sheet">
        <text class="zj-sheet-title">{{t.stepInfo}}</text>
        <text class="zj-form-hint">{{t.stepInfoHint}}</text>
        <view wx:if="{{!record}}" class="field"><text class="field-label">{{t.teamLabel}}</text><picker range="{{teams}}" range-key="title" value="{{teamIndex}}" bindchange="team" disabled="{{busy || loading || !ready || uncertainCreate}}"><view class="picker-value">{{teamTitle || t.noTeam}} ▾</view></picker></view>
        <text wx:if="{{!editable && !loading}}" class="zj-callout zj-callout-warning">{{t.readOnly}}</text>
        <view class="field"><text class="field-label">{{t.titleLabel}}</text><input cursor-spacing="24" value="{{fields.title}}" maxlength="120" bindinput="input" data-field="title" disabled="{{busy || loading || !editable}}" /><text class="zj-form-hint">{{t.titleHint}}</text></view>
        <view class="field"><text class="field-label">{{t.competitionLabel}}</text><input cursor-spacing="24" value="{{fields.competition}}" maxlength="200" bindinput="input" data-field="competition" disabled="{{busy || loading || !editable}}" /></view>
        <view class="field"><text class="field-label">{{t.placingLabel}}</text><input cursor-spacing="24" value="{{fields.placing}}" maxlength="200" bindinput="input" data-field="placing" disabled="{{busy || loading || !editable}}" /></view>
        <view class="field"><text class="field-label">{{t.dateLabel}}</text><view class="honor-edit-date"><picker mode="date" value="{{fields.date}}" bindchange="date" disabled="{{busy || loading || !editable}}"><view class="picker-value">{{fields.date || t.pickDate}} ▾</view></picker><button class="plain" bindtap="clearDate" disabled="{{busy || loading || !editable}}">{{t.clearDate}}</button></view></view>
        <view class="field"><text class="field-label">{{t.descriptionLabel}}</text><textarea cursor-spacing="24" value="{{fields.description}}" maxlength="5000" bindinput="input" data-field="description" disabled="{{busy || loading || !editable}}" /><text class="zj-form-hint">{{t.descriptionHint}}</text></view>
      </view>
      <view class="zj-sheet">
        <text class="zj-sheet-title">{{t.stepMaterials}}</text>
        <view class="zj-callout"><text class="honor-edit-label">{{t.publicOnly}}</text><text>{{t.publicOnlyBody}}</text></view>
        <view class="zj-record-head"><text class="field-label">{{t.images}}</text><text class="zj-count">{{images.length}}/6</text></view>
        <text class="zj-form-hint">{{t.imagesHint}}</text>
        <view wx:for="{{images}}" wx:key="index" class="honor-edit-image">
          <view class="zj-record-head"><text class="field-label">{{t.materialPrefix}}{{index+1}}</text><button class="plain honor-edit-remove" bindtap="removeImage" data-index="{{index}}" disabled="{{busy || loading || !editable}}">{{t.removeImage}}</button></view>
          <button class="image-button" hover-class="zj-pressed" wx:if="{{item.path}}" bindtap="previewEvidence" data-path="{{item.path}}" aria-label="{{item.caption || t.evidenceImage}}"><image class="honor-edit-photo" mode="aspectFill" src="{{item.path}}" aria-label="{{item.caption || t.evidenceImage}}" /></button>
          <view class="field"><text class="field-label">{{t.captionLabel}}</text><input cursor-spacing="24" value="{{item.caption}}" maxlength="200" bindinput="caption" data-index="{{index}}" disabled="{{busy || loading || !editable}}" /></view>
        </view>
        <text wx:if="{{imageError}}" class="zj-form-hint">{{imageError}}</text>
        <button class="secondary honor-edit-add" bindtap="chooseImages" disabled="{{busy || loading || !editable || images.length >= 6}}">{{t.addImages}}</button>
        <text class="zj-form-hint">{{t.addImagesHint}}</text>
        <button class="plain" bindtap="openPrivacy" disabled="{{busy || loading}}">{{t.privacyGuide}}</button>
      </view>
      <view class="zj-sheet">
        <text class="zj-sheet-title">{{t.stepVideo}}</text>
        <text class="zj-form-hint">{{t.videoHint}}</text>
        <view wx:if="{{record.hasVideo}}" class="honor-edit-video">
          <text class="field-label">{{t.savedVideo}}</text>
          <button class="plain" bindtap="viewVideo" disabled="{{busy || loading}}">{{t.readSavedVideo}}</button>
          <video wx:if="{{videoSource}}" id="honor-own-video" class="evidence-video" src="{{videoSource}}" controls autoplay="{{false}}" binderror="videoError" data-id="{{record.id}}" data-revision="{{record.revision}}" aria-label="{{t.savedVideoLabel}}" />
          <text wx:if="{{videoError}}" class="error">{{videoError}}</text>
          <label class="honor-edit-switch"><view><text class="field-label">{{t.removeVideoLabel}}</text><text class="zj-form-hint">{{t.removeVideoHint}}</text></view><switch color="{{themePrimary}}" checked="{{fields.removeVideo}}" bindchange="removeVideo" disabled="{{busy || loading || !editable}}" /></label>
        </view>
        <text wx:if="{{!record}}" class="zj-callout">{{t.videoAfterDraft}}</text>
        <button wx:if="{{record}}" class="secondary" bindtap="chooseVideo" disabled="{{busy || loading || !editable || !canSave}}">{{hasSelectedVideo ? t.rechooseVideo : t.chooseVideo}}</button>
        <view wx:if="{{hasSelectedVideo}}" class="honor-edit-video"><text class="field-label">{{t.pendingVideo}}</text><text class="zj-form-hint">{{selectedVideoSize}}{{t.pendingVideoSuffix}}</text><view class="actions"><button class="primary" bindtap="uploadVideo" disabled="{{busy || loading || !canUploadVideo}}">{{t.uploadVideo}}</button><button class="plain" bindtap="discardVideo" disabled="{{busy || loading}}">{{t.discardVideo}}</button></view></view>
        <view wx:if="{{videoUploading}}" class="honor-edit-upload" aria-role="status"><text class="field-label">{{videoProgress < 100 ? t.uploading : t.confirming}}</text><progress percent="{{videoProgress}}" show-info activeColor="{{themePrimary}}" backgroundColor="{{themeLine}}" stroke-width="6" border-radius="6" /><text class="zj-form-hint">{{t.uploadWait}}</text></view>
      </view>
      <text class="zj-form-hint">{{t.submitNote}}</text>
      <text wx:if="{{record && record.state === 'approved'}}" class="zj-callout zj-callout-warning">{{t.approvedWarning}}</text>
      <view class="zj-dock"><button class="secondary" bindtap="save" loading="{{busy}}" disabled="{{busy || loading || !canSave}}">{{t.saveDraft}}</button><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || loading || !canSubmit}}">{{t.submit}}</button></view>
    </view>
    <view class="honor-edit-links"><button class="plain" bindtap="retry" disabled="{{busy || loading}}">{{t.rereadState}}</button><button wx:if="{{record}}" class="plain" bindtap="reload" disabled="{{busy || loading}}">{{t.reloadSaved}}</button><button class="plain" bindtap="mine" disabled="{{busy || loading}}">{{t.viewMyHonors}}</button></view>
  </block>
</view>
<privacy-consent id="privacyConsent" />
