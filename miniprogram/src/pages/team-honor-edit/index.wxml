<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page honor-edit-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">‹ 返回</button>
      <text class="zj-hero-kicker">队伍成果 · 投稿</text>
      <text class="zj-hero-title">{{record ? '荣誉投稿与回执' : '记录一份队伍荣誉'}}</text>
      <text class="zj-hero-lead">填写成果与可公开材料，送交本社群管理员审核后进入荣誉档案。</text>
    </view>
  </view>
  <template is="feedback" data="{{needsLogin}}" />
  <text wx:if="{{loading}}" class="zj-form-hint" aria-role="status">正在核对投稿资料与操作权限…</text>
  <text wx:if="{{busy && !videoUploading}}" class="zj-callout">本次确认、选图或保存尚未结束，请稍候。</text>
  <view wx:if="{{error}}" class="zj-alert"><text class="zj-small">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{busy || loading}}">重新读取回执</button></view>
  <block wx:if="{{!needsLogin}}">
    <text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text>
    <text wx:if="{{message}}" class="zj-callout zj-callout-success" aria-role="status">{{message}}</text>
    <view wx:if="{{record}}" class="zj-honor honor-edit-receipt">
      <view class="zj-honor-top"><view><text class="zj-honor-meta">当前投稿状态</text><text class="zj-honor-title">{{record.statusText}}</text></view><text class="zj-placing honor-edit-id">#{{record.id}}</text></view>
      <text class="zj-honor-meta">{{teamTitle}} · 修订 {{record.revision}}<block wx:if="{{record.season}}"> · 原赛季 {{record.season}}</block></text>
      <view wx:if="{{record.reviewNote}}" class="honor-edit-feedback"><text class="honor-edit-label">审核反馈</text><text>{{record.reviewNote}}</text></view>
      <text class="zj-honor-meta">{{record.state === 'approved' ? '本修订已批准。保存修改会撤下当前展示，重新提交审核后方可恢复。' : record.state === 'pending' ? '已进入审核队列，请在回执中查看后续反馈。' : '草稿与补充材料保留在同一投稿，提交后由他人审核。'}}</text>
      <button wx:if="{{record.state === 'approved'}}" class="zj-stage-ghost" bindtap="archive" disabled="{{busy || loading}}">查看队伍公开荣誉档案</button>
    </view>
    <view wx:if="{{uncertainCreate}}" class="zj-sheet">
      <text class="zj-sheet-title">先核对这次新建结果</text>
      <text class="zj-callout zj-callout-warning">原输入已保留，请先查看本人记录。同名记录需逐份核对，本页不会自动认领或重复新建。</text>
      <button class="secondary" bindtap="mine" disabled="{{busy || loading}}">查看我的投稿记录</button>
      <view wx:for="{{recentDocs}}" wx:key="id" class="zj-record"><view class="zj-record-head"><text class="zj-record-title">{{item.title}}</text><text class="zj-pill zj-pill-action">{{item.statusText}}</text></view><text class="zj-small">投稿 {{item.id}} · 队伍 {{item.team}}</text><button class="plain" bindtap="openRecent" data-id="{{item.id}}" disabled="{{busy}}">核对这份本人回执</button></view>
    </view>
    <view wx:if="{{ready && !record && !teams.length && !uncertainCreate}}" class="zj-empty">
      <text class="zj-empty-icon">🛡</text>
      <text class="zj-empty-title">投稿需要当前有效队员身份</text>
      <text class="zj-small">当前范围内暂无你可以投稿的代表队。</text>
      <button class="secondary" bindtap="recruitments">查看代表队招新与本人记录</button>
    </view>
    <view wx:else class="honor-edit-form">
      <view class="zj-sheet">
        <text class="zj-sheet-title">① 成果信息</text>
        <text class="zj-form-hint">先写清哪场赛事、获得什么成绩。标题为草稿必填；其余信息在提交审核前补齐。</text>
        <view wx:if="{{!record}}" class="field"><text class="field-label">所属有效代表队 · 必选</text><picker range="{{teams}}" range-key="title" value="{{teamIndex}}" bindchange="team" disabled="{{busy || loading || !ready || uncertainCreate}}"><view class="picker-value">{{teamTitle || '暂无可投稿的有效队伍'}} ▾</view></picker></view>
        <text wx:if="{{!editable && !loading}}" class="zj-callout zj-callout-warning">当前资料只读，可重新读取回执核对允许的操作。</text>
        <view class="field"><text class="field-label">荣誉标题 · 必填</text><input cursor-spacing="24" value="{{fields.title}}" maxlength="120" bindinput="input" data-field="title" disabled="{{busy || loading || !editable}}" /><text class="zj-form-hint">最多 120 字，作为荣誉档案中的标题。</text></view>
        <view class="field"><text class="field-label">赛事名称 · 提交时必填</text><input cursor-spacing="24" value="{{fields.competition}}" maxlength="200" bindinput="input" data-field="competition" disabled="{{busy || loading || !editable}}" /></view>
        <view class="field"><text class="field-label">奖项或名次 · 提交时必填</text><input cursor-spacing="24" value="{{fields.placing}}" maxlength="200" bindinput="input" data-field="placing" disabled="{{busy || loading || !editable}}" /></view>
        <view class="field"><text class="field-label">赛事日期 · 提交时必填</text><view class="honor-edit-date"><picker mode="date" value="{{fields.date}}" bindchange="date" disabled="{{busy || loading || !editable}}"><view class="picker-value">{{fields.date || '请选择赛事日期'}} ▾</view></picker><button class="plain" bindtap="clearDate" disabled="{{busy || loading || !editable}}">清空日期</button></view></view>
        <view class="field"><text class="field-label">获奖说明 · 提交时必填</text><textarea cursor-spacing="24" value="{{fields.description}}" maxlength="5000" bindinput="input" data-field="description" disabled="{{busy || loading || !editable}}" /><text class="zj-form-hint">描述队伍参与与获奖情况，最多 5000 字。</text></view>
      </view>
      <view class="zj-sheet">
        <text class="zj-sheet-title">② 成果材料与公开范围</text>
        <view class="zj-callout"><text class="honor-edit-label">请仅上传获准公开的材料</text><text>审核前仅本人及当前有权审核者可读；批准后，文字和以下证据随荣誉档案公开。这里没有单独保留私密凭证的上传区。</text></view>
        <view class="zj-record-head"><text class="field-label">图片材料</text><text class="zj-count">{{images.length}}/6</text></view>
        <text class="zj-form-hint">每份 2 MB 以内，支持 PNG、JPEG 或 WebP。提交时逐份说明材料内容。</text>
        <view wx:for="{{images}}" wx:key="index" class="honor-edit-image">
          <view class="zj-record-head"><text class="field-label">材料 {{index+1}}</text><button class="plain honor-edit-remove" bindtap="removeImage" data-index="{{index}}" disabled="{{busy || loading || !editable}}">移除此图</button></view>
          <button class="image-button" hover-class="zj-pressed" wx:if="{{item.path}}" bindtap="previewEvidence" data-path="{{item.path}}" aria-label="{{item.caption || '荣誉证据图片'}}"><image class="honor-edit-photo" mode="aspectFill" src="{{item.path}}" aria-label="{{item.caption || '荣誉证据图片'}}" /></button>
          <view class="field"><text class="field-label">材料说明 · 提交时必填</text><input cursor-spacing="24" value="{{item.caption}}" maxlength="200" bindinput="caption" data-index="{{index}}" disabled="{{busy || loading || !editable}}" /></view>
        </view>
        <text wx:if="{{imageError}}" class="zj-form-hint">{{imageError}}</text>
        <button class="secondary honor-edit-add" bindtap="chooseImages" disabled="{{busy || loading || !editable || images.length >= 6}}">＋ 添加证据图片</button>
        <text class="zj-form-hint">主动选择后读取图片。取消或读取失败会保留原材料，移除后须保存才更改投稿。</text>
        <button class="plain" bindtap="openPrivacy" disabled="{{busy || loading}}">查看微信隐私指引</button>
      </view>
      <view class="zj-sheet">
        <text class="zj-sheet-title">③ 视频材料（可选）</text>
        <text class="zj-form-hint">MP4，10 MB 以内。先保存图片草稿，再上传视频；上传会同时保存当前文字与保留的图片为草稿。</text>
        <view wx:if="{{record.hasVideo}}" class="honor-edit-video">
          <text class="field-label">已保存视频</text>
          <button class="plain" bindtap="viewVideo" disabled="{{busy || loading}}">读取已保存视频证据</button>
          <video wx:if="{{videoSource}}" id="honor-own-video" class="evidence-video" src="{{videoSource}}" controls autoplay="{{false}}" binderror="videoError" data-id="{{record.id}}" data-revision="{{record.revision}}" aria-label="已保存荣誉视频证据" />
          <text wx:if="{{videoError}}" class="error">{{videoError}}</text>
          <label class="honor-edit-switch"><view><text class="field-label">保存时移除原视频</text><text class="zj-form-hint">不勾选时保留已保存视频。</text></view><switch color="{{themePrimary}}" checked="{{fields.removeVideo}}" bindchange="removeVideo" disabled="{{busy || loading || !editable}}" /></label>
        </view>
        <text wx:if="{{!record}}" class="zj-callout">保存草稿取得回执后，可选择视频。</text>
        <button wx:if="{{record}}" class="secondary" bindtap="chooseVideo" disabled="{{busy || loading || !editable || !canSave}}">{{hasSelectedVideo ? '重新选择 MP4 视频' : '选择 MP4 视频'}}</button>
        <view wx:if="{{hasSelectedVideo}}" class="honor-edit-video"><text class="field-label">待上传视频</text><text class="zj-form-hint">{{selectedVideoSize}}，尚未保存到投稿。</text><view class="actions"><button class="primary" bindtap="uploadVideo" disabled="{{busy || loading || !canUploadVideo}}">上传视频并保存草稿</button><button class="plain" bindtap="discardVideo" disabled="{{busy || loading}}">移除待上传视频</button></view></view>
        <view wx:if="{{videoUploading}}" class="honor-edit-upload" aria-role="status"><text class="field-label">{{videoProgress < 100 ? '视频上传中' : '文件已传送，正在确认保存'}}</text><progress percent="{{videoProgress}}" show-info activeColor="{{themePrimary}}" backgroundColor="{{themeLine}}" stroke-width="6" border-radius="6" /><text class="zj-form-hint">请等待服务器回执，确认前不会重复上传。</text></view>
      </view>
      <text class="zj-form-hint">提交时须完整填写成果信息，并至少保留一份图片或已保存视频。批准后公开归档，并显示在对应社群荣誉索引中。保存草稿后仍需提交；审核结果与补充要求显示在本页回执。</text>
      <text wx:if="{{record && record.state === 'approved'}}" class="zj-callout zj-callout-warning">本次保存修改将撤下当前公开展示，重新审核通过后恢复。</text>
      <view class="zj-dock"><button class="secondary" bindtap="save" loading="{{busy}}" disabled="{{busy || loading || !canSave}}">保存草稿</button><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || loading || !canSubmit}}">提交审核</button></view>
    </view>
    <view class="honor-edit-links"><button class="plain" bindtap="retry" disabled="{{busy || loading}}">重新读取当前状态</button><button wx:if="{{record}}" class="plain" bindtap="reload" disabled="{{busy || loading}}">重新加载已保存资料</button><button class="plain" bindtap="mine" disabled="{{busy || loading}}">查看我的荣誉投稿</button></view>
  </block>
</view>
<privacy-consent id="privacyConsent" />
