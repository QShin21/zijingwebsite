@import "../../templates/business.wxss";
@import "../../styles/native-forms.wxss";

/* V2 honor editor: trophy receipt, numbered sheets, evidence tiles, sticky dock. */
.honor-edit-v2 { padding-top: 0; }
.honor-edit-receipt { margin-bottom: 8rpx; }
.honor-edit-id { font-size: 30rpx; }
.honor-edit-feedback { padding: 16rpx 20rpx; border-radius: 20rpx; background: rgba(255, 255, 255, .08); color: var(--z-stage-ink); }
.honor-edit-label { display: block; font-weight: 900; }
.honor-edit-date { display: flex; align-items: center; gap: 12rpx; }
.honor-edit-date picker { flex: 1; }
.honor-edit-image { display: flex; flex-direction: column; gap: 10rpx; padding: 20rpx; margin-top: 14rpx; border: 1rpx solid var(--z-line); border-radius: 24rpx; background: var(--z-raised); }
.mini-page .honor-edit-remove { color: var(--z-danger); }
.honor-edit-photo { display: block; width: 100%; height: 320rpx; border-radius: 20rpx; background: var(--z-media); }
.mini-page .honor-edit-add { display: block; width: 100%; margin-top: 14rpx; border-style: dashed; }
.honor-edit-video { display: flex; flex-direction: column; gap: 10rpx; padding: 20rpx; margin-top: 12rpx; border-radius: 24rpx; background: var(--z-raised); border: 1rpx solid var(--z-line); }
.evidence-video { width: 100%; height: 360rpx; border-radius: 20rpx; }
.honor-edit-switch { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.honor-edit-upload { display: flex; flex-direction: column; gap: 10rpx; padding: 20rpx; margin-top: 12rpx; border-radius: 24rpx; background: var(--z-tint); }
.honor-edit-links { display: flex; flex-wrap: wrap; gap: 8rpx 24rpx; margin-top: 24rpx; }
