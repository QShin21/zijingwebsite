<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page seat-page {{theme === 'dark' ? 'zj-dark' : ''}} {{palette === 'simple' ? 'seat-page-simple' : ''}}">
  <view class="zj-hero seat-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{review ? t.kickerReview : manage ? t.kickerManage : adding ? t.kickerAdd : changing ? t.kickerChange : t.kickerSelect}}</text>
      <text class="zj-hero-title">{{title || (review ? t.titleReview : manage ? t.titleManage : adding ? t.titleAdd : changing ? t.titleChange : t.titleSelect)}}</text>
      <view wx:if="{{title}}" class="zj-hero-meta">
        <text wx:if="{{review}}" class="zj-pill {{enabled ? 'zj-pill-live' : 'zj-pill-neutral'}}">{{scheduled ? t.waiting : open ? t.openNow : enabled ? t.closed : t.notOpened}}</text>
        <text wx:elif="{{adding}}">{{t.requestPrefix}}{{requestNumber}}{{t.addSuffix}}</text>
        <text wx:elif="{{changing}}">{{t.requestPrefix}}{{requestNumber}}{{t.changeSuffix}}</text>
        <text wx:else class="zj-pill {{open ? 'zj-pill-live' : 'zj-pill-neutral'}}">{{scheduled ? t.waiting : open ? t.openShort : enabled ? t.closed : t.notEnabled}}</text>
        <text wx:if="{{!review && enabled && counts}}">{{counts.rows}}{{t.rowsSuffix}}{{counts.total}}{{t.seatsSuffix}}{{counts.free}}</text>
        <text wx:if="{{review}}">{{t.reviewHint}}</text>
      </view>
    </view>
  </view>

  <template is="feedback" data="{{loading: loading && !title, error: loadError, needsLogin: needsLogin, t: t}}" />

  <block wx:if="{{title && !needsLogin}}">
    <text wx:if="{{notice}}" class="zj-callout zj-callout-success" aria-role="status">{{notice}}</text>
    <text wx:if="{{error}}" class="zj-callout zj-callout-warning" aria-role="alert">{{error}}</text>
    <text wx:if="{{busy || loading}}" class="zj-form-hint seat-busy" aria-role="status">{{busy ? busyText + t.ellipsisSuffix : t.refreshing}}</text>

    <block wx:if="{{review}}">
      <view class="zj-sheet seat-control">
        <view class="zj-record-head"><text class="zj-sheet-title">{{t.settings}}</text><text class="zj-pill {{enabled ? 'zj-pill-live' : 'zj-pill-neutral'}}">{{scheduled ? t.waiting : open ? t.open : enabled ? t.closedShort : t.notOpenedShort}}</text></view>
        <text class="zj-form-hint">{{scheduled ? t.hintScheduled : enabled ? t.hintEnabled : t.hintDisabled}}</text>
        <text wx:if="{{scheduled}}" class="zj-form-hint">{{t.opensPrefix}}{{openingLabel}}{{t.opensSuffix}}</text>
        <text class="zj-form-hint">{{t.modePrefix}}{{mode === 'random' ? t.modeRandom : t.modeSelection}}{{t.modeSuffix}}</text>
        <view class="zj-record-actions">
          <button class="{{mode === 'selection' ? 'primary' : 'secondary'}}" data-mode="selection" bindtap="setMode" disabled="{{busy || loading || mode === 'selection'}}">{{t.selection}}</button>
          <button class="{{mode === 'random' ? 'primary' : 'secondary'}}" data-mode="random" bindtap="setMode" disabled="{{busy || loading || mode === 'random'}}">{{t.random}}</button>
        </view>
        <view class="field seat-opening">
          <text class="field-label">{{t.scheduleLabel}}</text>
          <view class="seat-toolbar">
            <picker mode="date" value="{{openingDate}}" bindchange="changeOpeningDate" disabled="{{busy || loading}}" aria-label="{{t.openingDate}}"><view class="seat-picker">{{openingDate || t.pickDate}}</view></picker>
            <picker mode="time" value="{{openingTime}}" bindchange="changeOpeningTime" disabled="{{busy || loading}}" aria-label="{{t.openingTime}}"><view class="seat-picker">{{openingTime || t.pickTime}}</view></picker>
            <button class="primary" bindtap="scheduleOpening" disabled="{{busy || loading}}">{{t.saveOpening}}</button>
          </view>
        </view>
        <view class="zj-record-actions">
          <button wx:if="{{!enabled || scheduled}}" class="primary" bindtap="setEnabled" data-enabled="{{true}}" disabled="{{busy || loading}}">{{scheduled ? t.openImmediately : t.enable}}</button>
          <button wx:if="{{enabled}}" class="secondary" bindtap="setEnabled" data-enabled="{{false}}" disabled="{{busy || loading}}">{{t.disable}}</button>
          <button class="secondary" bindtap="openMap" disabled="{{busy}}">{{t.viewMap}}</button>
          <button class="secondary" bindtap="openManage" disabled="{{busy || loading}}">{{t.manageAndReview}}</button>
        </view>
      </view>
      <view class="zj-sheet seat-layout-editor">
        <view class="zj-record-head"><text class="zj-sheet-title">{{t.layoutTitle}}</text><button class="secondary" bindtap="openLayout" disabled="{{busy || loading}}">{{layoutOpen ? t.collapse : t.editLayout}}</button></view>
        <text class="zj-form-hint">{{t.layoutHint}}</text>
        <block wx:if="{{layoutOpen && layoutInfo}}">
          <text wx:if="{{layoutLegacyLocked}}" class="zj-callout">{{t.layoutLegacy}}</text>
          <text wx:elif="{{!layoutInfo.layout}}" class="zj-form-hint">{{t.layoutNumbering}}</text>
          <view class="seat-layout-controls">
            <view class="seat-layout-field"><text class="field-label">{{t.rowCount}}</text><input type="number" cursor-spacing="24" value="{{layoutRowInput}}" data-key="row" bindinput="layoutInput" disabled="{{busy || loading || layoutLegacyLocked}}" /></view>
            <view class="seat-layout-field"><text class="field-label">{{t.columnCount}}</text><input type="number" cursor-spacing="24" value="{{layoutColumnInput}}" data-key="column" bindinput="layoutInput" disabled="{{busy || loading || layoutLegacyLocked}}" /></view>
            <button class="secondary" bindtap="layoutResize" disabled="{{busy || loading || layoutLegacyLocked}}">{{t.applySize}}</button>
          </view>
          <view class="zj-record-actions"><button class="secondary" bindtap="layoutAll" data-present="{{true}}" disabled="{{busy || loading || layoutLegacyLocked}}">{{t.allSeats}}</button><button class="secondary" bindtap="layoutAll" data-present="{{false}}" disabled="{{busy || loading || layoutLegacyLocked}}">{{t.clearCells}}</button></view>
          <text class="zj-form-hint">{{t.layoutNowPrefix}}{{layoutGrid.rowCount}}{{t.layoutRowsSuffix}}{{layoutGrid.columnCount}}{{t.layoutColumnsSuffix}}{{layoutCount}}{{t.layoutSeatsSuffix}}</text>
          <scroll-view wx:if="{{!layoutLegacyLocked}}" scroll-x scroll-y class="seat-layout-scroll">
            <view class="seat-layout-grid" style="width: {{layoutWidth}}px;">
              <view wx:for="{{layoutCells}}" wx:key="row" wx:for-item="layoutRow" wx:for-index="rowIndex" class="seat-layout-row">
                <text class="seat-layout-row-label">{{layoutRow.row}}{{t.rowLabelSuffix}}</text>
                <button wx:for="{{layoutRow.cells}}" wx:key="id" wx:for-item="cell" wx:for-index="columnIndex" class="seat-layout-cell {{cell.present ? 'present' : ''}} {{cell.locked ? 'protected' : ''}}" data-row="{{rowIndex}}" data-column="{{columnIndex}}" bindtap="layoutToggle" disabled="{{busy || loading || cell.locked}}" aria-label="{{t.rowAriaPrefix}}{{layoutRow.row}}{{t.rowAriaMiddle}}{{cell.number}}{{t.columnAriaSuffix}}{{cell.present ? t.seat : t.gap}}">{{cell.number}}</button>
              </view>
            </view>
          </scroll-view>
          <view class="zj-record-actions"><button class="primary" bindtap="saveLayout" disabled="{{busy || loading || layoutLegacyLocked || !layoutCount}}">{{t.saveLayout}}</button></view>
        </block>
      </view>
      <view class="zj-sheet seat-ticket-manager">
        <text class="zj-sheet-title">{{t.tickets}}</text>
        <text class="zj-form-hint">{{t.ticketsHint}}</text>
        <text class="zj-form-hint">{{t.ticketsUploadedPrefix}}{{ticketSeats.length}}{{t.ticketsUploadedSuffix}}</text>
        <button class="secondary" bindtap="chooseTickets" disabled="{{busy || loading}}">{{t.chooseTickets}}</button>
        <text wx:for="{{ticketUploadErrors}}" wx:key="index" class="zj-callout zj-callout-warning">{{item}}</text>
      </view>
      <view class="zj-segments seat-filters" aria-role="tablist">
        <button wx:for="{{filters}}" wx:key="status" class="zj-segment {{status === item.status ? 'active' : ''}}" data-status="{{item.status}}" bindtap="filter" disabled="{{busy || loading}}" aria-role="tab" aria-selected="{{status === item.status}}">{{item.label}}</button>
      </view>
      <view wx:if="{{!loading && !docs.length && !loadError}}" class="zj-empty" aria-role="status">
        <text class="zj-empty-icon">✓</text>
        <text class="zj-empty-title">{{t.emptyPrefix}}{{statusLabel}}{{t.emptySuffix}}</text>
        <text class="zj-small">{{status === 'pending' ? t.emptyPending : t.emptyOther}}</text>
      </view>
      <view wx:for="{{docs}}" wx:key="id" wx:for-item="record" class="zj-record seat-review seat-review-{{record.status}}">
        <view class="zj-record-head"><text class="zj-record-title">{{record.memberName}}</text><text class="zj-pill zj-pill-{{record.tone}}">{{record.label}}</text></view>
        <view class="zj-kv">
          <view class="zj-kv-row"><text class="zj-kv-label">{{t.phone}}</text><text class="zj-kv-value" selectable>{{record.phone}}</text></view>
          <view class="zj-kv-row"><text class="zj-kv-label">{{t.seats}}</text><text class="zj-kv-value">{{record.seatCount}}{{t.countSuffix}}{{record.seats}}</text></view>
          <view wx:if="{{record.releasedSeats}}" class="zj-kv-row"><text class="zj-kv-label">{{t.released}}</text><text class="zj-kv-value">{{record.releasedSeats}}</text></view>
          <view wx:if="{{record.addedSeats}}" class="zj-kv-row"><text class="zj-kv-label">{{t.added}}</text><text class="zj-kv-value">{{record.addedSeats}}</text></view>
          <view class="zj-kv-row"><text class="zj-kv-label">{{t.submitted}}</text><text class="zj-kv-value">{{record.submitted}}</text></view>
          <view wx:if="{{record.reviewed}}" class="zj-kv-row"><text class="zj-kv-label">{{t.reviewed}}</text><text class="zj-kv-value">{{record.reviewed}}</text></view>
        </view>
        <view class="seat-proof-row">
          <text class="zj-small">{{t.proofsPrefix}}{{record.proofs.length}}{{t.proofsSuffix}}</text>
          <view class="seat-proof-buttons">
            <button wx:for="{{record.proofs}}" wx:key="*this" class="secondary seat-proof-button" data-proof="{{item}}" bindtap="previewProof" disabled="{{busy || loading}}">{{t.proofPrefix}}{{index + 1}}</button>
          </view>
        </view>
        <view wx:if="{{record.status === 'confirmed'}}" class="seat-proof-row">
          <text class="zj-small">{{t.revokeSingle}}</text>
          <view class="seat-proof-buttons">
            <button wx:for="{{record.seatItems}}" wx:key="id" wx:for-item="seat" class="secondary seat-proof-button" data-id="{{record.id}}" data-seat="{{seat.id}}" bindtap="revokeSeat" disabled="{{busy || loading}}">{{t.revokePrefix}}{{seat.label}}</button>
          </view>
        </view>
        <view class="zj-record-actions">
          <button class="plain" data-phone="{{record.phone}}" bindtap="call" disabled="{{busy}}">{{t.call}}</button>
          <button wx:if="{{record.unassigned}}" class="secondary" data-id="{{record.id}}" bindtap="adjustRandomCount" disabled="{{busy || loading}}">{{t.adjustCount}}</button>
          <button wx:if="{{!record.unassigned && (record.status === 'pending' || record.status === 'confirmed')}}" class="secondary" data-id="{{record.id}}" bindtap="openAdd" disabled="{{busy || loading || record.seatCount >= 10}}">{{t.addSeats}}</button>
          <button wx:if="{{!record.unassigned && (record.status === 'pending' || record.status === 'confirmed')}}" class="secondary" data-id="{{record.id}}" bindtap="openChange" disabled="{{busy || loading}}">{{t.changeSeats}}</button>
          <button wx:if="{{record.status === 'pending'}}" class="primary" data-id="{{record.id}}" data-status="confirmed" bindtap="decide" disabled="{{busy || loading}}">{{t.approve}}</button>
          <button wx:if="{{record.status === 'pending'}}" class="danger" data-id="{{record.id}}" data-status="rejected" bindtap="decide" disabled="{{busy || loading}}">{{t.reject}}</button>
          <button wx:if="{{record.status === 'confirmed'}}" class="danger" data-id="{{record.id}}" bindtap="revoke" disabled="{{busy || loading}}">{{t.revoke}}</button>
        </view>
      </view>
      <view wx:if="{{pageNumber > 1 || hasNextPage}}" class="seat-pager">
        <button class="secondary" bindtap="turn" data-delta="-1" disabled="{{pageNumber <= 1 || loading || busy}}">{{t.previous}}</button>
        <text class="seat-pager-status">{{t.pagePrefix}}{{pageNumber}}{{t.pageSuffix}}</text>
        <button class="secondary" bindtap="turn" data-delta="1" disabled="{{!hasNextPage || loading || busy}}">{{t.next}}</button>
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{mine}}" class="zj-sheet seat-receipt seat-receipt-{{mine.status}}">
        <view class="zj-record-head"><text class="zj-sheet-title">{{t.mine}}</text><text class="zj-pill zj-pill-{{mine.tone}}">{{mine.label}}</text></view>
        <text class="seat-receipt-seats">{{mine.seats || (mine.count + t.seatCountSuffix)}}</text>
        <text class="zj-form-hint">{{mine.status === 'pending' ? (mine.seats ? t.minePendingSeats : t.minePending) : mine.status === 'confirmed' ? t.mineConfirmed : mine.status === 'cancelled' ? t.mineCancelled : mine.status === 'revoked' ? t.mineRevoked : editable ? t.mineRejectedEditable : t.mineRejected}}</text>
        <view wx:if="{{mine.status === 'confirmed'}}" class="seat-tickets">
          <text class="field-label">{{t.tickets}}</text>
          <view wx:for="{{tickets}}" wx:key="seat" class="seat-ticket">
            <text class="field-label">{{item.label}}</text>
            <image wx:if="{{item.path}}" class="seat-ticket-image" src="{{item.path}}" mode="widthFix" data-seat="{{item.seat}}" bindtap="previewTicket" aria-label="{{item.label}}{{t.ticketAriaSuffix}}" />
            <button wx:if="{{item.path}}" class="secondary" data-seat="{{item.seat}}" bindtap="saveTicket" disabled="{{busy || loading}}">{{t.saveTicket}}</button>
            <text wx:elif="{{item.failed}}" class="zj-form-hint">{{t.ticketFailed}}</text>
            <text wx:elif="{{item.version}}" class="zj-form-hint">{{t.ticketLoading}}</text>
            <text wx:else class="zj-form-hint">{{t.ticketPending}}</text>
          </view>
        </view>
        <view wx:if="{{canEditMine && !editing}}" class="zj-record-actions"><button class="primary" bindtap="startEdit" disabled="{{busy || loading}}">{{t.editRequest}}</button></view>
        <view wx:if="{{mine.status === 'pending'}}" class="zj-record-actions"><button class="secondary" bindtap="cancelRequest" disabled="{{busy || loading}}">{{t.cancelRequest}}</button></view>
      </view>
      <view wx:if="{{canReview && !manage && !adding && !changing}}" class="seat-tools"><button class="secondary" bindtap="openReview" disabled="{{busy}}">{{t.workbench}}</button></view>

      <view wx:if="{{adding}}" class="zj-sheet">
        <text class="zj-sheet-title">{{t.requestPrefix}}{{requestNumber}}{{t.addSuffix}}</text>
        <text class="zj-form-hint">{{t.addExistingPrefix}}{{existingCount}}{{t.addExistingMiddle}}{{seatLimit}}{{t.addExistingSuffix}}</text>
      </view>
      <view wx:if="{{changing}}" class="zj-sheet">
        <text class="zj-sheet-title">{{t.requestPrefix}}{{requestNumber}}{{t.changeSuffix}}</text>
        <text class="zj-form-hint">{{t.changeHintPrefix}}{{existingCount}}{{t.changeHintSuffix}}</text>
      </view>

      <view wx:if="{{(enabled || manage || editing || adding || changing) && (mode !== 'random' || canReview || manage || adding || changing)}}" class="seat-arena">
        <view class="seat-arena-tools">
          <view class="seat-legend" aria-label="{{t.legend}}">
            <view class="seat-key"><view class="seat-swatch available"></view><text>{{t.available}}</text></view>
            <view class="seat-key"><view class="seat-swatch selected"></view><text>{{t.picked}}</text></view>
            <view class="seat-key"><view class="seat-swatch pending"></view><text>{{t.pending}}</text></view>
            <view class="seat-key"><view class="seat-swatch confirmed"></view><text>{{t.confirmed}}</text></view>
            <view class="seat-key"><view class="seat-swatch blocked"></view><text>{{t.blocked}}</text></view>
            <view wx:if="{{hasAccent}}" class="seat-key"><view class="seat-swatch available accent"></view><text>{{t.accent}}</text></view>
          </view>
          <view class="seat-zoom" aria-label="{{t.zoom}}">
            <button class="seat-zoom-step" data-delta="-1" bindtap="rescale" disabled="{{zoom === 0}}" aria-label="{{t.zoomOut}}">−</button>
            <text class="seat-zoom-label">{{zoomLabel}}</text>
            <button class="seat-zoom-step" data-delta="1" bindtap="rescale" disabled="{{zoom === 2}}" aria-label="{{t.zoomIn}}">＋</button>
          </view>
        </view>
        <view class="seat-board zoom-{{zoom}}">
          <view class="seat-row-numbers">
            <view class="seat-stage-spacer"></view>
            <text wx:for="{{rows}}" wx:key="row" class="seat-row-number {{item.accent ? 'accent' : ''}}" aria-label="{{t.rowAriaPrefix}}{{item.row}}{{t.rowLabelSuffix}}">{{item.row}}</text>
          </view>
          <scroll-view scroll-x enhanced class="seat-scroll">
            <view class="seat-grid" style="width: {{boardWidth}}px;">
              <view class="seat-stage"><view class="seat-stage-arc"></view><text class="seat-stage-label">{{t.stage}}</text></view>
              <view wx:for="{{rows}}" wx:key="row" wx:for-item="row" class="seat-row {{row.accent ? 'accent' : ''}}" style="padding-left: {{row.indent}}px;">
                <block wx:for="{{row.seats}}" wx:key="id" wx:for-item="seat"><view wx:if="{{seat.missing}}" class="seat-gap"></view><button wx:else class="seat {{seat.style}} {{seat.picked ? 'chosen' : ''}}" data-seat="{{seat.id}}" bindtap="toggle" hover-class="none"
                  aria-label="{{seat.label}}" aria-disabled="{{busy || loading || !editable || seat.locked || (mode === 'random' && !manage && !adding && !changing)}}" aria-selected="{{seat.picked}}">{{seat.number}}</button></block>
              </view>
            </view>
          </scroll-view>
        </view>
        <text class="seat-arena-hint">{{manage ? t.manageHint : t.scrollHint + (editable ? t.scrollEditHint : '') + t.periodSuffix}}</text>
      </view>
      <text wx:if="{{mode === 'random' && !manage && !adding && !changing}}" class="zj-callout">{{t.randomNotice}}</text>
      <view wx:if="{{manage && inspectedSeat}}" id="seat-review-detail" class="zj-sheet seat-review">
        <view class="zj-record-head"><text class="zj-sheet-title">{{inspectedSeat}}{{t.inspectSuffix}}</text><button class="plain" bindtap="closeSeatReview">{{t.close}}</button></view>
        <block wx:if="{{seatReview}}">
          <view class="zj-record-head"><text class="zj-record-title">{{seatReview.memberName}}</text><text class="zj-pill zj-pill-{{seatReview.tone}}">{{seatReview.label}}</text></view>
          <view class="zj-kv">
            <view class="zj-kv-row"><text class="zj-kv-label">{{t.requestNumber}}</text><text class="zj-kv-value">#{{seatReview.id}}</text></view>
            <view class="zj-kv-row"><text class="zj-kv-label">{{t.phone}}</text><text class="zj-kv-value" selectable>{{seatReview.phone}}</text></view>
            <view class="zj-kv-row"><text class="zj-kv-label">{{t.seats}}</text><text class="zj-kv-value">{{seatReview.seatCount}}{{t.countSuffix}}{{seatReview.seats}}</text></view>
            <view wx:if="{{seatReview.releasedSeats}}" class="zj-kv-row"><text class="zj-kv-label">{{t.released}}</text><text class="zj-kv-value">{{seatReview.releasedSeats}}</text></view>
            <view wx:if="{{seatReview.addedSeats}}" class="zj-kv-row"><text class="zj-kv-label">{{t.added}}</text><text class="zj-kv-value">{{seatReview.addedSeats}}</text></view>
            <view class="zj-kv-row"><text class="zj-kv-label">{{t.submitted}}</text><text class="zj-kv-value">{{seatReview.submitted}}</text></view>
            <view wx:if="{{seatReview.reviewed}}" class="zj-kv-row"><text class="zj-kv-label">{{t.reviewed}}</text><text class="zj-kv-value">{{seatReview.reviewed}}</text></view>
          </view>
          <view class="seat-proof-row"><text class="zj-small">{{t.proofsPrefix}}{{seatReview.proofs.length}}{{t.proofsSuffix}}</text>
            <view class="seat-proof-buttons"><button wx:for="{{seatReview.proofs}}" wx:key="*this" class="secondary seat-proof-button" data-proof="{{item}}" bindtap="previewProof" disabled="{{busy || loading}}">{{t.proofPrefix}}{{index + 1}}</button></view>
          </view>
          <view wx:if="{{seatReview.status === 'confirmed'}}" class="seat-proof-row">
            <text class="zj-small">{{t.revokeSingle}}</text>
            <view class="seat-proof-buttons"><button wx:for="{{seatReview.seatItems}}" wx:key="id" wx:for-item="seat" class="secondary seat-proof-button" data-id="{{seatReview.id}}" data-seat="{{seat.id}}" bindtap="revokeSeat" disabled="{{busy || loading}}">{{t.revokePrefix}}{{seat.label}}</button></view>
          </view>
          <view class="zj-record-actions">
            <button class="plain" data-phone="{{seatReview.phone}}" bindtap="call" disabled="{{busy}}">{{t.call}}</button>
            <button class="secondary" data-id="{{seatReview.id}}" bindtap="openAdd" disabled="{{busy || loading || seatReview.seatCount >= 10}}">{{t.addSeats}}</button>
            <button class="secondary" data-id="{{seatReview.id}}" bindtap="openChange" disabled="{{busy || loading}}">{{t.changeSeats}}</button>
            <button wx:if="{{seatReview.status === 'pending'}}" class="primary" data-id="{{seatReview.id}}" data-status="confirmed" bindtap="decide" disabled="{{busy || loading}}">{{t.approve}}</button>
            <button wx:if="{{seatReview.status === 'pending'}}" class="danger" data-id="{{seatReview.id}}" data-status="rejected" bindtap="decide" disabled="{{busy || loading}}">{{t.reject}}</button>
            <button wx:if="{{seatReview.status === 'confirmed'}}" class="danger" data-id="{{seatReview.id}}" bindtap="revoke" disabled="{{busy || loading}}">{{t.revoke}}</button>
          </view>
        </block>
        <text wx:else class="zj-form-hint">{{t.noRequest}}</text>
      </view>
      <view wx:if="{{manage}}" class="zj-sheet seat-management">
        <text class="zj-form-hint">{{t.selectedPrefix}}{{selectedAvailable}}{{t.selectedMiddle}}{{selectedBlocked}}{{t.selectedSuffix}}</text>
        <view class="zj-record-actions">
          <button class="primary" bindtap="setSeatBlocks" data-blocked="{{true}}" disabled="{{busy || loading || !selectedAvailable}}">{{t.lockSelected}}</button>
          <button class="secondary" bindtap="setSeatBlocks" data-blocked="{{false}}" disabled="{{busy || loading || !selectedBlocked}}">{{t.unlockSelected}}</button>
        </view>
      </view>

      <text wx:if="{{scheduled && !manage && !adding && !changing}}" class="zj-callout" aria-role="status">{{t.opensPrefix}}{{openingLabel}}{{t.opensSuffix}}</text>
      <text wx:elif="{{enabled && !open && !manage && !adding && !changing}}" class="zj-callout">{{t.closedNotice}}</text>
      <view wx:if="{{!enabled && !mine && !canReview && !manage && !adding && !changing}}" class="zj-empty" aria-role="status">
        <text class="zj-empty-icon">◎</text>
        <text class="zj-empty-title">{{t.notOpenedTitle}}</text>
        <text class="zj-small">{{t.notOpenedBody}}</text>
      </view>
      <view class="seat-tools">
        <button wx:if="{{enabled || manage || adding || changing}}" class="secondary" bindtap="refresh" disabled="{{loading || busy}}">{{t.refreshSeats}}</button>
        <button wx:if="{{open && !loggedIn && !manage && !adding && !changing}}" class="primary" bindtap="login">{{t.loginToSelect}}</button>
      </view>

      <view wx:if="{{adding && editable}}" class="zj-sheet seat-form">
        <text class="zj-sheet-title">{{t.addTitle}}</text>
        <view class="seat-count"><text class="seat-count-value">{{selected.length}}</text><text class="zj-small">{{t.limitPrefix}}{{seatLimit}}{{t.seatCountSuffix}}</text></view>
        <view wx:if="{{chips.length}}" class="seat-chips"><button wx:for="{{chips}}" wx:key="id" class="seat-chip" data-seat="{{item.id}}" bindtap="unpick" disabled="{{busy || loading}}">{{item.label}} ×</button></view>
        <text wx:else class="zj-form-hint">{{t.tapHint}}</text>
      </view>
      <view wx:if="{{adding && editable}}" class="zj-dock"><button class="primary" bindtap="submitAdd" disabled="{{busy || loading || !selected.length}}">{{t.confirmAdd}}</button></view>

      <view wx:if="{{changing && editable}}" class="zj-sheet seat-form">
        <text class="zj-sheet-title">{{t.changeTitle}}</text>
        <view class="seat-count"><text class="seat-count-value">{{selected.length}}</text><text class="zj-small">{{t.limitPrefix}}{{seatLimit}}{{t.seatCountSuffix}}</text></view>
        <view wx:if="{{chips.length}}" class="seat-chips"><button wx:for="{{chips}}" wx:key="id" class="seat-chip" data-seat="{{item.id}}" bindtap="unpick" disabled="{{busy || loading}}">{{item.label}} ×</button></view>
        <text class="zj-form-hint">{{t.changeCountHint}}</text>
      </view>
      <view wx:if="{{changing && editable}}" class="zj-dock"><button class="primary" bindtap="submitChange" disabled="{{busy || loading || !changeReady}}">{{t.confirmChange}}</button></view>

      <view wx:if="{{editable && !manage && !adding && !changing}}" class="zj-sheet seat-form">
        <text class="zj-sheet-title">{{editing ? t.editTitle : t.submitTitle}}</text>
        <view wx:if="{{mode === 'random'}}" class="field"><text class="field-label">{{t.requestedCount}}</text><input type="number" cursor-spacing="24" value="{{requestedCount}}" bindinput="countInput" disabled="{{busy || loading}}" /><text class="zj-form-hint">{{t.countHintPrefix}}{{seatLimit}}{{t.countHintSuffix}}</text></view>
        <view wx:else class="seat-count"><text class="seat-count-value">{{selected.length}}</text><text class="zj-small">{{t.limitPrefix}}{{seatLimit}}{{t.seatCountSuffix}}</text></view>
        <view wx:if="{{mode !== 'random' && chips.length}}" class="seat-chips">
          <button wx:for="{{chips}}" wx:key="id" class="seat-chip" data-seat="{{item.id}}" bindtap="unpick" disabled="{{busy || loading}}" aria-label="{{t.unpickPrefix}}{{item.label}}">{{item.label}} ×</button>
        </view>
        <text wx:if="{{mode !== 'random' && !chips.length}}" class="zj-form-hint">{{t.pickHintPrefix}}{{seatLimit}}{{t.pickHintSuffix}}</text>
        <view class="field">
          <text class="field-label">{{t.phone}}</text>
          <input type="text" maxlength="24" value="{{phone}}" bindinput="phoneInput" placeholder="{{t.phonePlaceholder}}" placeholder-style="color:{{themeMuted}}" cursor-spacing="24" disabled="{{busy || loading}}" />
        </view>
        <view class="field">
          <text class="field-label">{{t.proof}}</text>
          <text class="zj-form-hint">{{t.proofCountPrefix}}{{editing ? editProofs.length : drafts.length}} / {{proofLimit}}{{t.proofCountMiddle}}{{proofMB}}{{t.proofCountSuffix}}</text>
          <view wx:for="{{editing ? editProofs : drafts}}" wx:key="*this" class="seat-proof">
            <text class="seat-proof-name">{{t.proofPrefix}}{{index + 1}}</text>
            <button class="secondary seat-proof-button" data-proof="{{item}}" bindtap="previewProof" disabled="{{busy || loading}}">{{t.view}}</button>
            <button class="plain" data-proof="{{item}}" bindtap="removeProof" disabled="{{busy || loading}}" aria-label="{{t.removeProofPrefix}}{{index + 1}}">{{t.remove}}</button>
          </view>
          <text wx:if="{{busy === '正在上传凭证'}}" class="zj-form-hint" aria-role="status">{{t.uploadingProof}}</text>
          <text wx:if="{{proofNotice}}" class="zj-callout zj-callout-success" aria-role="status">{{proofNotice}}</text>
          <text wx:if="{{proofError}}" class="zj-callout zj-callout-warning" aria-role="alert">{{proofError}}</text>
          <button class="secondary seat-upload" bindtap="chooseProofs" disabled="{{busy || loading || (editing ? editProofs.length : drafts.length) >= proofLimit}}">{{t.uploadProof}}</button>
        </view>
        <text class="zj-form-hint">{{editing ? t.hintEditing : mode === 'random' ? t.hintRandom : t.hintSelection}}</text>
        <button wx:if="{{editing}}" class="secondary" bindtap="cancelEdit" disabled="{{busy || loading}}">{{t.cancelEdit}}</button>
      </view>
      <view wx:if="{{editable && !manage && !adding && !changing}}" class="zj-dock">
        <button class="primary" bindtap="submit" disabled="{{busy || loading}}">{{editing ? t.saveEdit : t.submit}}</button>
      </view>
    </block>
  </block>
</view>
<privacy-consent id="privacyConsent" />
