<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page seat-page {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero seat-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">‹ 返回</button>
      <text class="zj-hero-kicker">{{review ? 'SEATING · 选座工作台' : manage ? 'SEATING · 管理座位' : 'SEATING · 活动选座'}}</text>
      <text class="zj-hero-title">{{title || (review ? '选座工作台' : manage ? '管理未开放座位' : '活动选座')}}</text>
      <view wx:if="{{title}}" class="zj-hero-meta">
        <text wx:if="{{review}}" class="zj-pill {{enabled ? 'zj-pill-live' : 'zj-pill-neutral'}}">{{scheduled ? '等待开放' : open ? '选座开放中' : enabled ? '选座已关闭' : '选座未开启'}}</text>
        <text wx:else class="zj-pill {{open ? 'zj-pill-live' : 'zj-pill-neutral'}}">{{scheduled ? '等待开放' : open ? '选座开放' : enabled ? '选座已关闭' : '选座未启用'}}</text>
        <text wx:if="{{!review && enabled && counts}}">{{counts.rows}} 排 · {{counts.total}} 座 · 剩余 {{counts.free}}</text>
        <text wx:if="{{review}}">核对手机号与凭证：通过锁定，驳回释放</text>
      </view>
    </view>
  </view>

  <template is="feedback" data="{{loading: loading && !title, error: loadError, needsLogin: needsLogin}}" />

  <block wx:if="{{title && !needsLogin}}">
    <text wx:if="{{notice}}" class="zj-callout zj-callout-success" aria-role="status">{{notice}}</text>
    <text wx:if="{{error}}" class="zj-callout zj-callout-warning" aria-role="alert">{{error}}</text>
    <text wx:if="{{busy || loading}}" class="zj-form-hint seat-busy" aria-role="status">{{busy ? busy + '…' : '正在刷新…'}}</text>

    <block wx:if="{{review}}">
      <view class="zj-sheet seat-control">
        <view class="zj-record-head"><text class="zj-sheet-title">选座设置</text><text class="zj-pill {{enabled ? 'zj-pill-live' : 'zj-pill-neutral'}}">{{scheduled ? '等待开放' : open ? '开放中' : enabled ? '已关闭' : '未开启'}}</text></view>
        <text class="zj-form-hint">{{scheduled ? '开放时间到达后，成员可在活动页选座并提交凭证。' : enabled ? '成员可在活动页选座并提交凭证。关闭后不再接收新申请，已提交的申请仍在此审核。' : '开启后成员可选择 1–10 个座位并提交手机号与凭证；未公开的活动不能开启。'}}</text>
        <text wx:if="{{scheduled}}" class="zj-form-hint">将于北京时间 {{openingLabel}} 开放选座。</text>
        <view class="field seat-opening">
          <text class="field-label">定时开放（北京时间）</text>
          <view class="seat-toolbar">
            <picker mode="date" value="{{openingDate}}" bindchange="changeOpeningDate" disabled="{{busy || loading}}" aria-label="开放日期"><view class="seat-picker">{{openingDate || '选择日期'}}</view></picker>
            <picker mode="time" value="{{openingTime}}" bindchange="changeOpeningTime" disabled="{{busy || loading}}" aria-label="开放时间"><view class="seat-picker">{{openingTime || '选择时间'}}</view></picker>
            <button class="primary" bindtap="scheduleOpening" disabled="{{busy || loading}}">保存开放时间</button>
          </view>
        </view>
        <view class="zj-record-actions">
          <button wx:if="{{!enabled || scheduled}}" class="primary" bindtap="setEnabled" data-enabled="{{true}}" disabled="{{busy || loading}}">{{scheduled ? '立即开放' : '开启选座'}}</button>
          <button wx:if="{{enabled}}" class="secondary" bindtap="setEnabled" data-enabled="{{false}}" disabled="{{busy || loading}}">关闭选座</button>
          <button class="secondary" bindtap="openMap" disabled="{{busy}}">查看座位图</button>
          <button class="secondary" bindtap="openManage" disabled="{{busy || loading}}">管理未开放座位</button>
        </view>
      </view>
      <view class="zj-segments seat-filters" aria-role="tablist">
        <button wx:for="{{filters}}" wx:key="status" class="zj-segment {{status === item.status ? 'active' : ''}}" data-status="{{item.status}}" bindtap="filter" disabled="{{busy || loading}}" aria-role="tab" aria-selected="{{status === item.status}}">{{item.label}}</button>
      </view>
      <view wx:if="{{!loading && !docs.length && !loadError}}" class="zj-empty" aria-role="status">
        <text class="zj-empty-icon">✓</text>
        <text class="zj-empty-title">此页没有{{statusLabel}}的选座申请</text>
        <text class="zj-small">{{status === 'pending' ? '新的选座申请提交后会出现在这里。' : '切换上方状态查看其他申请。'}}</text>
      </view>
      <view wx:for="{{docs}}" wx:key="id" wx:for-item="record" class="zj-record seat-review seat-review-{{record.status}}">
        <view class="zj-record-head"><text class="zj-record-title">{{record.memberName}}</text><text class="zj-pill zj-pill-{{record.tone}}">{{record.label}}</text></view>
        <view class="zj-kv">
          <view class="zj-kv-row"><text class="zj-kv-label">手机号</text><text class="zj-kv-value" selectable>{{record.phone}}</text></view>
          <view class="zj-kv-row"><text class="zj-kv-label">座位</text><text class="zj-kv-value">{{record.seatCount}} 个 · {{record.seats}}</text></view>
          <view class="zj-kv-row"><text class="zj-kv-label">提交时间</text><text class="zj-kv-value">{{record.submitted}}</text></view>
          <view wx:if="{{record.reviewed}}" class="zj-kv-row"><text class="zj-kv-label">审核时间</text><text class="zj-kv-value">{{record.reviewed}}</text></view>
        </view>
        <view class="seat-proof-row">
          <text class="zj-small">活动参与凭证 {{record.proofs.length}} 张</text>
          <view class="seat-proof-buttons">
            <button wx:for="{{record.proofs}}" wx:key="*this" class="secondary seat-proof-button" data-proof="{{item}}" bindtap="previewProof" disabled="{{busy || loading}}">凭证 {{index + 1}}</button>
          </view>
        </view>
        <view class="zj-record-actions">
          <button class="plain" data-phone="{{record.phone}}" bindtap="call" disabled="{{busy}}">拨打</button>
          <button wx:if="{{record.status === 'pending'}}" class="primary" data-id="{{record.id}}" data-status="confirmed" bindtap="decide" disabled="{{busy || loading}}">通过并锁定</button>
          <button wx:if="{{record.status === 'pending'}}" class="danger" data-id="{{record.id}}" data-status="rejected" bindtap="decide" disabled="{{busy || loading}}">驳回并释放</button>
        </view>
      </view>
      <view wx:if="{{pageNumber > 1 || hasNextPage}}" class="seat-pager">
        <button class="secondary" bindtap="turn" data-delta="-1" disabled="{{pageNumber <= 1 || loading || busy}}">上一页</button>
        <text class="seat-pager-status">第 {{pageNumber}} 页</text>
        <button class="secondary" bindtap="turn" data-delta="1" disabled="{{!hasNextPage || loading || busy}}">下一页</button>
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{mine}}" class="zj-sheet seat-receipt seat-receipt-{{mine.status}}">
        <view class="zj-record-head"><text class="zj-sheet-title">我的选座申请</text><text class="zj-pill zj-pill-{{mine.tone}}">{{mine.label}}</text></view>
        <text class="seat-receipt-seats">{{mine.seats}}</text>
        <text class="zj-form-hint">{{mine.status === 'pending' ? '座位已为你保留，等待管理员核对凭证后锁定。' : mine.status === 'confirmed' ? '审核已通过，座位已锁定。' : editable ? '申请已驳回，座位已释放；可以重新选座并提交凭证。' : '申请已驳回，座位已释放。'}}</text>
        <view wx:if="{{canEditMine && !editing}}" class="zj-record-actions"><button class="primary" bindtap="startEdit" disabled="{{busy || loading}}">修改申请</button></view>
      </view>
      <view wx:if="{{canReview && !manage}}" class="seat-tools"><button class="secondary" bindtap="openReview" disabled="{{busy}}">选座工作台</button></view>

      <view wx:if="{{enabled || manage || editing}}" class="seat-arena">
        <view class="seat-arena-tools">
          <view class="seat-legend" aria-label="座位状态图例">
            <view class="seat-key"><view class="seat-swatch available"></view><text>可选</text></view>
            <view class="seat-key"><view class="seat-swatch selected"></view><text>已选</text></view>
            <view class="seat-key"><view class="seat-swatch pending"></view><text>待审核</text></view>
            <view class="seat-key"><view class="seat-swatch confirmed"></view><text>已确认</text></view>
            <view class="seat-key"><view class="seat-swatch blocked"></view><text>未开放</text></view>
            <view class="seat-key"><view class="seat-swatch available accent"></view><text>中心区</text></view>
          </view>
          <view class="seat-zoom" aria-label="座位图缩放">
            <button class="seat-zoom-step" data-delta="-1" bindtap="rescale" disabled="{{zoom === 0}}" aria-label="缩小座位图">−</button>
            <text class="seat-zoom-label">{{zoomLabel}}</text>
            <button class="seat-zoom-step" data-delta="1" bindtap="rescale" disabled="{{zoom === 2}}" aria-label="放大座位图">＋</button>
          </view>
        </view>
        <view class="seat-board zoom-{{zoom}}">
          <view class="seat-row-numbers">
            <view class="seat-stage-spacer"></view>
            <text wx:for="{{rows}}" wx:key="row" class="seat-row-number {{item.accent ? 'accent' : ''}}" aria-label="第 {{item.row}} 排">{{item.row}}</text>
          </view>
          <scroll-view scroll-x enhanced class="seat-scroll">
            <view class="seat-grid" style="width: {{boardWidth}}rpx;">
              <view class="seat-stage"><view class="seat-stage-arc"></view><text class="seat-stage-label">舞台 · 屏幕</text></view>
              <view wx:for="{{rows}}" wx:key="row" wx:for-item="row" class="seat-row {{row.accent ? 'accent' : ''}}" style="padding-left: {{row.indent}}rpx;">
                <view wx:for="{{row.seats}}" wx:key="id" wx:for-item="seat" class="seat {{seat.style}} {{seat.picked ? 'chosen' : ''}}" data-seat="{{seat.id}}" bindtap="toggle"
                  aria-role="button" aria-label="{{seat.label}}" aria-disabled="{{!editable || seat.locked}}" aria-selected="{{seat.picked}}">{{seat.number}}</view>
              </view>
            </view>
          </scroll-view>
        </view>
        <text class="seat-arena-hint">{{manage ? '左右滑动查看座位。点选空座锁定，点选未开放的座位解锁；已有申请的座位保留原状态。' : '左右滑动查看整排座位' + (editable ? '；点选可选座位，再点一次取消' : '') + '。'}}</text>
      </view>
      <view wx:if="{{manage}}" class="zj-sheet seat-management">
        <text class="zj-form-hint">已选 {{selectedAvailable}} 个空座、{{selectedBlocked}} 个未开放座位</text>
        <view class="zj-record-actions">
          <button class="primary" bindtap="setSeatBlocks" data-blocked="{{true}}" disabled="{{busy || loading || !selectedAvailable}}">锁定所选空座</button>
          <button class="secondary" bindtap="setSeatBlocks" data-blocked="{{false}}" disabled="{{busy || loading || !selectedBlocked}}">解锁所选座位</button>
        </view>
      </view>

      <text wx:if="{{scheduled && !manage}}" class="zj-callout" aria-role="status">将于北京时间 {{openingLabel}} 开放选座。</text>
      <text wx:elif="{{enabled && !open && !manage}}" class="zj-callout">当前活动选座已关闭，不再接收新的申请；已提交的申请仍由管理员处理。</text>
      <view wx:if="{{!enabled && !mine && !canReview && !manage}}" class="zj-empty" aria-role="status">
        <text class="zj-empty-icon">◎</text>
        <text class="zj-empty-title">本活动暂未开启选座</text>
        <text class="zj-small">开启后会在活动详情显示选座入口。</text>
      </view>
      <view class="seat-tools">
        <button wx:if="{{enabled || manage}}" class="secondary" bindtap="refresh" disabled="{{loading || busy}}">刷新座位</button>
        <button wx:if="{{open && !loggedIn && !manage}}" class="primary" bindtap="login">登录后选座</button>
      </view>

      <view wx:if="{{editable && !manage}}" class="zj-sheet seat-form">
        <text class="zj-sheet-title">{{editing ? '修改选座申请' : '提交选座申请'}}</text>
        <view class="seat-count"><text class="seat-count-value">{{selected.length}}</text><text class="zj-small">/ {{seatLimit}} 个座位</text></view>
        <view wx:if="{{chips.length}}" class="seat-chips">
          <button wx:for="{{chips}}" wx:key="id" class="seat-chip" data-seat="{{item.id}}" bindtap="unpick" disabled="{{busy || loading}}" aria-label="取消 {{item.label}}">{{item.label}} ×</button>
        </view>
        <text wx:else class="zj-form-hint">在座位图中点选 1–{{seatLimit}} 个座位。</text>
        <view class="field">
          <text class="field-label">手机号</text>
          <input type="text" maxlength="24" value="{{phone}}" bindinput="phoneInput" placeholder="仅供本活动审核联系" placeholder-style="color:{{themeMuted}}" cursor-spacing="24" disabled="{{busy || loading}}" />
        </view>
        <view class="field">
          <text class="field-label">活动参与凭证</text>
          <text class="zj-form-hint">已选择 {{editing ? editProofs.length : drafts.length}} / {{proofLimit}} 张 · JPEG/PNG/WebP · 单张最多 {{proofMB}} MB</text>
          <view wx:for="{{editing ? editProofs : drafts}}" wx:key="*this" class="seat-proof">
            <text class="seat-proof-name">凭证 {{index + 1}}</text>
            <button class="secondary seat-proof-button" data-proof="{{item}}" bindtap="previewProof" disabled="{{busy || loading}}">查看</button>
            <button class="plain" data-proof="{{item}}" bindtap="removeProof" disabled="{{busy || loading}}" aria-label="移除凭证 {{index + 1}}">移除</button>
          </view>
          <button class="secondary seat-upload" bindtap="chooseProofs" disabled="{{busy || loading || (editing ? editProofs.length : drafts.length) >= proofLimit}}">＋ 上传凭证</button>
        </view>
        <text class="zj-form-hint">{{editing ? '保存成功后更新座位和凭证，申请继续等待审核。' : '手机号与凭证仅供本活动审核使用。提交后座位进入待审核；每人每场活动只保留一份待审核或已确认的申请。'}}</text>
        <button wx:if="{{editing}}" class="secondary" bindtap="cancelEdit" disabled="{{busy || loading}}">取消修改</button>
      </view>
      <view wx:if="{{editable && !manage}}" class="zj-dock">
        <button class="primary" bindtap="submit" disabled="{{busy || loading}}">{{editing ? '保存修改' : '提交选座'}}</button>
      </view>
    </block>
  </block>
</view>
<privacy-consent id="privacyConsent" />
