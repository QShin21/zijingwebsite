<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page business-page team-review-page">
  <button class="plain back" bindtap="back">返回</button><view class="page-heading"><text wx:if="{{mode === 'join'}}" class="task-context">队伍管理工作台</text><text class="title">{{mode === 'join' ? teamDoc.title || '队伍工作台' : '建队申请审核'}}</text><text class="subtitle">{{mode === 'join' ? '先处理入队申请，再安排招新与队伍日常。' : '核对所属社群、组织与训练计划后，保存人工审核决定。'}}</text></view><template is="feedback" data="{{needsLogin}}" />
  <text wx:if="{{busy}}" class="muted">本次确认或保存尚未完成，完成后会核对最新记录。</text><text wx:if="{{loading}}" class="muted">正在核对权限与工作台…</text><view wx:if="{{error}}"><text class="error">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">重新加载</button></view><text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text><text wx:if="{{done}}" class="result-message" aria-role="status">{{done}}</text>
  <view wx:if="{{!needsLogin && !loading && !error && !allowed}}" class="empty"><text class="state-title">当前暂无此工作台的查看权限</text><button class="secondary" bindtap="retry">重新核对权限</button></view>
  <block wx:if="{{allowed && !needsLogin}}">
    <view wx:if="{{mode === 'join'}}" class="business-summary"><view class="record-heading"><view><text class="section-title">当前队伍</text><text class="muted">操作范围以此队伍的实时授权为准</text></view><text class="badge">{{teamDoc.statusText}}</text></view><button class="plain" bindtap="members" disabled="{{loading || busy}}">管理成员关系</button></view>
    <view class="section-head"><text class="section-title">{{mode === 'join' ? '入队申请' : '待审建队申请'}}</text><button class="plain" bindtap="retry" disabled="{{loading || busy}}">刷新核对</button></view>
    <view wx:if="{{mode === 'join'}}" class="field"><text class="field-label">申请状态</text><picker range="{{statusLabels}}" value="{{statusIndex}}" bindchange="status" disabled="{{loading || busy}}"><view>{{statusLabels[statusIndex]}} ▾</view></picker></view>
    <view class="record-list"><view wx:for="{{docs}}" wx:for-item="entry" wx:key="id" class="task-record"><view class="record-heading"><view><text class="section-title">{{entry.title}}</text><view class="record-meta"><text>申请 {{entry.id}}</text><text>{{entry.dateText}}</text></view></view><text class="badge">{{entry.statusText}}</text></view>
      <button class="plain disclosure" bindtap="toggleRecord" data-id="{{entry.id}}" disabled="{{busy}}" aria-expanded="{{expandedId === entry.id}}"><text>{{expandedId === entry.id ? '收起申请与处理区' : '查看申请并处理'}}</text><text>{{expandedId === entry.id ? '−' : '＋'}}</text></button>
      <view wx:if="{{expandedId === entry.id}}" class="record-detail"><text class="material-title">{{mode === 'join' ? '申请时提交的答卷' : '组织与训练计划'}}</text><text wx:if="{{mode === 'establishment'}}" class="body" selectable>{{entry.reason}}</text><view wx:for="{{entry.rows}}" wx:for-item="answer" wx:key="id" class="answer"><text class="answer-label">{{answer.label}}</text><text selectable>{{answer.answer}}</text></view><text wx:if="{{entry.receiptError}}" class="error">{{entry.receiptError}}</text><view wx:if="{{entry.reviewNote}}" class="task-feedback"><text class="task-feedback-label">上次处理意见</text><text class="body">{{entry.reviewNote}}</text></view>
        <view wx:if="{{entry.decisions.length}}" class="review-actions"><text class="section-title">保存审核决定</text><text class="muted">处理意见会显示在申请人的回执中。</text><view class="field"><text class="field-label">处理意见</text><textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{entry.noteDraft}}" bindinput="note" data-id="{{entry.id}}" maxlength="1000" placeholder="退回或拒绝时必填具体原因" disabled="{{busy}}" /></view><view class="actions"><button wx:for="{{entry.decisions}}" wx:for-item="decision" wx:key="value" class="{{decision.value === 'approved' ? 'primary' : decision.value === 'rejected' ? 'danger' : 'secondary'}}" bindtap="decide" data-id="{{entry.id}}" data-decision="{{decision.value}}" disabled="{{loading || busy || (entry.receiptError && decision.value === 'approved')}}">{{decision.label}}</button></view></view><text wx:else class="task-note">暂无可执行审核操作。</text>
      </view>
    </view></view>
    <view wx:if="{{!docs.length && !loading && !error}}" class="empty"><text class="state-title">此状态暂无申请</text><text wx:if="{{mode === 'join'}}" class="muted">未提交草稿不进入审核队列。</text></view><button wx:if="{{hasMore}}" class="plain" bindtap="onReachBottom" disabled="{{loading || busy}}">加载更多申请</button>
    <block wx:if="{{mode === 'join'}}">
      <view class="task-section"><view class="section-head"><text class="section-title">招新批次</text><button wx:if="{{teamActions.createRecruitment}}" class="plain" bindtap="websiteWorkbench" data-create="{{true}}" disabled="{{loading || busy}}">新建批次地址</button></view><text class="muted">复制地址可在网站工作台创建批次、设置题型与分支。小程序可填写申请和审核完整答卷。</text>
        <view class="record-list"><view wx:for="{{recruitments}}" wx:key="id" class="task-record"><view class="record-heading"><view><text class="section-title">{{item.title}}</text><view class="record-meta"><text wx:if="{{item.startText}}">开始 {{item.startText}}</text><text wx:if="{{item.endText}}">截止 {{item.endText}}</text></view></view><text class="badge">{{item.state}}</text></view><view class="actions"><button wx:if="{{item.actions.view}}" class="secondary" bindtap="openRecruitment" data-id="{{item.id}}" disabled="{{loading || busy}}">查看申请入口</button><button wx:if="{{item.actions.edit}}" class="plain" bindtap="websiteWorkbench" data-id="{{item.id}}" disabled="{{loading || busy}}">复制编辑地址</button><button wx:if="{{item.actions.close}}" class="plain" bindtap="operate" data-operation="close-recruitment" data-status="closed" data-id="{{item.id}}" disabled="{{loading || busy}}">关闭本轮招新</button><button wx:if="{{item.actions.archive}}" class="danger" bindtap="operate" data-operation="close-recruitment" data-status="archived" data-id="{{item.id}}" disabled="{{loading || busy}}">归档批次</button></view></view></view><text wx:if="{{!recruitments.length && !loading && !error}}" class="task-note">暂无本队招新批次。</text><button wx:if="{{batchesMore}}" class="plain" bindtap="moreBatches" disabled="{{loading || busy}}">加载更多批次</button>
      </view>
      <view class="task-section"><text class="task-section-title">队伍运营</text><view class="record-facts"><view class="record-fact"><text class="fact-label">当前状态</text><text class="fact-value">{{teamDoc.statusText}}</text></view></view><text wx:if="{{lifecycleChoices.length}}" class="muted">设为休整或归档会关闭当前开放的招新批次，保存前需确认。</text><view class="actions"><button wx:for="{{lifecycleChoices}}" wx:key="value" class="{{item.value === 'archived' ? 'danger' : 'secondary'}}" bindtap="operate" data-operation="lifecycle" data-status="{{item.value}}" disabled="{{loading || busy}}">设为{{item.label}}</button></view><button class="plain" bindtap="websiteWorkbench" disabled="{{loading || busy}}">复制网站工作台地址</button></view>
    </block>
  </block>
</view>
