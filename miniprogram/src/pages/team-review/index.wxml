<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page team-review-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">‹ 返回</button>
      <text class="zj-hero-kicker">{{mode === 'join' ? (teamDoc.title || '当前队伍') + ' · 工作台' : 'TEAMS · 建队审核'}}</text>
      <text class="zj-hero-title">{{mode === 'join' ? '入队审核' : '建队申请审核'}}</text>
      <text class="zj-hero-lead">{{mode === 'join' ? '核对已提交答卷，记录处理意见，再安排本队招新与日常。' : '核对组织与训练计划，保存人工审核决定。'}}</text>
      <view wx:if="{{mode === 'join' && allowed}}" class="zj-hero-meta"><text>队伍状态</text><text class="zj-pill zj-pill-live">{{teamDoc.statusText}}</text></view>
    </view>
  </view>
  <template is="feedback" data="{{needsLogin}}" />
  <text wx:if="{{busy}}" class="zj-callout" aria-role="status">本次确认或保存尚未完成，完成后会核对最新记录。</text>
  <view wx:if="{{loading}}" class="zj-skeleton" aria-role="status" aria-label="正在核对权限与工作台"><view wx:if="{{!allowed}}" class="zj-skeleton-row"><view class="zj-skeleton-date"></view><view class="zj-skeleton-lines"><view></view><view></view><view></view></view></view></view>
  <view wx:if="{{error}}" class="zj-alert"><text class="zj-small" aria-role="alert">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">重新加载</button></view>
  <text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text>
  <text wx:if="{{done}}" class="zj-callout zj-callout-success" aria-role="status">{{done}}</text>
  <view wx:if="{{!needsLogin && !loading && !error && !allowed}}" class="zj-empty"><text class="zj-empty-icon">🔒</text><text class="zj-empty-title">当前暂无此工作台的查看权限</text><text class="zj-small">可刷新核对当前队伍或建队审核的授权。</text><button class="secondary" bindtap="retry" disabled="{{busy}}">重新核对权限</button></view>

  <view wx:if="{{allowed && !needsLogin && recruitmentEditor}}" class="zj-sheet team-review-editor">
    <text class="zj-sheet-title">{{recruitmentEditor.id ? '编辑招新批次' : '新建招新批次'}}</text>
    <view class="field">
      <text class="field-label">批次名称</text>
      <input cursor-spacing="24" value="{{recruitmentEditor.title}}" bindinput="recruitmentTitle" maxlength="120" aria-label="批次名称" disabled="{{loading || busy || recruitmentEditor.blocked}}" />
    </view>
    <text class="zj-callout">选拔问卷共 {{recruitmentEditor.questionCount}} 题。题型和分支可在网站工作台编辑。</text>
    <button class="plain" bindtap="websiteWorkbench" data-id="{{recruitmentEditor.id}}" data-create="{{!recruitmentEditor.id}}" disabled="{{loading || busy}}">复制网站问卷编辑地址</button>
    <text class="zj-form-hint">以下时间均为北京时间。开始时间留空时，发布后立即接受申请。发布前请填写未来的截止时间。</text>
    <view wx:for="{{['start', 'end']}}" wx:for-item="key" wx:key="*this" class="field">
      <text class="field-label">{{key === 'start' ? '报名开始时间（选填）' : '报名截止时间'}}</text>
      <view class="team-review-pickers">
        <picker mode="date" value="{{recruitmentEditor[key].date}}" bindchange="recruitmentTime" data-key="{{key}}" data-part="date" disabled="{{loading || busy || recruitmentEditor.blocked}}" aria-label="{{key === 'start' ? '开始日期' : '截止日期'}}"><view class="picker-value">{{recruitmentEditor[key].date || '选择日期'}}</view></picker>
        <picker mode="time" value="{{recruitmentEditor[key].time}}" bindchange="recruitmentTime" data-key="{{key}}" data-part="time" disabled="{{loading || busy || recruitmentEditor.blocked}}" aria-label="{{key === 'start' ? '开始时刻' : '截止时刻'}}"><view class="picker-value">{{recruitmentEditor[key].time || '选择时刻'}}</view></picker>
        <button wx:if="{{recruitmentEditor[key].date}}" class="plain" bindtap="recruitmentTime" data-key="{{key}}" data-part="clear" disabled="{{loading || busy || recruitmentEditor.blocked}}">清除</button>
      </view>
    </view>
    <text wx:if="{{teamDoc.teamStatus !== 'active'}}" class="zj-callout zj-callout-warning">请在工作台的「调整队伍状态」中将队伍设为活跃，再发布招新。</text>
    <view class="zj-dock">
      <button class="primary" bindtap="saveRecruitment" data-status="open" disabled="{{loading || busy || recruitmentEditor.blocked || teamDoc.teamStatus !== 'active'}}">{{recruitmentEditor.status === 'open' ? '保存开放安排' : '发布招新'}}</button>
      <button wx:if="{{recruitmentEditor.status !== 'open'}}" class="secondary" bindtap="saveRecruitment" data-status="{{recruitmentEditor.status}}" disabled="{{loading || busy || recruitmentEditor.blocked}}">{{recruitmentEditor.status === 'draft' ? '保存草稿' : '保存批次'}}</button>
      <button class="plain" bindtap="closeRecruitmentEditor" disabled="{{busy}}">返回批次列表</button>
    </view>
  </view>

  <block wx:elif="{{allowed && !needsLogin}}">
    <view wx:if="{{mode === 'join'}}" class="team-review-shortcuts"><button class="primary" bindtap="recruitmentBatches" disabled="{{loading || busy || error}}">管理招新</button><button class="secondary" bindtap="members" disabled="{{loading || busy}}">管理成员关系</button></view>
    <view class="zj-section-head"><text class="zj-section-title">{{mode === 'join' ? '入队申请' : '待审建队申请'}}</text><button class="plain zj-more" bindtap="retry" disabled="{{loading || busy}}">刷新核对</button></view>
    <view wx:if="{{mode === 'join'}}" class="team-review-filter"><text class="zj-small">申请状态</text><picker range="{{statusLabels}}" value="{{statusIndex}}" bindchange="status" disabled="{{loading || busy}}"><view class="team-review-filter-value"><text>{{statusLabels[statusIndex]}}</text><text>▾</text></view></picker></view>
    <view wx:for="{{docs}}" wx:for-item="entry" wx:key="id" class="zj-record team-review-record {{expandedId === entry.id ? 'team-review-open' : ''}}">
      <view class="zj-record-head"><text class="zj-pill zj-pill-action">{{entry.statusText}}</text><text class="zj-small">申请 {{entry.id}}</text></view>
      <text class="zj-record-title">{{entry.title}}</text>
      <text wx:if="{{entry.dateText}}" class="zj-small">更新于 {{entry.dateText}}</text>
      <button class="plain team-review-disclosure" bindtap="toggleRecord" data-id="{{entry.id}}" disabled="{{busy}}" aria-expanded="{{expandedId === entry.id}}"><text>{{expandedId === entry.id ? '收起申请与处理区' : '查看申请并处理'}}</text><text>{{expandedId === entry.id ? '−' : '＋'}}</text></button>
      <view wx:if="{{expandedId === entry.id}}" class="team-review-detail">
        <view class="team-review-block">
          <text class="field-label">{{mode === 'join' ? '申请时提交的答卷' : '组织与训练计划'}}</text>
          <text wx:if="{{mode === 'establishment'}}" class="body" selectable>{{entry.reason}}</text>
          <view class="zj-kv"><view wx:for="{{entry.rows}}" wx:for-item="answer" wx:key="id" class="zj-kv-row team-review-answer"><text class="zj-kv-label">{{answer.label}}</text><text class="zj-kv-value" selectable>{{answer.answer}}</text></view></view>
          <text wx:if="{{entry.receiptError}}" class="error" aria-role="alert">{{entry.receiptError}}</text>
        </view>
        <view wx:if="{{entry.reviewNote}}" class="zj-callout"><text class="team-review-label">上次处理意见</text><text selectable>{{entry.reviewNote}}</text></view>
        <view wx:if="{{entry.decisions.length}}" class="team-review-decision">
          <text class="zj-sheet-title">本次审核决定</text>
          <text class="zj-form-hint">处理意见会显示在申请人的回执中。</text>
          <view class="field"><text class="field-label">处理意见</text><textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{entry.noteDraft}}" bindinput="note" data-id="{{entry.id}}" maxlength="1000" placeholder="退回或拒绝时必填具体原因" disabled="{{busy}}" /><text class="zj-form-hint">最多 1000 字，保存前会再次确认。</text></view>
          <view class="actions"><button wx:for="{{entry.decisions}}" wx:for-item="decision" wx:key="value" class="{{decision.value === 'approved' ? 'primary' : decision.value === 'rejected' ? 'danger' : 'secondary'}}" bindtap="decide" data-id="{{entry.id}}" data-decision="{{decision.value}}" disabled="{{loading || busy || (entry.receiptError && decision.value === 'approved')}}">{{decision.label}}</button></view>
        </view>
        <text wx:else class="zj-form-hint">暂无可执行审核操作。</text>
      </view>
    </view>
    <view wx:if="{{!docs.length && !loading && !error}}" class="zj-empty"><text class="zj-empty-icon">✓</text><text class="zj-empty-title">此状态暂无申请</text><text wx:if="{{mode === 'join'}}" class="zj-small">未提交草稿不进入审核队列。</text></view>
    <button wx:if="{{hasMore}}" class="secondary team-review-more" bindtap="onReachBottom" disabled="{{loading || busy}}">加载更多申请</button>

    <block wx:if="{{mode === 'join'}}">
      <view id="team-recruitment-batches" class="zj-section">
        <view class="zj-section-head"><view><text class="zj-section-title">招新批次</text><text class="zj-small">新建批次使用代表队选拔问卷。设置报名时间后即可发布。</text></view></view>
        <button wx:if="{{teamActions.createRecruitment}}" class="accent team-review-more" bindtap="openRecruitmentEditor" disabled="{{loading || busy || error}}">＋ 新建招新批次</button>
        <view class="zj-list team-review-batches">
          <view wx:for="{{recruitments}}" wx:key="id" class="zj-call">
            <view class="zj-row"><text class="zj-kind">代表队选拔</text><text class="zj-pill zj-pill-success">{{item.state}}</text></view>
            <text class="zj-card-title">{{item.title}}</text>
            <view class="team-review-dates"><view wx:if="{{item.startText}}" class="team-review-date"><text class="team-review-date-label">开始</text><text>{{item.startText}}</text></view><view wx:if="{{item.endText}}" class="team-review-date"><text class="team-review-date-label">截止</text><text>{{item.endText}}</text></view></view>
            <view class="zj-record-actions"><button wx:if="{{item.actions.view}}" class="secondary" bindtap="openRecruitment" data-id="{{item.id}}" disabled="{{loading || busy}}">查看申请入口</button><button wx:if="{{item.actions.edit}}" class="secondary" bindtap="openRecruitmentEditor" data-id="{{item.id}}" disabled="{{loading || busy || error}}">{{item.status === 'draft' ? '编辑并发布' : '编辑招新批次'}}</button><button wx:if="{{item.actions.close}}" class="plain" bindtap="operate" data-operation="close-recruitment" data-status="closed" data-id="{{item.id}}" disabled="{{loading || busy}}">关闭本轮招新</button><button wx:if="{{item.actions.archive}}" class="danger" bindtap="operate" data-operation="close-recruitment" data-status="archived" data-id="{{item.id}}" disabled="{{loading || busy}}">归档批次</button></view>
          </view>
        </view>
        <text wx:if="{{!recruitments.length && !loading && !error}}" class="zj-form-hint">暂无本队招新批次。</text>
        <button wx:if="{{batchesMore}}" class="secondary team-review-more" bindtap="moreBatches" disabled="{{loading || busy}}">加载更多批次</button>
      </view>
      <view class="zj-sheet team-review-lifecycle">
        <text class="zj-sheet-title">调整队伍状态</text>
        <view class="zj-row"><text class="zj-small">当前状态</text><text class="zj-pill zj-pill-action">{{teamDoc.statusText}}</text></view>
        <text wx:if="{{lifecycleChoices.length}}" class="zj-callout zj-callout-warning">设为休整或归档会关闭当前开放的招新批次，保存前需确认。</text>
        <view class="actions"><button wx:for="{{lifecycleChoices}}" wx:key="value" class="{{item.value === 'archived' ? 'danger' : 'secondary'}}" bindtap="operate" data-operation="lifecycle" data-status="{{item.value}}" disabled="{{loading || busy}}">设为{{item.label}}</button></view>
        <button class="plain" bindtap="websiteWorkbench" disabled="{{loading || busy}}">复制网站工作台地址</button>
      </view>
    </block>
  </block>
</view>
