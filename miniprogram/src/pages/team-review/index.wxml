<page-meta page-style="{{themePageStyle}}" />
<import src="../../templates/common.wxml" />
<view class="page mini-page team-review-v2 {{theme === 'dark' ? 'zj-dark' : ''}}">
  <view class="zj-hero">
    <view class="zj-stage-stripes"></view>
    <view class="zj-hero-inner">
      <button class="zj-hero-back" bindtap="back">{{t.back}}</button>
      <text class="zj-hero-kicker">{{mode === 'join' ? (teamDoc.title || t.currentTeam) + t.kickerJoinSuffix : t.kickerEstablishment}}</text>
      <text class="zj-hero-title">{{mode === 'join' ? t.titleJoin : t.titleEstablishment}}</text>
      <text class="zj-hero-lead">{{mode === 'join' ? t.leadJoin : t.leadEstablishment}}</text>
      <view wx:if="{{mode === 'join' && allowed}}" class="zj-hero-meta"><text>{{t.teamStatus}}</text><text class="zj-pill zj-pill-live">{{teamDoc.statusText}}</text></view>
    </view>
  </view>
  <template is="feedback" data="{{needsLogin,t}}" />
  <text wx:if="{{busy}}" class="zj-callout" aria-role="status">{{t.busyNote}}</text>
  <view wx:if="{{loading}}" class="zj-skeleton" aria-role="status" aria-label="{{t.checking}}"><view wx:if="{{!allowed}}" class="zj-skeleton-row"><view class="zj-skeleton-date"></view><view class="zj-skeleton-lines"><view></view><view></view><view></view></view></view></view>
  <view wx:if="{{error}}" class="zj-alert"><text class="zj-small" aria-role="alert">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">{{t.reload}}</button></view>
  <text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text>
  <text wx:if="{{done}}" class="zj-callout zj-callout-success" aria-role="status">{{done}}</text>
  <view wx:if="{{!needsLogin && !loading && !error && !allowed}}" class="zj-empty"><text class="zj-empty-icon">🔒</text><text class="zj-empty-title">{{t.noAccessTitle}}</text><text class="zj-small">{{t.noAccessBody}}</text><button class="secondary" bindtap="retry" disabled="{{busy}}">{{t.recheck}}</button></view>

  <view wx:if="{{allowed && !needsLogin && recruitmentEditor}}" class="zj-sheet team-review-editor">
    <text class="zj-sheet-title">{{recruitmentEditor.id ? t.editBatch : t.newBatch}}</text>
    <view class="field">
      <text class="field-label">{{t.batchName}}</text>
      <input cursor-spacing="24" value="{{recruitmentEditor.title}}" bindinput="recruitmentTitle" maxlength="120" aria-label="{{t.batchName}}" disabled="{{loading || busy || recruitmentEditor.blocked}}" />
    </view>
    <text class="zj-callout">{{t.questionCountPrefix}}{{recruitmentEditor.questionCount}}{{t.questionCountSuffix}}</text>
    <button class="plain" bindtap="websiteWorkbench" data-id="{{recruitmentEditor.id}}" data-create="{{!recruitmentEditor.id}}" disabled="{{loading || busy}}">{{t.copyQuestionnaire}}</button>
    <text class="zj-form-hint">{{t.timeHint}}</text>
    <view wx:for="{{['start', 'end']}}" wx:for-item="key" wx:key="*this" class="field">
      <text class="field-label">{{key === 'start' ? t.startLabel : t.endLabel}}</text>
      <view class="team-review-pickers">
        <picker mode="date" value="{{recruitmentEditor[key].date}}" bindchange="recruitmentTime" data-key="{{key}}" data-part="date" disabled="{{loading || busy || recruitmentEditor.blocked}}" aria-label="{{key === 'start' ? t.startDate : t.endDate}}"><view class="picker-value">{{recruitmentEditor[key].date || t.pickDate}}</view></picker>
        <picker mode="time" value="{{recruitmentEditor[key].time}}" bindchange="recruitmentTime" data-key="{{key}}" data-part="time" disabled="{{loading || busy || recruitmentEditor.blocked}}" aria-label="{{key === 'start' ? t.startTime : t.endTime}}"><view class="picker-value">{{recruitmentEditor[key].time || t.pickTime}}</view></picker>
        <button wx:if="{{recruitmentEditor[key].date}}" class="plain" bindtap="recruitmentTime" data-key="{{key}}" data-part="clear" disabled="{{loading || busy || recruitmentEditor.blocked}}">{{t.clear}}</button>
      </view>
    </view>
    <text wx:if="{{teamDoc.teamStatus !== 'active'}}" class="zj-callout zj-callout-warning">{{t.activeFirst}}</text>
    <view class="zj-dock">
      <button class="primary" bindtap="saveRecruitment" data-status="open" disabled="{{loading || busy || recruitmentEditor.blocked || teamDoc.teamStatus !== 'active'}}">{{recruitmentEditor.status === 'open' ? t.saveOpen : t.publish}}</button>
      <button wx:if="{{recruitmentEditor.status !== 'open'}}" class="secondary" bindtap="saveRecruitment" data-status="{{recruitmentEditor.status}}" disabled="{{loading || busy || recruitmentEditor.blocked}}">{{recruitmentEditor.status === 'draft' ? t.saveDraft : t.saveBatch}}</button>
      <button class="plain" bindtap="closeRecruitmentEditor" disabled="{{busy}}">{{t.backToBatches}}</button>
    </view>
  </view>

  <block wx:elif="{{allowed && !needsLogin}}">
    <view wx:if="{{mode === 'join'}}" class="team-review-shortcuts"><button class="primary" bindtap="recruitmentBatches" disabled="{{loading || busy || error}}">{{t.manageRecruitment}}</button><button class="secondary" bindtap="members" disabled="{{loading || busy}}">{{t.manageMembers}}</button></view>
    <view class="zj-section-head"><text class="zj-section-title">{{mode === 'join' ? t.joinApplications : t.pendingEstablishments}}</text><button class="plain zj-more" bindtap="retry" disabled="{{loading || busy}}">{{t.refresh}}</button></view>
    <view wx:if="{{mode === 'join'}}" class="team-review-filter"><text class="zj-small">{{t.applicationStatus}}</text><picker range="{{statusLabels}}" value="{{statusIndex}}" bindchange="status" disabled="{{loading || busy}}"><view class="team-review-filter-value"><text>{{statusLabels[statusIndex]}}</text><text>▾</text></view></picker></view>
    <view wx:for="{{docs}}" wx:for-item="entry" wx:key="id" class="zj-record team-review-record {{expandedId === entry.id ? 'team-review-open' : ''}}">
      <view class="zj-record-head"><text class="zj-pill zj-pill-action">{{entry.statusText}}</text><text class="zj-small">{{t.applicationPrefix}}{{entry.id}}</text></view>
      <text class="zj-record-title">{{entry.title}}</text>
      <text wx:if="{{entry.dateText}}" class="zj-small">{{t.updatedPrefix}}{{entry.dateText}}</text>
      <button class="plain team-review-disclosure" bindtap="toggleRecord" data-id="{{entry.id}}" disabled="{{busy}}" aria-expanded="{{expandedId === entry.id}}"><text>{{expandedId === entry.id ? t.hideApplication : t.showApplication}}</text><text>{{expandedId === entry.id ? '−' : '＋'}}</text></button>
      <view wx:if="{{expandedId === entry.id}}" class="team-review-detail">
        <view class="team-review-block">
          <text class="field-label">{{mode === 'join' ? t.answers : t.plan}}</text>
          <text wx:if="{{mode === 'establishment'}}" class="body" selectable>{{entry.reason}}</text>
          <view class="zj-kv"><view wx:for="{{entry.rows}}" wx:for-item="answer" wx:key="id" class="zj-kv-row team-review-answer"><text class="zj-kv-label">{{answer.label}}</text><text class="zj-kv-value" selectable>{{answer.answer}}</text></view></view>
          <text wx:if="{{entry.receiptError}}" class="error" aria-role="alert">{{entry.receiptError}}</text>
        </view>
        <view wx:if="{{entry.reviewNote}}" class="zj-callout"><text class="team-review-label">{{t.lastNote}}</text><text selectable>{{entry.reviewNote}}</text></view>
        <view wx:if="{{entry.decisions.length}}" class="team-review-decision">
          <text class="zj-sheet-title">{{t.decision}}</text>
          <text class="zj-form-hint">{{t.decisionHint}}</text>
          <view class="field"><text class="field-label">{{t.noteLabel}}</text><textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" value="{{entry.noteDraft}}" bindinput="note" data-id="{{entry.id}}" maxlength="1000" placeholder="{{t.notePlaceholder}}" disabled="{{busy}}" /><text class="zj-form-hint">{{t.noteHint}}</text></view>
          <view class="actions"><button wx:for="{{entry.decisions}}" wx:for-item="decision" wx:key="value" class="{{decision.value === 'approved' ? 'primary' : decision.value === 'rejected' ? 'danger' : 'secondary'}}" bindtap="decide" data-id="{{entry.id}}" data-decision="{{decision.value}}" disabled="{{loading || busy || (entry.receiptError && decision.value === 'approved')}}">{{decision.label}}</button></view>
        </view>
        <text wx:else class="zj-form-hint">{{t.noDecision}}</text>
      </view>
    </view>
    <view wx:if="{{!docs.length && !loading && !error}}" class="zj-empty"><text class="zj-empty-icon">✓</text><text class="zj-empty-title">{{t.emptyTitle}}</text><text wx:if="{{mode === 'join'}}" class="zj-small">{{t.emptyBody}}</text></view>
    <button wx:if="{{hasMore}}" class="secondary team-review-more" bindtap="onReachBottom" disabled="{{loading || busy}}">{{t.loadMore}}</button>

    <block wx:if="{{mode === 'join'}}">
      <view id="team-recruitment-batches" class="zj-section">
        <view class="zj-section-head"><view><text class="zj-section-title">{{t.batches}}</text><text class="zj-small">{{t.batchesHint}}</text></view></view>
        <button wx:if="{{teamActions.createRecruitment}}" class="accent team-review-more" bindtap="openRecruitmentEditor" disabled="{{loading || busy || error}}">{{t.addBatch}}</button>
        <view class="zj-list team-review-batches">
          <view wx:for="{{recruitments}}" wx:key="id" class="zj-call">
            <view class="zj-row"><text class="zj-kind">{{t.teamTrials}}</text><text class="zj-pill zj-pill-success">{{item.state}}</text></view>
            <text class="zj-card-title">{{item.title}}</text>
            <view class="team-review-dates"><view wx:if="{{item.startText}}" class="team-review-date"><text class="team-review-date-label">{{t.start}}</text><text>{{item.startText}}</text></view><view wx:if="{{item.endText}}" class="team-review-date"><text class="team-review-date-label">{{t.end}}</text><text>{{item.endText}}</text></view></view>
            <view class="zj-record-actions"><button wx:if="{{item.actions.view}}" class="secondary" bindtap="openRecruitment" data-id="{{item.id}}" disabled="{{loading || busy}}">{{t.viewEntry}}</button><button wx:if="{{item.actions.edit}}" class="secondary" bindtap="openRecruitmentEditor" data-id="{{item.id}}" disabled="{{loading || busy || error}}">{{item.status === 'draft' ? t.editPublish : t.editBatch}}</button><button wx:if="{{item.actions.close}}" class="plain" bindtap="operate" data-operation="close-recruitment" data-status="closed" data-id="{{item.id}}" disabled="{{loading || busy}}">{{t.closeRound}}</button><button wx:if="{{item.actions.archive}}" class="danger" bindtap="operate" data-operation="close-recruitment" data-status="archived" data-id="{{item.id}}" disabled="{{loading || busy}}">{{t.archiveBatch}}</button></view>
          </view>
        </view>
        <text wx:if="{{!recruitments.length && !loading && !error}}" class="zj-form-hint">{{t.noBatches}}</text>
        <button wx:if="{{batchesMore}}" class="secondary team-review-more" bindtap="moreBatches" disabled="{{loading || busy}}">{{t.moreBatches}}</button>
      </view>
      <view class="zj-sheet team-review-lifecycle">
        <text class="zj-sheet-title">{{t.adjustStatus}}</text>
        <view class="zj-row"><text class="zj-small">{{t.currentStatus}}</text><text class="zj-pill zj-pill-action">{{teamDoc.statusText}}</text></view>
        <text wx:if="{{lifecycleChoices.length}}" class="zj-callout zj-callout-warning">{{t.lifecycleWarning}}</text>
        <view class="actions"><button wx:for="{{lifecycleChoices}}" wx:key="value" class="{{item.value === 'archived' ? 'danger' : 'secondary'}}" bindtap="operate" data-operation="lifecycle" data-status="{{item.value}}" disabled="{{loading || busy}}">{{t.setPrefix}}{{item.label}}</button></view>
        <button class="plain" bindtap="websiteWorkbench" disabled="{{loading || busy}}">{{t.copyWorkbench}}</button>
      </view>
    </block>
  </block>
</view>
