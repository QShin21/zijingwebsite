<import src="../../templates/common.wxml" />
<view class="page mini-page team-review-page"><button class="plain" bindtap="back">返回</button><text class="eyebrow">TEAM WORKSPACE</text><text class="title">{{mode === 'join' ? teamDoc.title || '队伍工作台' : '建队申请审核'}}</text><text class="subtitle">根据你当前的管理权限查看与处理申请。核对提交时的答卷后，再保存人工决定。</text><template is="feedback" data="{{needsLogin}}" />
  <text wx:if="{{busy}}" class="muted">本次确认或保存尚未完成，完成后会核对最新记录。</text><text wx:if="{{loading}}" class="muted">正在核对权限与工作台…</text><view wx:if="{{error}}"><text class="error">{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading || busy}}">重新加载</button></view><text wx:if="{{operationError}}" class="error" aria-role="alert">{{operationError}}</text><text wx:if="{{done}}" class="body" aria-role="status">{{done}}</text>
  <view wx:if="{{!needsLogin && !loading && !error && !allowed}}" class="empty"><text>当前暂无此工作台的查看权限</text><button class="secondary" bindtap="retry">重新核对权限</button></view>
  <block wx:if="{{allowed && !needsLogin}}">
    <block wx:if="{{mode === 'join'}}"><view class="panel section"><text class="section-title">队伍运营状态</text><text class="badge">{{teamDoc.statusText}}</text><view class="actions"><button wx:for="{{lifecycleChoices}}" wx:key="value" class="secondary" bindtap="operate" data-operation="lifecycle" data-status="{{item.value}}" disabled="{{loading || busy}}">设为{{item.label}}</button></view><button class="plain" bindtap="members" disabled="{{loading || busy}}">成员关系管理 →</button><button class="plain" bindtap="websiteWorkbench" disabled="{{loading || busy}}">复制网站工作台地址</button></view>
      <view class="section-head section"><text class="section-title">招新批次</text><button wx:if="{{teamActions.createRecruitment}}" class="plain" bindtap="websiteWorkbench" data-create="{{true}}" disabled="{{loading || busy}}">复制新建批次地址</button></view><text class="muted">批次创作与全部题型、分支设置在网站工作台编辑；小程序保留完整作答与已提交答卷。</text>
      <view wx:for="{{recruitments}}" wx:key="id" class="panel section"><view class="row"><text class="section-title">{{item.title}}</text><text class="badge">{{item.state}}</text></view><text wx:if="{{item.startText}}" class="muted">开始：{{item.startText}}</text><text wx:if="{{item.endText}}" class="muted">截止：{{item.endText}}</text><view class="actions"><button wx:if="{{item.actions.view}}" class="plain" bindtap="openRecruitment" data-id="{{item.id}}" disabled="{{loading || busy}}">查看申请入口</button><button wx:if="{{item.actions.edit}}" class="plain" bindtap="websiteWorkbench" data-id="{{item.id}}" disabled="{{loading || busy}}">复制表单编辑地址</button><button wx:if="{{item.actions.close}}" class="secondary" bindtap="operate" data-operation="close-recruitment" data-status="closed" data-id="{{item.id}}" disabled="{{loading || busy}}">关闭本轮招新</button><button wx:if="{{item.actions.archive}}" class="secondary" bindtap="operate" data-operation="close-recruitment" data-status="archived" data-id="{{item.id}}" disabled="{{loading || busy}}">归档批次</button></view></view><text wx:if="{{!recruitments.length && !loading && !error}}" class="empty">暂无本队招新批次</text><button wx:if="{{batchesMore}}" class="plain" bindtap="moreBatches" disabled="{{loading || busy}}">加载更多批次</button>
      <view class="field section"><text class="field-label">按申请状态查看</text><picker range="{{statusLabels}}" value="{{statusIndex}}" bindchange="status" disabled="{{loading || busy}}"><view>{{statusLabels[statusIndex]}} ▾</view></picker></view>
    </block>
    <view class="section-head section"><text class="section-title">{{mode === 'join' ? '入队申请' : '待审建队申请'}}</text><button class="plain" bindtap="retry" disabled="{{loading || busy}}">刷新</button></view>
    <view wx:for="{{docs}}" wx:for-item="entry" wx:key="id" class="panel section"><view class="row"><text class="section-title">{{entry.title}}</text><text class="badge">{{entry.statusText}}</text></view><text class="muted">申请 {{entry.id}} · {{entry.dateText}}</text><text wx:if="{{mode === 'establishment'}}" class="body">{{entry.reason}}</text>
      <view wx:for="{{entry.rows}}" wx:for-item="answer" wx:key="id" class="answer"><text class="answer-label">{{answer.label}}</text><text selectable>{{answer.answer}}</text></view><text wx:if="{{entry.receiptError}}" class="error">{{entry.receiptError}}</text><text wx:if="{{entry.reviewNote}}" class="body">上次处理意见：{{entry.reviewNote}}</text>
      <view wx:if="{{entry.decisions.length}}" class="field"><text class="field-label">处理意见</text><textarea value="{{entry.noteDraft}}" bindinput="note" data-id="{{entry.id}}" maxlength="1000" placeholder="退回或拒绝时必填具体原因" disabled="{{busy}}" /></view><view class="actions"><button wx:for="{{entry.decisions}}" wx:for-item="decision" wx:key="value" class="secondary" bindtap="decide" data-id="{{entry.id}}" data-decision="{{decision.value}}" disabled="{{loading || busy || (entry.receiptError && decision.value === 'approved')}}">{{decision.label}}</button></view><text wx:if="{{!entry.decisions.length}}" class="muted">暂无可执行审核操作。</text>
    </view><view wx:if="{{!docs.length && !loading && !error}}" class="empty"><text>此状态暂无申请</text><text wx:if="{{mode === 'join'}}" class="muted">未提交草稿不进入审核队列。</text></view><button wx:if="{{hasMore}}" class="plain section" bindtap="onReachBottom" disabled="{{loading || busy}}">加载更多申请</button>
  </block>
</view>
