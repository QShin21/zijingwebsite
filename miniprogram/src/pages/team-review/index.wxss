@import "../../templates/business.wxss";
@import "../../styles/native-forms.wxss";

/* V2 team workbench: batch editor sheet, review queue, batches and lifecycle sheet. */
.team-review-v2 { padding-top: 0; }
.team-review-editor { border-top: 8rpx solid var(--z-primary); }
.team-review-pickers { display: flex; flex-wrap: wrap; gap: 12rpx; }
.team-review-pickers picker { flex: 1; min-width: 200rpx; }
.team-review-shortcuts { display: flex; gap: 12rpx; margin-bottom: 8rpx; }
.team-review-shortcuts > button { flex: 1; }
.team-review-filter { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 16rpx 22rpx; margin-bottom: 16rpx; border: 1rpx solid var(--z-line); border-radius: 24rpx; background: var(--z-surface); }
.team-review-filter-value { display: flex; gap: 10rpx; color: var(--z-primary); font-weight: 800; }
.team-review-open { border-color: var(--z-primary); box-shadow: 0 16rpx 48rpx rgba(28, 18, 64, .12); }
.mini-page .team-review-disclosure { display: flex; justify-content: space-between; width: 100%; padding: 10rpx 0; }
.team-review-detail { display: flex; flex-direction: column; gap: 16rpx; }
.team-review-block { display: flex; flex-direction: column; gap: 8rpx; padding: 22rpx; border-radius: 24rpx; background: var(--z-raised); border: 1rpx solid var(--z-line); }
.team-review-answer .zj-kv-label { width: 200rpx; }
.team-review-label { display: block; font-weight: 900; }
.team-review-decision { display: flex; flex-direction: column; gap: 8rpx; padding: 24rpx; border-radius: 24rpx; background: var(--z-tint); }
.mini-page .team-review-more { display: block; width: 100%; margin: 14rpx 0; }
.team-review-batches { margin-top: 12rpx; }
.team-review-dates { display: flex; gap: 12rpx; }
.team-review-date { flex: 1; display: flex; flex-direction: column; gap: 4rpx; padding: 12rpx 16rpx; border-radius: 18rpx; background: var(--z-stage); color: var(--z-stage-ink); font-size: 25rpx; font-weight: 800; }
.team-review-date-label { color: var(--z-stage-accent, var(--z-stage-ink)); font-size: 21rpx; font-weight: 900; }
.team-review-lifecycle { margin-top: 28rpx; gap: 12rpx; }
