<template name="native-reading-mark">
  <view class="reading-mark" aria-hidden="true"><view class="reading-mark-stroke"></view><view class="reading-mark-corner"></view></view>
</template>

<template name="native-content-records">
  <view class="reading-records">
    <block wx:for="{{docs}}" wx:key="id">
      <button wx:if="{{item.collection === 'honors'}}" class="content-link reading-honor" bindtap="openContent" data-doc="{{item}}" hover-class="pressed">
        <view class="reading-archive-date"><block wx:if="{{item.nativeReading.date.known}}"><text class="reading-archive-year">{{item.nativeReading.date.year}}</text><text class="reading-archive-day">{{item.nativeReading.date.day}}</text></block><view wx:else class="reading-date-pending"><text>日期</text><text>待公布</text></view></view>
        <view class="reading-record-copy"><view class="native-meta"><text wx:if="{{item.game.title}}">{{item.game.title}}</text><text wx:if="{{item.verified}}">已核验</text><text wx:if="{{item.demo}}">演示资料</text></view><text class="native-entry-title">{{item.title}}</text><text wx:if="{{item.competition}}" class="native-detail">{{item.competition}}</text><text wx:if="{{item.division}}" class="native-detail">{{item.division}}</text><text wx:if="{{item.placing}}" class="reading-honor-result">{{item.placing}}</text><text wx:if="{{item.summary}}" class="native-summary">{{item.summary}}</text><image wx:if="{{item.coverImage && !item.nativeCoverError}}" class="reading-record-cover" src="{{item.coverImage.url}}" mode="aspectFill" aria-label="{{item.coverImage.alt || item.title}}" binderror="nativeCoverError" data-id="{{item.id}}" data-collection="{{item.collection}}" data-url="{{item.coverImage.url}}" /><text wx:if="{{item.nativeCoverError}}" class="reading-media-failed">封面暂时无法显示</text><text wx:if="{{item.coverImage.credit}}" class="native-media-credit">{{item.coverImage.credit}}</text><text class="native-entry-action">查看成果记录</text></view>
      </button>
      <button wx:elif="{{item.collection === 'albums'}}" class="content-link reading-album {{item.coverImage && !item.nativeCoverError ? 'reading-album-with-image' : 'reading-album-without-image'}}" bindtap="openContent" data-doc="{{item}}" hover-class="pressed">
        <image wx:if="{{item.coverImage && !item.nativeCoverError}}" class="reading-album-cover" src="{{item.coverImage.url}}" mode="aspectFill" aria-label="{{item.coverImage.alt || item.title}}" binderror="nativeCoverError" data-id="{{item.id}}" data-collection="{{item.collection}}" data-url="{{item.coverImage.url}}" />
        <view wx:else class="reading-album-symbol" aria-hidden="true"><view class="reading-album-frame"></view><view class="reading-album-frame reading-album-frame-front"></view></view>
        <view class="reading-record-copy"><text wx:if="{{item.nativeCoverError}}" class="reading-media-failed">封面暂时无法显示</text><text wx:if="{{item.coverImage.credit}}" class="native-media-credit">{{item.coverImage.credit}}</text><view class="native-meta"><text wx:if="{{item.nativeReading.date.known}}">{{item.nativeReading.date.text}}</text><text wx:if="{{item.game.title}}">{{item.game.title}}</text><text wx:if="{{item.demo}}">演示资料</text></view><text class="native-entry-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="native-summary">{{item.summary}}</text><text class="native-entry-action">打开相册</text></view>
      </button>
      <button wx:elif="{{item.collection === 'teams' || item.collection === 'recruitment'}}" class="content-link reading-selection reading-selection-{{item.collection}}" bindtap="openContent" data-doc="{{item}}" hover-class="pressed">
        <view class="reading-selection-top"><view class="reading-record-copy"><view class="native-meta"><text wx:if="{{item.kindText}}">{{item.kindText}}</text><text wx:if="{{item.game.title}}">{{item.game.title}}</text><text wx:if="{{item.demo}}">演示资料</text></view><text class="native-entry-title">{{item.title}}</text></view><image wx:if="{{item.coverImage && !item.nativeCoverError}}" class="reading-selection-image" src="{{item.coverImage.url}}" mode="aspectFill" aria-label="{{item.coverImage.alt || item.title}}" binderror="nativeCoverError" data-id="{{item.id}}" data-collection="{{item.collection}}" data-url="{{item.coverImage.url}}" /><view wx:else class="reading-selection-mark" aria-hidden="true"><view></view></view></view>
        <text wx:if="{{item.summary}}" class="native-summary">{{item.summary}}</text><text wx:if="{{item.nativeCoverError}}" class="reading-media-failed">封面暂时无法显示</text><text wx:if="{{item.coverImage.credit}}" class="native-media-credit">{{item.coverImage.credit}}</text><view wx:if="{{item.statusText || item.nativeReading.deadline}}" class="reading-selection-state"><text wx:if="{{item.statusText}}" class="native-status">{{item.statusText}}</text><text wx:if="{{item.nativeReading.deadline}}" class="native-detail">截止 {{item.nativeReading.deadline}}</text></view><text wx:if="{{item.location}}" class="native-detail">{{item.location}}</text><text class="native-entry-action">{{item.nativeReading.action}}</text>
      </button>
      <button wx:else class="content-link reading-index {{item.coverImage && !item.nativeCoverError && item.collection === 'news' && index === 0 ? 'reading-index-featured' : ''}}" bindtap="openContent" data-doc="{{item}}" hover-class="pressed">
        <image wx:if="{{item.coverImage && !item.nativeCoverError && item.collection === 'news' && index === 0}}" class="reading-record-cover" src="{{item.coverImage.url}}" mode="aspectFill" aria-label="{{item.coverImage.alt || item.title}}" binderror="nativeCoverError" data-id="{{item.id}}" data-collection="{{item.collection}}" data-url="{{item.coverImage.url}}" />
        <text wx:if="{{item.coverImage && !item.nativeCoverError && item.collection === 'news' && index === 0 && item.coverImage.credit}}" class="native-media-credit">{{item.coverImage.credit}}</text>
        <view class="reading-index-main"><view class="reading-record-copy"><view class="native-meta"><text wx:if="{{item.nativeReading.date.known}}">{{item.nativeReading.date.text}}</text><text wx:if="{{item.kindText}}">{{item.kindText}}</text><text wx:if="{{item.game.title}}">{{item.game.title}}</text><text wx:if="{{item.statusText}}">{{item.statusText}}</text><text wx:if="{{item.demo}}">演示资料</text></view><text class="native-entry-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="native-summary">{{item.summary}}</text><text wx:if="{{item.location}}" class="native-detail">{{item.location}}</text><text class="native-entry-action">{{item.nativeReading.action || '阅读全文'}}</text></view><image wx:if="{{item.coverImage && !item.nativeCoverError && (item.collection !== 'news' || index !== 0)}}" class="reading-index-image" src="{{item.coverImage.url}}" mode="aspectFill" aria-label="{{item.coverImage.alt || item.title}}" binderror="nativeCoverError" data-id="{{item.id}}" data-collection="{{item.collection}}" data-url="{{item.coverImage.url}}" /></view><text wx:if="{{item.nativeCoverError}}" class="reading-media-failed">封面暂时无法显示</text><text wx:if="{{item.coverImage.credit && (item.nativeCoverError || item.collection !== 'news' || index !== 0)}}" class="native-media-credit">{{item.coverImage.credit}}</text>
      </button>
    </block>
    <view wx:if="{{!docs.length}}" class="empty"><text class="state-title">{{emptyTitle || '暂无已发布内容'}}</text><text class="muted">{{emptyHint || '新内容发布后会出现在这里，可稍后下拉刷新。'}}</text></view>
  </view>
</template>

<template name="native-reading-links">
  <view wx:if="{{links.length}}" class="reading-links"><text class="section-title">文中链接</text><view wx:for="{{links}}" wx:key="url" class="reading-link-row"><text class="body">{{item.label}}</text><button class="plain" bindtap="copy" data-value="{{item.url}}">复制链接，在浏览器打开</button></view></view>
</template>
