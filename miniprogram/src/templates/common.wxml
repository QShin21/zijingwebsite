<template name="feedback">
  <view wx:if="{{loading}}" class="state" aria-role="status"><text class="state-title">正在读取内容</text><text class="muted">请稍候，正在获取最新信息。</text><view class="loading-lines" aria-hidden="true"><view class="loading-line"></view><view class="loading-line short"></view></view></view>
  <view wx:elif="{{needsLogin}}" class="state"><text class="state-title">登录后继续</text><text class="muted">使用紫荆账号登录，完成后回到当前页面。</text><button class="primary" bindtap="login">登录账号</button></view>
  <view wx:elif="{{error}}" class="state" aria-role="alert"><text class="state-title">内容暂时未能读取</text><text class="muted">{{error}}</text><button class="secondary" bindtap="retry">重新加载</button></view>
</template>
<template name="cards">
  <view class="record-list">
    <button wx:for="{{docs}}" wx:key="id" class="content-link content-record content-record-{{item.collection}}" bindtap="openContent" data-doc="{{item}}" hover-class="pressed">
      <image wx:if="{{item.coverImage && (item.collection === 'albums' || item.collection === 'news')}}" class="content-record-image" src="{{item.coverImage.url}}" mode="aspectFill" aria-label="{{item.coverImage.alt || item.title}}" />
      <view class="content-record-main">
        <view wx:if="{{item.collection === 'events' || item.collection === 'honors'}}" class="content-record-date"><text class="date-label">{{item.collection === 'events' ? '活动日期' : '赛事日期'}}</text><text>{{item.dateText}}</text></view>
        <view class="content-record-copy">
          <view class="meta"><text wx:if="{{item.kindText}}">{{item.kindText}}</text><text wx:if="{{item.game.title}}">{{item.game.title}}</text><text wx:if="{{item.dateText && item.collection !== 'events' && item.collection !== 'honors'}}">{{item.dateText}}</text><text wx:if="{{item.statusText}}" class="badge">{{item.statusText}}</text><text wx:if="{{item.demo}}" class="badge">演示资料</text></view>
          <text class="card-title">{{item.title}}</text>
          <text wx:if="{{item.competition}}" class="muted">{{item.competition}}</text><text wx:if="{{item.placing}}" class="record-result">{{item.placing}}</text>
          <text wx:if="{{item.summary}}" class="card-summary">{{item.summary}}</text>
          <text wx:if="{{item.location}}" class="field-note">{{item.location}}</text>
          <text class="entry-link">{{item.collection === 'events' ? '活动详情与报名' : item.collection === 'teams' ? '查看队伍档案' : item.collection === 'honors' ? '查看成果记录' : item.collection === 'recruitment' ? '查看参与方式' : '阅读全文'}}</text>
        </view>
        <image wx:if="{{item.coverImage && item.collection !== 'albums' && item.collection !== 'news' && item.collection !== 'events' && item.collection !== 'honors'}}" class="content-record-thumb" src="{{item.coverImage.url}}" mode="aspectFill" aria-label="{{item.coverImage.alt || item.title}}" />
      </view>
    </button>
    <view wx:if="{{!docs.length}}" class="empty"><text class="state-title">{{emptyTitle || '暂无已发布内容'}}</text><text class="muted">{{emptyHint || '新内容发布后会出现在这里，可稍后下拉刷新。'}}</text></view>
  </view>
</template>
