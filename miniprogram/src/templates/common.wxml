<template name="feedback">
  <view wx:if="{{loading}}" class="state" aria-role="status"><view class="state-dot" aria-hidden="true"></view><text class="state-title">正在读取内容</text><text class="muted">请稍候，正在获取最新信息。</text><view class="loading-lines" aria-hidden="true"><view class="loading-line"></view><view class="loading-line short"></view></view></view>
  <view wx:elif="{{needsLogin}}" class="state"><text class="section-kicker">账号状态</text><text class="state-title">登录后继续</text><text class="muted">使用网站已有账号。登录成功后会回到当前页面。</text><button class="primary" bindtap="login">登录账号</button></view>
  <view wx:elif="{{error}}" class="state" aria-role="alert"><text class="section-kicker">读取未完成</text><text class="state-title">暂时没有加载成功</text><text class="muted">{{error}}</text><button class="secondary" bindtap="retry">重新加载</button></view>
</template>
<template name="cards">
  <button wx:for="{{docs}}" wx:key="id" class="card content-link editorial-entry" bindtap="openContent" data-doc="{{item}}" hover-class="pressed">
    <view class="card-body"><view class="meta"><text>{{item.kindText || label}}</text><text wx:if="{{item.dateText}}">{{item.dateText}}</text><text wx:if="{{item.statusText}}" class="badge">{{item.statusText}}</text><text wx:if="{{item.demo}}" class="badge">演示资料</text></view><text class="card-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="card-summary">{{item.summary}}</text><image wx:if="{{item.coverImage}}" class="card-image entry-image" src="{{item.coverImage.url}}" mode="aspectFill" aria-label="{{item.coverImage.alt || item.title}}" /><view class="meta card-footer"><text wx:if="{{item.location}}">{{item.location}}</text><text class="entry-link">查看详情 →</text></view></view>
  </button>
  <view wx:if="{{!docs.length}}" class="empty"><text class="state-title">这里还没有已发布内容</text><text class="muted">新内容发布后会出现在这里，可稍后下拉刷新。</text></view>
</template>
