<template name="staff-batches">
  <view wx:if="{{batches.length}}" class="section staff-batches"><view class="section-heading"><text class="section-title">正在招募社团骨干</text><button class="more" bindtap="openPage" data-page="staff">全部批次</button></view><text class="field-note">参与执行部与宣传部的社团工作。</text><button wx:for="{{batches}}" wx:key="id" class="content-link shortcut" bindtap="openPage" data-page="signup" data-params="{{item.params}}"><view class="shortcut-main"><view class="meta"><text class="badge">{{item.state}}</text></view><text class="shortcut-title">{{item.title}}</text></view><text class="shortcut-sign" aria-hidden="true">›</text></button></view>
</template>
<template name="promotion-cards">
  <view class="record-list"><button wx:for="{{docs}}" wx:key="sourceKey" class="content-link content-record" bindtap="openWebsite" data-url="{{item.href}}" hover-class="pressed"><view class="meta-line"><text>{{item.gameTitle}}</text><text>社团展示</text></view><text class="card-title">{{item.snapshot.title}}</text><text wx:if="{{item.snapshot.body}}" class="card-summary">{{item.snapshot.body}}</text><text class="entry-link">查看社群原文</text></button></view>
</template>
