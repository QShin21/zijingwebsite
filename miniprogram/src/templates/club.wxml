<template name="staff-batches">
  <view wx:if="{{batches.length}}" class="section panel"><text class="section-title">执行部 / 宣传部骨干招新</text><text class="muted">全站共用同一申请。普通入社请联系游戏社群管理员。</text><view wx:for="{{batches}}" wx:key="id" class="section"><text class="body">{{item.title}}</text><text class="badge">{{item.state}}</text><button class="secondary" bindtap="openPage" data-page="signup" data-params="{{item.params}}">查看批次与本人申请 →</button></view><button class="plain" bindtap="openPage" data-page="staff">全部批次 / 我的回执 →</button></view>
</template>
<template name="promotion-cards">
  <view wx:for="{{docs}}" wx:key="sourceKey" class="panel section" bindtap="openWebsite" data-url="{{item.href}}" hover-class="pressed"><text class="badge">已审批社团展示</text><text class="muted">来自 {{item.gameTitle}}</text><text class="card-title">{{item.snapshot.title}}</text><text class="card-summary">{{item.snapshot.body}}</text><text class="more">查看原社群内容 →</text></view>
</template>
