<template name="staff-batches">
  <view wx:if="{{batches.length}}" class="section"><view class="section-head"><view><text class="section-kicker">参与社团工作</text><text class="section-title">骨干招新</text></view><button class="more" bindtap="openPage" data-page="staff">全部 →</button></view><text class="muted">执行部 / 宣传部 · 同一批次共用一份申请与回执。</text><button wx:for="{{batches}}" wx:key="id" class="content-link directory-row" bindtap="openPage" data-page="signup" data-params="{{item.params}}"><view class="directory-main"><text class="directory-title">{{item.title}}</text><text class="badge">{{item.state}}</text></view><text class="directory-arrow">→</text></button></view>
</template>
<template name="promotion-cards">
  <button wx:for="{{docs}}" wx:key="sourceKey" class="card content-link" bindtap="openWebsite" data-url="{{item.href}}" hover-class="pressed"><view class="card-body"><view class="meta"><text>{{item.gameTitle}}</text><text class="badge">已审批社团展示</text></view><text class="card-title">{{item.snapshot.title}}</text><text wx:if="{{item.snapshot.body}}" class="card-summary">{{item.snapshot.body}}</text><text class="muted card-footer">查看原社群内容 →</text></view></button>
</template>
