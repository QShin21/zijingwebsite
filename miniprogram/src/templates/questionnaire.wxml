<template name="questionnaire-question">
  <view id="question-{{question.id}}" class="question-section answer-question {{question.error ? 'invalid' : ''}}">
    <text class="label">{{question.number}}. {{question.label}}{{question.type === 'description' ? '' : question.required ? ' *' : t.qOptional}}</text>
    <text wx:if="{{question.help}}" class="muted question-help">{{question.help}}</text>
    <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" wx:if="{{question.type === 'text' || question.type === 'number'}}" value="{{question.value}}" type="{{question.inputType}}" maxlength="{{question.maxLength}}" disabled="{{busy}}" bindinput="answer" data-id="{{question.id}}" placeholder="{{question.placeholder || t.qInput}}" />
    <textarea cursor-spacing="24" placeholder-style="color:{{themeMuted}}" wx:if="{{question.type === 'textarea'}}" value="{{question.value}}" maxlength="{{question.maxLength}}" disabled="{{busy}}" bindinput="answer" data-id="{{question.id}}" placeholder="{{question.placeholder || t.qInput}}" />
    <radio-group wx:if="{{question.type === 'single'}}" bindchange="answer" data-id="{{question.id}}"><label wx:for="{{question.choices}}" wx:key="value" class="choice"><radio color="{{themePrimary}}" value="{{item.value}}" checked="{{item.checked}}" disabled="{{busy}}" />{{item.label}}</label></radio-group>
    <checkbox-group wx:if="{{question.type === 'multiple'}}" bindchange="answer" data-id="{{question.id}}"><label wx:for="{{question.choices}}" wx:key="value" class="choice"><checkbox color="{{themePrimary}}" value="{{item.value}}" checked="{{item.checked}}" disabled="{{busy}}" />{{item.label}}</label></checkbox-group>
    <picker wx:if="{{question.type === 'select'}}" range="{{question.pickerLabels}}" value="{{question.pickerIndex}}" disabled="{{busy}}" bindchange="choose" data-id="{{question.id}}"><view class="picker picker-value">{{question.pickerLabels[question.pickerIndex]}} ▾</view></picker>
    <picker wx:if="{{question.type === 'date' || question.type === 'time'}}" mode="{{question.type}}" value="{{question.value}}" disabled="{{busy}}" bindchange="answer" data-id="{{question.id}}"><view class="picker picker-value">{{question.value || (question.type === 'date' ? t.qPickDate : t.qPickTime)}} ▾</view></picker>
    <block wx:if="{{question.type === 'rating' || question.type === 'nps'}}"><text class="muted">{{question.scaleHint}}</text><radio-group class="scale-choices" bindchange="answer" data-id="{{question.id}}"><label wx:for="{{question.choices}}" wx:key="value" class="scale-choice"><radio color="{{themePrimary}}" value="{{item.value}}" checked="{{item.checked}}" disabled="{{busy}}" />{{item.label}}</label></radio-group></block>
    <block wx:if="{{question.type === 'ranking'}}"><text class="muted">{{t.qRankingHint}}</text><view wx:for="{{question.rankRows}}" wx:key="index" class="subquestion"><text class="label">{{t.qRankPrefix}}{{item.index+1}}{{t.qRankSuffix}}</text><picker range="{{item.pickerLabels}}" value="{{item.pickerIndex}}" disabled="{{busy}}" bindchange="rankAnswer" data-id="{{question.id}}" data-index="{{item.index}}"><view class="picker picker-value">{{item.pickerLabels[item.pickerIndex]}} ▾</view></picker></view></block>
    <block wx:if="{{question.type === 'blanks' || question.type === 'matrix' || question.type === 'matrixMultiple'}}"><view wx:for="{{question.matrixRows}}" wx:for-item="row" wx:key="key" class="subquestion"><text class="label">{{row.label}}</text>
      <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" wx:if="{{question.type === 'blanks'}}" value="{{row.value}}" maxlength="200" disabled="{{busy}}" bindinput="rowAnswer" data-id="{{question.id}}" data-row="{{row.key}}" placeholder="{{t.qInput}}" />
      <radio-group wx:if="{{question.type === 'matrix'}}" bindchange="rowAnswer" data-id="{{question.id}}" data-row="{{row.key}}"><label wx:for="{{row.choices}}" wx:key="value" class="choice"><radio color="{{themePrimary}}" value="{{item.value}}" checked="{{item.checked}}" disabled="{{busy}}" />{{item.label}}</label></radio-group>
      <checkbox-group wx:if="{{question.type === 'matrixMultiple'}}" bindchange="rowAnswer" data-id="{{question.id}}" data-row="{{row.key}}"><label wx:for="{{row.choices}}" wx:key="value" class="choice"><checkbox color="{{themePrimary}}" value="{{item.value}}" checked="{{item.checked}}" disabled="{{busy}}" />{{item.label}}</label></checkbox-group>
    </view></block>
    <block wx:if="{{question.type === 'group'}}"><text class="muted">{{t.qGroupHintPrefix}}{{question.minEntries}}–{{question.maxEntries}}{{t.qGroupHintSuffix}}</text><view wx:for="{{question.entries}}" wx:for-item="entry" wx:key="index" class="entry-row"><view class="row"><text class="section-title">{{t.qEntryPrefix}}{{entry.index+1}}{{t.qEntrySuffix}}</text><button wx:if="{{question.canRemove}}" size="mini" disabled="{{busy}}" bindtap="removeEntry" data-id="{{question.id}}" data-index="{{entry.index}}">{{t.qRemoveEntry}}</button></view><view wx:for="{{entry.fields}}" wx:for-item="field" wx:key="id"><text class="label">{{field.label}}{{field.required ? ' *' : t.qOptional}}</text>
      <picker wx:if="{{field.type === 'select'}}" range="{{field.pickerLabels}}" value="{{field.pickerIndex}}" disabled="{{busy}}" bindchange="groupAnswer" data-id="{{question.id}}" data-index="{{entry.index}}" data-field="{{field.id}}"><view class="picker picker-value">{{field.pickerLabels[field.pickerIndex]}} ▾</view></picker>
      <input cursor-spacing="24" placeholder-style="color:{{themeMuted}}" wx:else value="{{field.value}}" type="{{field.inputType}}" maxlength="{{field.maxLength}}" disabled="{{busy}}" bindinput="groupAnswer" data-id="{{question.id}}" data-index="{{entry.index}}" data-field="{{field.id}}" placeholder="{{field.placeholder || t.qInput}}" />
    </view></view><button wx:if="{{question.canAdd}}" class="plain section" disabled="{{busy}}" bindtap="addEntry" data-id="{{question.id}}">{{t.qAddEntry}}</button></block>
    <button wx:if="{{!question.required && question.type !== 'description'}}" size="mini" class="clear-answer section" disabled="{{busy}}" bindtap="clearAnswer" data-id="{{question.id}}">{{t.qClearAnswer}}</button>
    <text wx:if="{{question.error}}" class="question-error" role="alert">{{question.error}}</text>
  </view>
</template>
