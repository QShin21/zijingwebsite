/* Opt-in form and review presentation; API, questionnaire and component behaviour stay in their existing modules. */
.mini-page.native-form-page .page-heading { margin-bottom: 24px; padding: 8px 0 24px; }
.mini-page.native-form-page .page-heading .title { font-size: 28px; line-height: 1.3; letter-spacing: -.4px; }
.mini-page.native-form-page .page-heading .subtitle { margin-top: 12px; }
.mini-page.native-form-page .task-context { margin-bottom: 8px; color: var(--z-muted); font-size: 13px; line-height: 1.65; }
.mini-page.native-form-page .task-section { margin-top: 32px; padding-top: 24px; }
.mini-page.native-form-page .task-section:first-child { margin-top: 0; }
.mini-page.native-form-page .task-section-title { font-size: 19px; line-height: 1.45; }
.mini-page.native-form-page .task-section > .muted { margin-top: 8px; }
.mini-page.native-form-page .section-head { gap: 12px; margin-bottom: 16px; }
.mini-page.native-form-page .section-title { font-size: 19px; line-height: 1.45; }
.mini-page.native-form-page .task-note { padding: 16px 0; font-size: 15px; line-height: 1.8; }
.mini-page.native-form-page .business-summary { margin: 24px 0; padding: 16px; border-left-width: 3px; }
.mini-page.native-form-page .business-summary .body { margin-top: 8px; }
.mini-page.native-form-page .business-summary .meta { margin-top: 12px; }
.mini-page.native-form-page .task-feedback { padding: 16px; margin: 20px 0; border-left-width: 3px; }
.mini-page.native-form-page .task-feedback-label { font-size: 14px; line-height: 1.6; }
.mini-page.native-form-page .task-feedback .body { margin-top: 8px; }
.mini-page.native-form-page .record-list { margin-top: 16px; }
.mini-page.native-form-page .task-record { padding: 24px 0; }
.mini-page.native-form-page .record-heading { gap: 12px; }
.mini-page.native-form-page .record-meta { gap: 4px 12px; margin-top: 8px; font-size: 13px; line-height: 1.7; }
.mini-page.native-form-page .record-detail { padding-top: 12px; }
.mini-page.native-form-page .record-facts, .mini-page.native-form-page .object-facts { margin: 20px 0; }
.mini-page.native-form-page .record-fact, .mini-page.native-form-page .fact-row { gap: 16px; padding: 8px 0; }
.mini-page.native-form-page .fact-label { flex: 0 0 76px; width: 76px; font-size: 14px; line-height: 1.75; }
.mini-page.native-form-page .fact-value { font-size: 15px; line-height: 1.75; }
.mini-page.native-form-page .material-title { margin: 20px 0 8px; font-size: 15px; line-height: 1.65; }
.mini-page.native-form-page .review-actions { margin-top: 24px; padding: 16px; border-radius: 8px; }
.mini-page.native-form-page .review-actions .field { margin: 16px 0; }
.mini-page.native-form-page .review-actions .actions { margin-top: 16px; }
.mini-page.native-form-page .disclosure { gap: 12px; padding: 12px 0; }
.mini-page.native-form-page .form-footer { margin-top: 24px; padding-top: 20px; }
.mini-page.native-form-page .form-footer .action-bar { margin-top: 16px; }
.mini-page.native-form-page .compact-actions { gap: 8px 12px; margin-top: 12px; }
.mini-page.native-form-page .selection-label { gap: 12px; padding: 16px 0; font-size: 15px; line-height: 1.75; }
.mini-page.native-form-page .selection-label > view { min-width: 0; }
.mini-page.native-form-page .result-message { margin: 20px 0; padding: 16px; border-left-width: 3px; font-size: 15px; line-height: 1.8; }
.mini-page.native-form-page .pagination { flex-wrap: wrap; gap: 8px 12px; margin: 24px 0; }
.mini-page.native-form-page .pagination > text { font-size: 14px; line-height: 1.7; }
.mini-page.native-form-page .task-section .field:first-child { margin-top: 16px; }
.mini-page.native-form-page .scope-filters { gap: 16px; margin: 24px 0; }
.mini-page.native-form-page .scope-filters .field-label { font-size: 14px; }
.mini-page.native-form-page .scope-filters picker { height: auto; }
.mini-page.native-form-page .scope-switch { margin: 24px 0; }
.mini-page.native-form-page .scope-tab { min-width: 44px; padding: 12px 8px; border-bottom-width: 2px; border-radius: 0; font-size: 15px; }
.mini-page.native-form-page .privacy-links { gap: 8px 16px; }
.mini-page.native-form-page .privacy-note, .mini-page.native-form-page .branch-notice { padding: 16px; margin-top: 20px; border-left-width: 3px; font-size: 14px; line-height: 1.8; }
.mini-page.native-form-page .consent { margin: 20px 0; }
.mini-page.native-form-page .consent > text, .mini-page.native-form-page .consent > view { flex: 1; min-width: 0; }
.mini-page.native-form-page .answer { padding: 16px 0; font-size: 15px; line-height: 1.8; }
.mini-page.native-form-page .record-id { margin-bottom: 8px; font-size: 12px; line-height: 1.7; overflow-wrap: anywhere; }
.mini-page.native-form-page .timeline { gap: 12px; margin: 24px 0; }
.mini-page.native-form-page .timeline-step { min-width: 64px; padding-top: 12px; border-top-width: 2px; font-size: 13px; line-height: 1.6; }
.mini-page.native-form-page .timeline-number { margin-bottom: 4px; font-size: 12px; }
.mini-page.native-form-page .form-section { margin-top: 24px; padding-top: 20px; }
.mini-page.native-form-page .form-section-title { margin-bottom: 8px; font-size: 17px; line-height: 1.5; }
.mini-page.native-form-page .field .row picker { min-width: 120px; }
.mini-page.native-form-page .task-feedback, .mini-page.native-form-page .result-message, .mini-page.native-form-page .privacy-note { width: 100%; min-width: 0; max-width: 100%; overflow-wrap: anywhere; word-break: break-word; }
@media (max-width: 359px) {
  .mini-page.native-form-page .scope-filters { flex-direction: column; }
  .mini-page.native-form-page .record-heading { flex-wrap: wrap; }
  .mini-page.native-form-page .record-heading .badge { max-width: 100%; }
  .mini-page.native-form-page .record-fact, .mini-page.native-form-page .fact-row { gap: 12px; }
  .mini-page.native-form-page .fact-label { flex-basis: 68px; width: 68px; }
}
