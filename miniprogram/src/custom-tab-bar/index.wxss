.tab-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 1000; display: flex; min-height: 98rpx; padding-bottom: env(safe-area-inset-bottom); border-top: 1rpx solid; }
.tab-item { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; margin: 0; padding: 4rpx; border-radius: 0; background: transparent; font-size: 20rpx; line-height: 1.2; }
.tab-item::after { border: 0; }
.tab-icon { width: 42rpx; height: 42rpx; }
.tab-active { font-weight: 700; }
