/* 紫荆赛场 V2 — native global layer. Colors come from lib/theme.js (--z-* page vars). */
@import "/templates/v2.wxss";

page { background: var(--z-page); color: var(--z-text); font-family: 'PingFang SC', 'HarmonyOS Sans SC', 'MiSans', 'Microsoft YaHei', -apple-system, sans-serif; font-size: 30rpx; line-height: 1.7; }
view, button, input, textarea, picker, scroll-view { box-sizing: border-box; }
button { margin: 0; font: inherit; white-space: normal; }
button::after { border: 0; }
.mini-page { width: 100%; max-width: 760px; margin: 0 auto; padding: 24rpx 32rpx 64rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.mini-page button { min-width: 44px; min-height: 44px; border: 3rpx solid var(--z-line-strong); border-radius: 999rpx; background: var(--z-surface); color: var(--z-text); padding: 18rpx 32rpx; line-height: 1.5; font-size: 28rpx; font-weight: 700; }
.mini-page button[disabled], .mini-page input[disabled], .mini-page textarea[disabled] { opacity: 1; color: var(--z-disabled-text); background: var(--z-disabled-bg); border-color: var(--z-disabled-bg); }
.mini-page .primary { background: var(--z-primary); color: var(--z-on-primary); border-color: var(--z-primary); font-weight: 800; }
.mini-page .accent { background: var(--z-accent); color: var(--z-on-accent); border-color: var(--z-accent); font-weight: 800; }
.mini-page .secondary { background: var(--z-tint); color: var(--z-primary); border-color: var(--z-tint); font-weight: 700; }
.mini-page .plain { color: var(--z-link); border-color: transparent; background: transparent; padding: 18rpx 0; }
.mini-page .danger { background: var(--z-danger-bg); color: var(--z-danger-text); border-color: var(--z-danger-border); }
.mini-page .content-link { display: block; width: 100%; text-align: left; padding: 0; font-weight: 400; border: 0; border-radius: 0; background: transparent; }
.mini-page .back, .mini-page > .plain:first-child { display: inline-flex; align-items: center; width: auto; padding: 0 16rpx 0 0; margin-bottom: 24rpx; font-size: 26rpx; font-weight: 800; }
.eyebrow { display: block; color: var(--z-primary); font-size: 24rpx; font-weight: 900; letter-spacing: 2rpx; line-height: 1.5; margin-bottom: 12rpx; }
.title { display: block; font-size: 52rpx; line-height: 1.2; font-weight: 900; letter-spacing: -1rpx; word-break: break-word; }
.subtitle { display: block; color: var(--z-muted); font-size: 29rpx; line-height: 1.75; margin-top: 16rpx; word-break: break-word; }
.page-heading { padding: 36rpx 32rpx 36rpx; margin: 0 -32rpx 28rpx; background: linear-gradient(160deg, var(--z-stage) 0%, var(--z-stage2) 100%); color: var(--z-stage-ink); border-radius: 0 0 40rpx 40rpx; }
.page-heading .eyebrow { color: var(--z-accent); }
.page-heading .subtitle { color: var(--z-stage-muted); max-width: 36em; }
.page-heading .meta, .page-heading .muted { color: var(--z-stage-muted); }
.section { margin-top: 44rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 22rpx; margin-bottom: 20rpx; }
.section-head > view { min-width: 0; flex: 1; }
.section-title { display: block; font-size: 36rpx; line-height: 1.4; font-weight: 900; word-break: break-word; }
.section-kicker { display: block; margin-bottom: 8rpx; font-size: 22rpx; color: var(--z-primary); font-weight: 900; letter-spacing: 2rpx; }
.section-index { color: var(--z-primary); font-size: 25rpx; margin-right: 16rpx; font-weight: 900; }
.mini-page .more { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: flex-end; min-width: 44px; min-height: 44px; padding: 16rpx 0 16rpx 12rpx; border: 0; background: transparent; color: var(--z-link); font-size: 26rpx; font-weight: 800; }
.panel { padding: 28rpx; margin-top: 20rpx; border: 1rpx solid var(--z-line); background: var(--z-surface); border-radius: 32rpx; }
.form-sheet, .status-panel, .notice-panel { padding: 30rpx; border: 1rpx solid var(--z-line); border-radius: 32rpx; background: var(--z-surface); }
.form-sheet .panel { border: 0; border-top: 1rpx solid var(--z-line); border-radius: 0; padding: 26rpx 0; margin: 0; }
.card { position: relative; border: 1rpx solid var(--z-line); border-radius: 32rpx; margin-bottom: 20rpx; background: var(--z-surface); overflow: hidden; }
.card-body { padding: 26rpx 28rpx; }
.card-image { display: block; width: 100%; height: 320rpx; background: var(--z-media); }
.card-title { display: block; font-size: 33rpx; line-height: 1.5; font-weight: 800; margin-top: 10rpx; word-break: break-word; }
.card-summary { display: block; color: var(--z-muted); font-size: 27rpx; line-height: 1.8; margin-top: 10rpx; word-break: break-word; }
.card-footer { margin-top: 18rpx; }
.meta { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; color: var(--z-muted); font-size: 24rpx; line-height: 1.7; word-break: break-word; }
.badge { display: inline-block; color: var(--z-primary); background: var(--z-tint); border-radius: 999rpx; padding: 4rpx 18rpx; font-size: 22rpx; font-weight: 800; line-height: 1.6; }
.muted { display: block; color: var(--z-muted); font-size: 27rpx; line-height: 1.8; word-break: break-word; }
.body { display: block; margin-top: 24rpx; color: var(--z-body); line-height: 1.85; font-size: 31rpx; white-space: pre-wrap; word-break: break-word; }
.body rich-text { white-space: normal; }
.row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 18rpx; }
.row > .section-title { flex: 1; min-width: 200rpx; }
.row > picker { flex: 1; min-width: 0; }
.actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 26rpx 0 0; }
.actions > button { flex: 1; min-width: 220rpx; }
.actions > .plain { min-width: 180rpx; }
.action-bar { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 36rpx; padding: 24rpx 0 calc(8rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--z-line); }
.action-bar > button { flex: 1; min-width: 220rpx; }
.chips { display: block; width: 100%; white-space: nowrap; margin: 24rpx 0; padding-bottom: 4rpx; }
.mini-page .chip { display: inline-flex; justify-content: center; align-items: center; vertical-align: middle; width: auto; min-height: 44px; padding: 14rpx 28rpx; margin: 0 12rpx 10rpx 0; background: var(--z-surface); border: 3rpx solid var(--z-line); border-radius: 999rpx; color: var(--z-muted); font-size: 26rpx; font-weight: 800; }
.mini-page .chip.active { color: var(--z-page); background: var(--z-text); border-color: var(--z-text); }
.search { display: flex; gap: 12rpx; margin: 24rpx 0; align-items: stretch; }
.search input { flex: 1; min-width: 0; border-radius: 999rpx; padding-left: 32rpx; }
.search button { flex-shrink: 0; }
input, textarea, .field picker, .picker-value { width: 100%; min-height: 44px; background: var(--z-field-bg); color: var(--z-text); border: 3rpx solid var(--z-field-border); border-radius: 24rpx; padding: 20rpx 24rpx; font-size: 30rpx; line-height: 1.6; }
input { height: 96rpx; }
textarea { height: 244rpx; }
input::placeholder, textarea::placeholder { color: var(--z-muted); opacity: 1; }
.field { display: block; margin: 28rpx 0; }
.field-label, .label, .answer-label { display: block; font-size: 28rpx; line-height: 1.6; font-weight: 800; margin: 0 0 12rpx; }
.field .muted { margin-top: 12rpx; }
.field .row picker { min-width: 220rpx; }
.form-section { margin-top: 32rpx; padding-top: 28rpx; border-top: 1rpx solid var(--z-line); }
.form-section:first-child { border-top: 0; padding-top: 0; }
.form-section-title { display: block; font-weight: 900; font-size: 32rpx; line-height: 1.5; margin-bottom: 12rpx; }
.field-note { display: block; margin-top: 10rpx; color: var(--z-muted); font-size: 25rpx; line-height: 1.75; }
.filters { padding: 20rpx 24rpx; margin: 24rpx 0; border: 1rpx solid var(--z-line); border-radius: 28rpx; background: var(--z-surface); }
.filters picker { flex: 1; min-width: 0; padding: 16rpx 10rpx; min-height: 44px; color: var(--z-link); font-weight: 700; }
.consent { display: flex; gap: 16rpx; align-items: flex-start; padding: 24rpx; margin: 24rpx 0; border: 3rpx solid var(--z-line); border-radius: 24rpx; background: var(--z-surface); color: var(--z-text); font-size: 28rpx; line-height: 1.8; }
.consent checkbox, .consent switch, .choice checkbox, .choice radio { flex-shrink: 0; }
.privacy-note, .branch-notice { display: block; padding: 24rpx; margin-top: 24rpx; border-left: 8rpx solid var(--z-primary); border-radius: 0 20rpx 20rpx 0; background: var(--z-tint); color: var(--z-text); font-size: 27rpx; line-height: 1.8; }
.error { display: block; width: 100%; margin: 22rpx 0; padding: 22rpx 26rpx; border: 1rpx solid var(--z-danger-line); border-radius: 24rpx; background: var(--z-danger-bg); color: var(--z-danger); line-height: 1.8; font-size: 28rpx; font-weight: 700; word-break: break-word; }
.state, .empty { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14rpx; padding: 48rpx 32rpx; margin: 24rpx 0; border: 3rpx dashed var(--z-line-strong); border-radius: 32rpx; background: var(--z-surface); }
.state-title { display: block; font-size: 33rpx; line-height: 1.5; font-weight: 900; }
.state button { margin-top: 8rpx; min-width: 240rpx; }
.state-dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--z-accent); box-shadow: 0 0 0 10rpx var(--z-tint); }
.loading-lines { width: 100%; }
.loading-line { height: 22rpx; width: 88%; background: var(--z-tint); border-radius: 12rpx; margin-top: 18rpx; animation: zj-pulse 1.2s ease-in-out infinite; }
.loading-line.short { width: 52%; }
@keyframes zj-pulse { 50% { opacity: .45; } }
.separator { height: 1rpx; margin: 30rpx 0; background: var(--z-line); }
.bottom-note { display: block; color: var(--z-muted); font-size: 24rpx; line-height: 1.8; padding-top: 28rpx; border-top: 1rpx solid var(--z-line); margin-top: 44rpx; word-break: break-word; }
.photo { display: block; width: 100%; max-width: 100%; border-radius: 24rpx; margin: 20rpx 0 12rpx; background: var(--z-media); }
.mini-page .image-button { display: block; padding: 0; width: 100%; min-height: 44px; background: transparent; border: 0; border-radius: 0; }
video, .evidence-video, .honor-video, .showcase-video { display: block; width: 100%; height: 380rpx; margin-top: 24rpx; border-radius: 24rpx; background: var(--z-video-surface); }
.qr, .qr-image, .contact-qr { display: block; width: 360rpx; height: 360rpx; max-width: 100%; margin: 24rpx auto; background: white; padding: 18rpx; border-radius: 24rpx; }
.answer { padding: 24rpx 0; border-top: 1rpx solid var(--z-line); white-space: pre-wrap; word-break: break-word; }
.record-sheet { padding: 28rpx; margin-top: 24rpx; border: 1rpx solid var(--z-line); border-radius: 32rpx; background: var(--z-surface); }
.record-sheet .muted { margin-top: 10rpx; }
.record-sheet .actions { padding-top: 20rpx; border-top: 1rpx solid var(--z-line); }
.record-id { font-size: 24rpx; color: var(--z-muted); margin-bottom: 12rpx; display: block; }
.reading-body { margin-top: 32rpx; font-size: 31rpx; line-height: 1.85; }
.directory-row { display: flex; align-items: center; gap: 22rpx; width: 100%; padding: 26rpx 28rpx; margin-bottom: 16rpx; border: 1rpx solid var(--z-line); border-radius: 28rpx; background: var(--z-surface); }
.mini-page button.directory-row { display: flex; padding: 26rpx 28rpx; border: 1rpx solid var(--z-line); border-radius: 28rpx; text-align: left; font-weight: 400; }
.directory-index { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 20rpx; background: var(--z-stage); color: var(--z-accent); font-size: 26rpx; font-weight: 900; }
.directory-main { flex: 1; min-width: 0; }
.directory-title { display: block; color: var(--z-text); font-size: 32rpx; line-height: 1.5; font-weight: 800; }
.directory-main .muted { margin-top: 6rpx; }
.directory-arrow { color: var(--z-primary); flex-shrink: 0; font-weight: 900; }
.timeline { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 28rpx 0; }
.timeline-step { flex: 1; min-width: 140rpx; border-top: 6rpx solid var(--z-line); padding-top: 16rpx; color: var(--z-muted); font-size: 25rpx; line-height: 1.6; }
.timeline-step.current { border-color: var(--z-primary); color: var(--z-text); font-weight: 800; }
.timeline-step text { display: block; }
.timeline-number { font-size: 23rpx; margin-bottom: 6rpx; color: var(--z-primary); font-weight: 900; }
.status-panel .section-title { color: var(--z-primary); }
.status-panel > .muted { margin-top: 14rpx; }
.honor, .honor-record { border-top: 6rpx solid var(--z-accent); }
.honor-title { margin: 18rpx 0; }
.honor-placing { display: block; font-size: 48rpx; line-height: 1.4; color: var(--z-primary); font-weight: 900; }
.profile-card .avatar, .preview-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; margin-bottom: 20rpx; }
.biography { white-space: pre-wrap; word-break: break-word; }
.mini-page .pressed { opacity: .72; }
.mini-page button:focus, .mini-page input:focus, .mini-page textarea:focus, .mini-page picker:focus { outline: 2px solid var(--z-focus); outline-offset: 4rpx; }
.zj-tab-page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.theme-choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 24rpx; }
.mini-page .theme-choice { width: 100%; min-width: 0; text-align: left; background: var(--z-surface); border-radius: 28rpx; }
.mini-page .theme-choice.selected { border-color: var(--z-primary); background: var(--z-tint); }
.theme-choice-title { display: flex; justify-content: space-between; gap: 12rpx; margin-top: 14rpx; }
.theme-check { color: var(--z-primary); }
.theme-swatch { height: 84rpx; border: 1rpx solid var(--z-line); border-radius: 16rpx; padding: 12rpx; }
.theme-swatch view { height: 6rpx; width: 80%; margin-top: 9rpx; background: currentColor; opacity: .4; }
.theme-swatch view:first-child { width: 46%; opacity: 1; }
.theme-swatch-light { background: var(--z-theme-light-page); color: var(--z-theme-light-primary); }
.theme-swatch-dark { background: var(--z-theme-dark-page); color: var(--z-theme-dark-primary); }
.theme-swatch-summer { background: var(--z-theme-summer-page); color: var(--z-theme-summer-primary); }
.theme-swatch-simple { background: var(--z-theme-simple-page); color: var(--z-theme-simple-primary); }
.theme-message { display: block; margin-top: 22rpx; color: var(--z-body); }
.entry-image { margin-top: 24rpx; height: 280rpx; }
.entry-link { color: var(--z-link); font-weight: 700; }
.archive-date { font-variant-numeric: tabular-nums; color: var(--z-primary); font-weight: 800; }
.evidence-detail { border-color: var(--z-primary); }
.review-decision { padding-top: 24rpx; border-top: 1rpx solid var(--z-line); }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 12rpx 24rpx; padding-bottom: 16rpx; margin-bottom: 8rpx; }
.task-summary { padding: 28rpx; margin-bottom: 20rpx; border: 1rpx solid var(--z-line); border-radius: 32rpx; background: var(--z-surface); }
.task-summary .title { font-size: 42rpx; }
.task-summary > .muted, .task-summary > .meta { margin-top: 14rpx; }
.task-summary .actions { margin-top: 22rpx; }
.record-list { margin-top: 12rpx; }
.record-row { padding: 26rpx 28rpx; margin-bottom: 16rpx; border: 1rpx solid var(--z-line); border-radius: 28rpx; background: var(--z-surface); }
.record-row > .muted, .record-row > .meta { margin-top: 10rpx; }
.meta-line { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx 20rpx; color: var(--z-muted); font-size: 26rpx; line-height: 1.7; word-break: break-word; }
.object-facts { margin: 24rpx 0; padding: 8rpx 24rpx; border-radius: 24rpx; background: var(--z-surface); border: 1rpx solid var(--z-line); }
.fact-row { display: flex; align-items: flex-start; gap: 24rpx; padding: 14rpx 0; border-bottom: 1rpx solid var(--z-line); }
.fact-row:last-child { border-bottom: 0; }
.fact-label { flex-shrink: 0; width: 128rpx; color: var(--z-muted); font-size: 26rpx; font-weight: 700; }
.fact-value { flex: 1; min-width: 0; font-size: 29rpx; font-weight: 600; word-break: break-word; }
.mini-page .section-tab { border: 3rpx solid var(--z-line); border-radius: 999rpx; margin: 0 12rpx 0 0; padding: 12rpx 28rpx; background: var(--z-surface); color: var(--z-muted); }
.mini-page .section-tab.active { border-color: var(--z-text); background: var(--z-text); color: var(--z-page); }
.section-tabs { margin: 18rpx 0 24rpx; padding-bottom: 0; white-space: nowrap; }
.filter-group { margin-bottom: 24rpx; padding: 24rpx; border: 1rpx solid var(--z-line); border-radius: 28rpx; background: var(--z-surface); }
.filter-group .search { margin: 14rpx 0 20rpx; }
.filter-group .chips { margin: 16rpx 0 0; }
.filter-label { display: block; color: var(--z-text); font-size: 27rpx; font-weight: 800; margin-bottom: 10rpx; }
.result-caption { display: block; color: var(--z-muted); font-size: 26rpx; font-weight: 700; margin: 20rpx 0; }
.mini-page .content-record { display: block; padding: 26rpx 28rpx; margin-bottom: 16rpx; border: 1rpx solid var(--z-line); border-radius: 28rpx; background: var(--z-surface); }
.content-record-main { display: flex; align-items: flex-start; gap: 22rpx; }
.content-record-copy { flex: 1; min-width: 0; }
.content-record-date { flex-shrink: 0; width: 126rpx; padding-top: 4rpx; color: var(--z-primary); font-size: 25rpx; font-weight: 800; line-height: 1.6; font-variant-numeric: tabular-nums; word-break: break-word; }
.content-record .card-title { margin-top: 6rpx; font-size: 31rpx; line-height: 1.5; }
.content-record .card-summary { font-size: 27rpx; line-height: 1.75; }
.content-record .meta { font-size: 24rpx; }
.content-record-thumb { width: 136rpx; height: 136rpx; flex-shrink: 0; border-radius: 20rpx; background: var(--z-media); }
.content-record-image { display: block; width: 100%; height: 300rpx; margin-bottom: 20rpx; border-radius: 20rpx; background: var(--z-media); }
.content-record .record-result { display: block; color: var(--z-primary); font-size: 38rpx; font-weight: 900; margin-top: 12rpx; }
.content-record .entry-link { display: block; margin-top: 14rpx; color: var(--z-link); font-size: 26rpx; }
.content-record .date-label { display: block; color: var(--z-muted); font-size: 22rpx; margin-bottom: 6rpx; }
.notice-inline { padding: 24rpx; border-left: 8rpx solid var(--z-primary); border-radius: 0 20rpx 20rpx 0; background: var(--z-tint); color: var(--z-text); }
.mini-page .shortcut { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; width: 100%; padding: 26rpx 28rpx; margin-bottom: 14rpx; text-align: left; border: 1rpx solid var(--z-line); background: var(--z-surface); border-radius: 28rpx; font-weight: 400; }
.shortcut-main { flex: 1; min-width: 0; }
.shortcut-title { display: block; font-size: 30rpx; font-weight: 800; line-height: 1.5; }
.shortcut .muted { margin-top: 6rpx; }
.shortcut-sign { flex-shrink: 0; display: flex; align-items: center; justify-content: center; min-width: 56rpx; height: 56rpx; padding: 0 14rpx; border-radius: 999rpx; background: var(--z-tint); color: var(--z-primary); font-size: 28rpx; font-weight: 900; }
.content-links { margin-top: 28rpx; }
.content-links .record-row { padding: 20rpx 24rpx; }
.business-page .title { font-size: 44rpx; }
.business-page .page-heading { margin-bottom: 20rpx; }
.business-page .section { margin-top: 32rpx; }
.business-page .record-sheet { margin-top: 20rpx; }
.business-page .section-title { font-size: 32rpx; }
@media (max-width: 359px) {
  page { font-size: 15px; }
  .body, .subtitle, .field-label, .label, .answer-label, input, textarea, .mini-page .field picker, .mini-page .picker-value,
  .mini-page button, .mini-page .back, .mini-page > .plain:first-child, .mini-page .more, .mini-page .chip,
  .mini-page .consent, .mini-page .privacy-note, .mini-page .branch-notice, .mini-page .error, .mini-page .question-error, .mini-page .reading-body { font-size: 15px; }
  .muted, .field-note, .card-summary { font-size: 14px; }
  .timeline-step { font-size: 13px; }
  .meta, .badge, .eyebrow, .bottom-note, .section-kicker, .timeline-number, .record-id { font-size: 12px; }
  .mini-page { padding-left: 24rpx; padding-right: 24rpx; }
  .content-record-date { width: 112rpx; font-size: 12px; }
  .content-record .card-summary, .meta-line, .fact-label, .result-caption { font-size: 14px; }
  .content-record .card-title, .shortcut-title, .fact-value { font-size: 16px; }
  .content-record .date-label { font-size: 12px; }
}

/* ===== 像素校园 (2026-11-13): square plates, dark outlines and hard shadows; same tokens as the web palettes. ===== */
page { --zp-outline: #1d1430; --zp-shadow: rgba(29, 20, 48, .22); }
.mini-page button { border: 4rpx solid var(--zp-outline); border-radius: 0; box-shadow: inset 0 -8rpx 0 rgba(0, 0, 0, .14), 0 6rpx 0 var(--zp-shadow); }
.zj-dark { --zp-outline: #140d24; --zp-shadow: #140d24; }
.mini-page button.button-hover { transform: translateY(6rpx); box-shadow: inset 0 6rpx 0 rgba(0, 0, 0, .16); }
.mini-page button[disabled] { border-color: var(--z-line-strong); box-shadow: none; }
.mini-page .primary, .mini-page .accent, .mini-page .secondary, .mini-page .danger { border-color: var(--zp-outline); }
.mini-page .plain { border-color: transparent; box-shadow: none; }
.mini-page .plain.button-hover { transform: none; box-shadow: none; opacity: .7; }
.panel, .form-sheet, .status-panel, .notice-panel, .card, .filters { border: 4rpx solid var(--zp-outline); border-radius: 0; box-shadow: 8rpx 8rpx 0 var(--zp-shadow); }
.form-sheet .panel { border: 0; border-top: 4rpx dashed var(--z-line); box-shadow: none; }
.mini-page .chip { border: 4rpx solid var(--z-line-strong); border-radius: 0; }
.mini-page .chip.active { background: var(--z-primary); color: var(--z-on-primary); border-color: var(--zp-outline); }
input, textarea, .field picker, .picker-value, .search input { border-width: 4rpx; border-radius: 0; box-shadow: inset 6rpx 6rpx 0 rgba(0, 0, 0, .06); }
.badge { border-radius: 0; }
.error, .privacy-note, .branch-notice, .consent { border-radius: 0; }
.state-dot { border-radius: 0; }
.page-heading { border-bottom: 6rpx solid var(--zp-outline); }
