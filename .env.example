APP_ENV=development
DATABASE_URL=postgresql://zijing:CHANGE_ME@127.0.0.1:55439/zijing
PAYLOAD_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Runtime origin (takes precedence; Compose fills this from NEXT_PUBLIC_SERVER_URL)
SERVER_URL=http://localhost:3000
DB_PUSH=false
MEDIA_DIR=media
# Optional production object storage; use a dedicated public-media bucket
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Supply ADMIN_EMAIL and ADMIN_PASSWORD only for admin:create
# BACKUP_DEST / BACKUP_REMOTE / BACKUP_RETENTION_DAYS configure backup scripts

# SMTP (optional; password reset disabled without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Backup client tools and isolated restore
PG_BIN=
BACKUP_DEST=backups
BACKUP_REMOTE=
BACKUP_RETENTION_DAYS=14
MEDIA_BACKUP_SOURCE=
RESTORE_DATABASE_URL=
